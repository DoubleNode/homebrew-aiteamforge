#!/usr/bin/env bash
# kb-tap-release — One-shot homebrew-tap release-cut command.
#
# Usage: kb-tap-release {patch|minor|major} [--dry-run] [--no-push] [--as-human] [--help]
#        kb-tap-release --push-only [--as-human]
#        kb-tap-release --push-tap-edit [--dry-run] [--as-human]
#
# Cuts a release of the AITeamForge homebrew tap:
#   Phase 0: Acquire the tap-writer lock (XACA-1122-008; skipped by --dry-run
#            and --no-push, which write to no remote). Released on every exit.
#   Phase 1: Compute new version, edit CHANGELOG.md / VERSION / Formula
#   Phase 2: Tap inner commit + tag + push (origin main)
#   Phase 3: Outer pointer bump commit + push (<outer-remote>/develop)
#
# XACA-1170-041: --push-tap-edit is the sanctioned way to push an already-prepared
# TAP-ONLY commit (a file with no dev-team canonical: tests/, libexec/, bin/, ...)
# to tap main as the release App once STRICT tap protection leaves no other write
# path. It is not a release cut: it commits nothing, tags nothing, bumps no version.
#
# XACA-1170-003: the two TAP pushes (main + release tag) are made as the
# `aiteamforge-release` GitHub App, not as the human admin. Under STRICT tap
# protection exactly two identities may write tap main: the publisher App and
# this one. The OUTER develop push (phase 3) stays the human admin on purpose —
# dev-team develop is ruleset-protected with bypass only for the publisher App
# and admins, so routing it through the release App would be refused.
#
# This script is one of exactly TWO writers to tap `main`; the other is the
# post-merge publisher workflow. They serialize against each other through
# refs/locks/tap-writer in the tap repo — see scripts/kb-tap-lock.sh. A GitHub
# `concurrency:` group cannot do this job, because it cannot reach a laptop.
#
# Outer-remote name: defaults via auto-detect (prefer "origin", fall back to
# "dev-team") so this works on both standard clones and on the dev-team source
# of truth, which uses "dev-team" as its remote name. Override explicitly with
# KB_TAP_RELEASE_OUTER_REMOTE. Tap inner remote is always "origin".
#
# XACA-0570, XACA-0575

set -euo pipefail

# ─── usage ───────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: kb-tap-release {patch|minor|major} [--dry-run] [--no-push] [--as-human]
                       [--tap-ahead-release="<reason>"] [--help]
       kb-tap-release --push-only [--as-human]
       kb-tap-release --push-tap-edit [--dry-run] [--as-human]

Cut a release of the AITeamForge homebrew tap.

Positional:
  patch | minor | major   Required. Which semver component to bump.

Flags:
  --dry-run     Print intended actions, write nothing, commit nothing, push nothing.
                Runs all preconditions; exits 0 if they pass, nonzero if any fail.
  --no-push     Perform local commits + tags but skip both git push calls.
                Takes NO tap-writer lock (nothing is pushed) — so the manual
                push you run afterwards is not serialized against the publisher.
  --tap-ahead-release="<reason>"
                Waiver for preflight #9 when the ONLY drift is TAP-AHEAD (the
                tap mirror already carries a newer, sanctioned mirror-ahead
                push whose canonical half has not merged yet — XACA-1112).
                Without this flag, preflight #9 BLOCKS on tap-ahead drift: a
                release cut from tap main's current tip would ship that
                unmerged content to consumers, which is exactly the near-miss
                XACA-1112-007 investigated. A written reason is required (not
                a bare "intentional") and is recorded as a 'Tap-Ahead-Release:'
                trailer on BOTH the tap release commit and the outer pointer-
                bump commit, so a waived release is auditable in git history.
                Does NOT waive CANONICAL-AHEAD or DIVERGED drift — those still
                hard-fail unconditionally; sync-tap.sh's remedy is CORRECT for
                those two directions.
  --as-human    EMERGENCY ESCAPE HATCH (also TAP_RELEASE_PUSH_AS_HUMAN=1): push the
                tap as the invoking human instead of the aiteamforge-release App.
                Prints a loud banner. Once STRICT tap protection is applied this
                push is REFUSED by GitHub unless that human holds an admin bypass.
                There is NO silent fallback: without this flag any credential or
                mint failure aborts BEFORE anything is committed or pushed.
  --push-only   Recovery: re-run ONLY the tap pushes (main + the single v* tag
                that points at tap HEAD) as the release App, after a release
                whose push step failed. Takes the tap-writer lock. Does not
                touch the outer repo; finish that by hand (see Partial-failure
                recovery). Cannot be combined with a bump level, --dry-run or
                --no-push.
  --push-tap-edit
                Push the tap's HEAD (one or more ALREADY-COMMITTED, TAP-ONLY commits)
                to tap main as the release App, under the tap-writer lock, with the
                single-writer hook's release marker on that one push. For files that
                have NO dev-team canonical (tests/, libexec/ except the one mirrored
                file, bin/, plugins/, Formula/, README.md, ...). It is NOT for mirrored
                content: that is the publisher's. Run from the outer checkout whose
                homebrew-tap/ holds the commit(s). Every precondition is checked
                BEFORE the lock and before any token is minted; any failure aborts
                with nothing pushed:
                  - the tap working tree and index are clean (untracked files too);
                  - tap main is fetched from the tap URL (read-only, no token) and HEAD
                    is a strict fast-forward of it with >= 1 new commit (behind,
                    diverged, or equal = refused);
                  - the new range is LINEAR (a merge commit is refused: its diff
                    against the first parent hides what the other parent brought);
                  - EVERY new commit carries exactly one trailer
                    'Tap-Only-Edit: intentional' (exact key and value, parsed by
                    git interpret-trailers - not a grep of the body; git itself
                    normalises the ':' spacing);
                  - NO new commit touches a path the publisher owns: any destination
                    in `zsh sync-tap.sh --check --porcelain` (the authoritative map,
                    evaluated exactly as the publisher does: develop's script over
                    develop's tree, materialised with git archive - nothing local is
                    read), anything under a TAP_STAGE_PATHS directory (share/,
                    fleet-monitor/server/, docs/), and the exact files the publisher
                    stages by name (.githooks/pre-push, CHANGELOG.md - derived from
                    sync-tap.sh's own `git add` calls). Adds, modifies, deletes and
                    BOTH sides of a rename count; offenders are listed per commit.
                    Needs zsh on PATH (fail closed without it).
                After the lock is taken tap main is re-fetched and must be unchanged,
                and HEAD must still be the commit that was checked. On success it
                prints the new tap SHA and the two-step follow-up (a dev-team PR that
                bumps the gitlink - this command never touches the outer repo).
                Cannot be combined with a bump level, --push-only, --no-push or
                --tap-ahead-release. --dry-run runs every precondition and nothing
                else (no lock, no token, no push). --as-human is allowed, with the loud
                banner, and is refused by GitHub once STRICT is applied.
  -h, --help    Print this usage and exit 0.

Release identity (XACA-1170-003) — one-time setup, per machine:
  The tap pushes authenticate as the `aiteamforge-release` GitHub App. Configure:
    mkdir -p ~/.config/gh-tap-release && chmod 700 ~/.config/gh-tap-release
    echo <APP_ID> > ~/.config/gh-tap-release/app-id        # or TAP_RELEASE_APP_ID
    # private key: exactly ONE <name>.private-key.pem in that directory, mode
    # 0600 (or TAP_RELEASE_APP_KEY_PATH=/path/to/key). A group/world-readable
    # key is refused. The App id and key are never defaulted or guessed.
  A short-lived installation token scoped to homebrew-aiteamforge with
  contents:write only is minted per run and handed to git through GIT_CONFIG_*
  environment variables — never argv, never disk, never git config. The
  credential headers are scoped to the tap's own URL (git's http.<url>.* /
  credential.<url>.* keys), so a git command that reaches another repo — e.g. the
  outer dev-team remote — never receives the
  token and keeps its normal credential helper. The token is minted LAST: after
  the config/URL checks, the tap-writer lock wait and preflight, immediately
  before the first push, so a long KB_TAP_RELEASE_LOCK_WAIT cannot age it. It is
  not minted for --dry-run or --no-push (they push nothing); --dry-run only
  checks that the App id and key resolve, without touching the network.
  Every App git call also pins GIT_ASKPASS=false and REFUSES to run when an inherited
  GIT_CONFIG_PARAMETERS (a `git -c` wrapper) sets credential.*, url.*, http.*,
  protocol.*, include*, or core.sshCommand/askPass/gitProxy/hooksPath: git applies those
  AFTER the URL-scoped credential reset, so a 401 on the App token could otherwise fall
  through to the human's credential helper (XACA-1170-047). Unrelated -c settings pass.
  The App push also pins GIT_ALLOW_PROTOCOL=https. The tap's pre-push hook is a pure
  single-writer identity check and never fetches the outer remote, so the pin does not
  constrain the outer remote's transport (XACA-1580); the develop fetch that reads the
  publisher-owned map is the human's own, via KB_TAP_RELEASE_OUTER_REMOTE.

Environment:
  KB_TAP_RELEASE_LOCK_WAIT      Seconds to wait for the tap-writer lock before
                                giving up. Default 0 (fail immediately, loudly).
                                Inspect the lock with scripts/kb-tap-lock.sh status.
  KB_TAP_RELEASE_OUTER_REMOTE   Outer-repo remote name (default: auto-detect —
                                 prefer "origin", fall back to "dev-team").
                                 Tap inner remote is always "origin".

Preconditions (all checked before any mutation, including --dry-run):
  1.  Run from outer repo (not a worktree).
  2.  Outer branch is develop.
  3.  Outer working tree is clean.
  4.  Outer develop is up-to-date with <outer-remote>/develop.
  5.  Tap submodule is initialized (homebrew-tap/.git exists).
  6.  Tap inner branch is main.
  7.  Tap inner working tree is clean.
  8.  Tap inner is up-to-date with origin/main.
  9.  sync-tap drift is direction-classified (XACA-1112): CANONICAL-AHEAD or
      DIVERGED drift always blocks. TAP-AHEAD-only drift also blocks UNLESS
      --tap-ahead-release "<reason>" is given.
  10. CHANGELOG [Unreleased] section is non-empty.
  11. VERSION and Formula tag agree; standalone Formula version line is optional (per XACA-0394).
  12. Computed new version tag does not already exist.

Partial-failure recovery:
  The release runs in three phases. If a step fails partway through, the
  remaining steps are skipped and the script exits nonzero. Recovery depends
  on which step failed. Examples below use "origin" for the outer remote;
  substitute your outer-remote name if different (e.g. "dev-team").

  Phase 2 — tap inner push (main) succeeds, tag push fails:
    scripts/kb-tap-release --push-only     # re-pushes main + tag as the release App
    git add homebrew-tap
    git commit -m "chore: Bump homebrew-tap submodule to vX.Y.Z"
    git push <outer-remote> develop

  Phase 2 — tap inner commit + tag landed locally, neither pushed:
    (also the recovery after a --no-push cut). Under STRICT tap protection a
    hand-typed push to tap main is refused, so use:
    scripts/kb-tap-release --push-only
    git add homebrew-tap && git commit -m "..." && git push <outer-remote> develop
    (the outer push stays the human admin — develop's ruleset bypasses admins.)

  Phase 3 — outer commit landed locally, push failed:
    git push <outer-remote> develop    # retry; nothing else to undo

  In all cases: do NOT re-run kb-tap-release after a partial publish. The
  tag-collision preflight will block. Finish the publish by hand instead.
EOF
}

# ─── argument parsing ─────────────────────────────────────────────────────────

LEVEL=""
DRY_RUN=0
NO_PUSH=0
PUSH_ONLY=0
PUSH_TAP_EDIT=0
PUSH_AS_HUMAN=0
if [ "${TAP_RELEASE_PUSH_AS_HUMAN:-}" = "1" ]; then PUSH_AS_HUMAN=1; fi
TAP_AHEAD_RELEASE_REASON=""

for arg in "$@"; do
  case "$arg" in
    patch|minor|major)
      LEVEL="$arg"
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    --no-push)
      NO_PUSH=1
      ;;
    --as-human)
      PUSH_AS_HUMAN=1
      ;;
    --push-only)
      PUSH_ONLY=1
      ;;
    --push-tap-edit)
      PUSH_TAP_EDIT=1
      ;;
    --tap-ahead-release=*)
      # =value syntax (not a separate positional token) — this loop iterates
      # "$@" one token at a time and was never restructured into a shift-based
      # while loop, so a two-token "--flag value" pair is not supported here.
      TAP_AHEAD_RELEASE_REASON="${arg#--tap-ahead-release=}"
      # XACA-1112-017: `[ -z ... ]` alone accepts a whitespace-only reason
      # (e.g. --tap-ahead-release=" "), because a string of spaces is not the
      # EMPTY string. The whole point of this flag is auditability — a
      # trailer that says only "Tap-Ahead-Release: " (or "  ") defeats that
      # purpose exactly as completely as an empty one, while LOOKING like it
      # was filled in. Require at least one non-whitespace character.
      _tap_ahead_reason_trimmed="$(printf '%s' "$TAP_AHEAD_RELEASE_REASON" | tr -d '[:space:]')"
      if [ -z "$TAP_AHEAD_RELEASE_REASON" ] || [ -z "$_tap_ahead_reason_trimmed" ]; then
        echo "Error: --tap-ahead-release requires a reason with at least one non-whitespace character: --tap-ahead-release=\"...\"" >&2
        usage >&2
        exit 1
      fi
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ "$PUSH_ONLY" -eq 1 ] && { [ -n "$LEVEL" ] || [ "$DRY_RUN" -eq 1 ] || [ "$NO_PUSH" -eq 1 ]; }; then
  echo "Error: --push-only cannot be combined with a bump level, --dry-run or --no-push." >&2
  exit 1
fi

if [ "$PUSH_TAP_EDIT" -eq 1 ]; then
  if [ "$PUSH_ONLY" -eq 1 ] || [ -n "$LEVEL" ] || [ "$NO_PUSH" -eq 1 ] || [ -n "$TAP_AHEAD_RELEASE_REASON" ]; then
    echo "Error: --push-tap-edit cannot be combined with a bump level, --push-only, --no-push or --tap-ahead-release." >&2
    exit 1
  fi
fi

if [ -z "$LEVEL" ] && [ "$PUSH_ONLY" -eq 0 ] && [ "$PUSH_TAP_EDIT" -eq 0 ]; then
  echo "Error: bump level is required (patch, minor, or major)." >&2
  usage >&2
  exit 1
fi

# ─── outer-remote resolution ──────────────────────────────────────────────────
# Default is the env override; otherwise prefer "origin", else "dev-team".
# If neither remote exists we keep the literal "origin" so downstream commands
# fail with their normal error (which is still clearer than a silent skip).

OUTER_REMOTE="${KB_TAP_RELEASE_OUTER_REMOTE:-}"
if [ -z "$OUTER_REMOTE" ]; then
  if git remote get-url origin >/dev/null 2>&1; then
    OUTER_REMOTE="origin"
  elif git remote get-url dev-team >/dev/null 2>&1; then
    OUTER_REMOTE="dev-team"
  else
    OUTER_REMOTE="origin"
  fi
fi

# ─── helpers ─────────────────────────────────────────────────────────────────

PASS_COUNT=0
FAIL_COUNT=0

check_pass() {
  echo "  [PASS] $1"
  PASS_COUNT=$((PASS_COUNT + 1))
}

check_fail() {
  echo "  [FAIL] $1"
  FAIL_COUNT=$((FAIL_COUNT + 1))
}

abort_on_failures() {
  if [ "$FAIL_COUNT" -gt 0 ]; then
    echo ""
    echo "Preflight failed: $FAIL_COUNT check(s) did not pass. Aborting."
    exit 1
  fi
}

# bump_version CURRENT_VERSION LEVEL
# Outputs the new version string; validates input format first.
bump_version() {
  local cur="$1"
  local lvl="$2"
  # validate format
  case "$cur" in
    [0-9]*.[0-9]*.[0-9]*)
      ;;
    *)
      echo "Error: current version '$cur' does not match X.Y.Z format." >&2
      exit 1
      ;;
  esac
  local major minor patch
  # Use IFS trick safe on bash 3.2 — no arrays needed
  local oldIFS="$IFS"
  IFS="."
  # shellcheck disable=SC2086
  read -r major minor patch <<EOF
$cur
EOF
  IFS="$oldIFS"
  # strip any whitespace
  major="${major%%[[:space:]]*}"
  minor="${minor%%[[:space:]]*}"
  patch="${patch%%[[:space:]]*}"
  case "$lvl" in
    patch)
      patch=$((patch + 1))
      ;;
    minor)
      minor=$((minor + 1))
      patch=0
      ;;
    major)
      major=$((major + 1))
      minor=0
      patch=0
      ;;
  esac
  echo "${major}.${minor}.${patch}"
}

# ─── python3 CHANGELOG footer rewriter ───────────────────────────────────────
# Embedded as a heredoc to avoid multi-line bash regex fragility.
# Called as: python3 <(cat <<'PYEOF' ...) <changelog_path> <old_version> <new_version>
# Or via a temp file — we use a temp file to be safe on all bash versions.

# XACA-0752: self-heal a poisoned /tmp from the pre-fix template below — BSD/macOS
# mktemp only randomizes TRAILING X's, so the old ".XXXXXX.py" suffix created a
# LITERAL, non-random file. A SIGKILL'd run (trap below never fires on SIGKILL)
# could leave that literal file behind, and the next run's mktemp would then fail
# with "mkstemp failed ... File exists". Remove any such leftover before minting a
# fresh, properly-randomized temp file.
rm -f /tmp/kb-tap-release-footer.XXXXXX.py
FOOTER_SCRIPT=$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-footer.XXXXXX")
# XACA-1170-056: every path the cleanup trap removes is initialised HERE, before the trap is
# installed, so a value inherited from the caller's environment can never be deleted by it.
KTR_CFG_TMP=""; DRIFT_RECORDS_FILE=""
PTE_MAP_FILE=""; PTE_DIRS_FILE=""; PTE_FILES_FILE=""; PTE_SHAS_FILE=""; PTE_OFFENCES_FILE=""; PTE_SYNC_ROOT=""

# XACA-1122-008: this trap now has TWO jobs. It is the `always()`-equivalent
# release path for the tap-writer lock — the lock must come off on every exit,
# including a preflight failure, a mid-phase abort, and Ctrl-C. A lock that is
# only released on the success path is a lock that wedges the next release cut
# and the next publisher run the first time anything goes wrong.
#
# KB_TAP_LOCK_ACQUIRED is guarded with :- because this trap is installed ~100
# lines BEFORE that variable exists, and `set -u` is active.
_kb_tap_release_cleanup() {
  _cleanup_rc=$?
  rm -f "$FOOTER_SCRIPT"
  # XACA-1170-055: function-scoped temp files registered here so SIGTERM cannot strand them.
  rm -f "${KTR_CFG_TMP:-}" "${DRIFT_RECORDS_FILE:-}"
  # XACA-1170-041: --push-tap-edit temp files (function is defined later; absent on other paths).
  if type _pte_cleanup >/dev/null 2>&1; then _pte_cleanup; fi
  if [ "${KB_TAP_LOCK_ACQUIRED:-0}" -eq 1 ]; then
    KB_TAP_LOCK_ACQUIRED=0
    _rel_rc=0
    kb_tap_lock_release || _rel_rc=$?
    if [ "$_rel_rc" -ne 0 ]; then
      # Do not swallow this. A failed release leaves a lock nobody owns, and the
      # only thing worse than a stuck lock is a stuck lock nobody was told about.
      echo "" >&2
      echo "kb-tap-release: FAILED TO RELEASE THE TAP-WRITER LOCK (exit ${_rel_rc})." >&2
      echo "kb-tap-release: it will block the next release cut and the next publisher run." >&2
      echo "kb-tap-release: inspect with 'scripts/kb-tap-lock.sh status' and clear it deliberately." >&2
      # `if`, not `[ ... ] && ...` — `set -e` is active and a short-circuited
      # && as a bare statement aborts the trap before it can exit properly
      # (feedback_set_e_last_line_short_circuit.md).
      if [ "$_cleanup_rc" -eq 0 ]; then
        _cleanup_rc="$_rel_rc"
      fi
    fi
  fi
  # Preserve the original exit status; a trap's own last command must not
  # become the script's verdict.
  exit "$_cleanup_rc"
}
trap _kb_tap_release_cleanup EXIT INT TERM

cat > "$FOOTER_SCRIPT" <<'PYEOF'
#!/usr/bin/env python3
"""
Maintains the CHANGELOG.md comparison-link footer block.

Footer format (at END of file, no blank lines between entries):
  [Unreleased]: https://github.com/DoubleNode/homebrew-aiteamforge/compare/vNEW...HEAD
  [X.Y.Z]: https://github.com/DoubleNode/homebrew-aiteamforge/compare/vPREV...vX.Y.Z
  [PREV]: ...

First run (no footer): append blank line + new footer block.
Subsequent runs: update [Unreleased] anchor, insert [NEW] line below it.
"""
import sys
import re

BASE_URL = "https://github.com/DoubleNode/homebrew-aiteamforge/compare"
CHANGELOG_PATH = sys.argv[1]
OLD_VERSION    = sys.argv[2]  # version BEFORE the bump (CUR_VERSION)
NEW_VERSION    = sys.argv[3]  # version AFTER the bump

with open(CHANGELOG_PATH, "r") as fh:
    content = fh.read()

lines = content.splitlines()

# Detect footer: a trailing block of consecutive lines matching
# [something]: https://... OR [Unreleased]: https://...
# We scan from the bottom up.
LINK_RE = re.compile(r'^\[([^\]]+)\]:\s+https://')

footer_start = None
i = len(lines) - 1
# skip trailing blank lines
while i >= 0 and lines[i].strip() == "":
    i -= 1
# now scan upward while lines look like footer entries
while i >= 0 and LINK_RE.match(lines[i]):
    footer_start = i
    i -= 1

if footer_start is None:
    # No footer exists — first run. Create one.
    unreleased_line = "[Unreleased]: {base}/v{new}...HEAD".format(
        base=BASE_URL, new=NEW_VERSION)
    new_line = "[{new}]: {base}/v{old}...v{new}".format(
        base=BASE_URL, old=OLD_VERSION, new=NEW_VERSION)
    # If file doesn't end with a newline, add one before footer
    footer_block = "\n" + unreleased_line + "\n" + new_line + "\n"
    # Ensure there's exactly one blank line separating body from footer
    stripped = content.rstrip("\n")
    new_content = stripped + "\n" + footer_block
else:
    # Footer exists — update it.
    footer_lines = lines[footer_start:]
    body_lines = lines[:footer_start]

    # Locate [Unreleased] line in footer
    unreleased_idx = None
    for idx, fl in enumerate(footer_lines):
        if fl.startswith("[Unreleased]:"):
            unreleased_idx = idx
            break

    # Build new [Unreleased] line and new [NEW_VERSION] line
    new_unreleased = "[Unreleased]: {base}/v{new}...HEAD".format(
        base=BASE_URL, new=NEW_VERSION)
    new_version_line = "[{new}]: {base}/v{old}...v{new}".format(
        base=BASE_URL, old=OLD_VERSION, new=NEW_VERSION)

    if unreleased_idx is not None:
        # Replace the existing [Unreleased] line; insert [NEW] below it
        updated_footer = (
            footer_lines[:unreleased_idx]
            + [new_unreleased, new_version_line]
            + footer_lines[unreleased_idx + 1:]
        )
    else:
        # No [Unreleased] line found — prepend it plus [NEW]
        updated_footer = [new_unreleased, new_version_line] + footer_lines

    all_lines = body_lines + updated_footer
    new_content = "\n".join(all_lines) + "\n"

with open(CHANGELOG_PATH, "w") as fh:
    fh.write(new_content)

print("Footer updated.")
PYEOF

# ─── release identity: push the TAP as the aiteamforge-release App ────────────
# XACA-1170-003. See the header comment for the why. Everything below is about
# ONE property: the installation token reaches git without ever appearing in
# argv (ps), on disk, or in git config, and a failure at any step aborts the run
# instead of falling back to the human's credentials.

TAP_APP_SLUG="DoubleNode/homebrew-aiteamforge"
TAP_APP_CONFIG_DIR="${TAP_RELEASE_CONFIG_DIR:-${HOME}/.config/gh-tap-release}"
TAP_APP_API="https://api.github.com"
TAP_APP_ID=""
TAP_APP_KEY=""
TAP_APP_TOKEN=""          # never exported, never echoed
TAP_PUSH_MODE="human"     # "app" once a token is minted (or still "human" for --as-human)
TAP_PUSH_TARGET="origin"  # becomes the explicit tap URL in app mode

# The tap URL the token is sent to. Only TWO shapes are ever accepted (allow-list,
# not a deny-list: every spelling of "somewhere else" - scp-style `git@host:path`,
# bare `host:path`, ssh://, git://, http(s) to another host, https to another
# owner/repo, ext:: - falls out by default):
#   1. https://github.com/<TAP_APP_SLUG>[.git]   - the only place a token is sent.
#   2. TEST-ONLY: an absolute local path or a file:/// URL, via
#      KB_TAP_RELEASE_TAP_URL (the tests stand a local bare repo in for the tap).
#      Safe for the token: it is attached only under an http.<https tap URL>.extraheader
#      key, which git never sends to a local path; and tap_authed_git pins
#      GIT_ALLOW_PROTOCOL so a local target can never be rerouted to the network.
tap_app_push_url() {
  local u="${KB_TAP_RELEASE_TAP_URL:-https://github.com/${TAP_APP_SLUG}.git}"
  case "$u" in
    "https://github.com/${TAP_APP_SLUG}"|"https://github.com/${TAP_APP_SLUG}.git") ;;
    /*|file:///*) ;;
    *)
      echo "Error: KB_TAP_RELEASE_TAP_URL must be https://github.com/${TAP_APP_SLUG}(.git) (or, for tests only, an absolute local path / file:/// URL) - refusing to send the release token elsewhere." >&2
      return 1 ;;
  esac
  printf '%s' "$u"
}

# tap_app_refuse_url_rewrite <url> — fail closed when git would push <url> somewhere
# else. `url.<base>.insteadOf` and `url.<base>.pushInsteadOf` (system, global, the
# tap clone's local config, [include]d files, GIT_CONFIG_COUNT / GIT_CONFIG_PARAMETERS
# env, GIT_CONFIG_GLOBAL/SYSTEM) rewrite the URL of an explicit `git push <url>` AFTER
# we chose it, so the push would run as the human while we print "as the App".
# `git ls-remote --get-url` honours insteadOf but NOT pushInsteadOf (measured, git
# 2.54), so it cannot be the only check. We also ask git for every applicable rule
# (`config --show-scope` merges all scopes, includes and env) and refuse if ANY
# rule's prefix matches the URL: git rewrites on a prefix match, so a match IS a
# rewrite. A rule for an unrelated prefix does not match and is allowed.
# Called BEFORE minting: a refusal never creates a token.
tap_app_refuse_url_rewrite() {
  local url="$1" tmp scope origin rec key val rc=0 hit="" resolved
  if ! resolved="$(git -C "$TAP_DIR" ls-remote --get-url "$url" 2>/dev/null)"; then
    echo "Error: could not ask git how it resolves the tap URL — refusing to mint (fail closed)." >&2
    return 1
  fi
  if [ "$resolved" != "$url" ]; then
    hit="git resolves ${url} to ${resolved} (a url.<base>.insteadOf rule is active)"
  fi
  # XACA-1170-042: parse NUL-delimited (-z). Records are  scope\0origin\0key\nvalue\0 ;
  # a base/prefix may contain spaces (even a newline), so splitting on whitespace
  # would mis-split the key (the base lives IN the key) and let the rule through.
  # Goes via a temp file: bash cannot hold NUL in a variable, and a process
  # substitution would hide git's exit status.
  tmp="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-cfg.XXXXXX")" || {
    echo "Error: could not create a temp file to read git config — refusing to mint (fail closed)." >&2
    return 1
  }
  KTR_CFG_TMP="$tmp"   # XACA-1170-055: removed by the EXIT/INT/TERM trap too
  # exit 1 = no matching key (fine); anything else = git could not read its config.
  local re='^url\..*\.(push)?insteadof$'
  git -C "$TAP_DIR" config -z --show-scope --show-origin --get-regexp "$re" >"$tmp" 2>/dev/null || rc=$?
  if [ "$rc" -gt 1 ]; then
    rm -f "$tmp"
    echo "Error: could not read git config to check for URL rewrites (rc=${rc}) — refusing to mint (fail closed)." >&2
    return 1
  fi
  # shellcheck disable=SC2034  # origin is read only to keep the record in step
  while IFS= read -r -d '' scope && IFS= read -r -d '' origin && IFS= read -r -d '' rec; do
    case "$rec" in
      *$'\n'*) key="${rec%%$'\n'*}"; val="${rec#*$'\n'}" ;;
      *)       key="$rec"; val="" ;;      # valueless key: treat as match-all (fail closed)
    esac
    # empty value = empty prefix = matches everything; otherwise literal prefix match
    if [ -z "$val" ] || [ "${url#"$val"}" != "$url" ]; then
      hit="${key} = ${val}   [scope: ${scope}]"
      break
    fi
  done <"$tmp"
  rm -f "$tmp"
  if [ -n "$hit" ]; then
    {
      echo "Error: git would NOT push the tap to ${url} — a URL rewrite is configured:"
      echo "         ${hit}"
      echo "       The push would silently go somewhere else (as the human) while we say it is the App."
      echo "       Refusing before minting a token."
      echo "       Remedy: remove that url.*.insteadOf / pushInsteadOf entry"
      echo "       (see: git config --show-origin --get-regexp '^url\\..*insteadof'), or push as yourself"
      echo "       knowingly with --as-human."
    } >&2
    return 1
  fi
  return 0
}

# tap_app_resolve_config — find the App id and private key. Prints an actionable
# error and returns 1 on any problem. Touches no network.
tap_app_resolve_config() {
  local dir="$TAP_APP_CONFIG_DIR" f mode n
  TAP_APP_ID="${TAP_RELEASE_APP_ID:-}"
  if [ -z "$TAP_APP_ID" ] && [ -f "${dir}/app-id" ]; then
    TAP_APP_ID="$(tr -d '[:space:]' < "${dir}/app-id" 2>/dev/null || true)"
  fi
  if [ -z "$TAP_APP_ID" ]; then
    echo "Error: aiteamforge-release App id not configured." >&2
    echo "       Set TAP_RELEASE_APP_ID, or: echo <APP_ID> > ${dir}/app-id" >&2
    return 1
  fi
  case "$TAP_APP_ID" in
    *[!0-9]*) echo "Error: aiteamforge-release App id '${TAP_APP_ID}' is not numeric." >&2; return 1 ;;
  esac

  TAP_APP_KEY="${TAP_RELEASE_APP_KEY_PATH:-}"
  if [ -z "$TAP_APP_KEY" ]; then
    n=0
    for f in "${dir}"/*.private-key.pem; do
      [ -f "$f" ] || continue
      TAP_APP_KEY="$f"
      n=$((n + 1))
    done
    if [ "$n" -eq 0 ]; then
      echo "Error: no release App private key found in ${dir}/." >&2
      echo "       Put exactly one <name>.private-key.pem there (mode 0600), or set TAP_RELEASE_APP_KEY_PATH." >&2
      return 1
    elif [ "$n" -gt 1 ]; then
      echo "Error: ${n} private keys in ${dir}/ — ambiguous. Leave exactly one, or set TAP_RELEASE_APP_KEY_PATH." >&2
      return 1
    fi
  fi
  if [ ! -f "$TAP_APP_KEY" ] || [ ! -r "$TAP_APP_KEY" ]; then
    echo "Error: release App private key '${TAP_APP_KEY}' is not a readable file." >&2
    return 1
  fi
  # GNU stat first: on BSD/macOS `stat -c` fails and falls through to -f.
  mode="$(stat -c '%a' "$TAP_APP_KEY" 2>/dev/null || stat -f '%Lp' "$TAP_APP_KEY" 2>/dev/null || true)"
  case "$mode" in
    ''|*[!0-7]*)
      echo "Error: cannot determine the mode of '${TAP_APP_KEY}' — refusing to use a key whose permissions are unknown." >&2
      return 1 ;;
  esac
  if [ $(( 8#${mode} & 8#077 )) -ne 0 ]; then
    echo "Error: release App private key '${TAP_APP_KEY}' is mode ${mode} — group/world-accessible." >&2
    echo "       Fix: chmod 600 '${TAP_APP_KEY}'" >&2
    return 1
  fi
  return 0
}

_tap_app_b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# _tap_app_api METHOD URL BEARER [JSON-BODY] — prints "<body>\n<http-code>".
# The bearer goes to curl on STDIN as a config line (`-K -`), so it is in neither
# argv nor a temp file; printf is a builtin, so it is not in any argv either.
_tap_app_api() {
  local method="$1" url="$2" bearer="$3" data="${4:-}"
  if [ -n "$data" ]; then
    printf 'header = "Authorization: Bearer %s"\n' "$bearer" \
      | curl -sS --max-time 30 -K - -X "$method" \
          -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
          -H "Content-Type: application/json" --data "$data" \
          -w '\n%{http_code}' "$url"
  else
    printf 'header = "Authorization: Bearer %s"\n' "$bearer" \
      | curl -sS --max-time 30 -K - -X "$method" \
          -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
          -w '\n%{http_code}' "$url"
  fi
}

_tap_app_mint_inner() {
  local now payload signing_input signature jwt out code body inst repo_name
  repo_name="${TAP_APP_SLUG#*/}"
  now="$(date +%s)"
  # iat backdated 60s for clock skew; exp 480s (GitHub rejects > 600s).
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 480))" "$TAP_APP_ID")"
  signing_input="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | _tap_app_b64url).$(printf '%s' "$payload" | _tap_app_b64url)"
  signature="$(printf '%s' "$signing_input" | openssl dgst -sha256 -sign "$TAP_APP_KEY" -binary | _tap_app_b64url)" || {
    echo "Error: could not sign the App JWT — is '${TAP_APP_KEY}' a valid RSA private key?" >&2
    return 1
  }
  jwt="${signing_input}.${signature}"

  out="$(_tap_app_api GET "${TAP_APP_API}/repos/${TAP_APP_SLUG}/installation" "$jwt")" || {
    echo "Error: could not reach api.github.com to resolve the App installation." >&2
    return 1
  }
  code="${out##*$'\n'}"; body="${out%$'\n'*}"
  case "$code" in
    200) ;;
    401) echo "Error: GitHub rejected the App JWT (HTTP 401) — wrong App id, or the key is not this App's." >&2; return 1 ;;
    404) echo "Error: the release App is not installed on ${TAP_APP_SLUG} (HTTP 404) — install it in the org UI." >&2; return 1 ;;
    *)   echo "Error: installation lookup failed (HTTP ${code})." >&2; return 1 ;;
  esac
  inst="$(printf '%s' "$body" | python3 -I -c 'import json,sys; print(int(json.load(sys.stdin)["id"]))' 2>/dev/null)" || {
    echo "Error: unparseable installation response." >&2; return 1; }

  out="$(_tap_app_api POST "${TAP_APP_API}/app/installations/${inst}/access_tokens" "$jwt" \
        "{\"repositories\":[\"${repo_name}\"],\"permissions\":{\"contents\":\"write\"}}")" || {
    echo "Error: could not reach api.github.com to mint the installation token." >&2
    return 1
  }
  code="${out##*$'\n'}"; body="${out%$'\n'*}"
  if [ "$code" != "201" ]; then
    echo "Error: installation token request failed (HTTP ${code})." >&2
    return 1
  fi
  # Refuse a token broader than asked for: contents:write on exactly this repo.
  TAP_APP_TOKEN="$(printf '%s' "$body" | REPO_NAME="$repo_name" python3 -I -c '
import json, os, sys
d = json.load(sys.stdin)
perms = d.get("permissions") or {}
repos = [r.get("name") for r in (d.get("repositories") or [])]
if perms.get("contents") != "write" or repos != [os.environ["REPO_NAME"]]:
    sys.exit(3)
sys.stdout.write(d["token"])
' 2>/dev/null)" || {
    TAP_APP_TOKEN=""
    echo "Error: the minted token is missing, or not scoped to exactly ${TAP_APP_SLUG} with contents:write." >&2
    return 1
  }
  [ -n "$TAP_APP_TOKEN" ] || { echo "Error: empty installation token." >&2; return 1; }
  return 0
}

# tap_app_mint_token — xtrace is forced off for the duration: with `bash -x` the
# JWT and token would otherwise be echoed into the trace.
tap_app_mint_token() {
  local xt=0 rc=0
  case $- in *x*) xt=1 ;; esac
  set +x
  _tap_app_mint_inner || rc=$?
  if [ "$xt" -eq 1 ]; then set -x; fi
  return "$rc"
}

# tap_app_refuse_inherited_git_params — XACA-1170-047. git applies an inherited
# GIT_CONFIG_PARAMETERS (what `git -c k=v` exports to children) AFTER the
# GIT_CONFIG_COUNT/KEY/VALUE entries tap_authed_git appends, so a `-c credential.helper=...`
# wrapper lands AFTER our URL-scoped `credential.<tap-url>.helper=` reset and re-adds the
# human's helper: a 401 on the App token then falls through to the human's credentials,
# the silent fallback this whole identity forbids. Same hole for a `-c url.*.insteadOf`,
# an `http.*.extraheader` (second Authorization header), `core.sshCommand`/`askPass`/
# `gitProxy`/`hooksPath` and `include.path` (pulls in arbitrary config).
# REFUSE rather than strip: unsetting GIT_CONFIG_PARAMETERS would silently drop legitimate
# `-c` settings (color.ui, safe.directory, ...) the caller meant to keep, and a refusal
# names the offending KEY (never the value: an extraheader value is a secret). Unrelated
# keys pass untouched. Matched case-insensitively on the quoted-key shape of both formats
# git has used ('key=value' and 'key'='value'); a value that merely contains such text can
# cause an unnecessary refusal, never a miss.
tap_app_refuse_inherited_git_params() {
  local p lc keys
  p="${GIT_CONFIG_PARAMETERS:-}"
  [ -n "$p" ] || return 0
  lc="$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')"
  keys="$(printf '%s' "$lc" | grep -oE "'(credential\\.|url\\.|http\\.|protocol\\.|include(if)?\\.|core\\.(sshcommand|askpass|gitproxy|hookspath|fsmonitor))[^='[:space:]]*" | tr -d "'" | head -n 3 | tr '\n' ' ')" || true
  if [ -n "$keys" ]; then
    {
      echo "Error: an inherited GIT_CONFIG_PARAMETERS (a 'git -c' wrapper) sets: ${keys}"
      echo "       git applies it AFTER the release App's URL-scoped credential reset, so it can"
      echo "       let a rejected App token fall through to YOUR credentials, or reroute the push."
      echo "       Refusing (no token minted / no push). Remedy: run kb-tap-release from a shell"
      echo "       where it is not nested inside 'git -c ...' (check: env | grep GIT_CONFIG_PARAMETERS),"
      echo "       or push as yourself knowingly with --as-human."
    } >&2
    return 1
  fi
  return 0
}

# tap_authed_git <git args...> — run git, authenticated as the release App when a
# token was minted. Env-prefixed callers (TAP_SINGLE_WRITER_RELEASE=1) keep their
# variable: it is inherited through the subshell into git.
#   - http.<tap-url>.extraheader carries the credential, URL-scoped to EXACTLY the tap
#     repo (XACA-1170-043). The env is inherited by the tap's pre-push hook (which, before
#     XACA-1580, ran a 0848 guard that fetched the OUTER dev-team remote): an unscoped github.com header
#     would hand it a token that cannot read dev-team, and an unscoped
#     credential.helper reset would strip its keychain, so a --push-only over
#     mirrored paths was refused. git's urlmatch is a path-SEGMENT prefix match and
#     is exact about the ".git" suffix (…/homebrew-aiteamforge.git does NOT match
#     …/homebrew-aiteamforge), so the key is built from the validated push target
#     itself, spelling and all.
#   - credential.<tap-url>.helper is reset to empty (same scope) so a rejected token
#     can NEVER fall through to the human's keychain (the silent fallback this whole
#     ticket forbids); other URLs keep their helper. GIT_TERMINAL_PROMPT=0 forbids a
#     prompt too.
#   - `export` and printf are builtins and the subshell has xtrace off, so the
#     token appears in no argv and no trace. Nothing is written to config or disk.
tap_authed_git() {
  (
    set +x
    if [ "$TAP_PUSH_MODE" = "app" ] || [ "$TAP_PUSH_MODE" = "app-pending" ]; then
      n="${GIT_CONFIG_COUNT:-0}"
      case "$n" in ''|*[!0-9]*) echo "Error: GIT_CONFIG_COUNT is not numeric ('${n}')." >&2; exit 1 ;; esac
      if [ "$TAP_PUSH_MODE" != "app" ]; then
        # "app-pending" = validated but not minted: refuse rather than push as the human.
        echo "Error: tap push attempted before the release token was minted (mode '${TAP_PUSH_MODE}') — refusing." >&2
        exit 1
      fi
      # XACA-1170-047: checked on EVERY call (fetch, push, lock ops), not only once up front.
      tap_app_refuse_inherited_git_params || exit 1
      case "${TAP_PUSH_TARGET:-}" in
        https://github.com/*) scope_url="$TAP_PUSH_TARGET" ;;
        *)                    scope_url="https://github.com/${TAP_APP_SLUG}.git" ;;  # local test target: never sent
      esac
      b64="$(printf 'x-access-token:%s' "$TAP_APP_TOKEN" | base64 | tr -d '\n')"
      export "GIT_CONFIG_KEY_${n}=http.${scope_url}.extraheader"
      export "GIT_CONFIG_VALUE_${n}=Authorization: basic ${b64}"
      export "GIT_CONFIG_KEY_$((n + 1))=credential.${scope_url}.helper"
      export "GIT_CONFIG_VALUE_$((n + 1))="
      export GIT_CONFIG_COUNT=$((n + 2))
      export GIT_TERMINAL_PROMPT=0
      # XACA-1170-047: a rejected token must not reach an askpass program either (the
      # human's GIT_ASKPASS / core.askPass would answer the 401 retry). Env wins over config.
      export GIT_ASKPASS=false
      # XACA-1170-039: defence in depth under the rewrite refusal. Whatever a
      # url.*.insteadOf/pushInsteadOf (or a future bypass) turns the target into,
      # git may speak only https - an ssh/git/ext rewrite fails hard instead of
      # silently pushing as the human. `file` is allowed ONLY when the validated
      # target is a local path / file:// URL (the test stand-in; the token header
      # is scoped to https://github.com/ and never reaches it).
      case "${TAP_PUSH_TARGET:-}" in
        /*|file://*) export GIT_ALLOW_PROTOCOL=https:file ;;
        *)           export GIT_ALLOW_PROTOCOL=https ;;
      esac
    fi
    exec git "$@"
  )
}

# tap_release_identity_prepare — resolve + validate, or announce the escape hatch.
# Called BEFORE the lock and before any commit, tag or push; on failure the
# caller's `exit 1` leaves the tree untouched. It mints NOTHING: the 1h token is
# minted by tap_release_identity_mint, after the lock wait and preflight
# (XACA-1170-044), so a long KB_TAP_RELEASE_LOCK_WAIT cannot age it out mid-release.
tap_release_identity_prepare() {
  if [ "$PUSH_AS_HUMAN" -eq 1 ]; then
    {
      echo ""
      echo "  ***************************************************************"
      echo "  *  WARNING: --as-human / TAP_RELEASE_PUSH_AS_HUMAN=1          *"
      echo "  *  Pushing the TAP as the HUMAN, not as aiteamforge-release.  *"
      echo "  ***************************************************************"
      echo "  Once STRICT tap protection is applied, GitHub REFUSES this push"
      echo "  unless you hold an admin bypass. Emergency use only."
      echo ""
    } >&2
    TAP_PUSH_MODE="human"
    TAP_PUSH_TARGET="origin"
    return 0
  fi
  tap_app_resolve_config || return 1
  tap_app_refuse_inherited_git_params || return 1   # XACA-1170-047: before the lock and the mint
  TAP_PUSH_TARGET="$(tap_app_push_url)" || return 1
  tap_app_refuse_url_rewrite "$TAP_PUSH_TARGET" || return 1
  TAP_PUSH_MODE="app-pending"   # tap_authed_git refuses to run until the mint succeeds
  echo "  Release App credentials and push URL validated; the token is minted just before the first push."
  return 0
}

# tap_release_identity_mint — mint the 1h installation token. Called LAST: after the
# lock is held and (release path) preflight has passed, immediately before the first
# tap push. A failure aborts before anything is committed (release path) or pushed.
tap_release_identity_mint() {
  [ "$TAP_PUSH_MODE" = "app-pending" ] || return 0   # --as-human: nothing to mint
  echo "  Minting a short-lived aiteamforge-release installation token (contents:write, ${TAP_APP_SLUG##*/} only)..."
  tap_app_mint_token || return 1
  TAP_PUSH_MODE="app"
  echo "  Tap pushes will run as the aiteamforge-release App."
  return 0
}

# tap_release_identity_mint_or_exit — mint, or refuse the release (shared by both paths).
tap_release_identity_mint_or_exit() {
  tap_release_identity_mint || {
    echo "" >&2
    echo "Refusing to release: could not mint the release App token (details above)." >&2
    echo "  Nothing was pushed$([ "${PUSH_ONLY:-0}" -eq 1 ] || echo ' (and nothing was committed or tagged)'). To push as yourself in an emergency: --as-human" >&2
    exit 1
  }
}

# ─── locate tap dir ───────────────────────────────────────────────────────────

OUTER_DIR="$(pwd)"
TAP_DIR="${OUTER_DIR}/homebrew-tap"

# ─── tap-writer lock (XACA-1122-008) ─────────────────────────────────────────
#
# This script is the SECOND writer to tap `main`. The first is the post-merge
# publisher workflow (XACA-1122). A GitHub `concurrency:` group cannot serialize
# the two, because concurrency groups are an Actions-runtime construct and this
# script runs on a laptop that never enters that runtime. Both writers therefore
# take the same lock ref in the tap itself. See scripts/kb-tap-lock.sh and
# design §5.4 / O-8.
#
# WHY HERE, BEFORE PREFLIGHT AND NOT JUST BEFORE THE FIRST PUSH: the preflight
# below asks the remote for facts the release then depends on — the tap
# drift/direction classification, the tag-collision check against origin, the
# develop-vs-remote comparison. Those verdicts are only sound while nothing else
# is writing. Acquiring after them would leave a window in which they went stale
# between the answer and the act, which is precisely the check-not-a-lock failure
# this ticket exists to close. The cost is that a run which fails preflight still
# briefly took the lock; it is released on every exit path by the trap below.
#
# --dry-run and --no-push do NOT take the lock: neither writes to any remote.
# For --no-push that leaves the LATER manual push unprotected — called out loudly
# at the end of this block rather than papered over, because taking a lock here
# and releasing it at exit would imply a protection that does not extend to a
# push a human runs minutes later.

# WHERE kb-tap-lock.sh COMES FROM, AND WHY IT IS NOT SHIPPED (XACA-1122-047).
#
# It is resolved from the OUTER DEV CHECKOUT (${OUTER_DIR}/scripts/), with the
# directory holding this script as a fallback. It is deliberately in NEITHER
# sync-tap.sh's mirror roster NOR install-kanban.sh, even though THIS script is
# in both. That is not an oversight; it is the same disposition sync-tap.sh
# itself and scripts/attribute-tap-drift.sh already have — two other outer-repo
# files this script reads (preflight #9) that no consumer receives.
#
# The reason it costs nothing: a release cut REQUIRES an outer dev checkout by
# construction. Preconditions 1-5 demand cwd be the outer repo, on develop,
# clean, up-to-date, with homebrew-tap initialized. Every such tree carries
# scripts/kb-tap-lock.sh as a tracked file at the same commit as this script,
# so the dependency is satisfied exactly whenever the release can succeed.
# Shipping it would satisfy only the fallback branch, and only in trees where
# the release must fail anyway — while handing every read-only consumer
# `kb-tap-lock.sh break --force`, whose own banner describes letting a second
# writer into tap main.
#
# What the absence DID cost, until this block was rewritten, was the DIAGNOSIS:
# this check runs BEFORE preflight (see above), so a consumer copy invoked
# outside a dev checkout died naming a lock library instead of naming the
# missing checkout. The branch below reports the cause it can actually
# establish. It changes no success path — both arms already exit 1 — and it
# duplicates no preflight CHECK, only preflight's wording.
LOCK_LIB="${OUTER_DIR}/scripts/kb-tap-lock.sh"
if [ ! -f "$LOCK_LIB" ]; then
  LOCK_LIB="$(cd "$(dirname -- "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd -P)/kb-tap-lock.sh"
fi

KB_TAP_LOCK_ACQUIRED=0

# ─── --push-tap-edit: push prepared TAP-ONLY commits to tap main (XACA-1170-041) ─────
#
# WHY IT EXISTS. Under STRICT tap protection exactly two identities may write tap
# main: the publisher App (mirrored content) and this release App. ~198 tracked tap
# files have NO dev-team canonical (tests/, libexec/ except one file, bin/, plugins/,
# Formula/, README.md, ...), so the publisher never writes them. Without a sanctioned
# path an edit to one of them could not be pushed at all. This is that path. It pushes
# commits somebody already made; it commits, tags and bumps nothing.
#
# THE ONE SAFETY PROPERTY: it can never push something the publisher owns. That is
# decided from the publisher's OWN map, never re-derived here, and evaluated the way the publisher
# evaluates it: <outer remote>/develop's sync-tap.sh, run by ZSH (it is a zsh script, XACA-1170-050)
# over develop's whole tree materialised with `git archive` (XACA-1170-048/051), never the local
# checkout's script or sources:
#   (1) every destination `sync-tap.sh --check --porcelain` reports (OK, DRIFT, NEW and
#       MISSING all name a destination - a record exists for every sync_file/sync_dir
#       pair, so the map is the exact mirrored set);
#   (2) everything under a directory in sync-tap.sh's own TAP_STAGE_PATHS (the scope the
#       publisher's `git add -A` stages: share/, fleet-monitor/server/, docs/) - this
#       also covers a STALE tap file in a mirrored dir that canonical no longer has,
#       which sync_dir would never list (it does not delete tap-only files);
#   (3) the exact-file entries of TAP_STAGE_PATHS (.githooks/pre-push), plus every file sync-tap.sh
#       stages by name with `git -C "$TAP" add <file>` (CHANGELOG.md, rewritten by
#       _pub_write_tap_changelog - a tap-only edit would race that rewrite; XACA-1170-052).
# `libexec/` is the ONE TAP_STAGE_PATHS directory NOT refused wholesale: sync-tap.sh
# stages it whole (XACA-1568-024) but mirrors only libexec/lib/ci-runner-bundle.sh into
# it - the other 39 files are tap-native and are exactly what this command exists for.
# Its mirrored file is caught by (1). Paths are compared case-folded (a Linux publisher
# sees `Share/` and `share/` as different dirs; refusing both costs nothing).
# Fail closed: sync-tap.sh missing/erroring (rc > 1), zero records, or an unparseable
# TAP_STAGE_PATHS line = refuse. A malformed check must not return the reassuring answer.
#
# Linear range only: a merge commit's diff against its first parent hides what the
# second parent brought, so per-commit path checks would be unsound. Diffs use
# --no-renames, so a rename shows as delete(old)+add(new) and BOTH sides are checked
# with no pairing logic to get wrong.

PTE_MAP_FILE=""; PTE_DIRS_FILE=""; PTE_FILES_FILE=""; PTE_SHAS_FILE=""; PTE_OFFENCES_FILE=""; PTE_SYNC_ROOT=""; PTE_SYNC_SCRIPT=""
PTE_BASE=""; PTE_HEAD=""

# Removed by _kb_tap_release_cleanup on every exit path. PTE_SYNC_ROOT is a mktemp -d directory
# this script created; the recursive remove is guarded so an empty or foreign value can never
# widen it (absolute path whose last component is the mktemp template we asked for).
_pte_cleanup() {
  rm -f "${PTE_MAP_FILE:-}" "${PTE_DIRS_FILE:-}" "${PTE_FILES_FILE:-}" "${PTE_SHAS_FILE:-}" "${PTE_OFFENCES_FILE:-}"
  if [ -n "${PTE_SYNC_ROOT:-}" ] && [ "${PTE_SYNC_ROOT#/}" != "$PTE_SYNC_ROOT" ]; then
    case "${PTE_SYNC_ROOT##*/}" in
      kb-tap-release-sync.??*) rm -rf -- "$PTE_SYNC_ROOT" ;;
    esac
  fi
}

# pte_fetch_main — read-only, no token. Sets PTE_BASE to tap main's tip as the remote has
# it NOW, with its objects fetched (FETCH_HEAD only: no tap ref is moved). In app mode the
# fetch carries the same transport pin and askpass block as the push; a public tap needs no
# credential. (--as-human fetches from `origin` with no pin: it is the human's own path.)
pte_fetch_main() {
  local out rc=0
  if [ "$TAP_PUSH_MODE" = "human" ]; then
    out="$(GIT_TERMINAL_PROMPT=0 git -C "$TAP_DIR" fetch --quiet --no-tags "$TAP_PUSH_TARGET" refs/heads/main 2>&1)" || rc=$?
  else
    local pin="https"
    case "$TAP_PUSH_TARGET" in /*|file://*) pin="https:file" ;; esac
    out="$(GIT_ALLOW_PROTOCOL="$pin" GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=false \
          git -C "$TAP_DIR" fetch --quiet --no-tags "$TAP_PUSH_TARGET" refs/heads/main 2>&1)" || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    echo "Error: could not fetch tap main from ${TAP_PUSH_TARGET}:" >&2
    printf '%s\n' "$out" | sed 's/^/       /' >&2
    return 1
  fi
  PTE_BASE="$(git -C "$TAP_DIR" rev-parse --verify --quiet 'FETCH_HEAD^{commit}')" || {
    echo "Error: fetched tap main but could not resolve its commit." >&2; return 1; }
  return 0
}

# pte_fetch_develop_sync - XACA-1170-048/051. Materialises develop's WHOLE tree (as the OUTER remote
# has it NOW) into $PTE_SYNC_ROOT/src. The publisher runs develop's sync-tap.sh against develop's
# tree post-merge, so the authoritative "what does the publisher own" map is develop's script
# evaluated over develop's sources - not this checkout's. 048 took only the script from develop and
# ran it over the LOCAL tree: a checkout BEHIND develop made every source develop had added read
# MISSING (sync-tap.sh then exits 2 and the command refused every push), and an AHEAD or dirty
# checkout enumerated sync_dir sources the publisher will never see (051). A whole archive is the only
# reliable input: the script's source paths are built from variables (team lists, persona dirs,
# skills), so no static path list derived from it can be trusted to be complete. Measured on the
# real tree: ~2 s, ~550 MB in $TMPDIR, removed on every exit path.
# `git archive <sha>` reads the object database only: no checkout, no ref moves, no worktree. The
# fetch fills FETCH_HEAD only and needs no token (the outer remote is the human's own, exactly as the
# release path's develop fetch). Fail closed: unresolvable remote, fetch failure, no develop commit,
# extract failure, no sync-tap.sh in the tree.
pte_fetch_develop_sync() {
  local out rc=0 dev
  if ! git -C "$OUTER_DIR" remote get-url "$OUTER_REMOTE" >/dev/null 2>&1; then
    echo "Error: outer remote '${OUTER_REMOTE}' does not exist in ${OUTER_DIR} - cannot read develop's tree (the publisher-owned map). Set KB_TAP_RELEASE_OUTER_REMOTE. Refusing (fail closed)." >&2
    return 1
  fi
  out="$(GIT_TERMINAL_PROMPT=0 git -C "$OUTER_DIR" fetch --quiet --no-tags "$OUTER_REMOTE" develop 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "Error: could not fetch ${OUTER_REMOTE}/develop to read the publisher-owned map:" >&2
    printf '%s\n' "$out" | sed 's/^/       /' >&2
    echo "       Refusing (fail closed): the map must come from develop, not from this checkout." >&2
    return 1
  fi
  dev="$(git -C "$OUTER_DIR" rev-parse --verify --quiet 'FETCH_HEAD^{commit}')" || {
    echo "Error: fetched ${OUTER_REMOTE}/develop but could not resolve its commit. Refusing (fail closed)." >&2; return 1; }
  PTE_SYNC_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/kb-tap-release-sync.XXXXXX")" || { echo "Error: mktemp -d failed." >&2; return 1; }
  mkdir -p "${PTE_SYNC_ROOT}/src" "${PTE_SYNC_ROOT}/ref/homebrew-tap" || { echo "Error: could not create ${PTE_SYNC_ROOT}." >&2; return 1; }
  if ! git -C "$OUTER_DIR" archive "$dev" | tar -x -C "${PTE_SYNC_ROOT}/src"; then
    echo "Error: could not materialise ${OUTER_REMOTE}/develop (${dev}) from git archive. Refusing (fail closed)." >&2
    return 1
  fi
  PTE_SYNC_SCRIPT="${PTE_SYNC_ROOT}/src/sync-tap.sh"
  if [ ! -s "$PTE_SYNC_SCRIPT" ]; then
    echo "Error: sync-tap.sh is missing or empty on ${OUTER_REMOTE}/develop (${dev}) - cannot establish the publisher-owned set. Refusing (fail closed)." >&2
    return 1
  fi
  return 0
}

# pte_materialise_tap_names - XACA-1170-051. sync-tap.sh has DEST-DRIVEN loops (it iterates files the
# tap already ships: scripts/teams/<team>/scripts/*), so the map depends on which files the tap has,
# not only on develop. Gives it a scratch tap whose tracked paths are those of tap main as fetched
# (PTE_BASE - what the publisher sees) as ZERO-BYTE placeholders: names only, never contents, so the
# 317 MB tap is not copied. Why a scratch tap and not the real one: `sync-tap.sh --check` is not
# read-only against its reference tap - the BYTECODE-GUARD pre-clean deletes __pycache__/ and *.pyc
# there even in --check (XACA-0753) - and this command must never touch the shared tap checkout.
pte_materialise_tap_names() {
  local list f d last=""
  [ -n "${PTE_BASE:-}" ] || { echo "Error: tap main is unknown; cannot mirror its file names. Refusing (fail closed)." >&2; return 1; }
  [ -d "${PTE_SYNC_ROOT:-}" ] || { echo "Error: sync work dir missing; refusing (fail closed)." >&2; return 1; }
  # XACA-1170-053: temp files live under PTE_SYNC_ROOT, which _pte_cleanup removes on EXIT/INT/TERM.
  list="$(mktemp "${PTE_SYNC_ROOT}/names.XXXXXX")" || { echo "Error: mktemp failed." >&2; return 1; }
  if ! git -C "$TAP_DIR" ls-tree -r -z --name-only "$PTE_BASE" > "$list"; then
    rm -f "$list"; echo "Error: could not list tap main's tracked paths. Refusing (fail closed)." >&2; return 1
  fi
  while IFS= read -r -d '' f; do
    d="${f%/*}"
    if [ "$d" != "$f" ] && [ "$d" != "$last" ]; then mkdir -p "${PTE_SYNC_ROOT}/ref/homebrew-tap/${d}"; last="$d"; fi
    : > "${PTE_SYNC_ROOT}/ref/homebrew-tap/${f}"
  done < "$list"
  rm -f "$list"
  return 0
}

# pte_build_owned_map — fills the three files the classifier reads. See the block above.
pte_build_owned_map() {
  local porc errf rc=0 n line w sync cl
  pte_fetch_develop_sync || return 1
  pte_materialise_tap_names || return 1
  sync="$PTE_SYNC_SCRIPT"
  # sync-tap.sh is a ZSH script (shebang zsh; the publisher runs `zsh sync-tap.sh --publish`) and
  # uses zsh-only syntax such as the (N) glob qualifier: under bash it is a syntax error (rc 2),
  # which this command would read as "cannot establish the map" and refuse EVERY push (050).
  if ! command -v zsh >/dev/null 2>&1; then
    echo "Error: zsh is required to evaluate sync-tap.sh (a zsh script, as the publisher runs it) but was not found on PATH. Install zsh. Refusing (fail closed)." >&2
    return 1
  fi
  [ -d "${PTE_SYNC_ROOT:-}" ] || { echo "Error: sync work dir missing; refusing (fail closed)." >&2; return 1; }
  porc="$(mktemp "${PTE_SYNC_ROOT}/porc.XXXXXX")" || { echo "Error: mktemp failed." >&2; return 1; }
  errf="$(mktemp "${PTE_SYNC_ROOT}/perr.XXXXXX")" || { rm -f "$porc"; return 1; }
  PTE_MAP_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-map.XXXXXX")" || { rm -f "$porc" "$errf"; return 1; }
  PTE_DIRS_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-dirs.XXXXXX")" || { rm -f "$porc" "$errf"; return 1; }
  PTE_FILES_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-files.XXXXXX")" || { rm -f "$porc" "$errf"; return 1; }
  # develop's script over develop's tree and a scratch tap (names only): nothing local is read, and
  # nothing outside the scratch root can be written (--check never writes to the source dir).
  # rc 0 = nothing to sync, rc 1 = drift (a normal answer here); anything else = it broke.
  zsh "$sync" --check --porcelain --source-dir "${PTE_SYNC_ROOT}/src" --reference-dir "${PTE_SYNC_ROOT}/ref" >"$porc" 2>"$errf" || rc=$?
  if [ "$rc" -gt 1 ]; then
    echo "Error: 'zsh sync-tap.sh --check --porcelain' (develop's script over develop's tree) failed (rc=${rc}) - cannot establish the publisher-owned set. Refusing (fail closed)." >&2
    tail -n 5 "$errf" | sed 's/^/       /' >&2
    rm -f "$porc" "$errf"
    return 1
  fi
  rm -f "$errf"
  # Completeness: sync-tap.sh prints its "Checked N files." summary only after it has walked EVERY mapping.
  # An early `exit 1` (a guard firing mid-run) also reads as "drift, a normal answer" by rc alone, and
  # would hand back a PARTIAL map - the reassuring wrong answer. 4c682c30 under bash did exactly that.
  if ! grep -q '^Checked [0-9][0-9]* files' "$porc"; then
    echo "Error: 'zsh sync-tap.sh --check --porcelain' ended without its completion summary (rc=${rc}) - the listing may be PARTIAL, so the publisher-owned set cannot be established. Refusing (fail closed)." >&2
    rm -f "$porc"
    return 1
  fi
  LC_ALL=C awk -F'\t' '($1=="OK"||$1=="DRIFT"||$1=="NEW"||$1=="MISSING") && $3!="" {print $3}' "$porc" \
    | tr '[:upper:]' '[:lower:]' > "$PTE_MAP_FILE"
  rm -f "$porc"
  n="$(wc -l < "$PTE_MAP_FILE" | tr -d '[:space:]')"
  if [ -z "$n" ] || [ "$n" -lt 1 ]; then
    echo "Error: 'sync-tap.sh --check --porcelain' produced no mirror records - cannot establish the publisher-owned set. Refusing (fail closed)." >&2
    return 1
  fi
  line="$(grep -m1 '^TAP_STAGE_PATHS=(' "$sync" || true)"
  line="${line#TAP_STAGE_PATHS=(}"; line="${line%%)*}"
  if [ -z "${line//[[:space:]]/}" ]; then
    echo "Error: could not read TAP_STAGE_PATHS from ${sync} - refusing (fail closed)." >&2
    return 1
  fi
  for w in $line; do
    w="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]')"
    case "$w" in
      libexec/) : ;;                     # tap-native except the mapped file (see above)
      */)       printf '%s\n' "$w" >> "$PTE_DIRS_FILE" ;;
      *)        printf '%s\n' "$w" >> "$PTE_FILES_FILE" ;;
    esac
  done
  if [ ! -s "$PTE_DIRS_FILE" ] && [ ! -s "$PTE_FILES_FILE" ]; then
    echo "Error: TAP_STAGE_PATHS in ${sync} yielded no usable entries - refusing (fail closed)." >&2
    return 1
  fi
  # 052: files the publisher stages by name outside TAP_STAGE_PATHS (today: CHANGELOG.md, rewritten by
  # _pub_write_tap_changelog and `git -C "$TAP" add`-ed in the same publish). A tap-only edit to one
  # races the publisher's rewrite of it. Derived from the script's own staging calls, not hardcoded;
  # none found = refuse (a refactor of the staging must be re-read here, not silently un-owned).
  cl="$(sed -n -E 's/^[[:space:]]*git -C "\$TAP" add ([A-Za-z0-9_.][A-Za-z0-9_.\/-]*)[[:space:]]*$/\1/p' "$sync" | sort -u | tr '[:upper:]' '[:lower:]')"
  if [ -z "$cl" ]; then
    echo "Error: could not derive the publisher's exact-file staging (git -C \"\$TAP\" add <file>) from ${sync} - refusing (fail closed)." >&2
    return 1
  fi
  printf '%s\n' "$cl" >> "$PTE_FILES_FILE"
  return 0
}

# pte_owned_reason <path> — prints why the publisher owns the path and returns 0; returns 1
# when the path is tap-native (free for a tap-only edit).
pte_owned_reason() {
  local p d
  p="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  if grep -Fxq -- "$p" "$PTE_MAP_FILE"; then
    printf 'mirrored destination (sync-tap.sh map)'; return 0
  fi
  while IFS= read -r d || [ -n "$d" ]; do
    case "$p" in "$d"*) printf 'under publisher-staged directory %s' "$d"; return 0 ;; esac
  done < "$PTE_DIRS_FILE"
  if grep -Fxq -- "$p" "$PTE_FILES_FILE"; then
    printf 'publisher-staged file'; return 0
  fi
  return 1
}

# pte_check_commit <sha> — appends human-readable offences (one per line) to PTE_OFFENCES_FILE.
pte_check_commit() {
  local sha="$1" short st pth why trailers n_key dt
  short="$(git -C "$TAP_DIR" rev-parse --short=10 "$sha")"
  # trailer: exact key + value, exactly once, from git's own trailer parser.
  trailers="$(git -C "$TAP_DIR" log -1 --format=%B "$sha" | git interpret-trailers --parse 2>/dev/null || true)"
  n_key="$(printf '%s\n' "$trailers" | grep -ciE '^Tap-Only-Edit[[:space:]]*:' || true)"
  # Here-string, not `printf | grep -q`: under pipefail a >64 KiB trailer block lets grep -q exit
  # on its first hit while printf is still writing, printf takes SIGPIPE, and the pipeline's
  # status flips an accepted commit into "missing" (XACA-1404 ratchet; row B11).
  if ! grep -Fxq 'Tap-Only-Edit: intentional' <<<"$trailers"; then
    echo "${short}: missing the exact trailer 'Tap-Only-Edit: intentional' (key and value are case-sensitive; it must sit in the final trailer block)" >> "$PTE_OFFENCES_FILE"
  elif [ "$n_key" -ne 1 ]; then
    echo "${short}: carries ${n_key} Tap-Only-Edit trailers (exactly one 'Tap-Only-Edit: intentional' is allowed)" >> "$PTE_OFFENCES_FILE"
  fi
  # paths: every added/modified/deleted/type-changed path; renames arrive as delete + add.
  # Through a temp file, not process substitution: a failing git must be SEEN, not read as
  # "no paths changed".
  # XACA-1170-055: under PTE_SYNC_ROOT (removed by _pte_cleanup on EXIT/INT/TERM), like 053's files.
  [ -d "${PTE_SYNC_ROOT:-}" ] || { echo "${short}: sync work dir missing (refused)" >> "$PTE_OFFENCES_FILE"; return 0; }
  dt="$(mktemp "${PTE_SYNC_ROOT}/dt.XXXXXX")" || { echo "${short}: mktemp failed (refused)" >> "$PTE_OFFENCES_FILE"; return 0; }
  if ! git -C "$TAP_DIR" diff-tree --no-commit-id -r -z --no-renames --name-status --root "$sha" > "$dt" 2>/dev/null; then
    rm -f "$dt"
    echo "${short}: could not list the paths this commit touches (refused)" >> "$PTE_OFFENCES_FILE"
    return 0
  fi
  while IFS= read -r -d '' st && IFS= read -r -d '' pth; do
    case "$pth" in
      *$'\n'*) echo "${short}: path contains a newline (refused): $(printf '%q' "$pth")" >> "$PTE_OFFENCES_FILE"; continue ;;
    esac
    if why="$(pte_owned_reason "$pth")"; then
      echo "${short}: [${st}] ${pth}  <- ${why}" >> "$PTE_OFFENCES_FILE"
    fi
  done < "$dt"
  rm -f "$dt"
}

# pte_preconditions — everything checked BEFORE the lock and before a token exists.
# Prints a PASS/FAIL table; every failure is counted in FAIL_COUNT. Sets PTE_BASE / PTE_HEAD.
pte_preconditions() {
  local st n branch merges rev first_merge
  # (d) clean tree + index
  st="$(git -C "$TAP_DIR" status --porcelain 2>/dev/null || echo __STATUS_FAILED__)"
  if [ -z "$st" ]; then check_pass "Tap working tree and index are clean."
  else check_fail "Tap working tree is not clean (uncommitted, staged or untracked changes) - commit or clean up first, so the commit you meant is what you are looking at."; fi

  PTE_HEAD="$(git -C "$TAP_DIR" rev-parse --verify --quiet 'HEAD^{commit}' || true)"
  if [ -z "$PTE_HEAD" ]; then
    check_fail "Tap HEAD does not resolve to a commit."
    return 1
  fi
  branch="$(git -C "$TAP_DIR" branch --show-current 2>/dev/null || true)"
  check_pass "Tap HEAD ${PTE_HEAD} (${branch:-detached HEAD}); the push names its destination explicitly (<sha>:refs/heads/main), so a branch or a detached HEAD are both fine."

  # (a) fetch + strict fast-forward
  if ! pte_fetch_main; then
    check_fail "Could not fetch tap main from ${TAP_PUSH_TARGET} (details above)."
    return 1
  fi
  check_pass "Fetched tap main from ${TAP_PUSH_TARGET} (read-only, no token): ${PTE_BASE}."
  if [ "$PTE_BASE" = "$PTE_HEAD" ]; then
    check_fail "HEAD equals tap main - there is nothing to push."
    return 1
  elif git -C "$TAP_DIR" merge-base --is-ancestor "$PTE_HEAD" "$PTE_BASE" 2>/dev/null; then
    check_fail "HEAD is BEHIND tap main - the publisher (or a release) moved it. Rebase your tap-only commit(s) onto the fetched tap main and re-run."
    return 1
  elif ! git -C "$TAP_DIR" merge-base --is-ancestor "$PTE_BASE" "$PTE_HEAD" 2>/dev/null; then
    check_fail "HEAD has DIVERGED from tap main (not a fast-forward). Rebase your tap-only commit(s) onto the fetched tap main and re-run."
    return 1
  fi
  n="$(git -C "$TAP_DIR" rev-list --count "${PTE_BASE}..${PTE_HEAD}")"
  check_pass "HEAD is a strict fast-forward of tap main with ${n} new commit(s)."

  PTE_SHAS_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-shas.XXXXXX")" || { check_fail "mktemp failed."; return 1; }
  git -C "$TAP_DIR" rev-list --reverse "${PTE_BASE}..${PTE_HEAD}" > "$PTE_SHAS_FILE" || { check_fail "could not list the new commits."; return 1; }
  merges="$(git -C "$TAP_DIR" rev-list --merges "${PTE_BASE}..${PTE_HEAD}")" || { check_fail "could not look for merge commits."; return 1; }
  if [ -n "$merges" ]; then
    first_merge="${merges%%$'\n'*}"   # parameter expansion, not `| head -n1` (SIGPIPE under pipefail)
    check_fail "The new range contains a merge commit (${first_merge:0:10}). Linear history only: a merge's diff against its first parent hides what the other parent brought, so the per-commit checks below would be unsound. Rebase onto tap main."
    return 1
  fi
  check_pass "The new range is linear (no merge commits)."

  # (b)+(c) trailer and publisher-owned paths, per commit
  if ! pte_build_owned_map; then
    check_fail "Could not establish which tap paths the publisher owns (details above)."
    return 1
  fi
  PTE_OFFENCES_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-off.XXXXXX")" || { check_fail "mktemp failed."; return 1; }
  while IFS= read -r rev || [ -n "$rev" ]; do
    [ -n "$rev" ] || continue
    pte_check_commit "$rev"
  done < "$PTE_SHAS_FILE"
  if [ -s "$PTE_OFFENCES_FILE" ]; then
    check_fail "${n} commit(s) checked; offences:"
    sed 's/^/           /' "$PTE_OFFENCES_FILE"
    echo "           Publisher-owned content is edited in dev-team (canonical-source rule, XACA-0340) and mirrored by the publisher; this command is only for files with no canonical."
  else
    check_pass "Every new commit carries 'Tap-Only-Edit: intentional' and touches no publisher-owned path ($(wc -l < "$PTE_MAP_FILE" | tr -d '[:space:]') mirrored destinations + staged directories checked)."
  fi
  return 0
}

# push_tap_edit_main — the whole --push-tap-edit flow. Never returns into the release path.
push_tap_edit_main() {
  local rc=0 n before
  echo ""
  echo "=== kb-tap-release --push-tap-edit ==="
  echo ""
  if [ ! -e "${TAP_DIR}/.git" ]; then
    echo "Error: ${TAP_DIR} is not an initialized tap checkout. Run from the outer dev-team checkout." >&2
    exit 1
  fi
  # Identity first (config, key, URL allow-list, rewrite + git -c refusals): no network, no
  # token. It also fixes TAP_PUSH_TARGET, which the read-only fetch below uses.
  tap_release_identity_prepare || {
    echo "" >&2
    echo "Refusing: could not establish the tap push identity (details above). Nothing was pushed." >&2
    exit 1
  }
  pte_preconditions || true
  if [ "$FAIL_COUNT" -gt 0 ]; then
    echo ""
    echo "Refusing: $FAIL_COUNT precondition(s) did not pass. Nothing was locked, minted or pushed."
    exit 1
  fi
  n="$(wc -l < "$PTE_SHAS_FILE" | tr -d '[:space:]')"
  echo ""
  echo "  Commits to push (${n}):"
  git -C "$TAP_DIR" log --reverse --format='    %h %s' "${PTE_BASE}..${PTE_HEAD}"

  if [ "$DRY_RUN" -eq 1 ]; then
    echo ""
    echo "[DRY-RUN] All preconditions passed. Would take the tap-writer lock, mint the release App token,"
    echo "[DRY-RUN] and push ${PTE_HEAD}:refs/heads/main to ${TAP_PUSH_TARGET}. No lock, token or push was made."
    exit 0
  fi

  # Lock, THEN mint (a long KB_TAP_RELEASE_LOCK_WAIT must not age the 1h token).
  if [ ! -f "$LOCK_LIB" ]; then
    echo "Error: cannot find kb-tap-lock.sh (looked in ${OUTER_DIR}/scripts/ and next to this script). Refusing to push without the tap-writer lock." >&2
    exit 1
  fi
  # shellcheck source=scripts/kb-tap-lock.sh
  . "$LOCK_LIB"
  KB_TAP_LOCK_TAP_DIR="$TAP_DIR"
  export KB_TAP_LOCK_TAP_DIR
  echo ""
  echo "=== Acquiring the tap-writer lock ==="
  kb_tap_lock_acquire \
    "kb-tap-release push-tap-edit — $(id -un 2>/dev/null || echo unknown)@$(hostname -s 2>/dev/null || echo unknown)" \
    "${KB_TAP_RELEASE_LOCK_WAIT:-0}" || rc=$?
  case "$rc" in
    0) KB_TAP_LOCK_ACQUIRED=1
       echo "  Held: ${KB_TAP_LOCK_REF} (${KB_TAP_LOCK_HELD_SHA})" ;;
    10) echo "" >&2
        echo "Refusing: another writer holds the tap-writer lock (details above). Wait and re-run, or" >&2
        echo "  KB_TAP_RELEASE_LOCK_WAIT=600 kb-tap-release --push-tap-edit    (inspect: scripts/kb-tap-lock.sh status)" >&2
        exit 1 ;;
    *)  echo "" >&2
        echo "Refusing: could not determine the tap-writer lock state (exit ${rc}). Do NOT skip the lock." >&2
        exit 1 ;;
  esac

  # Under the lock: nothing may have moved since the preconditions ran.
  before="$PTE_BASE"
  pte_fetch_main || { echo "Refusing: could not re-fetch tap main under the lock. Nothing was pushed." >&2; exit 1; }
  if [ "$PTE_BASE" != "$before" ]; then
    echo "Refusing: tap main moved while waiting for the lock (${before} -> ${PTE_BASE}). Rebase and re-run. Nothing was pushed." >&2
    exit 1
  fi
  if [ "$(git -C "$TAP_DIR" rev-parse --verify --quiet 'HEAD^{commit}' || true)" != "$PTE_HEAD" ]; then
    echo "Refusing: tap HEAD moved after the preconditions ran (another session committed in this shared checkout?). Nothing was pushed." >&2
    exit 1
  fi

  tap_release_identity_mint_or_exit
  echo "=== --push-tap-edit: ${PTE_HEAD} -> tap main ==="
  # The exact commit that was verified, with an explicit destination ref: never `push origin
  # main` (a detached HEAD pushes nothing useful) and never a moving `HEAD` (the shared tap
  # checkout can gain a commit between the check and the push). Marker inline, not exported.
  TAP_SINGLE_WRITER_RELEASE=1 tap_authed_git -C "${TAP_DIR}" push "${TAP_PUSH_TARGET}" "${PTE_HEAD}:refs/heads/main"
  git -C "${TAP_DIR}" update-ref refs/remotes/origin/main "${PTE_HEAD}"
  echo "  Tap push complete."
  echo ""
  echo "=== Next: TWO-STEP follow-up (the tap is now ahead of dev-team's gitlink) ==="
  echo "  New tap main SHA: ${PTE_HEAD}"
  echo "  Until the gitlink PR below merges, the publisher's pointer-parity gate refuses (tap main is ahead of"
  echo "  develop's gitlink) and it catches up afterwards. So: ANNOUNCE this now (kb-msg send academy \"...\"),"
  echo "  do it one at a time, and merge promptly."
  echo "    git checkout -b chore/bump-tap-gitlink-${PTE_HEAD:0:10} dev-team/develop     # a branch, never develop itself"
  echo "    git submodule update --init homebrew-tap && git -C homebrew-tap checkout ${PTE_HEAD}"
  echo "    git add homebrew-tap"
  echo "    git commit -m \"chore: Bump homebrew-tap gitlink to ${PTE_HEAD}\" \\"
  echo "               -m \"Tap-only edit pushed by kb-tap-release --push-tap-edit (no dev-team canonical).\""
  echo "    # changelog: the tap-changelog-completeness gate SKIPS commits carrying 'Tap-Only-Edit: intentional'"
  echo "    # (yours do), so no homebrew-tap/CHANGELOG.md entry is needed. dev-team still wants its own fragment:"
  echo "    #   scripts/kb-changelog new <ITEM-ID>   (or a 'Changelog-Skip: <reason>' trailer)"
  echo "    git push -u dev-team HEAD && gh pr create --base develop ...   # then kb-pr-monitor as usual"
  exit 0
}

if [ "$PUSH_TAP_EDIT" -eq 1 ]; then
  push_tap_edit_main
fi

if [ "$DRY_RUN" -eq 0 ] && [ "$NO_PUSH" -eq 0 ] && [ "$PUSH_TAP_EDIT" -eq 0 ]; then
  if [ ! -f "$LOCK_LIB" ]; then
    # Same fact preflight #5 tests, read the same way: a gitlink is a FILE, so
    # -e rather than -d.
    if [ ! -e "${TAP_DIR}/.git" ]; then
      echo "Error: ${OUTER_DIR} is not an initialized outer dev-team checkout" >&2
      echo "       (no ${TAP_DIR}/.git), so this is not a tree a release can be cut from." >&2
      echo "       That, not the lock library, is what is missing here. kb-tap-release must be" >&2
      echo "       run from the outer repo with the homebrew-tap submodule initialized" >&2
      echo "       (preconditions 1 and 5 — see --help)." >&2
      echo "       kb-tap-lock.sh is resolved from that checkout's scripts/ and is deliberately" >&2
      echo "       not installed alongside this script; a release can only be cut from an outer" >&2
      echo "       dev checkout, which is the same thing preconditions 1 and 5 require." >&2
    else
      echo "Error: cannot find kb-tap-lock.sh (looked in ${OUTER_DIR}/scripts/ and next to this script)." >&2
      echo "       ${TAP_DIR}/.git exists, so this looks like an outer dev-team checkout with a" >&2
      echo "       tracked file missing. Restore it: git checkout -- scripts/kb-tap-lock.sh" >&2
    fi
    echo "       Refusing to release without the tap-writer lock — a release cut that skips it can" >&2
    echo "       interleave with the post-merge publisher and roll the gitlink backward." >&2
    exit 1
  fi
  # shellcheck source=scripts/kb-tap-lock.sh
  . "$LOCK_LIB"

  # XACA-1170-003: fail closed on the release identity BEFORE taking the lock or
  # touching anything (after the checkout/lock-library diagnosis above, which
  # names the more fundamental problem first). Config, key and push-URL validation
  # happen here (cheap, no network); the token is minted later, after the lock
  # (XACA-1170-044).
  tap_release_identity_prepare || {
    echo "" >&2
    echo "Refusing to release: could not establish the tap push identity (details above)." >&2
    echo "  Nothing was committed, tagged or pushed. To push as yourself in an emergency: --as-human" >&2
    exit 1
  }

  KB_TAP_LOCK_TAP_DIR="$TAP_DIR"
  export KB_TAP_LOCK_TAP_DIR

  echo ""
  echo "=== Acquiring the tap-writer lock ==="
  # `|| LOCK_RC=$?` is required: `set -e` is active and a bare call returning 10
  # would abort the script before the diagnostics below could print.
  LOCK_RC=0
  kb_tap_lock_acquire \
    "kb-tap-release ${LEVEL:-push-only} — $(id -un 2>/dev/null || echo unknown)@$(hostname -s 2>/dev/null || echo unknown)" \
    "${KB_TAP_RELEASE_LOCK_WAIT:-0}" || LOCK_RC=$?

  case "$LOCK_RC" in
    0)
      KB_TAP_LOCK_ACQUIRED=1
      echo "  Held: ${KB_TAP_LOCK_REF} (${KB_TAP_LOCK_HELD_SHA})"
      echo ""
      ;;
    10)
      echo "" >&2
      echo "Refusing to release: another writer holds the tap-writer lock (details above)." >&2
      echo "" >&2
      echo "  If that is a publisher run, wait for it to finish and re-run — it is short." >&2
      echo "  To wait automatically instead of failing:" >&2
      echo "      KB_TAP_RELEASE_LOCK_WAIT=600 kb-tap-release ${LEVEL:---push-only}" >&2
      echo "  To inspect the holder at any time:" >&2
      echo "      scripts/kb-tap-lock.sh status" >&2
      echo "" >&2
      exit 1
      ;;
    *)
      echo "" >&2
      echo "Refusing to release: could not determine the tap-writer lock state (exit ${LOCK_RC})." >&2
      echo "  This is an environment problem, not a contention finding. Do NOT work around it by" >&2
      echo "  skipping the lock — an unknown lock state is exactly when an interleave is possible." >&2
      echo "" >&2
      exit 1
      ;;
  esac
fi

# ─── --push-only: recovery path (XACA-1170-003) ──────────────────────────────
# Re-runs just the two tap pushes. Deliberately minimal: no preflight, no
# commits. It refuses unless tap HEAD is on main and exactly one v* tag points at
# it, so it can only ever publish a release commit this script (or its operator)
# already made locally.
if [ "$PUSH_ONLY" -eq 1 ]; then
  if [ ! -e "${TAP_DIR}/.git" ]; then
    echo "Error: ${TAP_DIR} is not an initialized tap checkout." >&2
    exit 1
  fi
  PO_BRANCH="$(git -C "${TAP_DIR}" branch --show-current 2>/dev/null || true)"
  if [ "$PO_BRANCH" != "main" ]; then
    echo "Error: --push-only requires the tap on 'main' (found '${PO_BRANCH}')." >&2
    exit 1
  fi
  PO_TAGS="$(git -C "${TAP_DIR}" tag --points-at HEAD --list 'v[0-9]*' 2>/dev/null || true)"
  PO_VERSION="${PO_TAGS#v}"
  if [ -z "$PO_TAGS" ] || [ "$(printf '%s\n' "$PO_TAGS" | grep -c .)" -ne 1 ]; then
    echo "Error: --push-only needs exactly one v* tag pointing at tap HEAD; found: ${PO_TAGS:-<none>}" >&2
    exit 1
  fi
  tap_release_identity_mint_or_exit   # after the lock wait, right before the pushes
  echo "=== --push-only: tap main + ${PO_TAGS} ==="
  TAP_SINGLE_WRITER_RELEASE=1 tap_authed_git -C "${TAP_DIR}" push "${TAP_PUSH_TARGET}" main
  git -C "${TAP_DIR}" update-ref refs/remotes/origin/main HEAD
  tap_authed_git -C "${TAP_DIR}" push "${TAP_PUSH_TARGET}" "v${PO_VERSION}"
  echo "  Tap push complete."
  echo "  Next (human admin, outer repo): git add homebrew-tap && git commit -m \"chore: Bump homebrew-tap submodule to ${PO_TAGS}\" && git push <outer-remote> develop"
  exit 0
fi

# ─── preflight ────────────────────────────────────────────────────────────────

echo ""
echo "=== kb-tap-release preflight ==="
echo ""

# 1. Not in a worktree
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ "$GIT_COMMON_DIR" = ".git" ]; then
  check_pass "Outer repo is not a worktree."
else
  check_fail "Cannot release from a worktree. Run from ~/dev-team."
fi

# 2. Outer branch is develop
OUTER_BRANCH="$(git branch --show-current 2>/dev/null || true)"
if [ "$OUTER_BRANCH" = "develop" ]; then
  check_pass "Outer branch is develop."
else
  check_fail "Outer repo must be on 'develop'. Current: ${OUTER_BRANCH}."
fi

# 3. Outer working tree clean
OUTER_STATUS="$(git status --porcelain 2>/dev/null || true)"
if [ -z "$OUTER_STATUS" ]; then
  check_pass "Outer working tree is clean."
else
  # XACA-1132-015: the stash stack is shared by every worktree and session of this repo.
  check_fail "Outer working tree has uncommitted changes. Inspect with: git status. Commit your own changes; do not stash - the stash stack is shared by every worktree and session of this repo."
fi

# 4. Outer up-to-date with <outer-remote>/develop
git fetch "${OUTER_REMOTE}" develop 2>/dev/null || true
LOCAL_SHA="$(git rev-parse develop 2>/dev/null || true)"
REMOTE_SHA="$(git rev-parse "${OUTER_REMOTE}/develop" 2>/dev/null || true)"
if [ -z "$LOCAL_SHA" ] || [ -z "$REMOTE_SHA" ]; then
  check_fail "Could not determine develop vs ${OUTER_REMOTE}/develop SHAs. Check git remote."
elif [ "$LOCAL_SHA" = "$REMOTE_SHA" ]; then
  check_pass "Outer develop is up-to-date with ${OUTER_REMOTE}/develop."
else
  # Determine direction
  MERGE_BASE="$(git merge-base develop "${OUTER_REMOTE}/develop" 2>/dev/null || true)"
  if [ "$MERGE_BASE" = "$LOCAL_SHA" ]; then
    check_fail "Outer develop is BEHIND ${OUTER_REMOTE}/develop. Pull develop first."
  elif [ "$MERGE_BASE" = "$REMOTE_SHA" ]; then
    check_fail "Outer develop is AHEAD of ${OUTER_REMOTE}/develop — push or rebase first."
  else
    check_fail "Outer develop diverged from ${OUTER_REMOTE}/develop — push or rebase first."
  fi
fi

# 5. Tap submodule initialized
if [ -e "${TAP_DIR}/.git" ]; then
  check_pass "Tap submodule is initialized (homebrew-tap/.git exists)."
else
  check_fail "Tap submodule is not initialized. Run: git submodule update --init homebrew-tap"
fi

# Only run tap-inner checks if submodule exists; otherwise they'll fail loudly
TAP_OK=0
if [ -e "${TAP_DIR}/.git" ]; then
  TAP_OK=1
fi

# 6. Tap inner branch is main
if [ "$TAP_OK" -eq 1 ]; then
  TAP_BRANCH="$(git -C "${TAP_DIR}" branch --show-current 2>/dev/null || true)"
  if [ "$TAP_BRANCH" = "main" ]; then
    check_pass "Tap inner branch is main."
  else
    # XACA-1132: detached HEAD is the NORMAL state after
    # `git submodule update`, and a bare `git checkout main` there moves the SHARED tap checkout to
    # LOCAL main, which can be stale (measured: 4 commits, 11 files / -1779 lines of rollback).
    # So compare HEAD with a FRESH origin/main before prescribing anything. #8 never fetches on
    # this path (TAP_OK is cleared here), so this block fetches itself. READ-ONLY: it prescribes
    # but never attaches - the checkout is shared by many live sessions.
    if [ -z "$TAP_BRANCH" ]; then TAP_WHERE="detached HEAD"; else TAP_WHERE="branch '${TAP_BRANCH}'"; fi
    if ! git -C "${TAP_DIR}" fetch origin main 2>/dev/null; then
      check_fail "Tap is on ${TAP_WHERE}, not main, and 'git fetch origin main' FAILED - HEAD cannot be compared with a fresh origin/main, so no checkout is prescribed (a stale ref could prescribe a rollback). Fix the tap's network/remote access and re-run."
    else
      TAP_HEAD_SHA="$(git -C "${TAP_DIR}" rev-parse HEAD 2>/dev/null || true)"
      TAP_ORIGIN_SHA="$(git -C "${TAP_DIR}" rev-parse origin/main 2>/dev/null || true)"
      TAP_MAIN_SHA="$(git -C "${TAP_DIR}" rev-parse --verify -q refs/heads/main 2>/dev/null || true)"
      if [ -z "$TAP_MAIN_SHA" ]; then TAP_MAIN_REL="no local main branch"
      elif [ "$TAP_MAIN_SHA" = "$TAP_ORIGIN_SHA" ]; then TAP_MAIN_REL="local main ${TAP_MAIN_SHA:0:10} == origin/main"
      elif [ "$TAP_MAIN_SHA" = "$TAP_HEAD_SHA" ]; then TAP_MAIN_REL="local main ${TAP_MAIN_SHA:0:10} == HEAD"
      elif git -C "${TAP_DIR}" merge-base --is-ancestor "$TAP_MAIN_SHA" "$TAP_ORIGIN_SHA" 2>/dev/null; then TAP_MAIN_REL="local main ${TAP_MAIN_SHA:0:10} is BEHIND origin/main"
      elif git -C "${TAP_DIR}" merge-base --is-ancestor "$TAP_ORIGIN_SHA" "$TAP_MAIN_SHA" 2>/dev/null; then TAP_MAIN_REL="local main ${TAP_MAIN_SHA:0:10} is AHEAD of origin/main"
      else TAP_MAIN_REL="local main ${TAP_MAIN_SHA:0:10} DIVERGED from origin/main"; fi
      if [ -z "$TAP_HEAD_SHA" ] || [ -z "$TAP_ORIGIN_SHA" ]; then
        check_fail "Tap is on ${TAP_WHERE}, not main, and HEAD / origin/main could not be resolved, so no checkout is prescribed. Inspect homebrew-tap by hand."
      elif [ "$TAP_HEAD_SHA" = "$TAP_ORIGIN_SHA" ] && { [ -z "$TAP_MAIN_SHA" ] || git -C "${TAP_DIR}" merge-base --is-ancestor "$TAP_MAIN_SHA" "$TAP_ORIGIN_SHA" 2>/dev/null; }; then
        check_fail "Tap is on ${TAP_WHERE} at origin/main (${TAP_HEAD_SHA:0:10}). Attach it to main with: cd homebrew-tap && git checkout -B main origin/main"
        echo "         (content-neutral: HEAD already equals origin/main, so no file changes; checking out plain local main is NOT equivalent - local main may be stale. Not run for you: this checkout is shared.)"
      elif [ "$TAP_HEAD_SHA" = "$TAP_ORIGIN_SHA" ]; then
        # -B resets local main, so it is only safe when main holds nothing origin/main lacks.
        check_fail "Tap is on ${TAP_WHERE} at origin/main (${TAP_HEAD_SHA:0:10}), but ${TAP_MAIN_REL}: it holds commits origin/main does not. Refusing - no checkout is prescribed (-B would orphan them). Push or reconcile local main by hand, then re-run."
      else
        TAP_DELTA="$(git -C "${TAP_DIR}" diff --shortstat HEAD origin/main 2>/dev/null || true)"
        TAP_MB="$(git -C "${TAP_DIR}" merge-base HEAD origin/main 2>/dev/null || true)"
        if [ "$TAP_MB" = "$TAP_HEAD_SHA" ]; then TAP_REL="BEHIND origin/main"
        elif [ "$TAP_MB" = "$TAP_ORIGIN_SHA" ]; then TAP_REL="AHEAD of origin/main (unpushed commits)"
        else TAP_REL="DIVERGED from origin/main"; fi
        check_fail "Tap is on ${TAP_WHERE}, not main, and HEAD (${TAP_HEAD_SHA:0:10}) != origin/main (${TAP_ORIGIN_SHA:0:10}): HEAD is ${TAP_REL}. Refusing - no checkout is prescribed."
        echo "         Delta HEAD -> origin/main (git diff --shortstat): ${TAP_DELTA:-no file changes}"
        echo "         Local main: ${TAP_MAIN_REL}."
        echo "         Moving this shared checkout could roll content back or orphan unpushed commits. Reconcile homebrew-tap by hand, then re-run."
      fi
    fi
    TAP_OK=0
  fi
else
  check_fail "Tap inner branch check skipped (submodule not initialized)."
fi

# 7. Tap inner working tree clean
if [ "$TAP_OK" -eq 1 ]; then
  TAP_STATUS="$(git -C "${TAP_DIR}" status --porcelain 2>/dev/null || true)"
  if [ -z "$TAP_STATUS" ]; then
    check_pass "Tap inner working tree is clean."
  else
    # XACA-1132-004: the tap checkout is shared by many live sessions; the dirt may be another
    # session's in-flight work, and stashing it would pull the files out from under them.
    check_fail "Tap working tree has uncommitted changes. Inspect with: git -C homebrew-tap status. This checkout is shared - do not stash, reset or discard changes you did not make; commit your own, or wait for the owner."
    TAP_OK=0
  fi
else
  check_fail "Tap inner working-tree check skipped (submodule not initialized or not on main)."
fi

# 8. Tap inner up-to-date with origin/main
if [ "$TAP_OK" -eq 1 ]; then
  git -C "${TAP_DIR}" fetch origin main 2>/dev/null || true
  TAP_LOCAL="$(git -C "${TAP_DIR}" rev-parse HEAD 2>/dev/null || true)"
  TAP_REMOTE="$(git -C "${TAP_DIR}" rev-parse origin/main 2>/dev/null || true)"
  if [ -z "$TAP_LOCAL" ] || [ -z "$TAP_REMOTE" ]; then
    check_fail "Could not determine tap HEAD vs origin/main SHAs."
    TAP_OK=0
  elif [ "$TAP_LOCAL" = "$TAP_REMOTE" ]; then
    check_pass "Tap inner is up-to-date with origin/main."
  else
    TAP_MERGE_BASE="$(git -C "${TAP_DIR}" merge-base HEAD origin/main 2>/dev/null || true)"
    if [ "$TAP_MERGE_BASE" = "$TAP_LOCAL" ]; then
      check_fail "Tap is BEHIND origin/main. Run: cd homebrew-tap && git merge --ff-only origin/main"
      TAP_OK=0
    else
      check_fail "Tap has diverged from origin/main. Reconcile before releasing."
      TAP_OK=0
    fi
  fi
else
  check_fail "Tap origin/main check skipped (earlier check failed)."
fi

# 9. sync-tap drift check — DIRECTION-AWARE (XACA-1112)
#
# The scalar "any drift = block" version of this check was ALSO the version
# that would have silently PASSED a release cut from tap main while it briefly
# carried four open PRs' mirror-ahead content (XACA-1112-007) — its
# check_fail's remedy ("run ./sync-tap.sh") is destructive for that direction
# (it would copy older canonical OVER newer, sanctioned tap content), so a
# releaser under release pressure had a real incentive to bypass it by hand.
#
# CANONICAL-AHEAD and DIVERGED still hard-fail unconditionally here — for
# those two directions ./sync-tap.sh really is the correct, safe remedy, and
# there is no legitimate reason to release while either is true.
#
# TAP-AHEAD is the highest-risk direction specifically at RELEASE time (unlike
# the mainline push gate, which cannot un-ship a push that already happened,
# this check runs BEFORE the tag is cut and can actually prevent shipping
# someone else's still-open PR). It therefore still BLOCKS by default — not a
# silent pass — and is waivable only via the explicit, reasoned
# --tap-ahead-release="<reason>" flag, recorded as a commit trailer on both
# release commits so a waived release is auditable (see Phase 2/3 below).
TAP_AHEAD_WAIVED=0
SYNCTAP_SCRIPT="${OUTER_DIR}/sync-tap.sh"
ATTRIB_SCRIPT="${OUTER_DIR}/scripts/attribute-tap-drift.sh"
if [ -x "$SYNCTAP_SCRIPT" ] && [ -f "$ATTRIB_SCRIPT" ]; then
  DRIFT_RECORDS_FILE="$(mktemp "${TMPDIR:-/tmp}/kb-tap-release-drift.XXXXXX")"
  SYNCTAP_OUT="$("${SYNCTAP_SCRIPT}" --check --porcelain 2>&1)" && SYNCTAP_EXIT=0 || SYNCTAP_EXIT=$?
  printf '%s\n' "$SYNCTAP_OUT" > "$DRIFT_RECORDS_FILE"

  if [ "$SYNCTAP_EXIT" -eq 0 ]; then
    check_pass "sync-tap drift check passed (clean)."
  else
    DIR_REPORT="$(REMOTE_NAME="$OUTER_REMOTE" TAP_DIR="$TAP_DIR" \
      bash "$ATTRIB_SCRIPT" --classify-direction \
        --records "$DRIFT_RECORDS_FILE" --sync-status "$SYNCTAP_EXIT" 2>&1)" \
      && DIR_EXIT=0 || DIR_EXIT=$?
    echo "    direction classification:"
    echo "$DIR_REPORT" | sed 's/^/      /'

    case "$DIR_EXIT" in
      2)
        check_fail "Drift direction could not be classified (environment problem, not a drift finding — see detail above)."
        ;;
      1)
        check_fail "Tap mirror has CANONICAL-AHEAD, DIVERGED, or unmirrored (NEW) drift. Run ./sync-tap.sh and commit the result first (this remedy IS correct/safe for these directions)."
        ;;
      0)
        if grep -qE '^[[:space:]]*TAP-AHEAD[[:space:]]' <<<"$DIR_REPORT"; then
          if [ -n "$TAP_AHEAD_RELEASE_REASON" ]; then
            TAP_AHEAD_WAIVED=1
            check_pass "sync-tap drift is TAP-AHEAD only — WAIVED via --tap-ahead-release=\"${TAP_AHEAD_RELEASE_REASON}\" (recorded as a commit trailer below)."
          else
            check_fail "Tap mirror carries TAP-AHEAD drift: the tap already has a newer, sanctioned mirror-ahead push whose canonical half has NOT merged yet (see the ticket named above). Releasing NOW would ship that still-open PR's content to consumers. Fix: wait for that PR to merge (drift clears on its own), or revert the tap-ahead commit(s). If this is a deliberate pre-merge release, re-run with --tap-ahead-release=\"<reason>\" — do NOT run ./sync-tap.sh, it would destroy the newer tap content."
          fi
        else
          check_pass "sync-tap drift check passed (clean)."
        fi
        ;;
      *)
        check_fail "attribute-tap-drift.sh --classify-direction returned an undefined exit code (${DIR_EXIT}). Its contract defines only 0, 1, 2 — refusing to interpret as a pass."
        ;;
    esac
  fi
else
  if [ ! -x "$SYNCTAP_SCRIPT" ]; then
    check_fail "sync-tap.sh not found or not executable at: $SYNCTAP_SCRIPT"
  else
    check_fail "attribute-tap-drift.sh not found at: $ATTRIB_SCRIPT"
  fi
fi

# 10. [Unreleased] block is non-empty (only if tap submodule is accessible)
TAP_CHANGELOG="${TAP_DIR}/CHANGELOG.md"
UNRELEASED_CONTENT=""
if [ -f "$TAP_CHANGELOG" ]; then
  # Extract lines between ## [Unreleased] and next ## [ header
  # Use python3 for reliable multi-line parsing
  UNRELEASED_CONTENT="$(python3 - "$TAP_CHANGELOG" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path) as fh:
    content = fh.read()
# Find [Unreleased] block
m = re.search(r'## \[Unreleased\](.*?)(?=\n## \[)', content, re.DOTALL)
if not m:
    sys.exit(0)
block = m.group(1)
# Strip blank lines; output non-blank lines
lines = [l.strip() for l in block.splitlines() if l.strip()]
print('\n'.join(lines))
PYEOF
  )"
  if [ -n "$UNRELEASED_CONTENT" ]; then
    check_pass "CHANGELOG [Unreleased] section has content."
  else
    check_fail "CHANGELOG [Unreleased] section is empty. Add release notes before cutting."
  fi
else
  check_fail "homebrew-tap/CHANGELOG.md not found."
fi

# 11. VERSION matches Formula (read current versions)
TAP_VERSION_FILE="${TAP_DIR}/VERSION"
TAP_FORMULA="${TAP_DIR}/Formula/aiteamforge.rb"
CUR_VERSION=""
FORMULA_TAG=""
FORMULA_VERSION=""

if [ -f "$TAP_VERSION_FILE" ] && [ -f "$TAP_FORMULA" ]; then
  CUR_VERSION="$(tr -d '[:space:]' < "$TAP_VERSION_FILE")"
  # || true guards: grep returns nonzero on no-match; set -e would abort without it.
  # The standalone version line was removed in XACA-0394 (version now derived from tag:).
  FORMULA_TAG="$(grep -oE 'tag: "v[0-9]+\.[0-9]+\.[0-9]+"' "$TAP_FORMULA" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  FORMULA_VERSION="$(grep -oE '^[[:space:]]*version "[0-9]+\.[0-9]+\.[0-9]+"' "$TAP_FORMULA" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"

  # Tag must always match VERSION; the standalone version line is OPTIONAL (XACA-0394).
  if [ "$CUR_VERSION" = "$FORMULA_TAG" ] && { [ -z "$FORMULA_VERSION" ] || [ "$FORMULA_VERSION" = "$CUR_VERSION" ]; }; then
    if [ -z "$FORMULA_VERSION" ]; then
      check_pass "VERSION ($CUR_VERSION) matches Formula tag (no standalone version line — derived from tag, per XACA-0394)."
    else
      check_pass "VERSION ($CUR_VERSION) matches Formula tag and version."
    fi
  else
    check_fail "Version drift: VERSION=${CUR_VERSION}, Formula tag=${FORMULA_TAG}, Formula version=${FORMULA_VERSION:-<none>}. Reconcile before releasing."
  fi
else
  check_fail "homebrew-tap/VERSION or Formula/aiteamforge.rb not found."
fi

# 12. Computed new version doesn't already exist as a tag
if [ -n "$CUR_VERSION" ]; then
  NEW_VERSION="$(bump_version "$CUR_VERSION" "$LEVEL")"

  # Check local tags
  EXISTING_LOCAL="$(git -C "${TAP_DIR}" tag --list "v${NEW_VERSION}" 2>/dev/null || true)"
  # Check remote tags (fetch already done in step 8)
  EXISTING_REMOTE="$(git -C "${TAP_DIR}" ls-remote --tags origin "refs/tags/v${NEW_VERSION}" 2>/dev/null || true)"

  if [ -n "$EXISTING_LOCAL" ] || [ -n "$EXISTING_REMOTE" ]; then
    check_fail "Tag v${NEW_VERSION} already exists locally or on origin. Pick a different bump level."
  else
    check_pass "Tag v${NEW_VERSION} does not yet exist (safe to create)."
  fi
else
  check_fail "Cannot compute new version — CUR_VERSION is empty (VERSION file missing or unreadable)."
fi

# 13. Release identity resolves (XACA-1170-003). Config only — no network, no
#     token. Skipped when nothing will be pushed, or the escape hatch is explicit.
if [ "$NO_PUSH" -eq 0 ] && [ "$PUSH_AS_HUMAN" -eq 0 ]; then
  if CFG_MSG="$(tap_app_resolve_config 2>&1)"; then
    check_pass "Release App id and private key resolve (key mode ok)."
  else
    check_fail "Release App credentials not usable: ${CFG_MSG}"
  fi
elif [ "$PUSH_AS_HUMAN" -eq 1 ] && [ "$NO_PUSH" -eq 0 ]; then
  check_pass "Release identity check skipped: --as-human escape hatch (tap push will be as the human)."
fi

echo ""
echo "=== Preflight: $PASS_COUNT passed, $FAIL_COUNT failed ==="
echo ""

abort_on_failures

# ─── dry-run output ──────────────────────────────────────────────────────────

TODAY="$(date +%Y-%m-%d)"

if [ "$DRY_RUN" -eq 1 ]; then
  echo "[DRY-RUN] Would compute: ${CUR_VERSION} -> ${NEW_VERSION} (${LEVEL})"
  echo "[DRY-RUN] Would edit:    homebrew-tap/CHANGELOG.md   (promote [Unreleased] -> [${NEW_VERSION}] - ${TODAY})"
  echo "[DRY-RUN] Would edit:    homebrew-tap/CHANGELOG.md   (footer: insert [${NEW_VERSION}] compare line; update [Unreleased] anchor)"
  echo "[DRY-RUN] Would edit:    homebrew-tap/VERSION        (${CUR_VERSION} -> ${NEW_VERSION})"
  echo "[DRY-RUN] Would edit:    homebrew-tap/Formula/aiteamforge.rb  (tag + version -> ${NEW_VERSION})"
  echo "[DRY-RUN] Would commit:  homebrew-tap  \"chore: Release AITeamForge ${NEW_VERSION}\""
  echo "[DRY-RUN] Would tag:     v${NEW_VERSION}"
  if [ "$NO_PUSH" -eq 1 ]; then
    echo "[DRY-RUN] Would push:    (skipped — --no-push)"
  else
    echo "[DRY-RUN] Would take:    tap-writer lock ${KB_TAP_LOCK_REF:-refs/locks/tap-writer} (released on exit)"
    if [ "$PUSH_AS_HUMAN" -eq 1 ]; then
      echo "[DRY-RUN] Would push:    homebrew-tap  origin main + tag v${NEW_VERSION}  (AS HUMAN: --as-human)"
    else
      echo "[DRY-RUN] Would push:    homebrew-tap  main + tag v${NEW_VERSION}  (as the aiteamforge-release App; token minted at run time)"
    fi
    echo "[DRY-RUN] Would commit:  outer         \"chore: Bump homebrew-tap submodule to v${NEW_VERSION}\""
    echo "[DRY-RUN] Would push:    outer         ${OUTER_REMOTE} develop  (as the human admin)"
  fi
  echo ""
  echo "Dry run complete. No changes made."
  exit 0
fi

# ─── phase 1: compute & edit ─────────────────────────────────────────────────

# XACA-1170-044: the 1h token is minted only now — lock wait and preflight are behind
# us — and still before anything is committed, so a mint failure leaves the tree
# untouched. (--no-push mints nothing: it pushes nothing.)
if [ "$NO_PUSH" -eq 0 ]; then
  tap_release_identity_mint_or_exit
fi

echo "=== Phase 1: Editing tap files ==="
echo ""

echo "  Bumping: ${CUR_VERSION} -> ${NEW_VERSION} (${LEVEL})"
echo ""

# a. CHANGELOG.md — promote [Unreleased] to [NEW_VERSION] - DATE
# We need to replace the FIRST occurrence of "## [Unreleased]" with:
#   ## [Unreleased]
#   (blank line)
#   ## [NEW_VERSION] - DATE
# Use python3 for reliable editing.

python3 - "$TAP_CHANGELOG" "$NEW_VERSION" "$TODAY" <<'PYEOF'
import sys, re

path       = sys.argv[1]
new_ver    = sys.argv[2]
today      = sys.argv[3]

with open(path) as fh:
    content = fh.read()

# Count [Unreleased] occurrences — must be exactly one
count = len(re.findall(r'^## \[Unreleased\]', content, re.MULTILINE))
if count != 1:
    print("Error: expected exactly 1 '## [Unreleased]' line in CHANGELOG.md; found {}.".format(count), file=sys.stderr)
    sys.exit(1)

replacement = "## [Unreleased]\n\n## [{}] - {}".format(new_ver, today)
new_content = re.sub(r'^## \[Unreleased\]', replacement, content, count=1, flags=re.MULTILINE)

with open(path, "w") as fh:
    fh.write(new_content)

# Verify
with open(path) as fh:
    verify = fh.read()
verify_count = len(re.findall(r'^## \[Unreleased\]', verify, re.MULTILINE))
if verify_count != 1:
    print("Error: post-edit verification failed — found {} [Unreleased] lines.".format(verify_count), file=sys.stderr)
    sys.exit(1)

print("CHANGELOG.md: promoted [Unreleased] -> [{}] - {}".format(new_ver, today))
PYEOF

# b. CHANGELOG.md footer
python3 "$FOOTER_SCRIPT" "$TAP_CHANGELOG" "$CUR_VERSION" "$NEW_VERSION"

echo "  CHANGELOG.md: footer updated."

# c. VERSION
echo "$NEW_VERSION" > "${TAP_VERSION_FILE}"
echo "  VERSION: ${CUR_VERSION} -> ${NEW_VERSION}"

# d. Formula/aiteamforge.rb — two sed expressions
cd "${TAP_DIR}"

sed -i.bak -E "s/tag: \"v[0-9]+\.[0-9]+\.[0-9]+\"/tag: \"v${NEW_VERSION}\"/" Formula/aiteamforge.rb
sed -i.bak2 -E "s/^([[:space:]]*)version \"[0-9]+\.[0-9]+\.[0-9]+\"/\1version \"${NEW_VERSION}\"/" Formula/aiteamforge.rb
rm -f Formula/aiteamforge.rb.bak Formula/aiteamforge.rb.bak2

# Verify updated lines.
# || true guards: grep returns nonzero on no-match; set -e would abort without it.
# The standalone version line is optional (removed in XACA-0394); tag is required.
FORMULA_TAG_AFTER="$(grep -oE 'tag: "v[0-9]+\.[0-9]+\.[0-9]+"' Formula/aiteamforge.rb | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
FORMULA_VER_AFTER="$(grep -oE '^[[:space:]]*version "[0-9]+\.[0-9]+\.[0-9]+"' Formula/aiteamforge.rb | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"

if [ "$FORMULA_TAG_AFTER" != "$NEW_VERSION" ]; then
  echo "Error: Formula tag not updated correctly — got '${FORMULA_TAG_AFTER}', expected '${NEW_VERSION}'." >&2
  exit 1
fi
# Only enforce version line when it exists (it was removed in XACA-0394).
if [ -n "$FORMULA_VER_AFTER" ] && [ "$FORMULA_VER_AFTER" != "$NEW_VERSION" ]; then
  echo "Error: Formula version not updated correctly — got '${FORMULA_VER_AFTER}', expected '${NEW_VERSION}'." >&2
  exit 1
fi

echo "  Formula/aiteamforge.rb: tag and version -> ${NEW_VERSION}"

cd "${OUTER_DIR}"

echo ""
echo "=== Phase 1 complete. ==="
echo ""

# ─── phase 2: tap inner commit + tag + push ──────────────────────────────────

echo "=== Phase 2: Tap inner commit + tag ==="
echo ""

git -C "${TAP_DIR}" add CHANGELOG.md VERSION Formula/aiteamforge.rb

# Verify staged
STAGED="$(git -C "${TAP_DIR}" diff --cached --name-only)"
STAGED_OK=0
grep -q "CHANGELOG.md" <<<"$STAGED" && grep -q "VERSION" <<<"$STAGED" && grep -q "Formula/aiteamforge.rb" <<<"$STAGED" && STAGED_OK=1

if [ "$STAGED_OK" -eq 0 ]; then
  echo "Error: expected CHANGELOG.md, VERSION, and Formula/aiteamforge.rb to be staged. Got:" >&2
  echo "$STAGED" >&2
  exit 1
fi

# XACA-1112: when preflight #9's TAP-AHEAD block was waived via
# --tap-ahead-release, record it as a trailer on BOTH release commits — this
# IS the decay detector the design calls for: waiver usage is only auditable
# if it survives in git history, not just in a terminal that already scrolled
# away. The gate-safe subject line itself is UNCHANGED (tap-changelog-
# completeness's skip filter matches the subject only; the trailer lives in
# the body and cannot break that match).
if [ "$TAP_AHEAD_WAIVED" -eq 1 ]; then
  git -C "${TAP_DIR}" commit \
    -m "chore: Release AITeamForge ${NEW_VERSION}" \
    -m "Tap-Ahead-Release: ${TAP_AHEAD_RELEASE_REASON}"
else
  git -C "${TAP_DIR}" commit -m "chore: Release AITeamForge ${NEW_VERSION}"
fi
TAP_COMMIT_SHA="$(git -C "${TAP_DIR}" rev-parse HEAD)"
echo "  Committed: ${TAP_COMMIT_SHA} (chore: Release AITeamForge ${NEW_VERSION})"

git -C "${TAP_DIR}" tag "v${NEW_VERSION}"
echo "  Tagged: v${NEW_VERSION}"

if [ "$NO_PUSH" -eq 0 ]; then
  echo "  Pushing tap main..."
  # XACA-1170-026: identify this push as a sanctioned release cut to the tap's
  # single-writer pre-push hook. Scoped to THIS command only (env prefix, never
  # `export`) so a later hand push in the same shell is still refused. The tag push
  # below needs nothing: the hook only guards refs/heads/main.
  #
  # XACA-1170-003: tap_authed_git runs the push as the aiteamforge-release App
  # (identity validated before the lock, token minted after it; see tap_release_identity_prepare/_mint), to an
  # explicit URL in app mode — so refresh the tracking ref by hand afterwards.
  TAP_SINGLE_WRITER_RELEASE=1 tap_authed_git -C "${TAP_DIR}" push "${TAP_PUSH_TARGET}" main
  git -C "${TAP_DIR}" update-ref refs/remotes/origin/main HEAD
  echo "  Pushing tap tag v${NEW_VERSION}..."
  tap_authed_git -C "${TAP_DIR}" push "${TAP_PUSH_TARGET}" "v${NEW_VERSION}"
  echo "  Tap push complete."
else
  echo "  (Skipping push — --no-push)"
fi

echo ""
echo "=== Phase 2 complete. ==="
echo ""

# ─── phase 3: outer pointer bump ─────────────────────────────────────────────

echo "=== Phase 3: Outer submodule pointer bump ==="
echo ""

git add homebrew-tap

# Verify staged
OUTER_STAGED="$(git diff --cached --name-only)"
if grep -q "homebrew-tap" <<<"$OUTER_STAGED"; then
  echo "  Staged: homebrew-tap submodule pointer."
else
  echo "Error: homebrew-tap not staged after 'git add homebrew-tap'." >&2
  exit 1
fi

if [ "$TAP_AHEAD_WAIVED" -eq 1 ]; then
  git commit \
    -m "chore: Bump homebrew-tap submodule to v${NEW_VERSION}" \
    -m "Tap-Ahead-Release: ${TAP_AHEAD_RELEASE_REASON}"
else
  git commit -m "chore: Bump homebrew-tap submodule to v${NEW_VERSION}"
fi
OUTER_COMMIT_SHA="$(git rev-parse HEAD)"
echo "  Committed: ${OUTER_COMMIT_SHA} (chore: Bump homebrew-tap submodule to v${NEW_VERSION})"

if [ "$NO_PUSH" -eq 0 ]; then
  echo "  Pushing outer develop to ${OUTER_REMOTE} (as the human admin — develop's ruleset bypasses admins, not the release App)..."
  git push "${OUTER_REMOTE}" develop
  echo "  Outer push complete."
else
  echo "  (Skipping push — --no-push)"
fi

echo ""
echo "=== Phase 3 complete. ==="
echo ""

# ─── success banner ──────────────────────────────────────────────────────────

if [ "$NO_PUSH" -eq 0 ]; then
  PUSHED_NOTE="pushed"
else
  PUSHED_NOTE="local only (--no-push)"
  # XACA-1122-008: --no-push writes nothing to any remote, so it takes no lock.
  # Say so, because the human push that follows is NOT covered by one and can
  # interleave with a publisher run.
  echo ""
  echo "  NOTE: --no-push took no tap-writer lock (nothing was pushed)."
  echo "        The manual push you run next is NOT serialized against the"
  echo "        post-merge publisher. Check first:"
  echo "            scripts/kb-tap-lock.sh status"
fi

echo "Released v${NEW_VERSION}"
echo ""
echo "  Tap commit:    ${TAP_COMMIT_SHA}  on main"
echo "  Tap tag:       v${NEW_VERSION} (${PUSHED_NOTE})"
echo "  Outer commit:  ${OUTER_COMMIT_SHA}  on develop (${PUSHED_NOTE})"
echo ""
echo "  Compare: https://github.com/DoubleNode/homebrew-aiteamforge/compare/v${CUR_VERSION}...v${NEW_VERSION}"
