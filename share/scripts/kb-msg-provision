#!/usr/bin/env python3
"""
kb-msg-provision — Tier-2 provisioning for the kb-msg comms channel (XACA-0885-002).

XACA-0777 shipped every Tier-2 artifact and nothing ever turned them on:
nothing invokes vault-keygen, and nothing writes ~/.aiteamforge/team-machines.json.
kb-msg's cross-machine path therefore fails closed on every box in the fleet.
This provisions both, idempotently, on dev machines and tap consumers alike.

WHAT THIS DOES NOT DO — and why that is deliberate
--------------------------------------------------
It does not invent a team -> machine mapping for teams it cannot see.

The subitem this implements says "generate team-machines.json from the fleet
topology". There is no fleet topology to read. `POST /api/team-register` carries
no machine identifier, `GET /api/registered-teams` returns none, and the server's
`machines` map (keyed by hostname) is never joined to `registeredTeams`. The
mapping has never existed anywhere in the system, locally or server-side.

What a machine CAN state authoritatively is which teams live on itself. So this
maps every locally-present team to this machine and leaves every other entry
exactly as found. A team we cannot see is recorded as unknown, never guessed:
a wrong mapping routes mail to the wrong box and fails there, which is strictly
worse than the current honest fail-closed error.

Closing the remote half needs `machineId` threaded through team-register ->
registered-teams. That is a server change, tracked separately.

Usage:
    kb-msg-provision [--check] [--dry-run] [--no-keygen]
                     [--server <url>] [--machine-id <slug>] [--quiet]

Exit codes:
    0  provisioned (or already provisioned) / --check found everything
    1  --check found a gap, or provisioning failed
    2  environment problem (node missing, vault-keygen.js not found, unreadable map)
"""

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse

TEAM_PATHS = os.path.expanduser("~/.aiteamforge/team-paths.json")
TEAM_MACHINES = os.path.expanduser("~/.aiteamforge/team-machines.json")
BACKUP_SUFFIX = ".pre-kb-msg-provision.bak"


def _die_env(msg):
    print("kb-msg-provision: %s" % msg, file=sys.stderr)
    raise SystemExit(2)


def _notice(msg):
    """Module-level operator notice.

    main()'s `say` is a CLOSURE over `args` and does not exist outside it;
    calling it from a module-level helper raises NameError and prints a raw
    traceback -- which is what happened the first time this notice was added.
    Goes to stderr so it cannot corrupt anything parsing stdout.
    """
    print("kb-msg-provision: %s" % msg, file=sys.stderr)


# ── Locating the authority ───────────────────────────────────────────────────
# vault-keygen.js is the ONLY correct source for the machine slug. Three other
# derivations exist in this tree; measured on M3Pro 2026-08-24, fleet-reporter.sh
# and timepad_config.py agree with it (darren-m3pro) while claude_code_cc_aliases.sh
# diverges to darren-m3pro-local by keeping the ".local" mDNS suffix this strips.
# A fourth reimplementation here would be a fourth chance to drift, so we require()
# the real module instead.
#
# Two layouts, and the consumer one is not merely a different prefix: the tap
# ships vault-keygen.js as a NON-EXECUTABLE datafile with no shebang and does not
# ship vault-keygen.sh at all. There is no wrapper to invoke on a consumer, which
# is why everything below drives node against the .js directly.
def _locate_keygen():
    base = os.environ.get("AITEAMFORGE_DIR") or os.path.expanduser("~/dev-team")
    candidates = [
        os.path.join(base, "fleet-monitor", "client", "vault-keygen.js"),  # dev repo
        os.path.join(base, "scripts", "vault-keygen.js"),                  # tap consumer
        os.path.expanduser("~/aiteamforge/scripts/vault-keygen.js"),       # default consumer root
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    _die_env(
        "vault-keygen.js not found. Looked in:\n  " + "\n  ".join(candidates)
        + "\n  Set AITEAMFORGE_DIR to the install root and retry."
    )


def _node(keygen_js, expr):
    """Evaluate `expr` with the vault-keygen module bound to `kg`."""
    if not shutil.which("node"):
        _die_env("node not found on PATH. Install Node.js >= 18 and retry.")
    script = "const kg=require(%s); %s" % (json.dumps(keygen_js), expr)
    try:
        out = subprocess.run(["node", "-e", script], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        _die_env("node timed out resolving the machine slug")
    if out.returncode != 0:
        _die_env("node failed: %s" % (out.stderr.strip() or "unknown error"))
    return out.stdout.strip()


def machine_slug(keygen_js, override=None):
    if override:
        return override
    if os.environ.get("AITEAMFORGE_MACHINE_ID"):
        return os.environ["AITEAMFORGE_MACHINE_ID"]
    return _node(keygen_js, "process.stdout.write(kg.defaultMachineSlug())")


def has_private_key(keygen_js, slug):
    val = _node(keygen_js, "process.stdout.write(String(kg.privateKeyExists(%s)))" % json.dumps(slug))
    return val == "true"



FLEET_CONFIG = os.path.expanduser("~/.aiteamforge/fleet-config.json")


def _carries_secret(value):
    """Does this --server value look like it embeds a credential?

    THE single predicate, used by the refusal. It stays deliberately literal:
    its job is to REFUSE, and refusing too much is cheap.
    """
    return "@" in value


def _describe_value(value):
    """Describe a --server value's SHAPE without ever reproducing it.

    Five rounds of this PR tried to answer "is this value safe to echo?" --
    first for user info, then for delimiter-reclassified user info, then for a
    query on a scheme-less value, then with a character allowlist. Every answer
    was wrong for some shape, and the last one was defeated by a JWT (which is
    just dots and base64url, indistinguishable from a host name by pattern) and
    by a fullwidth "@" homoglyph, which carries no ASCII "@" at all.

    The question was the defect. A message that never reproduces the value
    cannot leak it, whatever shape arrives -- so the value is described instead
    of quoted. Length, scheme presence and segment count are what an operator
    needs to see that their input was malformed; the bytes themselves add
    nothing the operator does not already have, and are the only part that can
    disclose a secret.
    """
    facts = ["%d characters" % len(value)]
    if "://" in value:
        facts.append("has a '://' separator")
    else:
        facts.append("no '://' separator")
    dots = value.count(".")
    if dots:
        facts.append("%d dot-separated segment(s)" % (dots + 1))
    for ch, name in (("@", "'@'"), ("?", "a query"), ("#", "a fragment")):
        if ch in value:
            facts.append("contains %s" % name)
    if not value:
        facts = ["empty"]
    return "<%s>" % ", ".join(facts)


def _relay_endpoint(server):
    """Build the <base>/api/status endpoint from a user-supplied --server value.

    This was `server.rstrip("/") + "/api/status"`, which is string concatenation
    applied to a STRUCTURED value. A URL carrying a query string or fragment --
    "https://fm.example.com/?token=x" -- produced
    "https://fm.example.com/?token=x/api/status": the path is appended INSIDE the
    query, so the request never reaches /api/status and the config records an
    endpoint that cannot work. It fails at first use, far from the provisioning
    run that wrote it.

    Parse, discard query/fragment (an API base carries neither), and join on the
    path component, so the result is well-formed for any input shape.
    """
    shown = _describe_value(server)
    try:
        parsed = urllib.parse.urlsplit(server)
    except ValueError:
        # urlsplit itself raises for a netloc that fails NFKC normalisation --
        # e.g. a fullwidth "＠" homoglyph -- and its ValueError message EMBEDS
        # THE RAW NETLOC. Uncaught, that printed the credential in a traceback
        # at exit 1, entirely outside this module's own messages. str(exc) is
        # deliberately NOT included below for the same reason.
        _die_env(
            "--server is not a parsable URL %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    if not parsed.scheme or not parsed.netloc:
        _die_env(
            "--server must be an absolute URL with a scheme and host %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    # Refuse embedded credentials rather than writing them to disk in the clear.
    # urlsplit preserves "user:pass@host" faithfully, so the naive thing is to
    # persist it verbatim into fleet-config.json -- a plaintext secret the
    # operator never chose to store and is not told about. Stripping it silently
    # is worse than refusing: the endpoint would still be well-formed and would
    # still be WRONG for a relay that actually needs those credentials, failing
    # later with an auth error that points nowhere near this line. Auth belongs
    # in the config's own token field, not in the URL.
    # Check the RAW string, not urlsplit's derived fields. urlsplit terminates
    # netloc at the first "/", "?" or "#", so a password containing any of them
    # is reclassified: "https://user:p/w0rd@host" parses as netloc "user:p" with
    # the rest in path, and .username/.password both come back None -- the
    # credential branch never fires. The "/" form then survives into the config,
    # because path is the one component this function keeps. Measured: it
    # persisted "https://user:p/w0rd@host/api/status" to disk. The "?" and "#"
    # forms are worse in a different way -- they persist "https://user:p", so
    # the recorded host IS the username fragment.
    #
    # No parse-based rule can be trusted here, because the parse is what the
    # attack manipulates. Any "@" at all is refused instead: an operator-supplied
    # API base has no legitimate use for one, and over-refusing costs a retype
    # while under-refusing writes a secret to disk.
    #
    # Note this refusal cannot catch a fullwidth "＠" homoglyph -- and does not
    # need to. Detection and disclosure were decoupled when the value stopped
    # being echoed at all: a shape this predicate misses is still never
    # reproduced in any message, so a miss costs a confusing refusal rather
    # than a leaked credential.
    if _carries_secret(server):
        _die_env(
            "--server must not embed credentials (value contains %r).\n"
            "  It would be written to %s in plaintext.\n"
            "  Pass the bare URL and configure authentication separately."
            % ("@", FLEET_CONFIG)
        )
    # The urlsplit-based check that used to sit here is GONE, not merely
    # redundant: it is unreachable behind _carries_secret (any value with
    # user info contains "@"), and it was the check that failed when a
    # delimiter in the password reclassified the parse. Keeping a weaker
    # duplicate of a rule invites a future edit to "simplify" onto the wrong one.
    # REVIEW-GATE FINDING XACA-0885-050. Discarding these silently is
    # inconsistent with refusing credentials in the userinfo: "?token=..." is the
    # same class of secret, handled the opposite way, and the operator was told
    # nothing either time. Say what was dropped -- never its value, which may be
    # the token itself.
    dropped = [n for n, v in (("query", parsed.query), ("fragment", parsed.fragment)) if v]
    if dropped:
        _notice(
            "discarding the %s from --server; an API base carries neither.\n"
            "  If that carried an auth token, configure authentication"
            " separately — it was NOT recorded and will not be used."
            % " and ".join(dropped)
        )
    path = parsed.path.rstrip("/") + "/api/status"
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, path, "", ""))


def _write_json_atomic(path, data, what):
    """Guarded atomic JSON write with a one-time backup. THE only write path here.

    Both writers in this file previously open-coded the same four-step sequence
    (makedirs / copy2 / mkstemp / replace), and every fix so far patched one
    instance at a time. A file-wide audit found FOUR unguarded sites across the
    two functions -- including an `os.makedirs` sitting one line above the two
    lines a previous round had just guarded. Patching instances is what produced
    that; the sequence is now written once and shared, so a future writer cannot
    reintroduce the class by forgetting a step.

    Guarantees, uniformly:
      * every OSError becomes this file's exit-2 refusal, never a raw traceback
      * the backup is written ONCE -- a second run must not overwrite the true
        original with post-first-run state
      * a failed write leaves the target untouched and removes the temp file
    """
    parent = os.path.dirname(path) or "."
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        _die_env("cannot create %s: %s\n  Nothing was changed." % (parent, exc))

    bak = path + BACKUP_SUFFIX
    if os.path.exists(path) and not os.path.exists(bak):
        try:
            shutil.copy2(path, bak)
        except OSError as exc:
            _die_env("cannot write %s: %s\n"
                     "  The directory is not writable; nothing was changed." % (bak, exc))

    try:
        fd, tmp = tempfile.mkstemp(dir=parent, prefix=".%s-" % what, suffix=".json")
    except OSError as exc:
        _die_env("cannot write %s: %s\n"
                 "  The directory is not writable; nothing was changed." % (path, exc))

    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(json.dumps(data, indent=2, sort_keys=True))
            fh.write("\n")
        os.replace(tmp, path)
    except OSError as exc:
        if os.path.exists(tmp):
            os.unlink(tmp)
        _die_env("cannot write %s: %s\n  Nothing was changed." % (path, exc))
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def persist_relay_url(server):
    """Record the relay URL where BOTH kb-msg and fleet-reporter already look.

    Generating a keypair against --server but not recording it left the send
    path unconfigured: msg-client defaults to http://localhost:3000, so every
    cross-machine send failed as "fetch failed" on a machine that had just been
    provisioned successfully. Provisioning that leaves the feature unusable is
    the exact failure XACA-0885 exists to remove, one layer up.

    Writes .centralServer.apiEndpoint -- the same key fleet-reporter reads -- and
    MERGES into any existing config rather than replacing it.
    Returns (changed, previous).
    """
    # The documented shape is "<base>/api/status" — see
    # config/templates/fleet-config.client.example.json and
    # fleet-reporter.sh:82's default. fleet-reporter POSTs status to this
    # exact value and derives its relay base by stripping /api/*, so a bare
    # "<base>/api" would both break its posting AND fail that strip.
    endpoint = _relay_endpoint(server)
    data = {}
    if os.path.isfile(FLEET_CONFIG):
        try:
            data = json.load(open(FLEET_CONFIG))
        except ValueError as exc:
            _die_env(
                "%s is not valid JSON (%s).\n"
                "  Refusing to rewrite it -- fix it by hand, then re-run."
                % (FLEET_CONFIG, exc)
            )
        if not isinstance(data, dict):
            _die_env("%s is not a JSON object; refusing to rewrite." % FLEET_CONFIG)
    central = data.get("centralServer")
    if not isinstance(central, dict):
        central = {}
    previous = central.get("apiEndpoint")
    if previous == endpoint:
        return False, previous
    central["apiEndpoint"] = endpoint
    data["centralServer"] = central
    _write_json_atomic(FLEET_CONFIG, data, "fleet-config")
    return True, previous


# ── Template/instance aliases ────────────────────────────────────────────────
# MIRROR of _kb_template_to_instance / _kb_instance_to_template in
# kanban-helpers.sh (~1840, XACA-0576). Keep the three cases in lock-step; that
# function's own comment already records one mirror in kanban-paths.sh, and this
# is a second, for the same reason (Python here, and the tap installs standalone
# and cannot source dev-team helpers at runtime).
#
# This is NOT cosmetic. team-paths.json keys personal-org teams by their INSTANCE
# id (`medical-general`), while kb-msg addresses them by their TEMPLATE id
# (`medical`) — `_kb_msg_resolve_machine` looks up whatever string the sender
# typed. Writing only the instance form produces a routing map that resolves for
# no one: provisioning reports success, the file looks correct, and
# `kb-msg send medical "..."` still dies with "cannot resolve which machine".
# Caught by probing the real send path before writing, not by reading the code.
# Both forms are emitted so a lookup by either id succeeds, matching the
# bidirectional intent the helper pair documents.
INSTANCE_TO_TEMPLATE = {
    "finance-personal":  "finance",
    "legal-coparenting": "legal",
    "medical-general":   "medical",
}


def with_aliases(teams):
    """Every id a sender might legitimately use for these teams."""
    out = list(teams)
    for t in teams:
        alias = INSTANCE_TO_TEMPLATE.get(t)
        if alias and alias not in out:
            out.append(alias)
    return sorted(out)


# ── Local team discovery ─────────────────────────────────────────────────────
def local_teams():
    """Teams this machine can speak for: those whose kanban_dir is present here.

    Returns (local, unknown). `unknown` is NOT "remote" — it is "this machine
    cannot tell", which is exactly why we refuse to write a mapping for them.
    """
    if not os.path.isfile(TEAM_PATHS):
        _die_env("%s not found — cannot determine which teams live here." % TEAM_PATHS)
    try:
        data = json.load(open(TEAM_PATHS))
    except ValueError as exc:
        _die_env("%s is not valid JSON (%s)" % (TEAM_PATHS, exc))
    teams = data.get("teams") or {}
    local, unknown = [], []
    for name, cfg in teams.items():
        kd = os.path.expanduser((cfg or {}).get("kanban_dir") or "")
        # Gate on the BOARD FILE, not merely the directory.
        #
        # Directory existence is a bad proxy for "this team lives here": the
        # framework's team-init guard auto-recreates an EMPTY kanban skeleton
        # shortly after one is removed. Observed 2026-08-24 — legal-coparenting
        # and finance-personal were archived and deleted after moving to M4Mini,
        # and both directories were back (0 files, no board) 12 minutes later.
        # A dir-only check called them local again and would have silently
        # reverted their routing from darren-m4-mini back to this machine,
        # sending their mail to a box that no longer holds them.
        #
        # A board file is what a team actually IS here; an empty skeleton is not.
        # "*-board.json", not "*board*.json": the latter is an unanchored
        # substring and matches dashboard.json, which is not a board at all
        # (review finding, PR #764). Real boards are all "<team>-board.json".
        has_board = bool(glob.glob(os.path.join(kd, "*-board.json"))) if kd else False
        (local if has_board else unknown).append(name)
    return sorted(local), sorted(unknown)


# ── team-machines.json ───────────────────────────────────────────────────────
def load_map():
    if not os.path.isfile(TEAM_MACHINES):
        return {}, False
    try:
        data = json.load(open(TEAM_MACHINES))
    except ValueError as exc:
        # Never silently rebuild: an operator-maintained remote mapping is the
        # only record of where other machines are, and it cannot be regenerated.
        _die_env(
            "%s is not valid JSON (%s).\n"
            "  Refusing to rewrite it — fix it by hand, then re-run." % (TEAM_MACHINES, exc)
        )
    if not isinstance(data, dict):
        _die_env("%s is not a JSON object; refusing to rewrite." % TEAM_MACHINES)
    return data, True


def write_map(data):
    """Persist the routing map. Uses the shared guarded writer (see
    _write_json_atomic) -- this function previously open-coded the same sequence
    with THREE unguarded steps, found by a file-wide audit after the sibling
    site was fixed. Fixing one side of a matched pair and leaving the other is
    how this class of bug survives."""
    _write_json_atomic(TEAM_MACHINES, data, "team-machines")


def merge_local(existing, teams, slug):
    """Assert `slug` for local teams. Returns (merged, added, retargeted).

    Entries for teams not in `teams` are carried through untouched — those are
    the operator's remote mappings and this machine has no standing to edit them.
    """
    merged = dict(existing)
    added, retargeted = [], []
    for t in teams:
        cur = merged.get(t)
        if cur == slug:
            continue
        if cur is None:
            added.append(t)
        else:
            retargeted.append((t, cur))
        merged[t] = slug
    return merged, added, retargeted


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--check", action="store_true", help="Report state; never write. Exit 1 on a gap.")
    ap.add_argument("--dry-run", action="store_true", help="Show what would change; never write.")
    ap.add_argument("--no-keygen", action="store_true", help="Do not generate a keypair if absent.")
    ap.add_argument("--server", default=None, help="Fleet Monitor URL for key registration.")
    ap.add_argument("--machine-id", default=None, help="Override the machine slug.")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    def say(msg=""):
        if not args.quiet:
            print(msg)

    keygen_js = _locate_keygen()
    if args.server and not (args.check or args.dry_run):
        changed, prev = persist_relay_url(args.server)
        if changed:
            say("  Recorded relay URL in %s%s"
                % (FLEET_CONFIG, "" if prev is None else " (was %s)" % prev))
    slug = machine_slug(keygen_js, args.machine_id)
    have_key = has_private_key(keygen_js, slug)
    loc, unknown = local_teams()
    loc = with_aliases(loc)   # template ids too, or kb-msg looks up a name we never wrote
    existing, map_existed = load_map()
    merged, added, retargeted = merge_local(existing, loc, slug)

    say("kb-msg provisioning")
    say("  machine slug : %s" % slug)
    say("  keygen       : %s" % keygen_js)
    say("  vault key    : %s" % ("present" if have_key else "ABSENT"))
    say("  local teams  : %d (%s)" % (len(loc), ", ".join(loc) or "none"))
    if unknown:
        say("  unmapped     : %d (%s)" % (len(unknown), ", ".join(unknown)))
        say("                 not assumed remote — left untouched, see module docstring")
    say("  routing map  : %s" % (TEAM_MACHINES if map_existed else "ABSENT"))

    if args.check:
        gaps = []
        if not have_key:
            gaps.append("no vault keypair for '%s' (run: kb-msg-provision)" % slug)
        if not map_existed:
            gaps.append("no %s" % TEAM_MACHINES)
        missing = [t for t in loc if existing.get(t) != slug]
        if missing:
            gaps.append("%d local team(s) unmapped or mis-targeted: %s" % (len(missing), ", ".join(missing)))
        if gaps:
            say("\n  GAPS:")
            for g in gaps:
                say("    - %s" % g)
            return 1
        say("\n  All Tier-2 provisioning present.")
        return 0

    # ── keypair ──
    if not have_key and not args.no_keygen:
        if args.dry_run:
            say("\n  [dry-run] would generate a vault keypair for '%s'" % slug)
        else:
            say("\n  Generating vault keypair for '%s'..." % slug)
            cmd = ["node", keygen_js, "--machine-id", slug]
            if args.server:
                cmd += ["--server", args.server]
            rc = subprocess.run(cmd).returncode
            if rc != 0:
                print("kb-msg-provision: vault-keygen failed (exit %d). Routing map not written."
                      % rc, file=sys.stderr)
                return 1
            have_key = has_private_key(keygen_js, slug)
    elif not have_key:
        say("\n  Skipping keypair generation (--no-keygen). Tier 2 stays unavailable.")

    # ── routing map ──
    if not added and not retargeted:
        say("  Routing map already correct for every local team — no change.")
        return 0

    if args.dry_run:
        say("\n  [dry-run] would write %s" % TEAM_MACHINES)
        for t in added:
            say("    + %s -> %s" % (t, slug))
        for t, was in retargeted:
            say("    ~ %s -> %s (was %s)" % (t, slug, was))
        return 0

    # No try/except here. This previously caught `Exception`, which became DEAD
    # CODE when both writers moved onto _write_json_atomic: that helper reports
    # every failure via _die_env, which raises SystemExit(2) — a BaseException,
    # not an Exception, so the handler could never fire (review finding, PR #764).
    # Leaving it would tell the next reader that write_map failures are handled
    # here, and they are not; they exit 2 from inside the helper.
    write_map(merged)

    say("\n  Wrote %s" % TEAM_MACHINES)
    for t in added:
        say("    + %s -> %s" % (t, slug))
    for t, was in retargeted:
        say("    ~ %s -> %s (was %s)" % (t, slug, was))
    return 0


if __name__ == "__main__":
    sys.exit(main())
