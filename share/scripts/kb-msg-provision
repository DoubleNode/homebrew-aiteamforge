#!/usr/bin/env python3
"""
kb-msg-provision — Tier-2 provisioning for the kb-msg comms channel (XACA-0885-002).

XACA-0777 shipped every Tier-2 artifact and nothing ever turned them on:
nothing invokes vault-keygen, and nothing writes ~/.aiteamforge/team-machines.json.
kb-msg's cross-machine path therefore fails closed on every box in the fleet.
This provisions both, idempotently, on dev machines and tap consumers alike.

WHAT THIS DOES NOT DO — and why that is deliberate
--------------------------------------------------
It does not invent a team -> machine mapping for teams it cannot see.

The subitem this implements says "generate team-machines.json from the fleet
topology". There is no fleet topology to read. `POST /api/team-register` carries
no machine identifier, `GET /api/registered-teams` returns none, and the server's
`machines` map (keyed by hostname) is never joined to `registeredTeams`. The
mapping has never existed anywhere in the system, locally or server-side.

What a machine CAN state authoritatively is which teams live on itself. So this
maps every locally-present team to this machine and leaves every other entry
exactly as found. A team we cannot see is recorded as unknown, never guessed:
a wrong mapping routes mail to the wrong box and fails there, which is strictly
worse than the current honest fail-closed error.

Closing the remote half needs `machineId` threaded through team-register ->
registered-teams. That is a server change, tracked separately.

Usage:
    kb-msg-provision [--check] [--dry-run] [--no-keygen]
                     [--server <url>] [--machine-id <slug>] [--quiet]
    kb-msg-provision --add-team <team-id> [--unattended] [--quiet]
    kb-msg-provision --unattended [--server <url>] [--quiet]

UNATTENDED CALLERS (XACA-1078) — the contract in one place
------------------------------------------------------------
The two forms above exist for callers that are NOT an operator typing a
command: `kb-init-team` at team birth, and the tap install/upgrade path at
machine provisioning. Full contract:
kanban/plans/XACA-1078/XACA-1078_msg_routing_provisioning.md, section
"The Unattended-Write Contract".

`--add-team <team-id>` — NARROW ADDITIVE single-team assertion. Bypasses the
whole-registry local_teams() re-derivation entirely and resolves exactly the
named team (plus its with_aliases() template/instance counterpart). Implies
--unattended and --no-keygen; mutually exclusive with --server (an
unattended team-birth site never mints machine identity or config — that is
machine provisioning, not a side effect of adding one team). Preconditions
(each a DECLINE — exit 1, nothing written — when unmet): the team is present
in team-paths.json and is not board_less/alias_of; its primary_host, if
declared, equals this machine's slug; a *-board.json exists under its
kanban_dir on this machine. Write rule is add-only: an absent key is added,
an already-correct key is a no-op, and a key naming another machine is
declined with both values reported — never retargeted.

`--unattended` — mode flag, valid with or without --add-team. Never reads
stdin, never prompts. Its most important effect is a WRITE-SIDE invariant:
the resulting map must be a pure superset of the map that was read. If the
write would retarget even one existing key, the ENTIRE write is refused
(exit 1) — not partially applied. This is validated at the write, not at
classification, so it catches a bad classification from any tier, including
one that does not exist yet. In a FULL run (no --add-team), it additionally
excludes tier-4-only classifications (the board-file bootstrap fallback —
inference about a team this run is not itself creating) from the write set
and reports them under a `deferred:` heading, alongside the existing
`unmapped:` and `foreign:` reports. Keypair generation, if attempted, runs
non-interactively (stdin closed) or is skipped and reported — it never
blocks.

NAMING: this flag is deliberately NOT called --non-interactive, even though
kb-init-team has a flag by that name. kb-init-team's --non-interactive means
"fail instead of prompting" — prompt-suppression only. --unattended does
that too, but it ALSO changes what this tool is permitted to WRITE (the
superset invariant above). A reader who assumed the two names were
synonyms would be wrong about the safety-critical half, so they stay
distinct on purpose.

Exit codes (unchanged in meaning for every invocation shape above):
    0  provisioned (or already provisioned) / --check found everything
    1  --check found a gap, or provisioning declined (retarget attempt,
       --add-team precondition unmet, --add-team key conflict)
    2  environment problem (node missing, vault-keygen.js not found, unreadable map)
"""

import argparse
import glob
import ipaddress
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.parse

TEAM_PATHS = os.path.expanduser("~/.aiteamforge/team-paths.json")
TEAM_MACHINES = os.path.expanduser("~/.aiteamforge/team-machines.json")
BACKUP_SUFFIX = ".pre-kb-msg-provision.bak"


def _die_env(msg):
    print("kb-msg-provision: %s" % msg, file=sys.stderr)
    raise SystemExit(2)


def _notice(msg):
    """Module-level operator notice.

    main()'s `say` is a CLOSURE over `args` and does not exist outside it;
    calling it from a module-level helper raises NameError and prints a raw
    traceback -- which is what happened the first time this notice was added.
    Goes to stderr so it cannot corrupt anything parsing stdout.
    """
    print("kb-msg-provision: %s" % msg, file=sys.stderr)


# ── Locating the authority ───────────────────────────────────────────────────
# vault-keygen.js is the ONLY correct source for the machine slug. Three other
# derivations exist in this tree; measured on M3Pro 2026-08-24, fleet-reporter.sh
# and timepad_config.py agree with it (darren-m3pro) while claude_code_cc_aliases.sh
# diverges to darren-m3pro-local by keeping the ".local" mDNS suffix this strips.
# A fourth reimplementation here would be a fourth chance to drift, so we require()
# the real module instead.
#
# Two layouts, and the consumer one is not merely a different prefix: the tap
# ships vault-keygen.js as a NON-EXECUTABLE datafile with no shebang and does not
# ship vault-keygen.sh at all. There is no wrapper to invoke on a consumer, which
# is why everything below drives node against the .js directly.
def _locate_keygen():
    base = os.environ.get("AITEAMFORGE_DIR") or os.path.expanduser("~/dev-team")
    candidates = [
        os.path.join(base, "fleet-monitor", "client", "vault-keygen.js"),  # dev repo
        os.path.join(base, "scripts", "vault-keygen.js"),                  # tap consumer
        os.path.expanduser("~/aiteamforge/scripts/vault-keygen.js"),       # default consumer root
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    _die_env(
        "vault-keygen.js not found. Looked in:\n  " + "\n  ".join(candidates)
        + "\n  Set AITEAMFORGE_DIR to the install root and retry."
    )


def _node(keygen_js, expr):
    """Evaluate `expr` with the vault-keygen module bound to `kg`."""
    if not shutil.which("node"):
        _die_env("node not found on PATH. Install Node.js >= 18 and retry.")
    script = "const kg=require(%s); %s" % (json.dumps(keygen_js), expr)
    try:
        out = subprocess.run(["node", "-e", script], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        _die_env("node timed out resolving the machine slug")
    if out.returncode != 0:
        _die_env("node failed: %s" % (out.stderr.strip() or "unknown error"))
    return out.stdout.strip()


def machine_slug(keygen_js, override=None):
    if override:
        return override
    if os.environ.get("AITEAMFORGE_MACHINE_ID"):
        return os.environ["AITEAMFORGE_MACHINE_ID"]
    return _node(keygen_js, "process.stdout.write(kg.defaultMachineSlug())")


def has_private_key(keygen_js, slug):
    val = _node(keygen_js, "process.stdout.write(String(kg.privateKeyExists(%s)))" % json.dumps(slug))
    return val == "true"



FLEET_CONFIG = os.path.expanduser("~/.aiteamforge/fleet-config.json")


def _carries_secret(value):
    """Does this --server value look like it embeds a credential?

    THE single predicate, used by the refusal. It stays deliberately literal:
    its job is to REFUSE, and refusing too much is cheap.
    """
    return "@" in value


def _describe_value(value):
    """Describe a --server value's SHAPE without ever reproducing it.

    Five rounds of this PR tried to answer "is this value safe to echo?" --
    first for user info, then for delimiter-reclassified user info, then for a
    query on a scheme-less value, then with a character allowlist. Every answer
    was wrong for some shape, and the last one was defeated by a JWT (which is
    just dots and base64url, indistinguishable from a host name by pattern) and
    by a fullwidth "@" homoglyph, which carries no ASCII "@" at all.

    The question was the defect. A message that never reproduces the value
    cannot leak it, whatever shape arrives -- so the value is described instead
    of quoted. Length, scheme presence and segment count are what an operator
    needs to see that their input was malformed; the bytes themselves add
    nothing the operator does not already have, and are the only part that can
    disclose a secret.
    """
    facts = ["%d characters" % len(value)]
    if "://" in value:
        facts.append("has a '://' separator")
    else:
        facts.append("no '://' separator")
    dots = value.count(".")
    if dots:
        facts.append("%d dot-separated segment(s)" % (dots + 1))
    for ch, name in (("@", "'@'"), ("?", "a query"), ("#", "a fragment")):
        if ch in value:
            facts.append("contains %s" % name)
    # REVIEW-GATE FINDING XACA-0885-056. Not echoing the value costs one real
    # diagnostic: a pasted token with a stray trailing newline, or a shell
    # quoting slip, previously showed as visibly odd and now shows only as an
    # unexplained character count. Reporting the PRESENCE of such characters
    # restores that without reproducing any of them.
    if value != value.strip():
        facts.append("has leading/trailing whitespace")
    if any(ord(c) < 32 or ord(c) == 127 for c in value):
        facts.append("contains control characters")
    if any(ord(c) > 126 for c in value):
        facts.append("contains non-ASCII characters")
    if "%" in value:
        facts.append("contains percent-encoding")
    if not value:
        facts = ["empty"]
    return "<%s>" % ", ".join(facts)


def _relay_endpoint(server):
    """Build the <base>/api/status endpoint from a user-supplied --server value.

    This was `server.rstrip("/") + "/api/status"`, which is string concatenation
    applied to a STRUCTURED value. A URL carrying a query string or fragment --
    "https://fm.example.com/?token=x" -- produced
    "https://fm.example.com/?token=x/api/status": the path is appended INSIDE the
    query, so the request never reaches /api/status and the config records an
    endpoint that cannot work. It fails at first use, far from the provisioning
    run that wrote it.

    Parse, discard query/fragment (an API base carries neither), and join on the
    path component, so the result is well-formed for any input shape.
    """
    shown = _describe_value(server)
    # REVIEW-GATE FINDING XACA-0885-061, first half. urlsplit SILENTLY DELETES
    # ASCII tab, CR and LF anywhere in the input (WHATWG behaviour), so
    # "https://h/a<TAB>b" was accepted and persisted as "https://h/ab" -- a
    # value the operator never typed, recorded without comment. Checked on the
    # RAW string, because by the time urlsplit has run the evidence is gone.
    if any(ord(c) < 32 or ord(c) == 127 for c in server):
        _die_env(
            "--server contains control characters %s.\n"
            "  They are silently removed by URL parsing, so the recorded value"
            " would differ from what you typed.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    try:
        parsed = urllib.parse.urlsplit(server)
    except ValueError:
        # urlsplit itself raises for a netloc that fails NFKC normalisation --
        # e.g. a fullwidth "＠" homoglyph -- and its ValueError message EMBEDS
        # THE RAW NETLOC. Uncaught, that printed the credential in a traceback
        # at exit 1, entirely outside this module's own messages. str(exc) is
        # deliberately NOT included below for the same reason.
        _die_env(
            "--server is not a parsable URL %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    if not parsed.scheme or not parsed.netloc:
        _die_env(
            "--server must be an absolute URL with a scheme and host %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    # Refuse embedded credentials rather than writing them to disk in the clear.
    # urlsplit preserves "user:pass@host" faithfully, so the naive thing is to
    # persist it verbatim into fleet-config.json -- a plaintext secret the
    # operator never chose to store and is not told about. Stripping it silently
    # is worse than refusing: the endpoint would still be well-formed and would
    # still be WRONG for a relay that actually needs those credentials, failing
    # later with an auth error that points nowhere near this line. Auth belongs
    # in the config's own token field, not in the URL.
    # Check the RAW string, not urlsplit's derived fields. urlsplit terminates
    # netloc at the first "/", "?" or "#", so a password containing any of them
    # is reclassified: "https://user:p/w0rd@host" parses as netloc "user:p" with
    # the rest in path, and .username/.password both come back None -- the
    # credential branch never fires. The "/" form then survives into the config,
    # because path is the one component this function keeps. Measured: it
    # persisted "https://user:p/w0rd@host/api/status" to disk. The "?" and "#"
    # forms are worse in a different way -- they persist "https://user:p", so
    # the recorded host IS the username fragment.
    #
    # No parse-based rule can be trusted here, because the parse is what the
    # attack manipulates. Any "@" at all is refused instead: an operator-supplied
    # API base has no legitimate use for one, and over-refusing costs a retype
    # while under-refusing writes a secret to disk.
    #
    # Note this refusal cannot catch a fullwidth "＠" homoglyph -- and does not
    # need to. Detection and disclosure were decoupled when the value stopped
    # being echoed at all: a shape this predicate misses is still never
    # reproduced in any message, so a miss costs a confusing refusal rather
    # than a leaked credential.
    if _carries_secret(server):
        _die_env(
            "--server must not embed credentials (value contains %r).\n"
            "  It would be written to %s in plaintext.\n"
            "  Pass the bare URL and configure authentication separately."
            % ("@", FLEET_CONFIG)
        )
    # The urlsplit-based check that used to sit here is GONE, not merely
    # redundant: it is unreachable behind _carries_secret (any value with
    # user info contains "@"), and it was the check that failed when a
    # delimiter in the password reclassified the parse. Keeping a weaker
    # duplicate of a rule invites a future edit to "simplify" onto the wrong one.
    # REVIEW-GATE FINDING XACA-0885-050. Discarding these silently is
    # inconsistent with refusing credentials in the userinfo: "?token=..." is the
    # same class of secret, handled the opposite way, and the operator was told
    # nothing either time. Say what was dropped -- never its value, which may be
    # the token itself.
    dropped = [n for n, v in (("query", parsed.query), ("fragment", parsed.fragment)) if v]
    if dropped:
        _notice(
            "discarding the %s from --server; an API base carries neither.\n"
            "  If that carried an auth token, configure authentication"
            " separately — it was NOT recorded and will not be used."
            % " and ".join(dropped)
        )
    # Rebuild the authority from VALIDATED COMPONENTS. urlunsplit was handed
    # parsed.netloc verbatim, so anything embedded in it survived into the
    # persisted value whatever its encoding: "%40" is a percent-encoded "@" with
    # no literal "@" byte, so it walked past the refusal above and was written
    # to fleet-config.json in the clear ON THE SUCCESS PATH, exit 0 -- the one
    # outcome this function exists to prevent, and invisible to every test here
    # because they all key on a refusal.
    #
    # Detecting bad authorities failed six times. Constructing only a known-good
    # one cannot fail the same way: user info is not copied because it is never
    # read, so no encoding of it can survive. Same rule the message path
    # already follows -- build what is known good rather than filter what is
    # known bad.
    #
    # ATTRIBUTION, measured rather than assumed: it is the host and port
    # validation below that REFUSES the "%40" shapes -- restoring the verbatim
    # netloc passthrough leaves them refused, so the reconstruction is not what
    # closes that hole. What the reconstruction does is guarantee user info can
    # never be COPIED even if a guard above is later weakened, and normalise the
    # host (an upper-case authority is persisted lower-cased). That normalisation
    # is what T9k pins, so this branch is exercised rather than merely asserted.
    host = parsed.hostname
    if not host:
        _die_env(
            "--server has no host %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    try:
        port = parsed.port
    except ValueError:
        # A non-numeric port is what a smuggled credential looks like after the
        # parser splits "user:SECRET%40host" -- host "user", port the rest.
        _die_env(
            "--server has an invalid port %s.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    # The host must LOOK like a host. Without this, "https://user%40fleet.
    # example.com" is accepted whole -- there is no colon, so the entire
    # percent-encoded string becomes the hostname and is persisted. Percent-
    # encoding is not valid in an authority at all, and "%40" is the same
    # smuggled "@" one line up wearing a different hat.
    #
    # Allowed: letters, digits, dot, hyphen, underscore (some internal names use
    # it), and colon for an IPv6 literal, which urlsplit returns unbracketed.
    # A non-ASCII host is refused rather than guessed at: IDNA has its own
    # normalisation rules and this is not the place to reimplement them --
    # punycode (xn--...) passes as plain ASCII.
    if not host or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789.-_:" for c in host):
        _die_env(
            "--server host is not a valid host name %s.\n"
            "  Percent-encoding and non-ASCII are not permitted in a host;"
            " use punycode for an internationalised domain.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    # REVIEW-GATE FINDING XACA-0885-062. The character allowlist above says
    # WHICH characters may appear, not that the result is shaped like a host, so
    # "..." and "---" were accepted and persisted. A host must carry at least one
    # alphanumeric, must not begin or end with a separator, and must not contain
    # an empty label.
    # Checked PER LABEL, not on the whole string: the first version tested only
    # host[0] and host[-1], so "trail-.com" passed -- the offending hyphen ends
    # a LABEL, and the host itself ends in "m". Caught by checking that
    # legitimate-looking-but-invalid inputs are refused, not by the hostile
    # sweep. IPv6 literals carry ":" and no labels, so they skip this.
    # REVIEW-GATE FINDING XACA-0885-063. The IPv6 exemption keyed on the
    # PRESENCE of a colon rather than the SHAPE of the value, so a colon-bearing
    # non-IPv6 host would skip the label rule.
    #
    # Measured before changing anything: that is not currently reachable. A colon
    # only survives into .hostname via brackets, and urlsplit RAISES for bracket
    # contents that are not a valid IPv6 literal.
    #
    # The two inputs the finding named are refused today, but NOT by the guards
    # an earlier version of this comment claimed -- it had them swapped, and
    # named urlsplit for one that never reaches it. Measured, one at a time:
    #   ":::a"   -> "--server has no host"      (hostname is None)
    #   "a-:-a"  -> "--server has an invalid port"
    # Neither is caught by the per-label rule they bypass, so the conclusion
    # stands: this is hardening, not a live defect. The correction is recorded
    # because a confident wrong attribution in a comment outlives whoever wrote
    # it, and this file has already had to fix that once.
    #
    # It is worth doing anyway, and not for the inputs named: the safety
    # currently rests on urlsplit validating bracket contents, an IMPLICIT
    # STDLIB DEPENDENCY. This module has already been bitten once by relying on
    # unstated urlsplit behaviour -- its NFKC ValueError embeds the raw netloc
    # and leaked a credential in a traceback. Asking ipaddress directly states
    # the intent and removes the dependency.
    #
    # COVERAGE, stated per PATH rather than per branch, because the two halves
    # differ and an earlier version of this comment flattened them into one
    # false claim ("no test covers this branch"):
    #
    #   ACCEPT (a valid IPv6 literal) IS covered -- T9k round-trips "[::]",
    #     "[::0]", "[::1]", "[::ffff:1.2.3.4]" and "[2001:db8::1]:8443" to
    #     literal endpoints; making this arm reject instead reddens T9k.
    #   REJECT IS covered, and the claim that it could not be was WRONG THREE
    #     TIMES in this same comment block. urlsplit does not raise on every
    #     invalid bracket content: it accepts IPvFuture ("[v1.fe80::1]",
    #     "[v1.abc]"), which reaches here and is correctly refused. T9q pins it.
    #
    # The lesson is not the specific inputs. Three times this comment asserted
    # an "unreachable" branch from reasoning about what the stdlib does, and
    # three times a measurement found an input that reaches it. Reachability
    # claims belong to mutation tests and probes, not to prose.
    # Order matters: the IPv6 shape check runs FIRST and is authoritative for a
    # colon-bearing host. The alphanumeric rule used to run unconditionally
    # ahead of it, which rejected "::" -- the unspecified address, and the only
    # valid IPv6 literal containing no alphanumeric character. "::0" and "0::0"
    # were accepted, so the behaviour was inconsistent as well as wrong. It
    # failed closed and no relay is ever addressed that way, but "harmless" is
    # not the same as "correct", and the asymmetry is the kind of thing that
    # reads as a deliberate rule later.
    # The signal is "was written as a bracketed IP literal", NOT "contains a
    # colon". urlsplit accepts RFC 3986 IPvFuture syntax -- "[v1.fe80::1]",
    # "[v1.abc]" -- and strips the brackets, so a colon test misses the
    # colon-less forms entirely. "[v1.abc]" was therefore treated as an ordinary
    # host name, passed the label rule, and was PERSISTED as
    # "https://v1.abc/api/status": brackets silently dropped, an IP-literal
    # request quietly turned into a host name. Found while checking a review
    # finding about the colon test, not by the finding itself.
    if "[" in parsed.netloc:
        try:
            ipaddress.IPv6Address(host)
            bad_host = False
        except ValueError:
            bad_host = True
    else:
        bad_host = not any(c.isalnum() for c in host)
    if not bad_host and ":" not in host:
        for label in host.split("."):
            if not label or label[0] == "-" or label[-1] == "-":
                bad_host = True
                break
    if bad_host:
        _die_env(
            "--server host is not a valid host name %s.\n"
            "  A host needs at least one letter or digit, no empty labels, and"
            " cannot begin or end with '.' or '-'.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    # urlsplit strips the brackets from an IPv6 literal, so they must be put
    # back: without them "2001:db8::1" plus a port renders as
    # "2001:db8::1:8443", which is not a parsable authority. Caught by checking
    # that LEGITIMATE inputs still round-trip -- the hostile-input sweep alone
    # would never have shown it.
    if ":" in host:
        host = "[%s]" % host
    netloc = host if port is None else "%s:%d" % (host, port)
    # REVIEW-GATE FINDING XACA-0885-061, second half. The authority is validated
    # and rebuilt, but the path was copied through untouched -- and it IS
    # persisted. Percent-encoding there can hide any byte from a reader, which is
    # how "%40" got through in the first place one component over. Same
    # allowlist discipline: state what a base path may contain and refuse the
    # rest, rather than enumerate what it may not.
    if any(c not in
           "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._~-/"
           for c in parsed.path):
        _die_env(
            "--server path contains characters not allowed in a base path %s.\n"
            "  Letters, digits, '.', '_', '~', '-' and '/' only; percent-encoding"
            " is not accepted here.\n"
            "  Example: --server https://fleet-monitor.fly.dev" % shown
        )
    path = parsed.path.rstrip("/") + "/api/status"
    return urllib.parse.urlunsplit((parsed.scheme, netloc, path, "", ""))


def _write_json_atomic(path, data, what):
    """Guarded atomic JSON write with a one-time backup. THE only write path here.

    Both writers in this file previously open-coded the same four-step sequence
    (makedirs / copy2 / mkstemp / replace), and every fix so far patched one
    instance at a time. A file-wide audit found FOUR unguarded sites across the
    two functions -- including an `os.makedirs` sitting one line above the two
    lines a previous round had just guarded. Patching instances is what produced
    that; the sequence is now written once and shared, so a future writer cannot
    reintroduce the class by forgetting a step.

    Guarantees, uniformly:
      * every OSError becomes this file's exit-2 refusal, never a raw traceback
      * the backup is written ONCE -- a second run must not overwrite the true
        original with post-first-run state
      * a failed write leaves the target untouched and removes the temp file
    """
    parent = os.path.dirname(path) or "."
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        _die_env("cannot create %s: %s\n  Nothing was changed." % (parent, exc))

    bak = path + BACKUP_SUFFIX
    if os.path.exists(path) and not os.path.exists(bak):
        try:
            shutil.copy2(path, bak)
        except OSError as exc:
            _die_env("cannot write %s: %s\n"
                     "  The directory is not writable; nothing was changed." % (bak, exc))

    try:
        fd, tmp = tempfile.mkstemp(dir=parent, prefix=".%s-" % what, suffix=".json")
    except OSError as exc:
        _die_env("cannot write %s: %s\n"
                 "  The directory is not writable; nothing was changed." % (path, exc))

    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(json.dumps(data, indent=2, sort_keys=True))
            fh.write("\n")
        os.replace(tmp, path)
    except OSError as exc:
        if os.path.exists(tmp):
            os.unlink(tmp)
        _die_env("cannot write %s: %s\n  Nothing was changed." % (path, exc))
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def persist_relay_url(server):
    """Record the relay URL where BOTH kb-msg and fleet-reporter already look.

    Generating a keypair against --server but not recording it left the send
    path unconfigured: msg-client defaults to http://localhost:3000, so every
    cross-machine send failed as "fetch failed" on a machine that had just been
    provisioned successfully. Provisioning that leaves the feature unusable is
    the exact failure XACA-0885 exists to remove, one layer up.

    Writes .centralServer.apiEndpoint -- the same key fleet-reporter reads -- and
    MERGES into any existing config rather than replacing it.
    Returns (changed, previous).
    """
    # The documented shape is "<base>/api/status" — see
    # config/templates/fleet-config.client.example.json and
    # fleet-reporter.sh:82's default. fleet-reporter POSTs status to this
    # exact value and derives its relay base by stripping /api/*, so a bare
    # "<base>/api" would both break its posting AND fail that strip.
    endpoint = _relay_endpoint(server)
    data = {}
    if os.path.isfile(FLEET_CONFIG):
        try:
            data = json.load(open(FLEET_CONFIG))
        except ValueError as exc:
            _die_env(
                "%s is not valid JSON (%s).\n"
                "  Refusing to rewrite it -- fix it by hand, then re-run."
                % (FLEET_CONFIG, exc)
            )
        if not isinstance(data, dict):
            _die_env("%s is not a JSON object; refusing to rewrite." % FLEET_CONFIG)
    central = data.get("centralServer")
    if not isinstance(central, dict):
        central = {}
    previous = central.get("apiEndpoint")
    if previous == endpoint:
        return False, previous
    central["apiEndpoint"] = endpoint
    data["centralServer"] = central
    _write_json_atomic(FLEET_CONFIG, data, "fleet-config")
    return True, previous


# ── Template/instance aliases ────────────────────────────────────────────────
# MIRROR of _kb_template_to_instance / _kb_instance_to_template in
# kanban-helpers.sh (~1840, XACA-0576). Keep the three cases in lock-step; that
# function's own comment already records one mirror in kanban-paths.sh, and this
# is a second, for the same reason (Python here, and the tap installs standalone
# and cannot source dev-team helpers at runtime).
#
# This is NOT cosmetic. team-paths.json keys personal-org teams by their INSTANCE
# id (`medical-general`), while kb-msg addresses them by their TEMPLATE id
# (`medical`) — `_kb_msg_resolve_machine` looks up whatever string the sender
# typed. Writing only the instance form produces a routing map that resolves for
# no one: provisioning reports success, the file looks correct, and
# `kb-msg send medical "..."` still dies with "cannot resolve which machine".
# Caught by probing the real send path before writing, not by reading the code.
# Both forms are emitted so a lookup by either id succeeds, matching the
# bidirectional intent the helper pair documents.
INSTANCE_TO_TEMPLATE = {
    "finance-personal":  "finance",
    "legal-coparenting": "legal",
    "medical-general":   "medical",
}


def with_aliases(teams):
    """Every id a sender might legitimately use for these teams."""
    out = list(teams)
    for t in teams:
        alias = INSTANCE_TO_TEMPLATE.get(t)
        if alias and alias not in out:
            out.append(alias)
    return sorted(out)


# ── Local team discovery ─────────────────────────────────────────────────────
def _load_teams_registry():
    """The `teams` dict from team-paths.json, or a fail-closed exit-2 refusal.

    Factored out of local_teams() (XACA-1078-003) so run_add_team() reads the
    SAME registry the same way — one parse-and-refuse implementation, not two
    that could drift on what counts as "unreadable".
    """
    if not os.path.isfile(TEAM_PATHS):
        _die_env("%s not found — cannot determine which teams live here." % TEAM_PATHS)
    try:
        data = json.load(open(TEAM_PATHS))
    except ValueError as exc:
        _die_env("%s is not valid JSON (%s)" % (TEAM_PATHS, exc))
    return data.get("teams") or {}


def _classify_team(name, cfg, slug_norm, routing_map):
    """Resolve ONE team's ownership. Returns (bucket, tier, owner):

      bucket  "skip" | "local" | "unknown" | "foreign"
      tier    1-4 (None for "skip") — see local_teams()'s docstring for what
              each tier means; kept here so a caller can tell tier-4 (pure
              board-file inference) apart from tier 2/3 (recorded authority)
              within the "local" bucket, which local_teams()'s own 3-tuple
              return cannot express without changing its signature.
      owner   the resolved owning slug for tier 2/3 (declared or recorded),
              else None.

    THE SHARED CLASSIFIER (XACA-1078-003). local_teams() and
    local_teams_by_tier() both call this and must never diverge in what they
    call "local" — a future edit to the tiering rule lands here once, for
    both callers, rather than being patched into one and silently left out
    of the other (the exact drift class k501-sibling-heuristic-drift-pattern
    documents).
    """
    cfg = cfg or {}

    # Tier 1: not a real, ownable team.
    if cfg.get("board_less") or cfg.get("alias_of"):
        return "skip", None, None

    # Tiers 2-3: an authority (declared or previously recorded) has an
    # opinion. It wins outright, over any local filesystem state.
    declared = (cfg.get("primary_host") or "").strip()
    recorded = "" if declared else (routing_map.get(name) or "").strip()
    owner = declared or recorded
    if owner:
        tier = 2 if declared else 3
        if owner.lower() == slug_norm:
            return "local", tier, owner
        return "foreign", tier, owner

    # Tier 4: bootstrap fallback — neither authority has ever recorded an
    # owner. Gate on the BOARD FILE, not merely the directory (see
    # local_teams()'s docstring for why directory existence alone is not
    # evidence of residency).
    kd = os.path.expanduser(cfg.get("kanban_dir") or "")
    has_board = bool(glob.glob(os.path.join(kd, "*-board.json"))) if kd else False
    if has_board:
        return "local", 4, None
    return "unknown", 4, None


def local_teams(slug, routing_map):
    """Teams this machine can speak for. Returns (local, unknown, foreign),
    where `foreign` is a dict of {team: resolved_owner} for teams a positive
    authority (tier 2 or 3 below) assigns to some OTHER machine.

    XACA-1063-022 REWRITE. The previous version gated purely on local BOARD
    FILE presence and never looked at `primary_host` at all — that is the
    bug: a dormant board file left behind by a migration outranked an
    explicit declaration of who owns the team now, misclassifying
    freelance-liquidstyle-agentbadges-{app,ios} as local on M3Pro months
    after both moved to M4Mini (both carry `primary_host=darren-m4-mini`
    in the live registry; their M3Pro trees are inert leftovers — 1
    completed item each, no activity since 2026-03).

    `primary_host` is measured (2026-09-03, full registry cross-referenced
    against team-machines.json) to be a DEPARTURE marker, not a live
    "who's online" field: all 15 teams that declare it point at
    darren-m4-mini and NONE point at the origin machine — nothing has ever
    migrated TO the origin, so it is never named there. Absence therefore
    means "never migrated," not "unknown," and must not be treated as the
    same thing.

    Resolution order per team, each tier consulted only when the one above
    has no opinion:

      1. `board_less` / `alias_of` set -> not a real, ownable team. Skip
         entirely (neither bucket). The registry's one such entry today,
         "mainevent", is a board-less alias of "command" — nothing to
         classify. Landing an unfixable name in `unknown` forever trains
         an operator to stop reading the report (review correction,
         XACA-1063-022): resolve ownership only for entries that can
         actually own something.
      2. `primary_host` present -> that is the owner, full stop. This is
         the fix: no local artifact overrides an explicit declaration.
      3. `primary_host` absent, but team-machines.json (the routing map
         this tool itself maintains) already has an entry for the team ->
         treat that recorded value as the owner. Deliberate inertia, not a
         new heuristic: it is the last classification some authority
         already committed, and reusing it avoids re-deriving from the
         same flaky board-file signal that caused the original bug on
         every subsequent run. Measured concordance where BOTH `primary_host`
         and a routing-map entry exist for the same team: 15/15 agree.
      4. Neither exists -> fall back to the pre-XACA-1063-022 board-file
         check (bootstrap path). This is intentionally the LAST resort,
         not removed outright: it is what lets a genuinely new team's
         very first classification happen at all (team-machines.json
         starts empty for a team that was never provisioned before, and
         nothing else in the fleet records ownership until this tool — or
         an operator — says so once). It can no longer overrule a
         declared or previously-recorded owner, which is the only thing
         that was ever wrong with it.

    A team resolved in tier 2 or 3 whose owner does NOT match this
    machine's `slug` is not ours — it goes to `foreign` (with the resolved
    owner recorded), never `local` and never `unknown`.

    REVIEW CORRECTION (XACA-1063-022, 2026-09-03): an earlier draft of this
    fix folded "positively foreign" and "no authority has an opinion" into
    one `unknown` bucket, matching the pre-existing function's docstring
    ("`unknown` is NOT remote — it is 'this machine cannot tell'") but
    defeating its own intent: on the CURRENT registry that made `unknown`
    permanently non-empty (15 foreign teams every single run), which is
    exactly the "always reports one outstanding item, so nobody reads it"
    failure mode this ticket's own correction called out for the
    mainevent-alias case. Splitting foreign out means `unknown` reverts to
    meaning ONLY "no declared or recorded owner, refuse to guess" — which
    is correctly the empty set on this machine today (every real,
    non-alias team is covered by tier 2 or 3) — while `foreign` becomes a
    genuine, informative, always-non-empty-when-true report of teams
    positively known to live elsewhere. `merge_local` only ever touches
    `local` entries, so a foreign-but-known team's existing routing-map row
    is left alone either way — this split changes what gets REPORTED, not
    what gets WRITTEN.
    """
    teams = _load_teams_registry()
    routing_map = routing_map or {}
    slug_norm = (slug or "").strip().lower()

    local, unknown, foreign = [], [], {}
    for name, cfg in teams.items():
        bucket, _tier, owner = _classify_team(name, cfg, slug_norm, routing_map)
        if bucket == "skip":
            continue
        elif bucket == "local":
            local.append(name)
        elif bucket == "unknown":
            unknown.append(name)
        elif bucket == "foreign":
            foreign[name] = owner
    return sorted(local), sorted(unknown), foreign


def local_teams_by_tier(slug, routing_map):
    """Same classification as local_teams(), split so an --unattended full
    run can tell tier-2/3 authority (`authoritative`) apart from the tier-4
    board-file bootstrap guess (`tier4_only`) within what local_teams() would
    lump together as one `local` list.

    XACA-1078 Decision 1 / "Ruling on subitem 002's proposal": a full
    unattended run must exclude tier-4-only classifications from the write
    set and report them as `deferred`, because a stale regenerated board
    stub can make a migrated-away team look resident (see local_teams()'s
    own docstring, "primary_host" section) — a mistake only the FULL run can
    make about a team it is NOT itself creating. --add-team is exempt: there,
    tier 4 is a contemporaneous observation of the very team-creation call in
    progress, not archaeology on someone else's leftovers.

    Returns (authoritative, tier4_only, unknown, foreign) — `unknown` and
    `foreign` are identical to local_teams()'s own buckets; deliberately NOT
    used by a plain (non-unattended) run, which keeps calling local_teams()
    unchanged so its behaviour for every existing caller (including this
    file's own manual/default path and the ownership-gates test that imports
    local_teams() directly) is untouched.
    """
    teams = _load_teams_registry()
    routing_map = routing_map or {}
    slug_norm = (slug or "").strip().lower()

    authoritative, tier4_only, unknown, foreign = [], [], [], {}
    for name, cfg in teams.items():
        bucket, tier, owner = _classify_team(name, cfg, slug_norm, routing_map)
        if bucket == "skip":
            continue
        elif bucket == "local":
            (authoritative if tier in (2, 3) else tier4_only).append(name)
        elif bucket == "unknown":
            unknown.append(name)
        elif bucket == "foreign":
            foreign[name] = owner
    return sorted(authoritative), sorted(tier4_only), sorted(unknown), foreign


# ── team-machines.json ───────────────────────────────────────────────────────
def load_map():
    if not os.path.isfile(TEAM_MACHINES):
        return {}, False
    try:
        data = json.load(open(TEAM_MACHINES))
    except ValueError as exc:
        # Never silently rebuild: an operator-maintained remote mapping is the
        # only record of where other machines are, and it cannot be regenerated.
        _die_env(
            "%s is not valid JSON (%s).\n"
            "  Refusing to rewrite it — fix it by hand, then re-run." % (TEAM_MACHINES, exc)
        )
    if not isinstance(data, dict):
        _die_env("%s is not a JSON object; refusing to rewrite." % TEAM_MACHINES)
    return data, True


def write_map(data):
    """Persist the routing map. Uses the shared guarded writer (see
    _write_json_atomic) -- this function previously open-coded the same sequence
    with THREE unguarded steps, found by a file-wide audit after the sibling
    site was fixed. Fixing one side of a matched pair and leaving the other is
    how this class of bug survives."""
    _write_json_atomic(TEAM_MACHINES, data, "team-machines")


def merge_local(existing, teams, slug):
    """Assert `slug` for local teams. Returns (merged, added, retargeted).

    Entries for teams not in `teams` are carried through untouched — those are
    the operator's remote mappings and this machine has no standing to edit them.
    """
    merged = dict(existing)
    added, retargeted = [], []
    for t in teams:
        cur = merged.get(t)
        if cur == slug:
            continue
        if cur is None:
            added.append(t)
        else:
            retargeted.append((t, cur))
        merged[t] = slug
    return merged, added, retargeted


def _refuse_retarget_under_unattended(unattended, retargeted, slug, say):
    """THE write-side superset invariant (XACA-1078 Decision 1, tier-agnostic
    rule — see the module docstring's "UNATTENDED CALLERS" section).

    Under --unattended, the resulting map must be a pure superset of the map
    that was read. If `retargeted` is non-empty, the caller must not write
    ANY of `merged` — not the non-conflicting keys either. This is
    deliberately checked here, immediately before the point of write, rather
    than upstream in local_teams()/local_teams_by_tier()'s classification:
    an independent enforcement layer at the write catches a bad
    classification from ANY tier — including a tier that does not exist yet
    — where a read-side-only filter could only ever advise.

    A manual (non-unattended) invocation is UNCHANGED: an operator running
    the bare command still gets the pre-existing "~ team -> slug (was X)"
    retarget behaviour, because a human reading the report is the safety
    property this rule exists to substitute for when nobody is watching.

    Returns True if the write may proceed, False if it was refused.

    The refusal reason is emitted via `_notice` (stderr, UNCONDITIONAL), never
    via `say` (stdout, suppressed by --quiet). This is not a style preference.
    Both automatic call sites — the tap installer and `aiteamforge upgrade` —
    invoke this tool as `--unattended --quiet`, and they disclose the reason to
    the operator by capturing its output. Routing this block through `say` made
    the refusal emit ZERO bytes under exactly that flag combination, so the
    wrappers fell through their `if [ -n "$routing_out" ]` disclosure branch and
    the operator saw only "exited 1" with no key named and no `was <machine>`.
    Contract rule 12 is "never abort AND never suppress the reason" — a refusal
    nobody can read is the silent failure this ticket exists to remove.
    Caught in review of PR #825; regression-pinned by U14/U15.
    """
    if not unattended or not retargeted:
        return True
    _notice("REFUSED: %d key(s) would be RETARGETED under --unattended — the entire "
            "write is declined, not applied partially:" % len(retargeted))
    for t, was in retargeted:
        _notice("  ~ %s -> %s (was %s)" % (t, slug, was))
    _notice("An unattended process does not adjudicate between two operator-maintained "
            "records. Nothing was written. Resolve by hand: kb-msg-provision")
    return False


def run_add_team(keygen_js, args, say):
    """`--add-team <team-id>` — narrow additive single-team assertion.

    XACA-1078 Decision 1/5: `kb-init-team` can honestly speak for exactly one
    fact ("this team was created here, just now, by me"), never the whole
    registry. This bypasses local_teams()'s whole-registry re-derivation
    entirely and resolves only the named team (plus its with_aliases()
    template/instance counterpart via INSTANCE_TO_TEMPLATE).

    Never touches the keypair (args.no_keygen is forced True by the caller)
    and never persists a relay URL (mutually exclusive with --server,
    enforced by the caller before this is reached) — team-birth provisioning
    never mints machine-level identity or config (Decision 2, rule 8).

    Returns the process exit code (0 ok / 1 declined / 2 raised via
    _die_env before this returns at all).
    """
    team_id = args.add_team
    slug = machine_slug(keygen_js, args.machine_id)

    teams = _load_teams_registry()
    cfg = teams.get(team_id)

    # Precondition 1: present, and not board_less/alias_of (not a real,
    # ownable team — same tier-1 rule _classify_team applies, stated
    # directly here since add-team never calls that shared classifier).
    if cfg is None:
        _notice("--add-team %r declined: not present in %s." % (team_id, TEAM_PATHS))
        return 1
    cfg = cfg or {}
    if cfg.get("board_less") or cfg.get("alias_of"):
        _notice("--add-team %r declined: it is board_less/alias_of, not an ownable team."
                 % team_id)
        return 1

    # Precondition 2: a declared primary_host, if present, must name THIS
    # machine. Never contradict a declared owner (Decision 2, rule 5).
    declared = (cfg.get("primary_host") or "").strip()
    if declared and declared.lower() != slug.lower():
        _notice("--add-team %r declined: primary_host declares %r, this machine is %r."
                 % (team_id, declared, slug))
        return 1

    # Precondition 3: a board file must exist HERE. Unlike local_teams()'s
    # tier-4 fallback (which lands a board-less team in `unknown` and moves
    # on), add-team has nothing else to fall back to — this IS its only
    # evidence, and it is trustworthy here specifically because kb-init-team
    # just created that board file, moments earlier, in this same process
    # (Decision 1, "Tier 4 is correct by construction for the new team").
    kd = os.path.expanduser(cfg.get("kanban_dir") or "")
    has_board = bool(glob.glob(os.path.join(kd, "*-board.json"))) if kd else False
    if not has_board:
        _notice("--add-team %r declined: no *-board.json found under %r."
                 % (team_id, kd or "(no kanban_dir declared)"))
        return 1

    names = with_aliases([team_id])
    existing, map_existed = load_map()

    # Write rule (Decision 1, "Write rule, add-only"): touches no key other
    # than `team_id` and its alias form. Absent -> add. Already correct ->
    # no-op. Names another machine -> decline the WHOLE call and report both
    # values — this is the same superset invariant --unattended enforces on
    # the full run, expressed directly since add-team's write set is already
    # bounded to `names` and never needs merge_local()'s general machinery.
    to_add, conflicts = [], []
    for name in names:
        cur = existing.get(name)
        if cur is None:
            to_add.append(name)
        elif cur != slug:
            conflicts.append((name, cur))
        # cur == slug: already correct — nothing to do for this name.

    say("kb-msg-provision --add-team %s" % team_id)
    say("  machine slug : %s" % slug)
    say("  names        : %s" % ", ".join(names))
    say("  routing map  : %s" % (TEAM_MACHINES if map_existed else "ABSENT"))

    if conflicts:
        for name, cur in conflicts:
            _notice("--add-team %r declined: %r already routes to %r (this machine is %r); "
                     "refusing to retarget." % (team_id, name, cur, slug))
        return 1

    if not to_add:
        say("  Already correct for %s and its alias(es) — no change." % team_id)
        return 0

    if args.check:
        say("\n  GAP: %d name(s) not yet routed to this machine: %s"
            % (len(to_add), ", ".join(to_add)))
        return 1

    if args.dry_run:
        say("\n  [dry-run] would write %s" % TEAM_MACHINES)
        for name in to_add:
            say("    + %s -> %s" % (name, slug))
        return 0

    merged = dict(existing)
    for name in to_add:
        merged[name] = slug
    write_map(merged)

    say("\n  Wrote %s" % TEAM_MACHINES)
    for name in to_add:
        say("    + %s -> %s" % (name, slug))
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--check", action="store_true", help="Report state; never write. Exit 1 on a gap.")
    ap.add_argument("--dry-run", action="store_true", help="Show what would change; never write.")
    ap.add_argument("--no-keygen", action="store_true", help="Do not generate a keypair if absent.")
    ap.add_argument("--server", default=None, help="Fleet Monitor URL for key registration.")
    ap.add_argument("--machine-id", default=None, help="Override the machine slug.")
    ap.add_argument("--add-team", metavar="TEAM_ID", default=None,
                     help="Narrow additive single-team assertion (XACA-1078): add "
                          "TEAM_ID (this machine) to the routing map if absent. "
                          "Bypasses the whole-registry re-derivation. Implies "
                          "--unattended and --no-keygen. Mutually exclusive with "
                          "--server. See the module docstring for the full contract.")
    ap.add_argument("--unattended", action="store_true",
                     help="Never reads stdin or prompts (true today; guaranteed going "
                          "forward). Enforces the additive-only superset invariant at "
                          "the write: a write that would retarget any existing key is "
                          "refused in FULL, not partially applied. In a full run "
                          "(no --add-team), tier-4-only classifications are excluded "
                          "from the write set and reported as 'deferred'. Deliberately "
                          "NOT the same promise as kb-init-team's --non-interactive — "
                          "see the module docstring's 'UNATTENDED CALLERS' section.")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    def say(msg=""):
        if not args.quiet:
            print(msg)

    # ── --add-team implications and guards (Decision 1/5, rule 8) ──────────
    if args.add_team and args.server:
        _die_env(
            "--add-team and --server are mutually exclusive.\n"
            "  Team-birth provisioning never writes machine-level configuration "
            "(fleet-config.json) or mints a vault keypair — that is machine "
            "provisioning, not a side effect of adding one team."
        )
    if args.add_team:
        args.unattended = True
        args.no_keygen = True

    keygen_js = _locate_keygen()

    if args.add_team:
        return run_add_team(keygen_js, args, say)

    if args.server and (args.check or args.dry_run):
        # REVIEW-GATE FINDING XACA-0885-057. These modes skipped _relay_endpoint
        # entirely, so a credential-bearing or malformed --server passed silently
        # in exactly the mode an operator runs as a PREFLIGHT. Dry-run should be
        # the safest place to catch it, not the one place that does not look.
        # Validate (which refuses on its own) and discard the result.
        _relay_endpoint(args.server)
    if args.server and not (args.check or args.dry_run):
        changed, prev = persist_relay_url(args.server)
        if changed:
            say("  Recorded relay URL in %s%s"
                % (FLEET_CONFIG, "" if prev is None else " (was %s)" % prev))
    slug = machine_slug(keygen_js, args.machine_id)
    have_key = has_private_key(keygen_js, slug)
    # XACA-1063-022: load_map() moved ahead of local_teams() so tier 3 of its
    # resolution order (an already-recorded team-machines.json entry, consulted
    # only when primary_host is absent) can be handed the SAME parsed map
    # main() goes on to merge into — one read, not two, and no risk of the two
    # calls seeing different snapshots of a file that could change between them.
    existing, map_existed = load_map()
    # XACA-1078-003: under --unattended, a full run must not write a route
    # derived ONLY from tier-4 inference (Decision 2, rule 4) — that guess is
    # trustworthy for a team this run is itself creating (--add-team), not
    # for an arbitrary team elsewhere in the registry. local_teams_by_tier()
    # is the ONLY thing that changes here; every other line in this function
    # is unchanged from the always-has-been-manual invocation.
    if args.unattended:
        loc_authoritative, deferred, unknown, foreign = local_teams_by_tier(slug, existing)
        loc = loc_authoritative
    else:
        loc, unknown, foreign = local_teams(slug, existing)
        deferred = []
    loc = with_aliases(loc)   # template ids too, or kb-msg looks up a name we never wrote
    merged, added, retargeted = merge_local(existing, loc, slug)

    say("kb-msg provisioning")
    say("  machine slug : %s" % slug)
    say("  keygen       : %s" % keygen_js)
    say("  vault key    : %s" % ("present" if have_key else "ABSENT"))
    say("  local teams  : %d (%s)" % (len(loc), ", ".join(loc) or "none"))
    if unknown:
        say("  unmapped     : %d (%s)" % (len(unknown), ", ".join(unknown)))
        say("                 no declared or recorded owner — left untouched, see module docstring")
    if foreign:
        # XACA-1063-022: distinct from `unmapped` above — these teams DO have
        # a positive owner, it just is not this machine. Printing the
        # resolved owner inline is what makes this report (and a test
        # driving this function directly) able to confirm WHICH machine,
        # not just that the team was excluded.
        foreign_desc = ", ".join("%s->%s" % (t, foreign[t]) for t in sorted(foreign))
        say("  foreign      : %d (%s)" % (len(foreign), foreign_desc))
        say("                 owned by another machine (XACA-1063 host-ownership authority) — left untouched")
    if deferred:
        # XACA-1078-003, Decision 1: tier-4-only (board-file bootstrap) teams
        # a full --unattended run refuses to write a guessed route for. The
        # first automatic run therefore writes only the tier-2/3-provable
        # set (see the plan doc's "Consequence to accept explicitly") — this
        # is the report that makes the remainder impossible to forget.
        say("  deferred     : %d (%s)" % (len(deferred), ", ".join(deferred)))
        say("                 tier-4-only inference — --unattended never writes a guessed route; run 'kb-msg-provision --add-team <id>' or a manual run to close")
    say("  routing map  : %s" % (TEAM_MACHINES if map_existed else "ABSENT"))

    if args.check:
        gaps = []
        if not have_key:
            gaps.append("no vault keypair for '%s' (run: kb-msg-provision)" % slug)
        if not map_existed:
            gaps.append("no %s" % TEAM_MACHINES)
        missing = [t for t in loc if existing.get(t) != slug]
        if missing:
            gaps.append("%d local team(s) unmapped or mis-targeted: %s" % (len(missing), ", ".join(missing)))
        if gaps:
            say("\n  GAPS:")
            for g in gaps:
                say("    - %s" % g)
            return 1
        say("\n  All Tier-2 provisioning present.")
        return 0

    # ── keypair ──
    if not have_key and not args.no_keygen:
        if args.dry_run:
            say("\n  [dry-run] would generate a vault keypair for '%s'" % slug)
        else:
            say("\n  Generating vault keypair for '%s'..." % slug)
            cmd = ["node", keygen_js, "--machine-id", slug]
            if args.server:
                cmd += ["--server", args.server]
            # --unattended (Decision 2, rule 10 / Decision 5): closing stdin is
            # structural insurance that this can never block waiting on input,
            # on top of vault-keygen.js already never reading it today.
            run_kwargs = {"stdin": subprocess.DEVNULL} if args.unattended else {}
            rc = subprocess.run(cmd, **run_kwargs).returncode
            if rc != 0:
                print("kb-msg-provision: vault-keygen failed (exit %d). Routing map not written."
                      % rc, file=sys.stderr)
                return 1
            have_key = has_private_key(keygen_js, slug)
    elif not have_key:
        say("\n  Skipping keypair generation (--no-keygen). Tier 2 stays unavailable.")

    # ── routing map ──
    if not added and not retargeted:
        say("  Routing map already correct for every local team — no change.")
        return 0

    # THE superset invariant (XACA-1078-003, Decision 1) — the single most
    # important line this subitem adds. Checked HERE, immediately before any
    # write (including the dry-run preview, so a preview never promises a
    # write this tool would actually refuse), not inside local_teams() /
    # local_teams_by_tier() / merge_local()'s classification — this is an
    # independent enforcement layer that catches a bad classification from
    # ANY tier, including one that does not exist yet.
    if not _refuse_retarget_under_unattended(args.unattended, retargeted, slug, say):
        return 1

    if args.dry_run:
        say("\n  [dry-run] would write %s" % TEAM_MACHINES)
        for t in added:
            say("    + %s -> %s" % (t, slug))
        for t, was in retargeted:
            say("    ~ %s -> %s (was %s)" % (t, slug, was))
        return 0

    # No try/except here. This previously caught `Exception`, which became DEAD
    # CODE when both writers moved onto _write_json_atomic: that helper reports
    # every failure via _die_env, which raises SystemExit(2) — a BaseException,
    # not an Exception, so the handler could never fire (review finding, PR #764).
    # Leaving it would tell the next reader that write_map failures are handled
    # here, and they are not; they exit 2 from inside the helper.
    write_map(merged)

    say("\n  Wrote %s" % TEAM_MACHINES)
    for t in added:
        say("    + %s -> %s" % (t, slug))
    for t, was in retargeted:
        say("    ~ %s -> %s (was %s)" % (t, slug, was))
    return 0


if __name__ == "__main__":
    sys.exit(main())
