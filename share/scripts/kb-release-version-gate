#!/usr/bin/env bash
# kb-release-version-gate — XACA-0658-004
# Version-confirmation gate: compare code version vs release target version.
#
# Usage:
#   kb-release-version-gate <release-id> --platform <plat> [--env <ENV>] [--team <team>] [--quiet] [--dry-run]
#
# Exit codes:
#   0 — PASS (versions match) or SKIP (no target version set for non-PROD env, or no version_sources)
#   1 — FAIL (version mismatch) or PROD-no-target (PROD requires a target version)
#   3 — CR-DIVERGENCE HALT (XACA-0897 Guard 5): the release's platforms.<plat>.version
#       has diverged from the linked CR's cr_submitted_version, OR the check could not
#       be resolved (unresolvable board, dangling CR link, missing cr_submitted_version,
#       ambiguous multiple linked CRs, no release version set) — fail-closed, never a
#       skip. Distinct from exit 1 on purpose: kb-release-push-promote must NEVER
#       attempt --auto-bump against this class, and it is not agent-clearable. See
#       "Step 0: CR-divergence halt" below and docs/ "CR-Divergence Halt (Guard 5)".
#       Override (human-only, not usable by an agent): kb-release-version-gate ...
#       --override-cr-divergence — requires a live interactive TTY, refuses outright
#       in any detected AI-agent shell, and requires typed confirmation + a reason.
#
# --dry-run — genuinely evaluates the CR-divergence check and the ordinary
#       version comparison (same exit codes as a real run: 0/1/3) but makes
#       NO writes anywhere: it does not consume a pending human override
#       sentinel (peek-only — see _cr_div_check_override_sentinel) and does
#       not POST gateStatus to LCARS (see _write_gate_status). Combining
#       --dry-run with --override-cr-divergence is a no-op for the override
#       (loudly warned, not silently dropped) since recording an override is
#       itself a write.
#
# The gate writes gateStatus to the release via the LCARS API (POST /api/releases/<id>/platform-gate-status).
# If LCARS is down the status write is non-fatal; the exit code is still correct. Under
# --dry-run this write is skipped entirely (see above), independent of LCARS reachability.
#
# Canonical source: ~/dev-team/scripts/kb-release-version-gate
# Tap mirror:       homebrew-tap/share/scripts/kb-release-version-gate
# Canonical-source rule: XACA-0340 — edit here, run ./sync-tap.sh to mirror.
#
# Note: set -euo pipefail is applied AFTER sourcing kanban-helpers.sh (below),
# matching sibling scripts kb-release-version-bump / kb-release-push-promote:
# kanban-helpers.sh may return non-zero from internal checks and reads unset
# vars, so we source it permissively and tighten up immediately after.

# ---------------------------------------------------------------------------
# Self-location: resolve AITEAMFORGE_DIR / kanban-helpers.sh regardless of
# whether we're running from the dev-tree or from the tap install.
# ---------------------------------------------------------------------------
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
# AITEAMFORGE_DIR may already be set (tap context); if not, infer from script location.
if [[ -z "${AITEAMFORGE_DIR:-}" ]]; then
    export AITEAMFORGE_DIR="$(dirname "$_SCRIPT_DIR")"
fi
_HELPERS="$AITEAMFORGE_DIR/kanban-helpers.sh"
if [[ -f "$_HELPERS" ]]; then
    # shellcheck source=/dev/null
    source "$_HELPERS" 2>/dev/null || true
fi
_PATHS_PY="$AITEAMFORGE_DIR/kanban-hooks/aiteamforge_paths.py"

# Tighten shell options now that sourcing is complete (see note above).
set -euo pipefail

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
_release_id=""
_platform=""
_env=""
_team_override=""
_quiet=0
_cr_div_override_requested=0
_dry_run=0

while [[ $# -gt 0 ]]; do
    case "${1-}" in
        --platform|-p)
            _platform="${2-}"; shift 2 ;;
        --env|-e)
            _env="${2-}"; shift 2 ;;
        --team|-t)
            _team_override="${2-}"; shift 2 ;;
        --quiet|-q)
            _quiet=1; shift ;;
        --override-cr-divergence)
            # Human-only (XACA-0897-005). Merely passing this flag does
            # NOTHING by itself — it only makes the interactive confirmation
            # AVAILABLE if a genuine CR-divergence is found. See "Step 0"
            # below: it still requires a live TTY and refuses outright in
            # any detected AI-agent shell (CLAUDECODE/AI_AGENT env).
            _cr_div_override_requested=1; shift ;;
        --dry-run)
            # XACA-0897-round21 (BLOCKING fix): a non-consuming, non-writing
            # preview mode. round 20 made kb-release-push-promote --dry-run
            # run this gate FOR REAL (fixing "dry-run reports a pass it
            # never computed") but the gate itself had no concept of
            # dry-run, so the real Step 0 code path ran unmodified --
            # including _cr_div_check_override_sentinel's unconditional
            # `rm -f` of the single-use override sentinel. A preview run
            # silently burned a human's one-time CR-divergence authorization.
            # This flag makes the gate genuinely evaluate divergence (no
            # reverting to an unconditional pass) while suppressing every
            # write reachable from this script: the override sentinel is
            # PEEKED, never consumed (see _cr_div_check_override_sentinel),
            # and the best-effort LCARS gateStatus POST (_write_gate_status)
            # is skipped entirely. See docs/ "CR-Divergence Halt (Guard 5)".
            _dry_run=1; shift ;;
        --help|-h)
            # XACA-0897-116: `grep '^#' | head -20` cut the header comment
            # block off at a fixed line count, which sliced straight
            # through the --dry-run documentation (added after line 20) --
            # the "no writes / peek not consume" contract was invisible to
            # --help. Fixed by capturing the WHOLE leading comment block
            # instead of a hardcoded line count: read consecutive lines
            # starting with '#' from the top of the file and stop at the
            # first line that isn't one (the blank line right before the
            # "Self-location" implementation-comment section below) --
            # this is the file's actual header docstring boundary, and it
            # tracks the header growing in the future instead of moving
            # the cliff to wherever the next 20-line guess runs out.
            awk '/^#/{print; next} {exit}' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        -*)
            echo "Error: Unknown option: ${1-}" >&2
            echo "Usage: kb-release-version-gate <release-id> --platform <plat> [--env <ENV>] [--team <team>] [--quiet] [--dry-run]" >&2
            exit 1 ;;
        *)
            if [[ -z "$_release_id" ]]; then
                _release_id="${1-}"
            else
                echo "Error: Unexpected argument: ${1-}" >&2
                exit 1
            fi
            shift ;;
    esac
done

if [[ "$_dry_run" -eq 1 && "$_cr_div_override_requested" -eq 1 ]]; then
    # --override-cr-divergence's whole job is to WRITE a sentinel (after a
    # live human confirms interactively) -- that is a write, so it cannot
    # be honored under --dry-run's "no writes at all" contract. Neutralize
    # it loudly rather than silently ignoring it or silently writing anyway:
    # falls through to Step 0 with the override request cleared, so a real
    # divergence still reports HALT under dry-run, matching what a real
    # (non-override) run would report.
    echo "Warning: --override-cr-divergence has no effect combined with --dry-run." >&2
    echo "  --dry-run makes no writes, so no override can be recorded here. Re-run without" >&2
    echo "  --dry-run (interactively, as a human) to actually record an override." >&2
    _cr_div_override_requested=0
fi

if [[ -z "$_release_id" ]]; then
    echo "Error: release-id is required." >&2
    echo "Usage: kb-release-version-gate <release-id> --platform <plat> [--env <ENV>] [--team <team>] [--quiet] [--dry-run]" >&2
    exit 1
fi

if [[ -z "$_platform" ]]; then
    echo "Error: --platform is required." >&2
    echo "Usage: kb-release-version-gate <release-id> --platform <plat> [--env <ENV>] [--team <team>] [--quiet] [--dry-run]" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Team and port resolution
# ---------------------------------------------------------------------------
if [[ -n "$_team_override" ]]; then
    _team="$_team_override"
elif [[ -n "${KB_TEAM:-}" ]]; then
    _team="$KB_TEAM"
else
    # Try _kb_detect_context (from kanban-helpers.sh if sourced)
    if declare -f _kb_detect_context >/dev/null 2>&1; then
        _ctx=$(_kb_detect_context 2>/dev/null || true)
        _team="${_ctx%%:*}"
    else
        echo "Error: Cannot determine team. Set KB_TEAM or pass --team <team>." >&2
        exit 1
    fi
fi

if [[ -z "$_team" || "$_team" == ERROR:* ]]; then
    echo "Error: Could not determine team. Set KB_TEAM or pass --team <team>." >&2
    exit 1
fi

# Resolve LCARS port
# Priority: (1) _kb_team_lcars_port helper (from kanban-helpers.sh)
#           (2) direct Python read from team-paths.json
#           (3) fallback 8080
_port=""
if declare -f _kb_team_lcars_port >/dev/null 2>&1; then
    _port=$(_kb_team_lcars_port "$_team" 2>/dev/null || true)
fi
if [[ -z "$_port" ]] || ! [[ "$_port" =~ ^[0-9]+$ ]]; then
    _port=$(python3 - "$_team" 2>/dev/null <<'PYEOF'
import json, os, sys
from pathlib import Path
team = sys.argv[1]
cfg = os.environ.get("AITEAMFORGE_CONFIG") or os.path.expanduser("~/.aiteamforge/team-paths.json")
try:
    with open(cfg) as fh:
        data = json.load(fh)
except Exception:
    sys.exit(1)
entry = data.get("teams", {}).get(team, {})
port = entry.get("lcars_port")
if port and str(port).isdigit():
    print(int(port))
else:
    sys.exit(1)
PYEOF
) || _port=""
fi
# XACA-0658-014: do NOT silently fall back to a hardcoded 8080 — a different
# service may be listening there, and the gateStatus write is best-effort/non-fatal
# anyway. If the port can't be resolved, mark LCARS unavailable and skip the write
# with a clear warning; the version-comparison result (the gate's real job) stands.
_lcars_unavailable=0
if [[ -z "$_port" ]] || ! [[ "$_port" =~ ^[0-9]+$ ]]; then
    _lcars_unavailable=1
    _lcars_base=""
else
    _lcars_base="http://localhost:${_port}"
fi

# ---------------------------------------------------------------------------
# Helper: write gateStatus back to LCARS (best-effort, non-fatal)
# ---------------------------------------------------------------------------
_write_gate_status() {
    local result="$1"
    local code_ver="${2:-}"
    local target_ver="${3:-}"

    # XACA-0897-round21: --dry-run makes NO writes, full stop -- this POST
    # mutates the release's gateStatus via the LCARS API, so it is skipped
    # under --dry-run exactly like the override-sentinel consumption is.
    if [[ "${_dry_run:-0}" -eq 1 ]]; then
        [[ $_quiet -eq 0 ]] && echo "[dry-run] would write gateStatus: result='${result}' codeVersion='${code_ver}' targetVersion='${target_ver}' -- skipped (--dry-run makes no writes)." >&2
        return 0
    fi

    # XACA-0658-014: skip the write entirely when the LCARS port couldn't be
    # resolved (rather than POSTing to a hardcoded 8080 that may be another service).
    if [[ "${_lcars_unavailable:-0}" -ne 0 ]]; then
        [[ $_quiet -eq 0 ]] && echo "Warning: LCARS port for team '${_team}' could not be resolved — skipping gateStatus write (non-fatal — gate result stands)" >&2
        return 0
    fi

    local checked_at
    checked_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || python3 -c "import datetime; print(datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ'))")

    local payload
    payload=$(python3 -c "
import json, sys
print(json.dumps({
    'platform':      sys.argv[1],
    'result':        sys.argv[2],
    'checkedAt':     sys.argv[3],
    'codeVersion':   sys.argv[4],
    'targetVersion': sys.argv[5],
}))" "$_platform" "$result" "$checked_at" "$code_ver" "$target_ver" 2>/dev/null) || {
        [[ $_quiet -eq 0 ]] && echo "Warning: could not build gateStatus payload" >&2
        return 0
    }

    # POST to the new endpoint (XACA-0658-004)
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "$payload" \
        --connect-timeout 3 \
        --max-time 5 \
        "${_lcars_base}/api/releases/${_release_id}/platform-gate-status" 2>/dev/null) || http_code="000"

    if [[ "$http_code" != "200" ]]; then
        [[ $_quiet -eq 0 ]] && echo "Warning: LCARS gateStatus write returned HTTP ${http_code} (non-fatal — gate result stands)" >&2
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Step 0: CR-divergence halt (XACA-0897 Guard 5)
#
# A NEW, independent axis from Steps 1-4 below. Steps 1-4 compare the CODE
# version (read from a source file via version_sources) to the release
# TARGET version -- "does the built code match the release target?" This
# step compares the release's platforms.<plat>.version (the SAME field
# Step 1 reads via LCARS -- see plan doc finding F1) against the linked CR's
# cr_submitted_version -- "has the release been renumbered since CAB
# approved it?" Different question, same field on the left, a different
# field entirely on the right.
#
# DELIBERATELY placed BEFORE Step 1's LCARS fetch -- including before that
# fetch's own early bail-out -- and reads the board file directly from disk
# rather than via the LCARS API, so this step does not sit behind ANY of the
# seven downstream "no verdict, proceed anyway" branches in Steps 1-4 (LCARS
# unreachable, platform absent at non-PROD, no target version at non-PROD, no
# version_sources configured, version_source missing file/match_pattern,
# working_dir unresolvable, version file not found -- see plan doc finding
# F6; grep the literal phrase those branches print, in lowercase, to re-count
# them independently of this comment). This step runs first, unconditionally,
# on every invocation, and only ever resolves to HALT or falls through to
# Steps 1-4 -- it has no such branch of its own. "Could not determine"
# (unresolvable board, release not found, dangling CR reference, missing
# cr_submitted_version, ambiguous multiple linked CRs, no release version
# set) resolves to HALT, never to skip -- per the user's 2026-08-07 decision
# recorded in the plan doc (Risks): absence of data is never read as
# permission. See plan doc Design Decisions -> "Fail closed, unlike the
# existing gate".
#
# Exit code 3 is reserved EXCLUSIVELY for this halt class -- distinct from
# the existing 0 (pass/skip) / 1 (fail) contract below -- so
# kb-release-push-promote can tell "ordinary code/target mismatch"
# (auto-bumpable) apart from "CR-governance halt" (never auto-bumpable,
# never agent-clearable). The "CR-DIVERGENCE HALT:" marker string is the
# human-readable identifier; the EXIT CODE is the authoritative
# machine-readable contract -- callers MUST key off $? == 3, never a
# substring grep (a bare-substring grep on this class of marker has
# false-matched a subitem TITLE that merely quoted the phrase before --
# see feedback_skip_heuristic_exact_marker.md).
# ---------------------------------------------------------------------------

# Returns 0 (true) if this shell is an AI-agent context, per env vars this
# fleet's own infrastructure sets for that purpose. This is a SECOND,
# independent layer under _cr_div_interactive_override_confirm, on top of
# the TTY check there -- even a hypothetical agent shell with a real pty
# attached is still refused.
_cr_div_agent_context_detected() {
    [[ -n "${CLAUDECODE:-}" || -n "${AI_AGENT:-}" || -n "${CLAUDE_CODE_ENTRYPOINT:-}" || -n "${CLAUDE_AGENT_HANDLE:-}" ]]
}

# Derives <kanban_dir>/releases from the board file path we already resolved
# (_cr_div_board_file), rather than calling _kb_get_releases_dir directly.
#
# WHY: kanban-helpers.sh contains a zsh-only construct around line ~3755
# (pre-existing, unrelated to XACA-0897, NOT this ticket's file to fix) that a
# real `/bin/bash` `source` cannot parse. Because kanban-helpers.sh is sourced
# with stderr silenced (`source ... 2>/dev/null || true`, by design — see the
# file's own "Self-location" preamble), that parse failure is swallowed
# silently and truncates sourcing at that point: every function defined AFTER
# line ~3755 — including _kb_get_releases_dir (~line 18155) — is simply
# UNDEFINED for the rest of the script when run under bash, even though
# `declare -f` guards make the failure non-fatal. _kb_get_board_file
# (~line 1778) and _kb_get_kanban_dir (~line 205) are both defined BEFORE the
# break and load reliably under bash, which is why this function derives the
# releases dir from the board file's own directory (the exact same
# `<kanban_dir>/releases` relationship _kb_get_releases_dir itself implements)
# instead of depending on the helper that bash silently loses.
_cr_div_releases_dir_from_board() {
    [[ -z "${_cr_div_board_file:-}" ]] && return 1
    echo "$(dirname "$_cr_div_board_file")/releases"
}

# XACA-0897-103: --release-id and --platform are user-supplied CLI values
# spliced directly into a filesystem path below (${rdir}/${rel}/...). Apply
# a conservative allowlist -- defense in depth against a crafted id (e.g.
# containing '../') escaping the releases dir when the override sentinel is
# read or written.
#
# XACA-0897-109: the original allowlist (letters, digits, underscore, hyphen
# -- mirroring XACA-0897-019's team-name check) rejected '.' outright. That
# is over-broad for THIS value: a release/platform id is not a team name, and
# a dotted id (a real-looking future shape, e.g. a semver-flavored release
# id) is not itself a path-traversal vector -- '..' (parent-dir traversal) is
# the actual concern, not '.' in isolation. '.' is now permitted; '..'
# anywhere in the string, and a leading '.', remain rejected (the latter
# also blocks the degenerate '.' / '..' ids outright).
_cr_div_valid_id_charset() {
    local val="$1"
    [[ "$val" == *..* ]] && return 1
    [[ "$val" == .* ]] && return 1
    [[ "$val" =~ ^[A-Za-z0-9_.-]+$ ]]
}

# Path to the (per release+platform) single-use override sentinel.
#
# XACA-0897-109: a charset rejection here used to fail SILENTLY -- the
# caller just got `return 1` indistinguishable from any other resolution
# failure, and every caller of THIS function (_cr_div_check_override_sentinel,
# _cr_div_interactive_override_confirm) folds that into a generic "no
# override" / "could not resolve releases dir" outcome with no mention of
# the actual cause. A human hitting this with a legitimately-shaped-but-
# rejected id would see the override escape hatch silently refuse to work,
# with no signal why. Now loud: a charset rejection is reported here,
# specifically, before returning failure.
#
# XACA-0897-117 (round 22): "loud" turned out to be too loud. This function
# is called on EVERY divergence via _cr_div_check_override_sentinel, not
# only when a human is actually attempting --override-cr-divergence, so an
# ordinary rejected --release-id fired the charset warning even when nobody
# was anywhere near the override escape hatch. Optional 3rd arg $3: pass
# the literal string "quiet" to suppress the two warning blocks below (the
# function still returns 1 exactly the same either way -- only the stderr
# noise is conditional). Omit it (or pass "") to keep the original loud
# behavior -- _cr_div_interactive_override_confirm's call site (reached
# only once a human has actually invoked --override-cr-divergence) always
# omits it, so the warning stays loud exactly where XACA-0897-109 needed it.
_cr_div_override_sentinel_path() {
    local rel="$1" plat="$2" quiet="${3:-}"
    local rdir
    if ! _cr_div_valid_id_charset "$rel"; then
        if [[ "$quiet" != "quiet" ]]; then
            echo "Warning: release id '${rel}' contains characters outside the allowed set" >&2
            echo "  ([A-Za-z0-9_.-], no leading '.', no '..' anywhere) -- cannot resolve the" >&2
            echo "  CR-divergence override sentinel path for it. The --override-cr-divergence" >&2
            echo "  escape hatch is unavailable for this release id as given." >&2
        fi
        return 1
    fi
    if ! _cr_div_valid_id_charset "$plat"; then
        if [[ "$quiet" != "quiet" ]]; then
            echo "Warning: platform '${plat}' contains characters outside the allowed set" >&2
            echo "  ([A-Za-z0-9_.-], no leading '.', no '..' anywhere) -- cannot resolve the" >&2
            echo "  CR-divergence override sentinel path for it. The --override-cr-divergence" >&2
            echo "  escape hatch is unavailable for this platform as given." >&2
        fi
        return 1
    fi
    rdir=$(_cr_div_releases_dir_from_board) || return 1
    [[ -z "$rdir" ]] && return 1
    echo "${rdir}/${rel}/cr-divergence-override-${plat}.json"
}

# Reads $1 (a sentinel file, on disk RIGHT NOW under that exact name) and
# prints "yes"/"no" on stdout depending on whether its five recorded fields
# EXACTLY match the divergence in $2-$6 (releaseId, platform, crId,
# crSubmittedVersion, releaseVersionAtOverride). Never writes anything.
# Shared by both the dry-run peek and the real claim-then-validate path
# below so the match rule can never drift between the two.
_cr_div_sentinel_matches() {
    python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except Exception:
    print('no'); sys.exit(0)
ok = (d.get('releaseId') == sys.argv[2] and d.get('platform') == sys.argv[3] and
      d.get('crId') == sys.argv[4] and d.get('crSubmittedVersion') == sys.argv[5] and
      d.get('releaseVersionAtOverride') == sys.argv[6])
print('yes' if ok else 'no')
" "$1" "$2" "$3" "$4" "$5" "$6" 2>/dev/null
}

# Prints a sentinel file's overriddenBy/overriddenAt/reason fields to
# stderr. Shared by the dry-run peek and the real honor path.
_cr_div_print_sentinel_details() {
    python3 -c "
import json, sys
with open(sys.argv[1]) as fh:
    d = json.load(fh)
sys.stderr.write('  Overridden by: %s\n' % d.get('overriddenBy', '?'))
sys.stderr.write('  Overridden at: %s\n' % d.get('overriddenAt', '?'))
sys.stderr.write('  Reason:        %s\n' % d.get('reason', '?'))
" "$1" 2>&1 1>&2 || true
}

# Checks for a pre-existing override sentinel whose recorded fields EXACTLY
# match the divergence being evaluated right now. On an exact match it
# CONSUMES (deletes) the sentinel and returns 0 -- single-use, and scoped
# tightly enough that a later, different renumber cannot silently ride on an
# old approval. It never CREATES a sentinel -- only
# _cr_div_interactive_override_confirm does that, and only after a live
# human confirms interactively.
#
# XACA-0897-round21: under --dry-run (global $_dry_run == 1) this becomes a
# PEEK -- it still reports whether a matching override exists (so a dry-run
# preview's verdict is genuine, not an assumed pass), but it does NOT delete
# the sentinel, and it does not claim/rename it either (see round-22 below).
#
# XACA-0897-113 (round 22, BLOCKING): the round-21 shape read the sentinel,
# matched it, printed, and only THEN deleted it -- four separate, unlocked
# steps. N concurrent REAL invocations could all observe match=='yes' before
# any of them got as far as the `rm`, so all N honored the SAME single-use
# grant (reproduced live: 6-8 of 8 concurrent runs against one fresh
# sentinel all reported OVERRIDE HONORED). Fixed by making the CLAIM atomic
# instead of the delete: a real (non-dry-run) run first renames the
# sentinel to a per-process-unique name via `mv` before looking at its
# content at all. `mv`/rename(2) is atomic within a filesystem -- of any
# number of concurrent processes racing that exact rename, the kernel lets
# exactly one succeed; every loser's `mv` fails because the source is
# already gone, and a loser returns 1 (no override) immediately, same as
# "sentinel absent". Only the single winner ever gets to look at the
# content, so at most one process per sentinel can ever reach the
# validate-and-honor branch below -- the TOCTOU window is closed by
# construction, not by a lock file. Validation happens AFTER the claim now
# (order flipped from round 21's read-then-delete): a claimed file that
# turns out NOT to match this exact divergence is renamed back to its
# original path (never burned by a claim that didn't apply to it) --
# preserves the pre-existing "a mismatch does not consume" property.
# Consumption (delete) on a genuine match is now VERIFIED, not attempted
# (XACA-0897-119: a `rm -f ... || true` on a read-only/immutable sentinel
# used to still print "consumed" and return 0 -- the second, independent
# route to two real passes off one grant that the reviewer flagged). If the
# verified delete fails, the claim is restored to its original path (so the
# grant is not silently voided by a filesystem that merely refused the
# unlink) and this returns 1 -- a failed consumption is reported as FAILURE,
# never success, and the caller's normal fail-closed HALT takes over.
#
# RESIDUAL, disclosed rather than hidden: a process killed (`kill -9`, OOM,
# host crash) strictly between the successful claim-rename and the
# verified-delete leaves an orphaned `<path>.claimed.<pid>.<rand>` file on
# disk. The original path is gone, so every subsequent run -- correctly --
# sees "no sentinel" and fails closed (HALT), exactly as if the override had
# never been granted. The human's one-time grant is lost, not double-spent:
# this is the same direction of failure the fail-closed design already
# treats as safe everywhere else in this script (absence is never read as
# permission), so a crash here degrades to "ask the human to override
# again", not to a second, unauthorized honor. No automatic reclaim of that
# orphaned file is implemented -- a time-based "presume abandoned and
# restore it" sweep would itself be a heuristic this script cannot
# guarantee is race-free against a merely-slow (not dead) claimant, and
# XACA-0897 already treats "state the residual, don't build an
# unguaranteed cleanup" as the correct call here. Stranded `.claimed.*`
# files are safe to delete by hand once confirmed abandoned.
_cr_div_check_override_sentinel() {
    local rel="$1" plat="$2" crid="$3" cr_ver="$4" rel_ver="$5"
    local path
    # Only the human's actual override-attempt path (an interactive
    # confirmation gated behind --override-cr-divergence) needs the loud
    # charset-rejection warning (XACA-0897-109). This function runs on
    # EVERY divergence, override requested or not, purely to see whether a
    # PRE-EXISTING sentinel already covers it -- so an ordinary divergence
    # with an out-of-charset release/platform id must not shout about the
    # override escape hatch nobody asked for (XACA-0897-117).
    local _sp_quiet=""
    [[ "${_cr_div_override_requested:-0}" -eq 1 ]] || _sp_quiet="quiet"
    path=$(_cr_div_override_sentinel_path "$rel" "$plat" "$_sp_quiet") || return 1
    [[ -z "$path" ]] && return 1

    if [[ "${_dry_run:-0}" -eq 1 ]]; then
        # PEEK ONLY: no claim, no rename, no delete -- see the round-22
        # comment above. Reads the sentinel in place, exactly as round 21
        # did.
        [[ -f "$path" ]] || return 1
        local match
        match=$(_cr_div_sentinel_matches "$path" "$rel" "$plat" "$crid" "$cr_ver" "$rel_ver") || match="no"
        if [[ "$match" == "yes" ]]; then
            echo "CR-DIVERGENCE OVERRIDE FOUND (dry-run preview): a matching human-confirmed override exists and would be consumed by a real run." >&2
            echo "  --dry-run makes no writes: the sentinel is NOT being consumed by this preview and remains available." >&2
            _cr_div_print_sentinel_details "$path"
            return 0
        fi
        return 1
    fi

    [[ -f "$path" ]] || return 1

    # Atomic claim: rename to a name unique to this process before looking
    # at the content at all. Exactly one concurrent racer can win this.
    local claimed
    claimed="${path}.claimed.$$.${RANDOM}"
    if ! mv "$path" "$claimed" 2>/dev/null; then
        # Lost the race (or it vanished between the -f check above and
        # here, which is the same thing from this process's point of
        # view): no override for THIS run. Fail-closed -- never "maybe".
        return 1
    fi

    local match
    match=$(_cr_div_sentinel_matches "$claimed" "$rel" "$plat" "$crid" "$cr_ver" "$rel_ver") || match="no"

    if [[ "$match" != "yes" ]]; then
        # Claimed something, but it does not describe THIS divergence.
        # A non-matching sentinel must not be burned by a claim that
        # didn't apply to it -- restore it so a later, correctly-matching
        # check (this run's own retry, or a different run) can still find
        # it.
        if ! mv "$claimed" "$path" 2>/dev/null; then
            echo "CR-DIVERGENCE OVERRIDE ERROR: claimed a non-matching sentinel and could not restore it to ${path} -- it is stranded at ${claimed}. Restore it by hand, or have the human re-run --override-cr-divergence." >&2
        fi
        return 1
    fi

    echo "CR-DIVERGENCE OVERRIDE HONORED: a matching human-confirmed override was found and is being consumed (single-use)." >&2
    _cr_div_print_sentinel_details "$claimed"

    rm -f "$claimed" 2>/dev/null || true
    if [[ -f "$claimed" ]]; then
        # XACA-0897-119: consumption must be VERIFIED, not attempted. The
        # unlink did not take (read-only/immutable/permission failure) --
        # this is a hard failure, never a success. Try to restore the
        # claim so the grant is not silently voided by a filesystem that
        # merely refused the unlink; either way, report failure and let
        # the caller's ordinary fail-closed HALT take over -- this run
        # must NOT proceed as if the override were honored.
        echo "CR-DIVERGENCE OVERRIDE ERROR: matched and validated the override, but could not verify its deletion (still present at ${claimed} after rm) -- treating this as NOT consumed, not as honored." >&2
        if mv "$claimed" "$path" 2>/dev/null; then
            echo "  Restored to ${path} -- the override remains available for a subsequent attempt." >&2
        else
            echo "  Restore ALSO failed -- the override is stranded at ${claimed} (original path is gone). Manual recovery required." >&2
        fi
        return 1
    fi

    return 0
}

# Interactive-ONLY human confirmation. Refuses outright (returns 1) unless:
#   (a) no known agent-context env var is set (CLAUDECODE/AI_AGENT/etc), AND
#   (b) stdin is a real TTY, AND
#   (c) the human types the release id back exactly, AND
#   (d) the human supplies a non-empty reason.
# On success it WRITES the single-use sentinel; it does NOT itself clear the
# halt for this run -- the caller re-checks the sentinel immediately after,
# the same code path a later non-interactive run (e.g. kb-release-push-promote
# calling this gate automatically) will also take.
_cr_div_interactive_override_confirm() {
    local rel="$1" plat="$2" crid="$3" cr_ver="$4" rel_ver="$5"

    if _cr_div_agent_context_detected; then
        echo "CR-DIVERGENCE OVERRIDE REFUSED: this shell is an AI-agent context (CLAUDECODE/AI_AGENT env detected)." >&2
        echo "  --override-cr-divergence is human-only by design and cannot be exercised from an agent shell." >&2
        return 1
    fi
    if [[ ! -t 0 ]]; then
        echo "CR-DIVERGENCE OVERRIDE REFUSED: --override-cr-divergence requires an interactive terminal (stdin is not a TTY)." >&2
        echo "  Deliberate: this is what makes the override structurally unreachable by an automated agent" >&2
        echo "  or CI job, neither of which has a live TTY attached to answer the confirmation prompts." >&2
        return 1
    fi

    {
        echo ""
        echo "======================================================================"
        echo " CR-DIVERGENCE OVERRIDE -- HUMAN CONFIRMATION REQUIRED"
        echo "======================================================================"
        echo " Release:              ${rel}"
        echo " Platform:             ${plat}"
        echo " CR-submitted version: ${cr_ver}"
        echo " Release version now:  ${rel_ver}"
        echo " Linked CR:            ${crid}"
        echo ""
        echo " Overriding certifies you personally reviewed this renumber and it is"
        echo " intentional -- WITHOUT a fresh CAB review cycle for the new version."
        echo ""
    } >&2

    local _typed _reason
    read -r -p " Type the release id EXACTLY as shown above to confirm: " _typed
    if [[ "$_typed" != "$rel" ]]; then
        echo "CR-DIVERGENCE OVERRIDE REFUSED: typed confirmation did not match '${rel}'." >&2
        return 1
    fi
    read -r -p " Reason for override (required, recorded in the audit log): " _reason
    if [[ -z "$_reason" ]]; then
        echo "CR-DIVERGENCE OVERRIDE REFUSED: a reason is required." >&2
        return 1
    fi

    local path ts who
    path=$(_cr_div_override_sentinel_path "$rel" "$plat") || {
        echo "CR-DIVERGENCE OVERRIDE REFUSED: could not resolve releases dir to record the override." >&2
        return 1
    }
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    who="${USER:-$(whoami 2>/dev/null)}"
    mkdir -p "$(dirname "$path")" 2>/dev/null || true
    python3 -c "
import json, sys
d = {
    'releaseId': sys.argv[2], 'platform': sys.argv[3], 'crId': sys.argv[4],
    'crSubmittedVersion': sys.argv[5], 'releaseVersionAtOverride': sys.argv[6],
    'overriddenBy': sys.argv[7], 'overriddenAt': sys.argv[8], 'reason': sys.argv[9],
}
with open(sys.argv[1], 'w') as fh:
    json.dump(d, fh, indent=2)
" "$path" "$rel" "$plat" "$crid" "$cr_ver" "$rel_ver" "$who" "$ts" "$_reason" || {
        echo "CR-DIVERGENCE OVERRIDE REFUSED: could not write override record to ${path}." >&2
        return 1
    }
    echo "CR-DIVERGENCE OVERRIDE RECORDED: ${path}" >&2
    return 0
}

_cr_div_board_file=""
if declare -f _kb_get_board_file >/dev/null 2>&1; then
    _cr_div_board_file=$(_kb_get_board_file "$_team" 2>/dev/null) || _cr_div_board_file=""
fi

_cr_div_release_obj=""
_cr_div_board_parse_rc=0
if [[ -n "$_cr_div_board_file" && -f "$_cr_div_board_file" ]]; then
    _cr_div_release_obj=$(jq -c --arg id "$_release_id" '.releases[]? | select(.id == $id)' "$_cr_div_board_file" 2>/dev/null) || _cr_div_board_parse_rc=$?
fi

if [[ $_cr_div_board_parse_rc -ne 0 ]]; then
    # XACA-0897-102: the board file EXISTS but jq could not parse it -- a
    # genuinely broken record, NOT a confirmed "release not on board". Before
    # this fix, a parse failure and an empty jq match (release id simply
    # absent) both collapsed to the same empty _cr_div_release_obj, so this
    # state fell into the fallback branch below and whether it halted then
    # depended on the unrelated accident of whether a cached manifest.json
    # happened to exist for this release -- the same parse-failure-as-absence
    # substitution as the fallback-path bug this ticket exists to close (see
    # the manifest-parse-rc handling a few lines down and in the "board
    # resolved" branch below). "I could not read it" must never be
    # representable as "there is nothing there" -- fail-closed, unconditionally,
    # before we ever ask whether a manifest cache can paper over it.
    echo "CR-DIVERGENCE HALT: board file for team '${_team}' (${_cr_div_board_file}) could not be parsed -- cannot verify CR governance for release '${_release_id}'." >&2
    echo "  Fail-closed: a board file that exists but cannot be read is treated as UNSAFE, never skipped." >&2
    _write_gate_status "cr_divergence_halt" "" "" 2>/dev/null || true
    exit 3
fi

if [[ -z "$_cr_div_release_obj" ]]; then
    # -------------------------------------------------------------------
    # Board-unresolvable / release-not-on-board fallback (Reno follow-up,
    # XACA-0897 subitems 004/005). We land here for either of two reasons:
    # the board file itself could not be resolved or read at all
    # (_cr_div_board_file is empty -- unknown/board-less team, e.g. the
    # live-fleet 'mainevent' alias), or it WAS resolved/read but this
    # release simply isn't in it (dangling/nonexistent release id, or a
    # resolvable-but-stale kanban_dir, e.g. the live-fleet 'command' entry
    # pointing at a leftover pytest temp dir). Either way we cannot read
    # this release's own platforms.<plat>.version or linkedCRs[] from the
    # board, so the full version-divergence comparison in the "else"
    # branch below is not possible here.
    #
    # Before this fix, BOTH reasons hard-halted unconditionally -- the bug
    # (XACA-0897 Guard-5 regression): a release cut for a team whose board
    # cannot be resolved hard-halted regardless of whether the release
    # carried any CR governance claim at all. Verified against the live
    # fleet: 'mainevent' resolves to an empty board path (board-less alias,
    # XACA-0727/XACA-0794) and 'command' resolves to a stale pytest temp
    # dir -- neither has anything to do with whether THIS release is
    # CAB-governed.
    #
    # Fall back to the release manifest's crIds[] cache -- the SAME
    # secondary source the "else" branch below already reads when a
    # resolved release has no linkedCRs[] -- to establish only WHETHER a CR
    # governance claim exists, which is the minimum needed to choose
    # between HALT (a claim exists but can't be version-verified without
    # the board -> unsafe) and fall-through (no readable claim -> the same
    # "not applicable" policy the on-board path already uses below,
    # unchanged). A manifest file that is simply ABSENT is treated the same
    # way the on-board path already treats it (see its comment below): a
    # POSITIVELY KNOWN absence of a cached claim, not an unresolved one --
    # this fallback would otherwise re-introduce the exact bug it fixes,
    # just one layer down, for every team/release with no release-cut
    # manifest ever written. Only a manifest that EXISTS but fails to
    # parse -- a genuinely broken record we cannot read -- reaches the
    # "could not determine" HALT, per the 2026-08-07 decision recorded in
    # the plan doc: absence of data is never read as permission, but
    # absence of a RECORD is not the same as a broken one.
    _cr_div_fallback_reason="could not resolve board file for team '${_team}'"
    if [[ -n "$_cr_div_board_file" && -f "$_cr_div_board_file" ]]; then
        _cr_div_fallback_reason="release '${_release_id}' not found on board for team '${_team}'"
    elif [[ -n "$_cr_div_board_file" ]]; then
        _cr_div_fallback_reason="board file for team '${_team}' does not exist at the resolved path (${_cr_div_board_file})"
    fi

    # _cr_div_releases_dir_from_board only needs _cr_div_board_file to be a
    # non-empty STRING (dirname of it) -- it does not require the file to
    # exist -- so this already covers the "board resolved but board.json
    # missing" and "release not on board" cases. It naturally returns
    # non-zero (empty) when _cr_div_board_file itself is empty, which is
    # exactly the signal that no releases dir can be determined at all.
    _cr_div_fallback_releases_dir=$(_cr_div_releases_dir_from_board 2>/dev/null) || _cr_div_fallback_releases_dir=""

    if [[ -z "$_cr_div_board_file" ]]; then
        # XACA-0897-016: the board file resolved to an EMPTY STRING, not merely
        # a missing/stale path -- this is a genuinely board-less team (e.g. the
        # live-fleet 'mainevent' alias, XACA-0727/XACA-0794), which by design
        # also has no kanban_dir in team-paths.json (verified: team-paths.json
        # carries kanban_dir: null for it, and _kb_get_kanban_dir refuses
        # outright for board-less aliases). _cr_div_releases_dir_from_board
        # cannot derive <board_dir>/releases from an empty board path, so
        # UNLIKE the "board resolved but this release/manifest is missing"
        # cases below, there is no releases dir to even ATTEMPT a manifest
        # lookup against -- no CR-governance check of any kind was possible.
        #
        # Judgment call (XACA-0897-016 review finding, documented rather than
        # engineered around): a board-less team has no kanban_dir and
        # therefore no releases[] of its own -- there is nothing under this
        # team name for a release to be cut FROM in the first place, so
        # practical exposure is believed nil. Deliberately NOT reaching into
        # team-paths.json for some other directory to search -- that field is
        # ALSO null by design for these teams, so it would find nothing and
        # would just be machinery for a case believed unreachable. If that
        # belief is ever wrong, this falls through UNCHECKED, same as before
        # this fix -- the change here is honesty, not new coverage: the
        # message below no longer claims a manifest was read (XACA-0897-017)
        # when none could exist to read. See docs/CR_WORKFLOW.md Guard 5 §
        # "Board-less teams have no releases to govern".
        [[ $_quiet -eq 0 ]] && echo "CR-divergence check: ${_cr_div_fallback_reason} -- team '${_team}' has no kanban_dir at all, so no releases directory exists and NO manifest lookup was possible (this is NOT the same as a manifest being checked and found empty). Not applicable: board-less teams have no releases[] of their own to govern. See docs/CR_WORKFLOW.md Guard 5." >&2
        # Falls through to Steps 1-4, same disposition as the confirmed-absence
        # cases below, but via a distinct, honest message.
    else
    _cr_div_fallback_manifest_exists=0
    _cr_div_fallback_manifest_parse_rc=0
    _cr_div_linked_ids=""
    if [[ -n "$_cr_div_fallback_releases_dir" ]]; then
        _cr_div_fallback_manifest="${_cr_div_fallback_releases_dir}/${_release_id}/manifest.json"
        if [[ -f "$_cr_div_fallback_manifest" ]]; then
            _cr_div_fallback_manifest_exists=1
            _cr_div_linked_ids=$(jq -r '[(.crIds // [])[]] | unique | .[]' "$_cr_div_fallback_manifest" 2>/dev/null) || _cr_div_fallback_manifest_parse_rc=$?
        fi
    fi

    if [[ $_cr_div_fallback_manifest_exists -eq 1 && $_cr_div_fallback_manifest_parse_rc -ne 0 ]]; then
        # The manifest EXISTS but could not be parsed -- a genuinely broken
        # record, not a confirmed absence. This is the "could not
        # determine" case: fail-closed.
        echo "CR-DIVERGENCE HALT: ${_cr_div_fallback_reason}, and the release manifest at ${_cr_div_fallback_manifest} could not be parsed -- cannot verify CR governance for release '${_release_id}'." >&2
        echo "  Fail-closed: a manifest that exists but cannot be read is treated as UNSAFE, never skipped." >&2
        _write_gate_status "cr_divergence_halt" "" "" 2>/dev/null || true
        exit 3
    fi

    if [[ -n "$_cr_div_linked_ids" ]]; then
        # Manifest readable and shows one or more CR links: a governance
        # claim EXISTS but its version cannot be verified without the
        # board. Unlike a confirmed absence of any claim, this is not a
        # positively-known-safe state -- HALT.
        echo "CR-DIVERGENCE HALT: ${_cr_div_fallback_reason}, but the release manifest shows linked CR(s) -- cannot verify the release version against CAB governance without the board." >&2
        echo "  Linked CR(s) per manifest cache: $(echo "$_cr_div_linked_ids" | tr '\n' ' ' | sed 's/[[:space:]]*$//')" >&2
        echo "  Fail-closed: a confirmed CR-governance claim that cannot be version-verified is treated as UNSAFE." >&2
        _write_gate_status "cr_divergence_halt" "" "" 2>/dev/null || true
        exit 3
    fi

    # XACA-0897-017: distinguish "we read the manifest and it positively shows
    # no CR link" from "no manifest file exists at all" -- both fall through
    # to the same disposition (not applicable), but the message must not
    # claim more than what actually happened.
    if [[ $_cr_div_fallback_manifest_exists -eq 1 ]]; then
        [[ $_quiet -eq 0 ]] && echo "CR-divergence check: ${_cr_div_fallback_reason}. Release manifest was read (${_cr_div_fallback_manifest}) and shows no linked CR -- not applicable." >&2
    else
        [[ $_quiet -eq 0 ]] && echo "CR-divergence check: ${_cr_div_fallback_reason}. No release manifest exists at ${_cr_div_fallback_releases_dir}/${_release_id}/manifest.json -- confirmed absence of any CR-governance record -- not applicable." >&2
    fi
    fi
else
    # Board resolved AND release found on it: full version-divergence path,
    # unchanged from the original XACA-0897 implementation.
    # Resolve linked CR id(s): prefer release.linkedCRs[] (F5 schema), fall back
    # to the release manifest's crIds[] cache if linkedCRs is empty/absent.
    # Uses _cr_div_releases_dir_from_board (see its comment above) rather than
    # _kb_get_releases_dir directly -- the latter is unreliable under a real
    # bash `source` of kanban-helpers.sh.
    # XACA-0897-022: herestring, not `echo "$var" | jq` -- the house rule this
    # repo forbids that pattern for (a echo can mangle literal control chars).
    # Provably moot here too -- $_cr_div_release_obj is itself `jq -c` output,
    # and JSON strings always escape control chars (\n etc.) rather than
    # embedding them raw -- but the herestring sidesteps the forbidden pattern
    # outright rather than relying on that argument holding forever.
    # XACA-0897-round20 (BLOCKING finding #1): both jq reads below used to
    # squash stderr AND jq's exit code (`2>/dev/null) || _cr_div_linked_ids=""`),
    # so a genuine PARSE FAILURE collapsed to the exact same empty string as
    # "no CRs linked, confirmed" -- and the fall-through below is commented as
    # a "POSITIVELY KNOWN fact", which is false for a parse failure. The
    # correct standard already exists a few dozen lines up, in the
    # board-unresolvable fallback branch (_cr_div_fallback_manifest_parse_rc):
    # capture the rc, and treat "exists but unparseable" as fail-closed HALT,
    # never as confirmed absence. Mirror that standard here rather than
    # inventing a third variant -- this is the repo's documented
    # sibling-heuristic-drift pattern (two parallel checks of the same fact
    # that quietly drifted apart); the fix is to make them agree.
    _cr_div_linked_ids=""
    _cr_div_linkedcrs_parse_rc=0
    _cr_div_linked_ids=$(jq -r '[(.linkedCRs // [])[].crId] | unique | .[]' <<< "$_cr_div_release_obj" 2>/dev/null) || _cr_div_linkedcrs_parse_rc=$?
    if [[ $_cr_div_linkedcrs_parse_rc -ne 0 ]]; then
        echo "CR-DIVERGENCE HALT: release '${_release_id}' object read from board '${_team}' could not be parsed for linkedCRs -- cannot verify CR governance." >&2
        echo "  Fail-closed: a release record that exists but cannot be read is treated as UNSAFE, never skipped." >&2
        _write_gate_status "cr_divergence_halt" "" "" 2>/dev/null || true
        exit 3
    fi

    _cr_div_manifest_exists=0
    _cr_div_manifest_parse_rc=0
    if [[ -z "$_cr_div_linked_ids" ]]; then
        _cr_div_releases_dir=$(_cr_div_releases_dir_from_board 2>/dev/null) || _cr_div_releases_dir=""
        _cr_div_manifest="${_cr_div_releases_dir}/${_release_id}/manifest.json"
        if [[ -n "$_cr_div_releases_dir" && -f "$_cr_div_manifest" ]]; then
            _cr_div_manifest_exists=1
            _cr_div_linked_ids=$(jq -r '[(.crIds // [])[]] | unique | .[]' "$_cr_div_manifest" 2>/dev/null) || _cr_div_manifest_parse_rc=$?
        fi
    fi

    if [[ $_cr_div_manifest_exists -eq 1 && $_cr_div_manifest_parse_rc -ne 0 ]]; then
        # The manifest EXISTS but could not be parsed -- a genuinely broken
        # record, not a confirmed absence. Before this fix, THIS EXACT
        # corrupt-manifest input HALTed via the board-unresolvable fallback
        # branch above but silently PASSED here, on the board-resolved path
        # every ordinary release cut actually takes -- same file, same
        # corruption, two different verdicts depending on which branch found
        # it first. Fail-closed, matching the fallback branch's standard.
        echo "CR-DIVERGENCE HALT: release '${_release_id}' has no linkedCRs[] on the board, and the release manifest at ${_cr_div_manifest} could not be parsed -- cannot verify CR governance." >&2
        echo "  Fail-closed: a manifest that exists but cannot be read is treated as UNSAFE, never skipped." >&2
        _write_gate_status "cr_divergence_halt" "" "" 2>/dev/null || true
        exit 3
    fi

    if [[ -z "$_cr_div_linked_ids" ]]; then
        # No CR governance claim exists on this release at all -- a POSITIVELY
        # KNOWN fact, not an unresolved one, so this is NOT the "could not
        # determine" case the fail-closed policy targets. Falls through to
        # Steps 1-4 below unchanged.
        [[ $_quiet -eq 0 ]] && echo "CR-divergence check: no CR linked to release '${_release_id}' -- not applicable." >&2
    else
        # Release's own version for this platform -- the SAME field Step 1 reads
        # (platforms.<plat>.version, per F1) -- read here from the local board
        # copy so this check does not depend on LCARS reachability.
        # XACA-0897-022: herestring, not `echo | jq` -- see comment above.
        _cr_div_release_version=$(jq -r --arg p "$_platform" '(.platforms[$p].version // "") | tostring' <<< "$_cr_div_release_obj" 2>/dev/null) || _cr_div_release_version=""

        _cr_div_halt=0
        _cr_div_seen_version=""
        _cr_div_seen_cr=""

        while IFS= read -r _cr_div_id; do
            [[ -z "$_cr_div_id" ]] && continue
            _cr_div_cr_obj=$(jq -c --arg id "$_cr_div_id" '.crs[]? | select(.id == $id)' "$_cr_div_board_file" 2>/dev/null) || _cr_div_cr_obj=""
            if [[ -z "$_cr_div_cr_obj" ]]; then
                echo "CR-DIVERGENCE HALT: release '${_release_id}' links CR '${_cr_div_id}' which does not exist on board '${_team}' -- cannot verify CR governance." >&2
                _cr_div_halt=1
                break
            fi
            # XACA-0897-022: herestring, not `echo | jq` -- see comment above.
            _cr_div_submitted=$(jq -r '(.cr_submitted_version // "") | tostring' <<< "$_cr_div_cr_obj" 2>/dev/null) || _cr_div_submitted=""
            if [[ -z "$_cr_div_submitted" ]]; then
                echo "CR-DIVERGENCE HALT: CR '${_cr_div_id}' linked to release '${_release_id}' has no cr_submitted_version stamped." >&2
                echo "  A missing stamp is treated as UNSAFE, not permission to proceed (2026-08-07 decision)." >&2
                echo "  If this is a legacy CR pre-dating XACA-0897, run the cr_submitted_version backfill tool, then retry." >&2
                _cr_div_halt=1
                break
            fi
            if [[ -z "$_cr_div_seen_version" ]]; then
                _cr_div_seen_version="$_cr_div_submitted"
                _cr_div_seen_cr="$_cr_div_id"
            elif [[ "$_cr_div_submitted" != "$_cr_div_seen_version" ]]; then
                echo "CR-DIVERGENCE HALT: release '${_release_id}' has multiple linked CRs asserting DIFFERENT submitted versions -- ambiguous governance state." >&2
                echo "  CR '${_cr_div_seen_cr}': cr_submitted_version='${_cr_div_seen_version}'" >&2
                echo "  CR '${_cr_div_id}': cr_submitted_version='${_cr_div_submitted}'" >&2
                _cr_div_halt=1
                break
            fi
        done <<< "$_cr_div_linked_ids"

        if [[ $_cr_div_halt -eq 0 ]]; then
            if [[ -z "$_cr_div_release_version" ]]; then
                echo "CR-DIVERGENCE HALT: release '${_release_id}' platform '${_platform}' has no version set, but linked CR '${_cr_div_seen_cr}' was submitted at version '${_cr_div_seen_version}'." >&2
                echo "  Cannot confirm the release has not drifted from what CAB approved. Fail-closed: absence is not permission." >&2
                _cr_div_halt=1
            elif [[ "$_cr_div_release_version" != "$_cr_div_seen_version" ]]; then
                if _cr_div_check_override_sentinel "$_release_id" "$_platform" "$_cr_div_seen_cr" "$_cr_div_seen_version" "$_cr_div_release_version"; then
                    # XACA-0897-118: under --dry-run, _cr_div_check_override_sentinel
                    # PEEKS -- it never consumes anything (see its own doc comment
                    # above, and the "dry-run preview" message it already printed
                    # two lines earlier). This summary line used to say "proceeding
                    # on a consumed human override" unconditionally, directly
                    # contradicting the peek branch's own "NOT being consumed"
                    # message from moments before. Say what actually happened on
                    # each path instead of one fixed sentence for both.
                    if [[ "${_dry_run:-0}" -eq 1 ]]; then
                        [[ $_quiet -eq 0 ]] && echo "CR-DIVERGENCE CHECK PASS (dry-run preview): release '${_release_id}' platform '${_platform}' would proceed on a pre-recorded human override (not consumed by this preview)."
                    else
                        [[ $_quiet -eq 0 ]] && echo "CR-DIVERGENCE CHECK PASS (OVERRIDDEN, pre-recorded): release '${_release_id}' platform '${_platform}' proceeding on a consumed human override."
                    fi
                elif [[ "${_cr_div_override_requested:-0}" -eq 1 ]] \
                    && _cr_div_interactive_override_confirm "$_release_id" "$_platform" "$_cr_div_seen_cr" "$_cr_div_seen_version" "$_cr_div_release_version"; then
                    # Sentinel just WRITTEN by the interactive confirmation above.
                    # Deliberately NOT self-consumed in this same run: this
                    # manual, standalone invocation only exists to RECORD the
                    # human's decision. Consuming it here too would burn the
                    # single use on a run that never actually drives a release
                    # cut, leaving nothing for the automated caller that DOES
                    # (kb-release-push-promote's own, separate, non-interactive
                    # re-run of this gate) — which is the entire point of
                    # persisting it to disk rather than just returning 0 in
                    # memory. That next matching invocation — automated or not —
                    # is what calls _cr_div_check_override_sentinel and consumes
                    # it. This run stops here, cleanly, without touching Steps
                    # 1-4 below (there is nothing further for a bare recording
                    # action to check).
                    echo "CR-DIVERGENCE OVERRIDE RECORDED — this run performed no further action." >&2
                    echo "  The override is a SINGLE-USE grant scoped to this exact divergence. The next" >&2
                    echo "  gate check for release '${_release_id}' platform '${_platform}' (e.g. an automated" >&2
                    echo "  release-cut re-run by kb-release-push-promote) will find, consume, and honor it." >&2
                    exit 0
                else
                    echo "CR-DIVERGENCE HALT: release '${_release_id}' platform '${_platform}' version has diverged from the CAB-approved CR version." >&2
                    echo "  Release manifest version (platforms.${_platform}.version): ${_cr_div_release_version}" >&2
                    echo "  CR-submitted version    (cr_submitted_version):            ${_cr_div_seen_version}" >&2
                    echo "  Linked CR:                                                 ${_cr_div_seen_cr}" >&2
                    echo "  This release was renumbered after the CR was submitted/approved. Creating a" >&2
                    echo "  new CR page triggers a new CAB review -- do not rename/re-submit casually." >&2
                    echo "  This halt cannot be cleared by --auto-bump or by any agent. Resolution requires" >&2
                    echo "  an explicit human decision. See docs/ for the 'CR-Divergence Halt (Guard 5)'" >&2
                    echo "  resolution procedure." >&2
                    _cr_div_halt=1
                fi
            else
                [[ $_quiet -eq 0 ]] && echo "CR-DIVERGENCE CHECK PASS: release '${_release_id}' platform '${_platform}' version '${_cr_div_release_version}' matches CR '${_cr_div_seen_cr}' cr_submitted_version."
            fi
        fi

        if [[ $_cr_div_halt -ne 0 ]]; then
            _write_gate_status "cr_divergence_halt" "${_cr_div_release_version:-}" "${_cr_div_seen_version:-}" 2>/dev/null || true
            exit 3
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Step 1: Load release.platforms.<platform>.version from LCARS API
# ---------------------------------------------------------------------------
_release_json=""
_release_json=$(curl -s \
    --connect-timeout 5 \
    --max-time 10 \
    "${_lcars_base}/api/releases/${_release_id}" 2>/dev/null) || _release_json=""

if [[ -z "$_release_json" ]]; then
    echo "Warning: LCARS unavailable — cannot reach ${_lcars_base}/api/releases/${_release_id}" >&2
    echo "  Gate skipped (LCARS not running)." >&2
    # Best-effort status write will also fail; skip it
    exit 0
fi

# Validate response is a JSON object with an "id" field.
# Uses a sentinel string rather than exit codes to avoid set -e gotchas.
_lcars_valid=$(echo "$_release_json" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print('ok' if 'id' in d else 'err')
except Exception:
    print('err')
" 2>/dev/null) || _lcars_valid="err"

if [[ "$_lcars_valid" != "ok" ]]; then
    echo "Error: Release '${_release_id}' not found or LCARS returned an error." >&2
    echo "  Response: $(echo "$_release_json" | head -c 200)" >&2
    exit 1
fi

# Extract target version: platforms.<plat>.version
# Uses sentinel prefix strings to avoid exit-code ambiguity under set -e.
_target_version=$(echo "$_release_json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
plat = sys.argv[1]
platforms = data.get('platforms', {})
if plat not in platforms:
    print('__NO_PLATFORM__')
    sys.exit(0)
ver = (platforms[plat].get('version') or '').strip()
if not ver:
    print('__NO_VERSION__')
    sys.exit(0)
print(ver)
" "$_platform" 2>/dev/null) || _target_version=""

if [[ "$_target_version" == "__NO_PLATFORM__" ]]; then
    # Platform not in release at all
    if [[ "${_env:-}" == "PROD" ]]; then
        echo "VERSION GATE FAILED: platform '${_platform}' not found in release '${_release_id}' (required at PROD)." >&2
        _write_gate_status "fail" "" ""
        exit 1
    fi
    [[ $_quiet -eq 0 ]] && echo "Warning: platform '${_platform}' not found in release '${_release_id}' — gate skipped." >&2
    _write_gate_status "skip" "" ""
    exit 0
fi

if [[ "$_target_version" == "__NO_VERSION__" || -z "$_target_version" ]]; then
    # No target version set
    if [[ "${_env:-}" == "PROD" ]]; then
        echo "VERSION GATE FAILED: no target version set for '${_platform}' in release '${_release_id}'." >&2
        echo "  At PROD a version is required. Fix: kb-release edit ${_release_id} --platform-version ${_platform}=<ver>" >&2
        _write_gate_status "fail" "" ""
        exit 1
    fi
    # Non-PROD: hard warning, proceed (OQ-5 = HARD WARNING not block)
    echo "Warning: no target version set for '${_platform}' in release '${_release_id}' — gate skipped." >&2
    echo "  Set it with: kb-release edit ${_release_id} --platform-version ${_platform}=<ver>" >&2
    _write_gate_status "skip" "" ""
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 2: Load version_sources config for team/platform
# Use the shell accessor (from kanban-helpers.sh) as primary source.
# Fallback: inline Python against team-paths.json when shell accessor unavailable.
# ---------------------------------------------------------------------------
_version_sources_json=""
if declare -f _kb_get_team_version_sources >/dev/null 2>&1; then
    _version_sources_json=$(_kb_get_team_version_sources "$_team" "$_platform" 2>/dev/null) || _version_sources_json="[]"
fi

# Inline fallback (when kanban-helpers.sh was not sourced)
if [[ -z "$_version_sources_json" || "$_version_sources_json" == "[]" ]]; then
    _version_sources_json=$(python3 - "$_team" "$_platform" 2>/dev/null <<'PYEOF'
import json, os, sys
from pathlib import Path
team, platform = sys.argv[1], sys.argv[2]
cfg = os.environ.get("AITEAMFORGE_CONFIG") or os.path.expanduser("~/.aiteamforge/team-paths.json")
try:
    with open(cfg) as fh:
        data = json.load(fh)
except Exception:
    print("[]")
    sys.exit(0)
sources = data.get("teams", {}).get(team, {}).get("version_sources", [])
if not isinstance(sources, list):
    sources = []
if platform:
    sources = [s for s in sources if isinstance(s, dict) and s.get("platform") == platform]
print(json.dumps([s for s in sources if isinstance(s, dict)]))
PYEOF
) || _version_sources_json="[]"
fi

if [[ -z "$_version_sources_json" || "$_version_sources_json" == "[]" ]]; then
    [[ $_quiet -eq 0 ]] && echo "Warning: no version_source configured for '${_platform}' in team '${_team}' — gate skipped." >&2
    [[ $_quiet -eq 0 ]] && echo "  Configure version_sources in ~/.aiteamforge/team-paths.json for team '${_team}'." >&2
    _write_gate_status "skip" "" "$_target_version"
    exit 0
fi

# Extract first matching source entry
_source_file=$(echo "$_version_sources_json" | python3 -c "
import json, sys
sources = json.load(sys.stdin)
if sources:
    print(sources[0].get('file', ''))
" 2>/dev/null) || _source_file=""

_match_pattern=$(echo "$_version_sources_json" | python3 -c "
import json, sys
sources = json.load(sys.stdin)
if sources:
    print(sources[0].get('match_pattern', ''))
" 2>/dev/null) || _match_pattern=""

if [[ -z "$_source_file" || -z "$_match_pattern" ]]; then
    [[ $_quiet -eq 0 ]] && echo "Warning: version_source for '${_platform}' is missing 'file' or 'match_pattern' — gate skipped." >&2
    _write_gate_status "skip" "" "$_target_version"
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 3: Resolve absolute path and read current version from file
# ---------------------------------------------------------------------------
# working_dir is needed to resolve relative paths
_working_dir=$(python3 - "$_team" 2>/dev/null <<'PYEOF'
import json, os, sys
from pathlib import Path
team = sys.argv[1]
cfg_path = os.environ.get("AITEAMFORGE_CONFIG") or os.path.expanduser("~/.aiteamforge/team-paths.json")
try:
    with open(cfg_path) as fh:
        data = json.load(fh)
except Exception:
    sys.exit(1)
entry = data.get("teams", {}).get(team, {})
wd = entry.get("working_dir", "")
if not wd:
    sys.exit(1)
print(str(Path(wd).expanduser()))
PYEOF
) || _working_dir=""

if [[ -z "$_working_dir" ]]; then
    [[ $_quiet -eq 0 ]] && echo "Warning: could not resolve working_dir for team '${_team}' — gate skipped." >&2
    _write_gate_status "skip" "" "$_target_version"
    exit 0
fi

# Build absolute path
if [[ "$_source_file" = /* ]]; then
    _abs_file="$_source_file"
else
    _abs_file="${_working_dir}/${_source_file}"
fi

if [[ ! -f "$_abs_file" ]]; then
    [[ $_quiet -eq 0 ]] && echo "Warning: version file not found: ${_abs_file} — gate skipped." >&2
    _write_gate_status "skip" "" "$_target_version"
    exit 0
fi

# Read current version using match_pattern (same regex logic as bump engine).
# Uses sentinel prefixes to avoid exit-code ambiguity under set -e.
_current_version=$(python3 - "$_abs_file" "$_match_pattern" 2>/dev/null <<'PYEOF'
import re, sys
filepath    = sys.argv[1]
pattern_tpl = sys.argv[2]

# Convert {version} placeholder to a regex capture group (same logic as bump engine)
VERSION_RE = r'([0-9]+\.[0-9]+(?:\.[0-9]+)?(?:-[A-Za-z0-9.+]+)?)'
regex_str = re.escape(pattern_tpl).replace(r'\{version\}', VERSION_RE)

try:
    with open(filepath, encoding='utf-8', errors='replace') as fh:
        content = fh.read()
except Exception as e:
    print(f"__READ_ERROR__: {e}")
    sys.exit(0)

m = re.search(regex_str, content)
if not m:
    print("__NO_MATCH__")
    sys.exit(0)
print(m.group(1))
PYEOF
) || _current_version=""

if [[ "$_current_version" == __READ_ERROR__* ]]; then
    echo "VERSION GATE FAILED: error reading version from ${_abs_file}" >&2
    _write_gate_status "fail" "" "$_target_version"
    exit 1
fi

if [[ "$_current_version" == "__NO_MATCH__" || -z "$_current_version" ]]; then
    echo "VERSION GATE FAILED: could not find version matching pattern in ${_abs_file}" >&2
    echo "  Pattern: ${_match_pattern}" >&2
    _write_gate_status "fail" "" "$_target_version"
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 4: Compare current version == target version
# ---------------------------------------------------------------------------
if [[ "$_current_version" == "$_target_version" ]]; then
    # PASS
    [[ $_quiet -eq 0 ]] && echo "VERSION GATE PASS: ${_platform} code version ${_current_version} matches release target ${_target_version}"
    _write_gate_status "pass" "$_current_version" "$_target_version"
    exit 0
else
    # FAIL
    echo "VERSION GATE FAILED: ${_platform} code version ${_current_version} != release target ${_target_version}" >&2
    echo "  File:   ${_abs_file}" >&2
    echo "  Fix A:  kb-release-version-bump ${_release_id} --platform ${_platform}" >&2
    echo "  Fix B:  kb-release edit ${_release_id} --platform-version ${_platform}=${_current_version}" >&2
    _write_gate_status "fail" "$_current_version" "$_target_version"
    exit 1
fi
