#!/usr/bin/env python3
"""kb-sync-plugins -- fleet-standard Claude Code plugin delivery (XACA-1599).

Usage: kb-sync-plugins <subcommand> [args]
Subcommands: list, check, sync, diff, sync-worktrees, binaries, skills, managed-policy, help

Source of truth: .claude/plugins-manifest.json, schema 2 (XACA-1643): ONE `fleet.plugins`
                 list, rendered per team by effective_team_cfg() minus recorded exceptions.
Writes:          <session dir>/.claude/settings.json, keys `enabledPlugins` and
                 `extraKnownMarketplaces` ONLY. Every other key is preserved.

Why this exists (XACA-1599 design record, sections 2.1-2.3): Claude Code reads
project settings from the primary working directory only (it does not walk up),
and user-scope settings cannot vary by team. So the team plugin list has to be
delivered to every directory a session can start in, without clobbering what a
human put in the same file.

Hard guards (each is covered by a mutation-sentinel test):
  * Never opens settings.local.json. Any target whose basename is not exactly
    `settings.json` is refused. `settings.local.json` is the documented per-person
    opt-out; this tool must never read or write it.
  * Removes a key only when this tool provably put it there (local state file,
    or a manifest tombstone in `retiredPlugins`). A human's key is never removed.
  * An unparseable target is a FAILURE, never overwritten.
  * A key a human changed is reported CONFLICT and left alone.

  * managed-policy never touches the system managed dir silently: the privileged
    swap runs only after an explicit [y/N] on a real terminal, through `sudo` (never
    `sudo -n`), as validate -> stage -> atomic `mv` -> read-back -> rollback. It
    removes or replaces ONLY its own drop-in file (50-aiteamforge.json).
  * `sync --install-missing` installs with `--scope project` only, never user or local.

Exit codes (check): 0 clean, 1 drift, 2 usage/environment error,
3 unverifiable (manifest/plugin list unreadable, claude below the floor, or the
--probe could not run). 3 is never folded into 0.
Exit code 70: an unexpected Python exception, so a caller can tell a crash of this
tool from "binary missing" (1) or drift (1).
Exit codes (managed-policy): 0 done or already current, 1 failed, 2 usage,
3 invalid policy, 4 not performed (non-interactive or declined: PENDING).

Runs on python3 >= 3.8, stdlib only (tap hosts have only the system python).
"""
import argparse
import contextlib
import copy
import difflib
import fcntl
import hashlib
import json
import os
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

PROG = "kb-sync-plugins"
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
DEV_TEAM = os.path.dirname(SCRIPT_DIR)

MANIFEST = os.environ.get("KBSPL_MANIFEST") or os.path.join(DEV_TEAM, ".claude", "plugins-manifest.json")
PERSONAS_MANIFEST = os.environ.get("KBSPL_PERSONAS_MANIFEST") or os.path.join(DEV_TEAM, ".claude", "personas-manifest.json")
TEAM_PATHS_JSON = os.environ.get("TEAM_PATHS_JSON") or os.path.expanduser("~/.aiteamforge/team-paths.json")
STATE_FILE = os.environ.get("KBSPL_STATE") or os.path.expanduser("~/.aiteamforge/state/kb-sync-plugins.json")
CATALOG_JSON = os.environ.get("KBSPL_CATALOG") or os.path.expanduser(
    "~/.claude/plugins/marketplaces/claude-plugins-official/.claude-plugin/marketplace.json")
CLAUDE_BIN = os.environ.get("KBSPL_CLAUDE") or "claude"
# CLAUDE_MANAGED_DIR is the managed-settings BASE dir: the one that holds managed-settings.json
# and the managed-settings.d/ drop-in dir. Tests always override it; the default is the real
# system path and is refused under TEST_TMP_DIR (guard_default_managed_dir).
DEFAULT_MANAGED_BASE = "/Library/Application Support/ClaudeCode"
MANAGED_BASE = os.environ.get("CLAUDE_MANAGED_DIR") or DEFAULT_MANAGED_BASE
DROPIN_NAME = "managed-settings.d"
POLICY_FILE = "50-aiteamforge.json"  # the ONLY file managed-policy ever writes or removes
POLICY_ENV = "AITEAMFORGE_MANAGED_POLICY"
EXIT_CRASH = 70
# Test-only seam so the settings.local.json guard can be exercised. The guard
# itself rejects any value other than "settings.json", so this can never be
# used to write anything else.
TARGET_BASENAME = os.environ.get("KBSPL_TARGET_BASENAME") or "settings.json"

SECTIONS = ("enabledPlugins", "extraKnownMarketplaces")
PLUGIN_ID_RE = re.compile(r"^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$")
VERSION_RE = re.compile(r"(\d+)\.(\d+)\.(\d+)")
EXCLUDE_LINE_TAIL = ".claude/settings.json"


class ToolError(Exception):
    """Environment/usage failure. `code` is the process exit code."""

    def __init__(self, msg, code=2):
        Exception.__init__(self, msg)
        self.code = code


def err(msg):
    sys.stderr.write("%s: ERROR: %s\n" % (PROG, msg))


def warn(msg):
    sys.stderr.write("%s: WARN: %s\n" % (PROG, msg))


def out(msg=""):
    sys.stdout.write(msg + "\n")


# ---------------------------------------------------------------------------
# JSON / filesystem helpers
# ---------------------------------------------------------------------------

def load_json(path, what, code=2):
    try:
        with open(path, "r") as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        raise ToolError("%s unreadable or not valid JSON: %s (%s)" % (what, path, exc), code)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def atomic_write_json(path, obj):
    # Write THROUGH a symlink: os.replace on the link itself would swap it for a
    # regular file and silently sever a dotfile-managed settings.json.
    path = os.path.realpath(path)  # GUARD:symlink
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    mode = 0o644
    try:
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".kbspl-tmp-")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(obj, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def expand(p):
    return os.path.expanduser(p)


def run(argv, cwd=None, timeout=60, env=None):
    """Run a command; return (rc, stdout, stderr). rc 127 if missing, 124 on timeout.
    env=None inherits the caller's environment."""
    try:
        cp = subprocess.run(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True, timeout=timeout)
        return cp.returncode, cp.stdout, cp.stderr
    except FileNotFoundError:
        return 127, "", "command not found: %s" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "timed out after %ss: %s" % (timeout, " ".join(argv))


def git(args, cwd=None):
    return run(["git"] + args, cwd=cwd)


# ---------------------------------------------------------------------------
# Manifest + registry
# ---------------------------------------------------------------------------

def load_manifest():
    # An unreadable manifest is exit 3, never a pass.
    return expand_patterns(load_json(MANIFEST, "plugins manifest", code=3))  # GUARD:unverifiable


def team_paths():
    """Return the parsed registry, or None when the file does not exist."""
    if not os.path.exists(TEAM_PATHS_JSON):
        return None
    tp = load_json(TEAM_PATHS_JSON, "team-paths registry", code=3)
    # A registry of the wrong shape verifies nothing: exit 3, never a traceback
    # (rc 1 reads as drift) and never a quiet "no teams here".
    if not isinstance(tp, dict) or not isinstance(tp.get("teams"), dict):  # GUARD:registry-shape
        raise ToolError("team-paths registry %s: expected an object with a `teams` object "
                        "(NO_HOSTED_TEAMS: nothing can be verified)" % TEAM_PATHS_JSON, 3)
    return tp


def working_dir(team):
    """Resolve ${working_dir}. None = this host does not host the team."""
    tp = team_paths()
    if tp is not None:
        ent = tp["teams"].get(team)
        if ent is None:
            return None
        if not isinstance(ent, dict) or not isinstance(ent.get("working_dir", ""), str):
            raise ToolError("team-paths registry %s: teams.%s must be an object whose working_dir "
                            "is a string (NO_HOSTED_TEAMS: nothing can be verified)" % (TEAM_PATHS_JSON, team), 3)
        if ent.get("working_dir"):
            return expand(ent["working_dir"])
        return None
    # No registry (pure dev layout): fall back to the personas manifest target.
    if os.path.exists(PERSONAS_MANIFEST):
        pm = load_json(PERSONAS_MANIFEST, "personas manifest", code=3)
        deps = pm.get("deployments", []) if isinstance(pm, dict) else None
        if not isinstance(deps, list):
            raise ToolError("personas manifest %s: expected an object with a `deployments` list "
                            "(NO_HOSTED_TEAMS: nothing can be verified)" % PERSONAS_MANIFEST, 3)
        for dep in deps:
            if isinstance(dep, dict) and dep.get("team") == team and isinstance(dep.get("targetRepo"), str) \
                    and dep["targetRepo"]:
                return expand(dep["targetRepo"])
    return None


def registry_team_names():
    """Names a team-pattern may expand to: the registry keys that own a working_dir (an `alias_of` entry
    owns none, so an alias never expands). No registry (pure dev layout): the personas manifest teams.
    Tolerant of a malformed entry on purpose; working_dir() is what rejects one when it is resolved."""
    tp = team_paths()
    if tp is not None:
        return sorted(k for k, ent in tp["teams"].items()
                      if isinstance(ent, dict) and isinstance(ent.get("working_dir"), str) and ent["working_dir"])
    if os.path.exists(PERSONAS_MANIFEST):
        pm = load_json(PERSONAS_MANIFEST, "personas manifest", code=3)
        deps = pm.get("deployments", []) if isinstance(pm, dict) else []
        if isinstance(deps, list):
            return sorted({d["team"] for d in deps if isinstance(d, dict) and isinstance(d.get("team"), str)
                           and isinstance(d.get("targetRepo"), str) and d["targetRepo"]})
    return []


# `teamTargetPatterns` (XACA-1643 round 1): one pattern target stands for every registry team whose key
# starts with the prefix, so the shipped manifest names no client or project team. `<prefix>-*` only:
# a literal prefix that ends in a dash, then a star.
PATTERN_RE = re.compile(r"^([a-z0-9][a-z0-9-]*-)\*$")
PATTERN_KEYS = {"mode", "sessionDirs", "worktreeRepos", "deliver", "deliverReason", "requiredBinaries", "group"}


def expand_patterns(m):
    """Expand `teamTargetPatterns` from the registry into plain `teamTargets` entries and into the
    `teams` list of the group each pattern names. Returns a new dict (the input is not changed). A
    malformed pattern is left for validate_patterns() to report; an expansion that lands on a name
    already defined is recorded in `_patternExpansion.conflicts` for the same reason. Everything
    downstream (validation, the connector floor, the resolver) then sees ordinary targets."""
    pats = m.get("teamTargetPatterns") if isinstance(m, dict) else None
    if not isinstance(pats, dict) or not pats or not isinstance(m.get("teamTargets"), dict):
        return m
    m = dict(m)
    m["teamTargets"] = dict(m["teamTargets"])
    groups = dict(m["teamGroups"]) if isinstance(m.get("teamGroups"), dict) else {}
    m["teamGroups"] = groups
    names = registry_team_names()
    info = {"expanded": {}, "conflicts": []}
    for glob in sorted(pats):
        body = pats[glob]
        mt = PATTERN_RE.match(glob) if isinstance(glob, str) else None
        if not mt or not isinstance(body, dict):
            continue
        for n in names:
            if not n.startswith(mt.group(1)):
                continue
            if n in m["teamTargets"] or n in info["expanded"]:
                info["conflicts"].append((glob, n, info["expanded"].get(n)))
                continue
            info["expanded"][n] = glob
            m["teamTargets"][n] = {k: copy.deepcopy(v) for k, v in body.items() if k != "group"}
            g = body.get("group")
            if isinstance(g, str) and isinstance(groups.get(g), dict):
                ng = dict(groups[g])
                ng["teams"] = sorted(set(x for x in (ng.get("teams") or []) if isinstance(x, str)) | {n})
                groups[g] = ng
    m["_patternExpansion"] = info
    return m


def no_hosted_teams(what):
    """Zero live targets means nothing was verified. Exit 3 (unverifiable), never 0."""
    err("NO_HOSTED_TEAMS: %s -- no manifest team resolves to an existing directory on this host; "
        "nothing was verified (check %s and the personas manifest)" % (what, TEAM_PATHS_JSON))
    return 3


def any_live(dirs):
    return any(os.path.isdir(d) for d in dirs)


# A dir spec may start with a registry reference. `${working_dir}` is THIS team's registry
# working_dir; `${working_dir:<registry key>}` is another registry key's working_dir (a dir that has
# its own registry entry but no team of its own, e.g. a second repo a team also works in). Nothing
# else is a token: a literal path is still allowed, a stray `${...}` is a validation error.
WD_REF_RE = re.compile(r"^\$\{working_dir(?::([A-Za-z0-9][A-Za-z0-9._-]*))?\}")


def resolve_dirs(team, cfg, key="sessionDirs"):
    """Resolve a team's dirs. Returns None when the team is not hosted here.

    A keyed ref (`${working_dir:<key>}`) whose key this host's registry does not hold is DROPPED, not an
    error: that dir lives on a host that has the repo, and the team's own dir decides hosting."""
    raw = cfg.get(key) or []
    uses_self = False
    dirs = []
    for d in raw:
        mt = WD_REF_RE.match(d)
        if mt:
            wd = working_dir(mt.group(1) or team)
            if wd is None:
                if mt.group(1) is None:
                    return None
                continue
            uses_self = uses_self or mt.group(1) is None
            d = wd + d[mt.end():]
        dirs.append(os.path.abspath(expand(d)))
    if not uses_self and key == "sessionDirs" and not any(os.path.isdir(d) for d in dirs):
        return None
    return dirs


def list_worktrees(repo):
    """Linked worktrees of `repo` (the main worktree is excluded)."""
    if not os.path.isdir(repo):
        return []
    rc, so, _se = git(["-C", repo, "worktree", "list", "--porcelain"])
    if rc != 0:
        return []
    paths = [ln[len("worktree "):] for ln in so.splitlines() if ln.startswith("worktree ")]
    return [os.path.abspath(p) for p in paths[1:]]


def target_path(directory):
    return os.path.join(directory, ".claude", TARGET_BASENAME)


def guard_target(path):
    """Refuse anything that is not exactly <dir>/.claude/settings.json."""
    # Writes go through symlinks, so judge the file the path resolves to:
    # settings.json -> settings.local.json must not reach the opt-out file, and
    # no link may reach the user-scope ~/.claude/settings.json.
    real = os.path.realpath(path)
    # Never CREATE anything through a symlink. A link's target can be spelled any
    # number of ways (case, firmlinks such as /System/Volumes/Data, ..), so rather
    # than recognise every spelling of ~/.claude, a linked .claude or settings.json
    # must already resolve to an existing file; the sync only ever updates it.
    linked = os.path.islink(path) or os.path.islink(os.path.dirname(path))
    if linked and not os.path.isfile(real):  # GUARD:dangling-link
        raise ToolError("refusing target %s: it is a symlink (or sits in a symlinked .claude) "
                        "whose target %s does not exist; the sync never creates files "
                        "through a link" % (path, real))
    if os.path.basename(real) != "settings.json":  # GUARD:local-json
        raise ToolError("refusing target %s (resolves to %s): only settings.json is ever "
                        "touched (settings.local.json is the user's opt-out)" % (path, real))
    # Do not trust spellings. APFS is case-insensitive, so ~/.CLAUDE/settings.json is
    # the user-scope file under another string, and it may not exist yet (so there is
    # no file to compare): match case-folded paths, the file, or its parent dir.
    user_dir = os.path.realpath(os.path.join(os.path.expanduser("~"), ".claude"))
    user_scope = os.path.join(user_dir, "settings.json")
    is_user_scope = (real.casefold() == user_scope.casefold() or _same_file(real, user_scope)
                     or _same_file(os.path.dirname(real), user_dir))
    if is_user_scope:  # GUARD:user-scope-link
        raise ToolError("refusing target %s: it resolves to the user-scope %s" % (path, user_scope))
    # Anchor on $HOME, which always exists, not on ~/.claude, which may not yet: a
    # session dir spelled or linked as /System/Volumes/Data/<home> lands in
    # <home>/.claude without any link inside the session dir to notice.
    parent = os.path.dirname(real)
    in_home_claude = (os.path.basename(parent).casefold() == ".claude"
                      and _same_file(os.path.dirname(parent), os.path.expanduser("~")))
    if in_home_claude:  # GUARD:home-anchored
        raise ToolError("refusing target %s: it resolves into the user-scope %s/.claude" % (
            path, os.path.expanduser("~")))
    # A hard link has no symlink to resolve and could be any other file, including a
    # settings.local.json anywhere; a settings.json the sync owns has exactly one name.
    try:
        nlink = os.stat(real).st_nlink
    except OSError:
        nlink = 1
    if nlink > 1:  # GUARD:hardlink
        raise ToolError("refusing target %s: it is hard-linked (%d names), so it may be "
                        "another file such as a settings.local.json" % (path, nlink))


def _same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


# ---------------------------------------------------------------------------
# Manifest validation (check --manifest)
# ---------------------------------------------------------------------------

SCHEMA_VERSION = 2
TEAM_KEYS = {"mode", "sessionDirs", "worktreeRepos", "deliver", "deliverReason", "requiredBinaries"}
TOP_KEYS = {"schemaVersion", "lastUpdated", "minClaudeVersion", "baseline", "binaries", "pluginClasses",
            "fleet", "teamGroups", "exceptions", "liveOutOfScope", "skills", "unmanagedTeams", "teamTargets",
            "teamTargetPatterns"}
FLEET_KEYS = {"plugins", "retiredPlugins", "extraKnownMarketplaces"}
PLUGIN_ENTRY_KEYS = {"class", "service", "localReason", "builtin", "minClaudeVersion"}
EXCEPTION_KEYS = {"id", "appliesTo", "removeClasses", "removePlugins", "render", "reason", "decided"}
PLUGIN_CLASSES = ("connector", "local")
RENDER_MODES = ("false", "absent")
# Teams that must sit in a `noConnectors` group whatever the manifest says (XACA-1643-010, user rule
# "connectors stay off for personal-data and client-data teams"): the three personal teams by name and
# every freelance-* target by prefix. A manifest edit that moves one out, or clears the flag, fails.
NO_CONNECTOR_TEAMS = ("finance", "legal", "medical")
NO_CONNECTOR_PREFIXES = ("freelance-",)
CONNECTOR_ALLOWLIST_ID = "connector-allowlist"
CONNECTOR_ALLOWLIST_REASON = ("connectors are opt-in per group: this team is in no teamGroups entry with "
                              "allowConnectors: true, so its connector entries render as an enforced false")


def is_floored_name(name):
    """The ONE predicate for 'connectors stay off here' by NAME (XACA-1643 round 3): casefolded; an
    exact finance/legal/medical, a `<that>-` prefix (finance-business), or a freelance- prefix. Target
    validation, pattern validation and the allowlist render all call this, so the floors cannot
    disagree (round 3 found the target floor exact-only while the pattern floor also took prefixes)."""
    n = str(name).strip().casefold()
    floored = n in NO_CONNECTOR_TEAMS or n.startswith(NO_CONNECTOR_PREFIXES) or any(n.startswith(t + "-") for t in NO_CONNECTOR_TEAMS)  # GUARD:floor-predicate
    return floored


def is_floored_pattern_prefix(prefix):
    """A pattern `<prefix>*` can expand to a floored team iff `<prefix>x` is one."""
    return is_floored_name(str(prefix) + "x")


def is_connector_entry(ent):
    return isinstance(ent, dict) and str(ent.get("class", "")).strip().casefold() == "connector"


def connector_allowed_teams(m):
    """Teams whose connector-class plugins may render TRUE: members of a group that explicitly says
    `allowConnectors: true` (a real boolean, with a non-empty reason, and not also noConnectors) and
    that the name floor does not exclude. EVERY other team renders connectors as an enforced false,
    whatever the manifest says about exceptions (the guarantee holds by construction)."""
    groups = m.get("teamGroups") if isinstance(m.get("teamGroups"), dict) else {}
    allowed = set()
    for g in groups.values():
        if (isinstance(g, dict) and g.get("allowConnectors") is True
                and g.get("noConnectors") is not True and nonempty_str(g.get("reason"))):
            allowed.update(x for x in (g.get("teams") or []) if isinstance(x, str))
    return {t for t in allowed if not is_floored_name(t)}


BASELINE_KEYS = {"revision", "extraKnownMarketplaces", "blockedPlugins"}
REVISION_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def baseline_problems(bl):
    """Problems with a manifest `baseline` object (None = not declared = no problems)."""
    if bl is None:
        return []
    if not isinstance(bl, dict):
        return ["baseline must be an object {revision, extraKnownMarketplaces, blockedPlugins}"]
    errs = []
    for k in bl:
        if k not in BASELINE_KEYS and not k.startswith("_"):
            errs.append("baseline: unknown key %s" % k)
    rev = bl.get("revision")
    if not (isinstance(rev, str) and REVISION_RE.match(rev)):
        errs.append("baseline.revision must be a non-empty string of [A-Za-z0-9._-] (it is the policy marker)")
    mk = bl.get("extraKnownMarketplaces", {})
    if not (isinstance(mk, dict) and all(isinstance(v, dict) for v in mk.values())):
        errs.append("baseline.extraKnownMarketplaces must be an object of objects")
    bp = bl.get("blockedPlugins", [])
    if not isinstance(bp, list):
        errs.append("baseline.blockedPlugins must be a list of plugin ids")
    else:
        for pid in bp:
            if not (isinstance(pid, str) and PLUGIN_ID_RE.match(pid) and not pid.startswith("-")):
                errs.append("baseline.blockedPlugins: bad plugin id %r" % (pid,))
    return errs


def blocked_plugins(m):
    """Plugin ids the L1 baseline forces to false. [] when no baseline declared."""
    bl = m.get("baseline")
    if not isinstance(bl, dict) or not isinstance(bl.get("blockedPlugins"), list):
        return []
    return sorted(p for p in bl["blockedPlugins"] if isinstance(p, str))


def render_policy(m):
    """The exact bytes of the L1 drop-in, generated from the manifest `baseline`.
    FAIL-CLOSED: a malformed Claude Code drop-in stops claude starting on every session of
    the host, so the text is validated here and nothing downstream sees an unvalidated one.
    Raises ToolError(3) when the baseline is absent or invalid."""
    bl = m.get("baseline")
    if bl is None:
        raise ToolError("manifest declares no `baseline`: there is no managed policy to render", 3)
    problems = baseline_problems(bl)
    if problems:  # GUARD:policy-validate
        raise ToolError("baseline invalid, refusing to render a managed policy: " + "; ".join(problems), 3)
    doc = {
        "extraKnownMarketplaces": bl.get("extraKnownMarketplaces") or {},
        "enabledPlugins": {pid: False for pid in bl.get("blockedPlugins") or []},
        "env": {POLICY_ENV: bl["revision"]},
    }
    text = json.dumps(doc, indent=2, ensure_ascii=False) + "\n"
    back = json.loads(text)
    if not isinstance(back, dict) or back.get("env", {}).get(POLICY_ENV) != bl["revision"]:
        raise ToolError("rendered policy failed its own round-trip check; refusing", 3)
    return text


def load_catalog():
    """{plugin_id: entry} from the official marketplace, or None when absent."""
    if not os.path.exists(CATALOG_JSON):
        return None
    doc = load_json(CATALOG_JSON, "marketplace catalog", code=3)
    cat = {}
    for p in doc.get("plugins", []):
        if isinstance(p, dict) and p.get("name"):
            cat["%s@claude-plugins-official" % p["name"]] = p
    return cat


def lsp_commands(entry):
    ls = entry.get("lspServers")
    if isinstance(ls, dict):
        return sorted(v.get("command") for v in ls.values() if isinstance(v, dict) and v.get("command"))
    return []


def nonempty_str(v):
    return isinstance(v, str) and bool(v.strip())


def validate_builtin_entry(where, pid, ent):
    """A built-in plugin (compiled into the claude binary, XACA-1643-015): `builtin` is the boolean
    true, the class is `local` (a built-in marked connector is rejected: connectors-off would then
    need a decision this entry cannot carry), the id ends @builtin and `minClaudeVersion` names
    the first claude that ships it. `minClaudeVersion` without `builtin: true` is also an error.
    Because the id must end @builtin, the catalog check in validate_fleet (which only flags
    unresolvable @claude-plugins-official ids) never applies to a built-in."""
    errs = []
    b = ent.get("builtin")
    if "builtin" in ent and b is not True:  # GUARD:builtin-flag
        errs.append("%s.builtin must be the boolean true (omit the key for a normal plugin)" % where)
    if b is not True:
        if "minClaudeVersion" in ent:
            errs.append("%s.minClaudeVersion is only valid on a `builtin: true` entry" % where)
        return errs
    if ent.get("class") != "local":  # GUARD:builtin-local
        errs.append("%s: a built-in plugin must be class local (it is part of the claude binary, "
                    "not a connector)" % where)
    if not pid.endswith("@builtin"):  # GUARD:builtin-id
        errs.append("%s: a `builtin: true` plugin id must end @builtin" % where)
    mv = ent.get("minClaudeVersion")
    if not (isinstance(mv, str) and re.match(r"^\d+\.\d+\.\d+$", mv)):  # GUARD:builtin-min-version
        errs.append("%s: a built-in needs minClaudeVersion like 2.1.287 (the first claude that ships it)" % where)
    return errs


def builtin_ids(m):
    """{plugin id: minClaudeVersion string} of the manifest's built-in fleet plugins."""
    fleet = m.get("fleet") if isinstance(m, dict) else None
    plugins = fleet.get("plugins") if isinstance(fleet, dict) else None
    return {pid: ent.get("minClaudeVersion") for pid, ent in (plugins or {}).items()
            if isinstance(ent, dict) and ent.get("builtin") is True}


def validate_fleet(m, binaries, blocked, catalog):
    """Problems with `fleet` (schema 2). Every plugin carries a known class; a connector names
    its service; the LSP / catalog / L1-block / retired checks that used to run per team run here."""
    errs = []
    fleet = m.get("fleet")
    if not isinstance(fleet, dict):
        return ["fleet must be an object {plugins, retiredPlugins, extraKnownMarketplaces}"]
    for k in fleet:
        if k not in FLEET_KEYS and not k.startswith("_"):
            errs.append("fleet: unknown key %s" % k)
    plugins = fleet.get("plugins")
    if not isinstance(plugins, dict) or not plugins:
        errs.append("fleet.plugins must be a non-empty object (an empty fleet would strip every team)")
        plugins = {}
    for sec in ("retiredPlugins", "extraKnownMarketplaces"):
        if not isinstance(fleet.get(sec, {}), dict):
            errs.append("fleet.%s must be an object" % sec)
    rp = fleet.get("retiredPlugins", {}) if isinstance(fleet.get("retiredPlugins", {}), dict) else {}
    for pid, ent in plugins.items():
        where = "fleet.plugins[%s]" % pid
        if not PLUGIN_ID_RE.match(pid):
            errs.append("fleet.plugins: bad plugin id %r" % pid)
        if not isinstance(ent, dict):
            errs.append("%s must be an object {class, service?}" % where)
            continue
        for k in ent:
            if k not in PLUGIN_ENTRY_KEYS and not k.startswith("_"):
                errs.append("%s: unknown key %s" % (where, k))
        cls = ent.get("class")
        if cls not in PLUGIN_CLASSES:  # GUARD:class-required
            errs.append("%s.class must be one of %s (an unclassified plugin could reach a "
                        "personal-data team)" % (where, "|".join(PLUGIN_CLASSES)))
        elif cls == "connector" and not nonempty_str(ent.get("service")):
            errs.append("%s: a connector must name the external `service` it reaches" % where)
        if "builtin" in ent or "minClaudeVersion" in ent:
            errs.extend(validate_builtin_entry(where, pid, ent))
        if pid in rp:
            errs.append("fleet: %s is both enabled and retired" % pid)
        if pid in blocked:
            errs.append("fleet enables %s, which the L1 baseline blocks" % pid)
        if pid.split("@")[0].endswith("-lsp") and pid not in binaries:
            errs.append("fleet enables LSP plugin %s with no `binaries` entry" % pid)
        if catalog is not None:
            cent = catalog.get(pid)
            if cent is None and pid.endswith("@claude-plugins-official"):
                errs.append("fleet enables %s, which is not in the official catalog (unresolvable id)" % pid)
            elif cent is not None and lsp_commands(cent) and pid not in binaries:
                errs.append("fleet enables LSP plugin %s (catalog lspServers) with no `binaries` entry" % pid)
    for pid in rp:
        if not PLUGIN_ID_RE.match(pid):
            errs.append("fleet.retiredPlugins: bad plugin id %r" % pid)
    return errs


def dir_token_problems(where, specs):
    """A `${...}` in a dir spec must be a registry reference at the very start of the spec."""
    errs = []
    for d in specs:
        if not isinstance(d, str) or "${" not in d:
            continue
        mt = WD_REF_RE.match(d)
        if not mt or "${" in d[mt.end():]:
            errs.append("%s: %r is not a supported reference (only a leading ${working_dir} or "
                        "${working_dir:<registry key>}; a literal path is also accepted)" % (where, d))
    return errs


def dir_spec_key(team, d):
    """Canonical identity of a dir spec, so two spellings of one dir compare equal. A literal path is
    `~`-expanded and normalised; `${working_dir}` is the team's own registry key, so it equals a
    keyed reference to that team's key."""
    mt = WD_REF_RE.match(d)
    if mt:
        return ("ref", mt.group(1) or team, posixpath.normpath("/" + d[mt.end():]))
    return ("path", os.path.abspath(expand(d)))


def duplicate_dir_problems(teams):
    """Static half of the one-dir-one-team guard (XACA-1643-016): two DIFFERENT teams naming the same
    session dir (or the same worktree repo) is a validation error, whatever the spelling, because the
    settings file is per directory while the connector exception is per team: the last write wins.
    The host half (dir_collisions) catches what only a registry can show."""
    errs = []
    for field in ("sessionDirs", "worktreeRepos"):
        seen = {}
        for name in sorted(teams):
            t = teams[name]
            specs = t.get(field) if isinstance(t, dict) else None
            if not isinstance(specs, list):
                continue
            for d in specs:
                if not isinstance(d, str) or not d:
                    continue
                k = dir_spec_key(name, d)  # GUARD:dup-dir-static
                if k in seen and seen[k] != name:
                    errs.append("teamTargets.%s.%s and teamTargets.%s.%s resolve to the same directory (%s): a "
                                "directory has ONE settings file, so two teams sharing it would overwrite "
                                "each other's connector setting" % (seen[k], field, name, field, d))
                else:
                    seen.setdefault(k, name)
    return errs


def validate_patterns(m):
    """`teamTargetPatterns` problems. A pattern's dirs must all be the team's OWN registry dir (every
    expanded team would otherwise share one dir), its group must exist, and a pattern that could
    produce a personal or client-data team must route to a noConnectors group (the same floor the
    expanded names meet in validate_connector_rule, enforced here too because a host with no matching
    registry team expands to nothing and the floor would never see it)."""
    errs = []
    pats = m.get("teamTargetPatterns")
    if pats is None:
        return errs
    if not isinstance(pats, dict):
        return ["teamTargetPatterns must be an object {<prefix>-*: {target}}"]
    groups = m.get("teamGroups") if isinstance(m.get("teamGroups"), dict) else {}
    for glob, body in pats.items():
        if glob.startswith("_"):
            continue
        where = "teamTargetPatterns[%s]" % glob
        mt = PATTERN_RE.match(glob)
        if not mt:
            errs.append("%s: a pattern is a literal prefix ending in a dash, then * (e.g. freelance-*)" % where)
            continue
        if not isinstance(body, dict):
            errs.append("%s must be an object" % where)
            continue
        for k in body:
            if k not in PATTERN_KEYS and not k.startswith("_"):
                errs.append("%s: unknown key %s" % (where, k))
        if body.get("mode") not in ("tracked", "deployed"):
            errs.append("%s.mode must be tracked|deployed" % where)
        for field in ("sessionDirs", "worktreeRepos"):
            specs = body.get(field, [] if field == "worktreeRepos" else None)
            if not (isinstance(specs, list) and (specs or field == "worktreeRepos")
                    and all(isinstance(x, str) and x for x in specs)):
                errs.append("%s.%s must be a %sstring list" % (where, field, "" if field == "worktreeRepos" else "non-empty "))
                continue
            for d in specs:
                r = WD_REF_RE.match(d)
                if not r or r.group(1) is not None or "${" in d[r.end():]:
                    errs.append("%s.%s: %r must start with ${working_dir} (the expanded team's own registry "
                                "dir); anything else would give every expanded team the same directory" % (where, field, d))
        if not isinstance(body.get("deliver"), bool):
            errs.append("%s.deliver must be a boolean" % where)
        g = body.get("group")
        if not (isinstance(g, str) and g in groups and isinstance(groups[g], dict)):
            errs.append("%s.group must name a teamGroups entry (every team sits in a group)" % where)
        else:
            floored = is_floored_pattern_prefix(mt.group(1))
            if floored and groups[g].get("noConnectors") is not True:  # GUARD:pattern-floor
                errs.append("%s routes to group %r, which is not noConnectors: true; teams matching it are "
                            "personal or client-data teams and connectors stay off for them" % (where, g))
            if body.get("deliver") is False and groups[g].get("allowConnectors") is not True:
                errs.append("%s: deliver=false would strip the enforced connector false entries from every "
                            "team it expands to (group %r does not allow connectors)" % (where, g))
    info = m.get("_patternExpansion") if isinstance(m.get("_patternExpansion"), dict) else {}
    for glob, n, other in info.get("conflicts", []):
        errs.append("teamTargetPatterns[%s] would create %r, which %s" % (
            glob, n, "another pattern already created" if other else "is already defined in teamTargets"))
    return errs


def validate_targets(m):
    """Problems with `teamTargets`. Returns (errs, names). A target never carries enabledPlugins:
    its list is rendered, so a hand-written one would be a second copy that can disagree."""
    errs = []
    if "teams" in m:
        errs.append("`teams` was renamed `teamTargets` in schema 2; move the blocks and drop their "
                    "enabledPlugins/retiredPlugins/extraKnownMarketplaces")
    teams = m.get("teamTargets")
    if not isinstance(teams, dict) or not teams:
        errs.append("teamTargets must be a non-empty object")
        return errs, set()
    for name, t in teams.items():
        where = "teamTargets.%s" % name
        if not isinstance(t, dict):
            errs.append("%s must be an object" % where)
            continue
        if "enabledPlugins" in t:  # GUARD:no-team-enabled
            errs.append("%s: enabledPlugins is not allowed in a team target (schema 2 renders it from "
                        "fleet.plugins; remove it or record an exception)" % where)
        for k in t:
            if k not in TEAM_KEYS and k != "enabledPlugins" and not k.startswith("_"):
                errs.append("%s: unknown key %s" % (where, k))
        if t.get("mode") not in ("tracked", "deployed"):
            errs.append("%s.mode must be tracked|deployed" % where)
        sd = t.get("sessionDirs")
        if not (isinstance(sd, list) and sd and all(isinstance(x, str) and x for x in sd)):
            errs.append("%s.sessionDirs must be a non-empty string list" % where)
        else:
            errs.extend(dir_token_problems("%s.sessionDirs" % where, sd))
        wr = t.get("worktreeRepos", [])
        if not (isinstance(wr, list) and all(isinstance(x, str) for x in wr)):
            errs.append("%s.worktreeRepos must be a string list" % where)
        elif wr and t.get("mode") == "tracked":
            errs.append("%s.worktreeRepos is deployed-mode only (tracked worktrees inherit by checkout)" % where)
        if isinstance(wr, list):
            errs.extend(dir_token_problems("%s.worktreeRepos" % where, wr))
        if not isinstance(t.get("deliver"), bool):
            errs.append("%s.deliver must be a boolean" % where)
        elif t["deliver"] is False and not nonempty_str(t.get("deliverReason")):
            errs.append("%s: deliver=false needs a non-empty deliverReason" % where)
    errs.extend(duplicate_dir_problems(teams))
    return errs, set(teams)


def validate_groups_and_exceptions(m, targets, plugins):
    """teamGroups + exceptions. Every group and every exception carries a non-empty reason."""
    errs = []
    groups = m.get("teamGroups", {})
    if not isinstance(groups, dict):
        errs.append("teamGroups must be an object")
        groups = {}
    pats = m.get("teamTargetPatterns") if isinstance(m.get("teamTargetPatterns"), dict) else {}
    pattern_groups = {b.get("group") for k, b in pats.items() if isinstance(b, dict) and not k.startswith("_")}
    for gname, g in groups.items():
        where = "teamGroups.%s" % gname
        if not isinstance(g, dict):
            errs.append("%s must be an object {teams, reason}" % where)
            continue
        if not nonempty_str(g.get("reason")):  # GUARD:group-reason
            errs.append("%s: needs a non-empty reason" % where)
        gt = g.get("teams")
        if gt is None and gname in pattern_groups:
            continue  # filled from the registry by expand_patterns; empty on a host with no matching team
        if not (isinstance(gt, list) and (gt or gname in pattern_groups) and all(isinstance(x, str) for x in gt)):
            errs.append("%s.teams must be a non-empty string list" % where)
            continue
        for tn in gt:
            if tn not in targets:
                errs.append("%s names %r, which is not in teamTargets" % (where, tn))
    excs = m.get("exceptions", [])
    if not isinstance(excs, list):
        errs.append("exceptions must be a list")
        excs = []
    seen = set()
    for i, e in enumerate(excs):
        where = "exceptions[%d]" % i
        if not isinstance(e, dict):
            errs.append("%s must be an object" % where)
            continue
        where = "exceptions[%s]" % (e.get("id") if nonempty_str(e.get("id")) else i)
        if not nonempty_str(e.get("id")):
            errs.append("%s: needs a non-empty id" % where)
        elif e["id"] in seen:
            errs.append("%s: duplicate exception id" % where)
        else:
            seen.add(e["id"])
        for k in e:
            if k not in EXCEPTION_KEYS and not k.startswith("_"):
                errs.append("%s: unknown key %s" % (where, k))
        if not nonempty_str(e.get("reason")):  # GUARD:exception-reason
            errs.append("%s: needs a non-empty reason (an exception nobody explained is drift)" % where)
        ap = e.get("appliesTo")
        if not (isinstance(ap, str) and ":" in ap):
            errs.append("%s.appliesTo must be 'group:<name>' or 'team:<name>'" % where)
        else:
            kind, _sep, ref = ap.partition(":")
            if kind == "group" and ref not in groups:
                errs.append("%s.appliesTo names unknown group %r" % (where, ref))
            elif kind == "team" and ref not in targets:
                errs.append("%s.appliesTo names unknown team %r" % (where, ref))
            elif kind not in ("group", "team"):
                errs.append("%s.appliesTo must start with group: or team:" % where)
        rc = e.get("removeClasses", [])
        rpl = e.get("removePlugins", [])
        if not (isinstance(rc, list) and all(c in PLUGIN_CLASSES for c in rc)):
            errs.append("%s.removeClasses must be a list drawn from %s" % (where, "|".join(PLUGIN_CLASSES)))
            rc = []
        if not isinstance(rpl, list):
            errs.append("%s.removePlugins must be a list of fleet plugin ids" % where)
            rpl = []
        for pid in rpl:
            if pid not in plugins:
                errs.append("%s.removePlugins names %r, which is not in fleet.plugins" % (where, pid))
        if not rc and not rpl:
            errs.append("%s must remove something (removeClasses or removePlugins)" % where)
        if e.get("render", "false") not in RENDER_MODES:
            errs.append("%s.render must be one of %s" % (where, "|".join(RENDER_MODES)))
    errs.extend(validate_connector_rule(m, groups, targets))
    return errs


def covers_no_connectors(exc):
    """True for an exception that removes class `connector` and renders it an enforced false (an
    absent render would let a stray user-scope setting re-enable the connector)."""
    return (isinstance(exc, dict) and isinstance(exc.get("removeClasses"), list)
            and "connector" in exc["removeClasses"] and exc.get("render", "false") == "false")  # GUARD:cover-render


def validate_connector_rule(m, groups, targets):
    """"Connectors stay off" for every team that is not explicitly allowed, fail closed (XACA-1643).

    The guarantee is the ALLOWLIST in connector_allowed_teams()/exception_removals(): a connector
    renders true only for a member of a group with `allowConnectors: true`. These checks keep the
    manifest honest around it:
    0. `allowConnectors` is a boolean; a group cannot set both it and noConnectors;
    1. a group with `noConnectors: true` has every member covered by an exception that removes class
       connector with render "false" (deleting the exception, or softening it to "absent", fails);
    2. every team target belongs to at least one group, so a new team forces an explicit choice;
    3. the floor (one shared predicate, is_floored_name): finance/legal/medical, their `<name>-`
       prefixes and every freelance- target must be in a noConnectors group and in NO allowConnectors
       group, so emptying the group, moving a member out or clearing the flag cannot turn them on;
    4. deliver=false is rejected for a team whose connectors render false: sync would strip the
       enforced false entries and let a user-scope true through."""
    errs = []
    excs = [e for e in (m.get("exceptions") or []) if isinstance(e, dict)]
    nc_members = set()
    allow_members = set()
    in_group = set()
    for gname, g in groups.items():
        if not isinstance(g, dict):
            continue
        if "allowConnectors" in g and not isinstance(g["allowConnectors"], bool):  # GUARD:allow-bool
            errs.append("teamGroups.%s.allowConnectors must be a boolean" % gname)
        if g.get("allowConnectors") is True and g.get("noConnectors") is True:
            errs.append("teamGroups.%s sets both allowConnectors and noConnectors" % gname)
        flag = g.get("noConnectors", False)
        if not isinstance(flag, bool):
            errs.append("teamGroups.%s.noConnectors must be a boolean" % gname)
            continue
        members = [x for x in (g.get("teams") or []) if isinstance(x, str)]
        in_group.update(members)
        if g.get("allowConnectors") is True:
            allow_members.update(members)
        if not flag:
            continue
        nc_members.update(members)
        for tn in members:
            if tn in targets and not any(exception_applies(m, e, tn) and covers_no_connectors(e) for e in excs):  # GUARD:no-connector-cover
                errs.append("teamGroups.%s is noConnectors but %r has no exception removing class connector "
                            "with render \"false\" (record one; \"absent\" does not count)" % (gname, tn))
    for tn in sorted(targets):  # GUARD:team-in-group
        if tn not in in_group:
            errs.append("teamTargets.%s belongs to no teamGroups entry (put it in a group so the connector "
                        "decision is explicit: a noConnectors group, or an allowConnectors group)" % tn)
    for tn in sorted(targets):  # GUARD:no-connector-floor
        if not is_floored_name(tn):
            continue
        if tn not in nc_members:
            errs.append("teamTargets.%s must stay in a teamGroups entry with noConnectors: true "
                        "(connectors stay off for personal-data and client-data teams)" % tn)
        if tn in allow_members:  # GUARD:floor-allow
            errs.append("teamTargets.%s is in a group with allowConnectors: true; connectors stay off "
                        "for personal-data and client-data teams" % tn)
    plugins = (m.get("fleet") or {}).get("plugins") if isinstance(m.get("fleet"), dict) else None
    if isinstance(plugins, dict) and any(is_connector_entry(e) for e in plugins.values()):
        allowed = connector_allowed_teams(m)
        tt = m.get("teamTargets") if isinstance(m.get("teamTargets"), dict) else {}
        for tn in sorted(targets):
            if tn not in allowed and isinstance(tt.get(tn), dict) and tt[tn].get("deliver") is False:  # GUARD:no-deliver-off
                errs.append("teamTargets.%s: deliver=false is not allowed for a team whose connectors render "
                            "false (sync would strip the enforced false entries); keep deliver=true or put "
                            "the team in an allowConnectors group" % tn)
    return errs


def validate_misc(m):
    errs = []
    pc = m.get("pluginClasses")
    if pc is not None and not isinstance(pc, dict):
        errs.append("pluginClasses must be an object")
    los = m.get("liveOutOfScope")
    if los is not None:
        if not isinstance(los, dict):
            errs.append("liveOutOfScope must be an object {marketplaces, reason}")
        else:
            mk = los.get("marketplaces")
            if not (isinstance(mk, list) and all(isinstance(x, str) and x for x in mk)):
                errs.append("liveOutOfScope.marketplaces must be a string list")
            if not nonempty_str(los.get("reason")):
                errs.append("liveOutOfScope: needs a non-empty reason")
    um = m.get("unmanagedTeams")
    if um is not None:
        if not isinstance(um, dict):
            errs.append("unmanagedTeams must be an object {<registry key>: <reason>}")
        else:
            for k, v in um.items():
                if not k.startswith("_") and not nonempty_str(v):
                    errs.append("unmanagedTeams[%s]: needs a non-empty reason" % k)
    return errs


def validate_manifest(m, catalog=None):
    errs = []
    if not isinstance(m, dict):
        return ["manifest root is not an object"]
    if m.get("schemaVersion") != SCHEMA_VERSION:
        errs.append("schemaVersion must be %d" % SCHEMA_VERSION)
    for k in m:
        if k not in TOP_KEYS and k != "teams" and not k.startswith("_"):
            errs.append("unknown top-level key: %s" % k)
    mv = m.get("minClaudeVersion")
    if mv is not None and not (isinstance(mv, str) and re.match(r"^\d+\.\d+\.\d+$", mv)):
        errs.append("minClaudeVersion must look like 2.1.205")
    binaries = m.get("binaries", {})
    if not isinstance(binaries, dict):
        errs.append("binaries must be an object")
        binaries = {}
    for pid, b in binaries.items():
        if not PLUGIN_ID_RE.match(pid):
            errs.append("binaries: bad plugin id %r" % pid)
        if not isinstance(b, dict) or not isinstance(b.get("command"), str) or not b.get("command"):
            errs.append("binaries[%s].command must be a non-empty string" % pid)
            continue
        for lk in ("probe", "installCmd"):
            if lk in b and not (isinstance(b[lk], list) and b[lk] and all(isinstance(x, str) for x in b[lk])):
                errs.append("binaries[%s].%s must be a non-empty string list" % (pid, lk))
    errs.extend(baseline_problems(m.get("baseline")))
    errs.extend(validate_fleet(m, binaries, blocked_plugins(m), catalog))
    terrs, targets = validate_targets(m)
    errs.extend(terrs)
    errs.extend(validate_patterns(m))
    fleet = m.get("fleet")
    plugins = fleet.get("plugins") if isinstance(fleet, dict) and isinstance(fleet.get("plugins"), dict) else {}
    errs.extend(validate_groups_and_exceptions(m, targets, plugins))
    errs.extend(validate_misc(m))
    errs.extend(validate_skills(m, targets))
    if catalog is not None:
        for pid, b in binaries.items():
            ent = catalog.get(pid)
            if ent is None:
                continue
            cmds = lsp_commands(ent)
            if cmds and isinstance(b, dict) and b.get("command") not in cmds:
                errs.append("binaries[%s].command %r != catalog lspServers command(s) %s" % (pid, b.get("command"), cmds))
    return errs


# ---------------------------------------------------------------------------
# The resolver: the ONLY producer of a team's rendered plugin block (XACA-1643)
# ---------------------------------------------------------------------------

def exception_applies(m, exc, team):
    ap = exc.get("appliesTo") if isinstance(exc, dict) else None
    if not isinstance(ap, str):
        return False
    kind, _sep, ref = ap.partition(":")
    if kind == "team":
        return ref == team
    if kind == "group":
        g = (m.get("teamGroups") or {}).get(ref)
        return isinstance(g, dict) and team in (g.get("teams") or [])
    return False


def team_exceptions(m, team):
    """The recorded exceptions that apply to `team`, in manifest order."""
    return [e for e in (m.get("exceptions") or []) if exception_applies(m, e, team)]


def exception_removals(m, team):
    """{plugin id: {"mode": "false"|"absent", "by": [{"id", "reason"}]}} for every fleet plugin a
    recorded exception removes from `team`. "false" beats "absent". The ONE place the exception
    matching lives: effective_team_cfg() renders from it and the check paths (EXCEPTED,
    EXCEPTION_BREACH) read it, so the two can never disagree."""
    plugins = (m.get("fleet") or {}).get("plugins") or {}
    removed = {}
    allowed = connector_allowed_teams(m)
    for exc in team_exceptions(m, team):
        mode = exc.get("render", "false")
        ids = set(exc.get("removePlugins") or [])
        classes = set(exc.get("removeClasses") or [])
        for pid, ent in plugins.items():
            if pid in ids or (isinstance(ent, dict) and ent.get("class") in classes):  # GUARD:remove-plugins
                r = removed.setdefault(pid, {"mode": mode, "by": []})
                if mode == "false":
                    r["mode"] = "false"
                r["by"].append({"id": exc.get("id"), "reason": exc.get("reason")})
    if team not in allowed:  # GUARD:allowlist-render
        for pid, ent in plugins.items():
            if is_connector_entry(ent):
                r = removed.setdefault(pid, {"mode": "false", "by": []})
                if r["mode"] != "false" or not r["by"]:
                    r["mode"] = "false"
                    r["by"].append({"id": CONNECTOR_ALLOWLIST_ID, "reason": CONNECTOR_ALLOWLIST_REASON})
    return removed


def effective_team_cfg(m, team):
    """Render one team's block from fleet + groups + exceptions.

    Returns the team target's own keys (mode, sessionDirs, worktreeRepos, deliver, ...) plus the
    three sections the sync writes, so process_target()/plan_merge() and every reader see one
    shape. enabledPlugins maps each fleet plugin to True, except plugins an exception removes:
    those render False (an explicit project-scope false outranks a user-scope true, so the
    exception is ENFORCED) or, with render "absent", are left out. `deliver` is NOT applied here:
    plan_merge() and enabled_ids() own it. This is the only place a team's list is computed: no reader may read a raw
    teamTargets block's enabledPlugins (it is rejected by validation)."""
    cfg = dict(m["teamTargets"][team])
    fleet = m.get("fleet") or {}
    plugins = fleet.get("plugins") or {}
    removed = exception_removals(m, team)
    ep = {}
    for pid in plugins:
        mode = (removed.get(pid) or {}).get("mode")
        if mode == "absent":
            continue
        ep[pid] = mode != "false"
    cfg["enabledPlugins"] = ep  # GUARD:render
    cfg["retiredPlugins"] = dict(fleet.get("retiredPlugins") or {})
    cfg["extraKnownMarketplaces"] = dict(fleet.get("extraKnownMarketplaces") or {})
    return cfg


def enabled_ids(cfg):
    """Plugin ids a rendered block turns ON: none when deliver=false, and an excepted plugin
    (rendered False) is not one."""
    if not cfg.get("deliver", True):
        return set()
    return {pid for pid, v in (cfg.get("enabledPlugins") or {}).items() if v is True}


def load_valid_manifest(catalog=None):
    """Load + validate. Any validation error is exit 3 BEFORE the caller writes anything."""
    m = load_manifest()
    problems = validate_manifest(m, catalog)
    if problems:  # GUARD:validate-first
        for p in problems:
            err("manifest invalid: %s" % p)
        raise ToolError("manifest has %d validation problem(s); nothing was written "
                        "(run `%s check --manifest`)" % (len(problems), PROG), 3)
    return m


# ---------------------------------------------------------------------------
# State (provenance) -- what THIS host's sync wrote, per absolute target path
# ---------------------------------------------------------------------------

def load_state():
    if not os.path.exists(STATE_FILE):
        return {}
    st = load_json(STATE_FILE, "state file")  # GUARD:state
    if not isinstance(st, dict):
        raise ToolError("state file is not an object: %s (move it aside to start fresh)" % STATE_FILE)
    return st


def save_state(st):
    atomic_write_json(STATE_FILE, st)


@contextlib.contextmanager
def state_lock():
    """Serialize state read-modify-write across concurrent syncs (worktree creation
    runs `sync-worktrees` while other sessions sync). Without it two runs load the
    same state and the later save drops the earlier run's provenance records."""
    lock_path = STATE_FILE + ".lock"
    os.makedirs(os.path.dirname(lock_path), exist_ok=True)
    timeout = float(os.environ.get("KBSPL_LOCK_TIMEOUT") or 60)
    fh = open(lock_path, "a")
    try:
        deadline = time.time() + timeout
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)  # GUARD:lock
                break
            except (IOError, OSError):
                if time.time() >= deadline:
                    raise ToolError("could not acquire %s within %ss (another kb-sync-plugins running?)"
                                    % (lock_path, timeout))
                time.sleep(0.1)
        yield
    finally:
        fh.close()


def manifest_commit():
    rc, so, _se = git(["-C", DEV_TEAM, "rev-parse", "HEAD"])
    return so.strip() if rc == 0 else "unknown"


# ---------------------------------------------------------------------------
# The merge
# ---------------------------------------------------------------------------

def plan_merge(cur, cfg, written, force_owned=False):
    """Pure merge. Returns (new_obj, actions, new_written).

    cur      parsed target (dict) or None when the file is absent
    cfg      the team's RENDERED block (effective_team_cfg), never a raw teamTargets block
    written  {section: {key: value}} this host's sync wrote previously
    actions  [(section, key, ACTION)] ACTION in ADDED UPDATED ADOPTED REMOVED CONFLICT
    """
    obj = dict(cur) if cur is not None else {}  # GUARD:preserve (unrelated keys survive)
    actions = []
    new_written = {}
    deliver = cfg.get("deliver", True)
    for sec in SECTIONS:
        desired = dict(cfg.get(sec) or {}) if deliver else {}  # GUARD:deliver
        retired = cfg.get("retiredPlugins") or {} if sec == "enabledPlugins" else {}
        prior = (written or {}).get(sec) or {}
        cur_sec = obj.get(sec)
        if cur_sec is None:
            cur_sec = {}
        if not isinstance(cur_sec, dict):
            raise ToolError("target %s is not an object; refusing to overwrite" % sec)
        cur_sec = dict(cur_sec)
        keep_written = {}
        for k in list(cur_sec.keys()):
            if k in desired:
                continue
            owned = (k in prior) or (k in retired)  # GUARD:provenance
            if not owned:
                continue
            expected = prior[k] if k in prior else True
            if cur_sec[k] == expected or (k in retired and cur_sec[k] is True):  # GUARD:value-check
                del cur_sec[k]
                actions.append((sec, k, "REMOVED"))
            else:
                actions.append((sec, k, "CONFLICT"))
                if k in prior:
                    keep_written[k] = prior[k]
        for k, dv in desired.items():
            if k not in cur_sec:
                cur_sec[k] = dv
                actions.append((sec, k, "ADDED"))
                keep_written[k] = dv
            elif cur_sec[k] == dv:
                if k not in prior:
                    actions.append((sec, k, "ADOPTED"))
                keep_written[k] = dv
            elif k in prior and cur_sec[k] == prior[k]:  # GUARD:update
                cur_sec[k] = dv
                actions.append((sec, k, "UPDATED"))
                keep_written[k] = dv
            elif force_owned:
                cur_sec[k] = dv
                actions.append((sec, k, "UPDATED"))
                keep_written[k] = dv
            else:
                actions.append((sec, k, "CONFLICT"))
        if cur_sec or sec in obj:
            obj[sec] = cur_sec
        if keep_written:
            new_written[sec] = keep_written
    return obj, actions, new_written


DRIFT_ACTIONS = ("ADDED", "UPDATED", "REMOVED", "CONFLICT")


def read_target(path):
    """Return the parsed target dict, None if absent. Raises ToolError if unparseable."""
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r") as fh:
            doc = json.load(fh)
    except (OSError, ValueError) as exc:
        raise ToolError("target unreadable or not valid JSON, refusing to overwrite: %s (%s)" % (path, exc), 1)
    if not isinstance(doc, dict):  # GUARD:notobject
        raise ToolError("target is not a JSON object, refusing to overwrite: %s" % path, 1)
    return doc


def ensure_git_exclude(directory):
    """Deployed-mode targets inside a git repo go into .git/info/exclude (common dir)."""
    return ensure_git_exclude_lines(directory, [EXCLUDE_LINE_TAIL])


def ensure_git_exclude_lines(directory, tails):
    """Add `<show-prefix><tail>` for each tail to .git/info/exclude. Returns the file when it changed."""
    rc, so, _se = git(["-C", directory, "rev-parse", "--git-common-dir"])
    if rc != 0:
        return None
    common = so.strip()
    if not os.path.isabs(common):
        common = os.path.join(directory, common)
    rc, so, _se = git(["-C", directory, "rev-parse", "--show-prefix"])
    prefix = so.strip() if rc == 0 else ""
    exclude = os.path.join(common, "info", "exclude")
    existing = ""
    if os.path.exists(exclude):
        with open(exclude, "r") as fh:
            existing = fh.read()
    have = set(existing.splitlines())
    lines = [prefix + t for t in tails if prefix + t not in have]
    if not lines:
        return None
    os.makedirs(os.path.dirname(exclude), exist_ok=True)
    with open(exclude, "a") as fh:
        if existing and not existing.endswith("\n"):
            fh.write("\n")
        for line in lines:
            fh.write(line + "\n")
    return exclude


def process_target(team, cfg, directory, state, dry_run=False, force_owned=False):
    """Plan (and unless dry_run, apply) one target. Returns a result dict."""
    path = target_path(directory)
    res = {"team": team, "dir": directory, "path": path, "mode": cfg.get("mode"),
           "actions": [], "changed": False, "status": "OK", "error": None}
    if not os.path.isdir(directory):
        res["status"] = "DIR_ABSENT"
        return res
    try:
        guard_target(path)
        cur = read_target(path)
        entry = state.get(path) or {}
        new_obj, actions, new_written = plan_merge(cur, cfg, entry.get("written"), force_owned)
    except ToolError as exc:
        res["status"] = "ERROR"
        res["error"] = str(exc)
        return res
    res["actions"] = [{"section": s, "key": k, "action": a} for s, k, a in actions]
    if any(a == "CONFLICT" for _s, _k, a in actions):
        res["status"] = "CONFLICT"
    changed_file = (cur is None and bool(new_obj)) or (cur is not None and new_obj != cur)
    if cur is None and not any(a in ("ADDED", "UPDATED") for _s, _k, a in actions):
        changed_file = False  # never create an empty file
    res["changed"] = changed_file
    if any(a in ("ADDED", "UPDATED", "REMOVED") for _s, _k, a in actions) and res["status"] == "OK":
        res["status"] = "DRIFT" if dry_run else "SYNCED"
    if dry_run:
        res["_new_obj"] = new_obj
        return res
    try:
        if changed_file:
            atomic_write_json(path, new_obj)
        if cfg.get("mode") == "deployed" and (changed_file or os.path.exists(path)) and cfg.get("deliver", True):
            ex = ensure_git_exclude(directory)
            if ex:
                res["exclude"] = ex
        if new_written or entry:
            if new_written:
                state[path] = {
                    "team": team,
                    "written": new_written,
                    "manifestCommit": manifest_commit(),
                    "fileSha256": sha256_file(path) if os.path.exists(path) else None,
                    "syncedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                }
            else:
                state.pop(path, None)
    except (OSError, ToolError) as exc:
        res["status"] = "ERROR"
        res["error"] = str(exc)
    return res


# ---------------------------------------------------------------------------
# Target enumeration
# ---------------------------------------------------------------------------

def select_teams(m, team, all_flag):
    teams = m["teamTargets"]
    if team:
        if team not in teams:
            raise ToolError("unknown team %r (manifest teams: %s)" % (team, ", ".join(sorted(teams))))
        return [team]
    if all_flag:
        return sorted(teams)
    raise ToolError("specify a team or --all")


def dir_identity(d):
    """Identity of a dir for the collision check: (device, inode), so a symlink, a trailing slash, a
    `..` spelling and a case-insensitive alias all compare equal (its realpath if it cannot be stat'd)."""
    try:
        st = os.stat(d)
        return ("ino", st.st_dev, st.st_ino)
    except OSError:
        return ("path", os.path.realpath(d))


def dir_collisions(m, names=None):
    """[{dir, teams}] for every real directory that two or more DIFFERENT teams would write a settings
    file or skill links into (session dirs and linked worktrees, after registry resolution, symlink
    and `..` normalisation). `names` keeps only the collisions that involve one of those teams.

    A team this host does not host (no registry working_dir) owns no directory and is skipped. That
    is how a registry alias is handled: `mainevent` is `alias_of: command`, so it resolves to nothing
    of its own and shares no write target with `command`. Giving an alias a dir of its own that equals
    its target's dir would be reported, because then two teams do write the same file."""
    owners = {}
    shown = {}
    for n in sorted(m["teamTargets"]):
        cfg = effective_team_cfg(m, n)
        dirs = resolve_dirs(n, cfg)
        if dirs is None:
            continue
        cand = list(dirs)
        repos = (resolve_dirs(n, cfg, key="worktreeRepos") or []) if cfg.get("mode") == "deployed" else dirs
        for r in repos:
            cand.extend(list_worktrees(r))
        for d in cand:
            if not os.path.isdir(d):
                continue  # an absent dir is never written (DIR_ABSENT); the guard fires once it exists
            k = dir_identity(d)
            owners.setdefault(k, set()).add(n)
            shown.setdefault(k, os.path.realpath(d))
    hits = []
    for k, teams in owners.items():
        if len(teams) > 1 and (names is None or teams & set(names)):
            hits.append({"dir": shown[k], "teams": sorted(teams)})
    return sorted(hits, key=lambda h: h["dir"])


def guard_dir_collisions(m, names):
    """Exit 3 before any write when a selected team shares a real directory with another team."""
    hits = dir_collisions(m, names)
    if hits:  # GUARD:dir-collision
        for h in hits:
            err("DIR_COLLISION: %s is the session dir or linked worktree of more than one team (%s)"
                % (h["dir"], ", ".join(h["teams"])))
        raise ToolError("%d directory collision(s): teams cannot share a directory (one settings file per "
                        "directory, last write wins, so a connector could be switched on for a personal team); "
                        "nothing was written" % len(hits), 3)


def session_targets(m, names):
    """[(team, cfg, dir)] for hosted teams' session dirs."""
    res = []
    for n in names:
        cfg = effective_team_cfg(m, n)
        dirs = resolve_dirs(n, cfg)
        if dirs is None:
            continue
        for d in dirs:
            res.append((n, cfg, d))
    return res


def worktree_targets(m, names):
    """[(team, cfg, dir)] for linked worktrees of deployed teams' worktreeRepos."""
    res = []
    for n in names:
        cfg = effective_team_cfg(m, n)
        if cfg.get("mode") != "deployed":
            continue
        repos = resolve_dirs(n, cfg, key="worktreeRepos") or []
        for r in repos:
            for wt in list_worktrees(r):
                res.append((n, cfg, wt))
    return res


def guard_not_worktree(directory):
    if "/worktrees/" in directory + "/":
        raise ToolError("refusing to sync a session dir inside /worktrees/ (%s); "
                        "use `sync-worktrees` for linked worktrees" % directory)


# ---------------------------------------------------------------------------
# Skills (XACA-1643-006, design D6): shared / dev-host / group classes
# ---------------------------------------------------------------------------
# shared    machine-wide on every host (the sync-tap.sh mirrored list ships these to consumers)
# devHost   machine-wide on hosts with a dev-team clone only (NOT-MIRRORED, each with a reason)
# group     project-scope symlinks <session dir>/.claude/skills/<name> -> <owner repo>/<name>, written
#           by this tool into the group's session dirs and linked worktrees. Distribution only: the
#           owning repo is never written into, only symlinks are created or removed.

SKILL_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._'-]*$")
SKILLS_KEYS = {"ignore", "unmanagedLocal", "shared", "devHost", "sourceRoots", "groups"}
GROUP_SKILL_KEYS = {"owner", "reason"}
DEV_TEAM_TOKEN = "${dev_team}"
SKILLS_SRC = os.environ.get("KBSPL_SKILLS_SRC") or os.path.join(DEV_TEAM, "skills")
SKILLS_STATE_KEY = "skillLinks"


def skill_name_ok(n):
    return isinstance(n, str) and n == n.strip() and bool(SKILL_NAME_RE.match(n)) and ".." not in n


def validate_skills(m, targets):
    """`skills` block problems. Every group skill needs an owner with a source root; every dev-host
    entry, every unmanaged entry and every group needs a reason (a silent exception cannot be reviewed)."""
    errs = []
    sk = m.get("skills")
    if sk is None:
        return errs
    if not isinstance(sk, dict):
        return ["skills must be an object"]
    for k in sk:
        if k not in SKILLS_KEYS and not k.startswith("_"):
            errs.append("skills: unknown key %s" % k)
    claimed = {}

    def claim(name, label):
        if name in claimed:
            errs.append("skills: %r is classified twice (%s and %s)" % (name, claimed[name], label))
        else:
            claimed[name] = label

    ig = sk.get("ignore", [])
    if not (isinstance(ig, list) and all(isinstance(x, str) and x for x in ig)):
        errs.append("skills.ignore must be a string list")
        ig = []
    for n in ig:
        claim(n, "ignore")
    um = sk.get("unmanagedLocal", {})
    if not isinstance(um, dict):
        errs.append("skills.unmanagedLocal must be an object {<name>: <reason>}")
        um = {}
    for n, why in um.items():
        if n.startswith("_"):
            continue
        if not nonempty_str(why):
            errs.append("skills.unmanagedLocal[%s]: needs a non-empty reason" % n)
        claim(n, "unmanagedLocal")
    sh = sk.get("shared", [])
    if not isinstance(sh, list):
        errs.append("skills.shared must be a list of skill names")
        sh = []
    for n in sh:
        if not skill_name_ok(n):
            errs.append("skills.shared: bad skill name %r" % (n,))
        else:
            claim(n, "shared")
    dh = sk.get("devHost", {})
    if not isinstance(dh, dict):
        errs.append("skills.devHost must be an object {<name>: {reason}}")
        dh = {}
    for n, ent in dh.items():
        if n.startswith("_"):
            continue
        if not skill_name_ok(n):
            errs.append("skills.devHost: bad skill name %r" % n)
        elif not isinstance(ent, dict) or not nonempty_str(ent.get("reason")):
            errs.append("skills.devHost[%s]: needs a non-empty reason (why it is NOT-MIRRORED)" % n)
        claim(n, "devHost")
    roots = sk.get("sourceRoots", {})
    if not isinstance(roots, dict):
        errs.append("skills.sourceRoots must be an object {<owner>: <dir>}")
        roots = {}
    for o, tpl in roots.items():
        if o.startswith("_"):
            continue
        if not nonempty_str(tpl):
            errs.append("skills.sourceRoots[%s] must be a non-empty path" % o)
        elif "${" in tpl:
            rest = tpl[len(DEV_TEAM_TOKEN):] if tpl.startswith(DEV_TEAM_TOKEN) else None
            if rest is None:
                r = WD_REF_RE.match(tpl)
                rest = tpl[r.end():] if r and r.group(1) else None
            if rest is None or "${" in rest:
                errs.append("skills.sourceRoots[%s]: %r is not a supported reference (a leading ${dev_team} or "
                            "${working_dir:<registry key>}, or a literal path)" % (o, tpl))
    groups = sk.get("groups", {})
    if not isinstance(groups, dict):
        errs.append("skills.groups must be an object")
        groups = {}
    for gname, g in groups.items():
        if gname.startswith("_"):
            continue
        where = "skills.groups.%s" % gname
        if not isinstance(g, dict):
            errs.append("%s must be an object" % where)
            continue
        if not nonempty_str(g.get("reason")):
            errs.append("%s: needs a non-empty reason" % where)
        teams = g.get("teams")
        if not (isinstance(teams, list) and teams and all(isinstance(t, str) for t in teams)):
            errs.append("%s.teams must be a non-empty string list" % where)
        else:
            for t in teams:
                if t not in targets:
                    errs.append("%s.teams: %r is not in teamTargets" % (where, t))
        gs = g.get("skills")
        if not (isinstance(gs, dict) and any(not k.startswith("_") for k in gs)):
            errs.append("%s.skills must be a non-empty object" % where)
            continue
        for n, ent in gs.items():
            if n.startswith("_"):
                continue
            if not skill_name_ok(n):
                errs.append("%s.skills: bad skill name %r" % (where, n))
                continue
            claim(n, "group:%s" % gname)
            if not isinstance(ent, dict):
                errs.append("%s.skills[%s] must be an object {owner, reason?}" % (where, n))
                continue
            for k in ent:
                if k not in GROUP_SKILL_KEYS and not k.startswith("_"):
                    errs.append("%s.skills[%s]: unknown key %s" % (where, n, k))
            owner = ent.get("owner")
            if not nonempty_str(owner):  # GUARD:skill-owner
                errs.append("%s.skills[%s]: needs an `owner` (who maintains the source)" % (where, n))
            elif owner not in roots:
                errs.append("%s.skills[%s]: owner %r has no entry in skills.sourceRoots, so the "
                            "source cannot be resolved" % (where, n, owner))
            elif DEV_TEAM_TOKEN in str(roots[owner]) and not nonempty_str(ent.get("reason")):
                errs.append("%s.skills[%s]: a dev-team-tracked skill is NOT-MIRRORED and needs a "
                            "non-empty reason" % (where, n))
    return errs


def skills_cfg(m):
    sk = m.get("skills")
    return sk if isinstance(sk, dict) else {}


def skill_source_root(m, owner):
    tpl = str((skills_cfg(m).get("sourceRoots") or {}).get(owner) or "")
    mt = WD_REF_RE.match(tpl)
    if mt and mt.group(1):
        wd = working_dir(mt.group(1))
        # A key this host's registry lacks resolves to a path that cannot hold a SKILL.md, so every
        # skill under it plans SOURCE_ABSENT (named in the detail) instead of guessing a location.
        tpl = (wd if wd is not None else "/.unresolved-registry-key/" + mt.group(1)) + tpl[mt.end():]
    return os.path.abspath(expand(tpl.replace(DEV_TEAM_TOKEN, DEV_TEAM)))


def group_skill_map(m):
    """{skill name: {group, owner, source}} for every group skill (names are unique: validated)."""
    res = {}
    for gname, g in sorted((skills_cfg(m).get("groups") or {}).items()):
        if gname.startswith("_") or not isinstance(g, dict):
            continue
        for n, ent in sorted((g.get("skills") or {}).items()):
            if n.startswith("_") or not isinstance(ent, dict):
                continue
            res[n] = {"group": gname, "owner": ent.get("owner"),
                      "source": os.path.join(skill_source_root(m, ent.get("owner")), n)}
    return res


def team_skills(m, team):
    """The group skills a team receives: those of every group listing it."""
    res = {}
    gm = group_skill_map(m)
    for gname, g in sorted((skills_cfg(m).get("groups") or {}).items()):
        if gname.startswith("_") or not isinstance(g, dict) or team not in (g.get("teams") or []):  # GUARD:skill-group-scope
            continue
        for n in (g.get("skills") or {}):
            if n in gm:
                res[n] = gm[n]
    return res


def skill_link_records(state):
    recs = state.get(SKILLS_STATE_KEY)
    return recs if isinstance(recs, dict) else {}


def guard_skill_dir(directory):
    """Refuse a skills dir that is, or leads into, a link: a symlinked .claude/skills could be the
    machine-wide ~/.claude/skills, and a link written through it would defeat the whole point."""
    claude = os.path.join(directory, ".claude")
    skills = os.path.join(claude, "skills")
    if os.path.islink(claude) or os.path.islink(skills):  # GUARD:skills-symlinked
        raise ToolError("refusing %s: .claude or .claude/skills is a symlink; the skills writer never "
                        "creates anything through a link" % skills)
    user_dir = os.path.join(os.path.expanduser("~"), ".claude")
    if _same_file(claude, user_dir) or os.path.realpath(claude).casefold() == os.path.realpath(user_dir).casefold():  # GUARD:skills-home
        raise ToolError("refusing %s: it is the user-scope ~/.claude/skills, which is machine-wide" % skills)


def plan_skill_dir(m, team, cfg, directory, state):
    """Pure plan for one dir: [{skill, link, action, source, detail}].
    Actions: ADD UPDATE ADOPT OK REMOVE FORGET CONFLICT SOURCE_ABSENT ERROR."""
    plan = []
    desired = team_skills(m, team) if cfg.get("deliver", True) else {}
    recs = skill_link_records(state)
    skills_dir = os.path.join(directory, ".claude", "skills")
    mine = {l: r for l, r in recs.items() if os.path.dirname(l) == skills_dir}
    if not desired and not mine:
        return plan
    try:
        guard_skill_dir(directory)
    except ToolError as exc:
        return [{"skill": "-", "link": skills_dir, "action": "ERROR", "source": None, "detail": str(exc)}]

    def add(name, link, action, source, detail=""):
        plan.append({"skill": name, "link": link, "action": action, "source": source, "detail": detail})

    for name, ent in sorted(desired.items()):
        link = os.path.join(skills_dir, name)
        src = ent["source"]
        if os.path.realpath(skills_dir).startswith(os.path.realpath(src) + os.sep):  # GUARD:skills-self
            add(name, link, "ERROR", src, "skills dir lies inside the source skill dir")
            continue
        if not os.path.isfile(os.path.join(src, "SKILL.md")):
            add(name, link, "SOURCE_ABSENT", src, "source %s has no SKILL.md" % src)
            continue
        rec = mine.get(link)
        if os.path.islink(link):
            cur = os.readlink(link)
            if cur == src or os.path.realpath(link) == os.path.realpath(src):
                add(name, link, "OK" if rec else "ADOPT", src)
            elif rec and rec.get("target") == cur:  # GUARD:skill-repointed
                add(name, link, "UPDATE", src, "stale link -> %s" % cur)
            elif rec:
                add(name, link, "CONFLICT", src, "owned link was repointed to %s by someone else" % cur)
            else:
                add(name, link, "CONFLICT", src, "foreign symlink -> %s" % cur)
        elif os.path.lexists(link):  # GUARD:skill-conflict-real
            kind = "dir" if os.path.isdir(link) else "file"
            add(name, link, "CONFLICT", src, "a real %s is in the way; the sync never replaces one" % kind)
        else:
            add(name, link, "ADD", src)
    for link, rec in sorted(mine.items()):
        name = os.path.basename(link)
        if name in desired:
            continue
        if not os.path.lexists(link):
            add(name, link, "FORGET", rec.get("target"), "recorded link is already gone")
        elif os.path.islink(link) and os.readlink(link) == rec.get("target"):  # GUARD:skill-owned
            add(name, link, "REMOVE", rec.get("target"), "no longer in this team's group")
        else:
            add(name, link, "CONFLICT", rec.get("target"), "recorded as ours, but it is no longer our symlink; left alone")
    return plan


def apply_skill_plan(team, directory, plan, state):
    """Apply a plan. Only symlinks are created or removed, and nothing is opened inside a source dir."""
    recs = state.setdefault(SKILLS_STATE_KEY, {})
    skills_dir = os.path.join(directory, ".claude", "skills")
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    excl = []
    for p in plan:
        act, link, src = p["action"], p["link"], p["source"]
        if act in ("ADD", "UPDATE"):
            os.makedirs(skills_dir, exist_ok=True)
            if act == "ADD":
                try:
                    os.symlink(src, link)  # GUARD:skill-symlink
                except FileExistsError:
                    p["action"], p["detail"] = "CONFLICT", "appeared while syncing; left alone"
                    continue
            else:
                tmp = os.path.join(skills_dir, ".%s.kbspl-tmp" % p["skill"])
                if os.path.lexists(tmp):
                    os.unlink(tmp)
                os.symlink(src, tmp)
                os.replace(tmp, link)
        if act in ("ADD", "UPDATE", "ADOPT"):
            recs[link] = {"team": team, "skill": p["skill"], "target": src, "syncedAt": now}
            excl.append(".claude/skills/%s" % p["skill"])
        elif act == "REMOVE":
            if os.path.islink(link):
                os.unlink(link)  # GUARD:skill-unlink
            recs.pop(link, None)
        elif act == "FORGET":
            recs.pop(link, None)
    if not recs:
        state.pop(SKILLS_STATE_KEY, None)
    # Add an exclude line only for a link git does not already ignore (the Main Event repos ignore
    # `.claude/*` themselves, so nothing is written into their .git there). rc 1 = not ignored.
    excl = [t for t in excl if git(["-C", directory, "check-ignore", "-q", "--", t])[0] == 1]
    if excl:
        ensure_git_exclude_lines(directory, excl)


SKILL_ACTION_LABEL = {"ADD": "ADDED", "UPDATE": "UPDATED", "REMOVE": "REMOVED", "ADOPT": "ADOPTED",
                      "FORGET": "FORGOT", "CONFLICT": "CONFLICT", "SOURCE_ABSENT": "SOURCE_ABSENT",
                      "ERROR": "ERROR"}


def process_skill_dir(m, team, cfg, directory, state, dry_run=False):
    """Plan (and unless dry_run, apply) one dir's group skills. None when there is nothing to say."""
    if not os.path.isdir(directory):
        return None
    plan = plan_skill_dir(m, team, cfg, directory, state)
    if not plan:
        return None
    skills_dir = os.path.join(directory, ".claude", "skills")
    res = {"team": team, "dir": directory, "path": skills_dir, "mode": None, "kind": "skills",
           "actions": [], "changed": False, "status": "OK", "error": None}
    if not dry_run:
        try:
            apply_skill_plan(team, directory, plan, state)
        except (OSError, ToolError) as exc:
            res["status"] = "ERROR"
            res["error"] = str(exc)
            return res
    res["actions"] = [{"section": "skills", "key": p["skill"], "action": SKILL_ACTION_LABEL[p["action"]]}
                      for p in plan if p["action"] != "OK"]
    bad = [p for p in plan if p["action"] in ("ERROR", "SOURCE_ABSENT")]
    if bad:
        res["status"] = "ERROR"
        res["error"] = "; ".join("%s: %s" % (p["skill"], p["detail"]) for p in bad)
    elif any(p["action"] == "CONFLICT" for p in plan):
        res["status"] = "CONFLICT"
        res["error"] = "; ".join("%s: %s" % (p["skill"], p["detail"]) for p in plan if p["action"] == "CONFLICT")
    elif any(p["action"] in ("ADD", "UPDATE", "REMOVE") for p in plan):
        res["status"] = "DRIFT" if dry_run else "SYNCED"
    res["changed"] = any(p["action"] in ("ADD", "UPDATE", "REMOVE") for p in plan)
    return res


def skill_targets(m, names, state, sessions=True, worktrees=True):
    """[(team, cfg, dir)] where group skills are (or were) delivered: group members' session dirs and
    linked worktrees, plus any other team's dir that still holds a link this tool owns."""
    recs = skill_link_records(state)
    owners = {r.get("team") for r in recs.values() if isinstance(r, dict)}
    res = []
    for n in names:
        cfg = effective_team_cfg(m, n)
        if not cfg.get("deliver", True) or (not team_skills(m, n) and n not in owners):
            continue
        dirs = resolve_dirs(n, cfg)
        if dirs is None:
            continue
        if sessions:
            res.extend((n, cfg, d) for d in dirs)
        if worktrees:
            repos = (resolve_dirs(n, cfg, key="worktreeRepos") or []) if cfg.get("mode") == "deployed" else dirs
            for r in repos:
                res.extend((n, cfg, wt) for wt in list_worktrees(r))
    return res


def skill_results(m, names, state, dry_run, sessions=True, worktrees=True):
    res = []
    for t, c, d in skill_targets(m, names, state, sessions, worktrees):
        r = process_skill_dir(m, t, c, d, state, dry_run)
        if r is not None:
            res.append(r)
    return res


def skill_rows(m, team, cfg, directory, state):
    """check / check --host rows for one dir's group skills (problems only)."""
    rows = []
    if not os.path.isdir(directory):
        return rows
    for p in plan_skill_dir(m, team, cfg, directory, state):
        act = p["action"]
        if act in ("OK", "ADOPT", "FORGET"):
            continue
        if act in ("ADD", "UPDATE", "SOURCE_ABSENT"):
            status = "SKILL_GROUP_MISSING"  # GUARD:skill-group-missing
            actual = {"ADD": "absent", "UPDATE": p["detail"], "SOURCE_ABSENT": p["detail"]}[act]
        elif act == "REMOVE":
            status, actual = "SKILL_GROUP_LEAK", "stale owned link (team left the group)"
        elif act == "CONFLICT":
            status, actual = "CONFLICT", p["detail"]
        else:
            status, actual = "FILE_DRIFT", p["detail"]
        rows.append({"team": team, "dir": directory, "plugin": p["skill"], "kind": "skill",
                     "expected": "linked" if act != "REMOVE" else "not linked", "actual": actual, "status": status})
    return rows


def tracked_skill_names(src):
    """Top-level names git tracks under <src> (an untracked link into another repo is not ours)."""
    rc, so, _se = run(["git", "-C", src, "ls-files", "-z", "--", "."])
    if rc == 0 and so:
        return {p.split("/", 1)[0] for p in so.split("\0") if p}
    return {n for n in os.listdir(src) if not os.path.islink(os.path.join(src, n))}


def expected_machine_skills(m):
    """(kind, names, problem). Dev host: tracked skills/ minus group names. Consumer: the tap's
    share/skills listing. problem is set when neither source is readable (never a quiet pass)."""
    tap = os.environ.get("KBSPL_TAP_SKILLS")
    if not tap and not os.path.isdir(SKILLS_SRC):
        cands = []
        if os.environ.get("AITEAMFORGE_DIR"):
            cands.append(os.path.join(os.environ["AITEAMFORGE_DIR"], "share", "skills"))
        cands.append(os.path.join(DEV_TEAM, "share", "skills"))
        for cand in cands:
            if os.path.isdir(cand):
                tap = cand
                break
    if tap:
        if not os.path.isdir(tap):
            return "consumer", set(), "tap skills listing %s is not a directory" % tap
        return "consumer", {n for n in os.listdir(tap) if not n.startswith(".")}, None
    if os.path.isdir(SKILLS_SRC):
        return "dev", tracked_skill_names(SKILLS_SRC) - set(group_skill_map(m)), None
    return "none", set(), "no dev-team skills/ at %s and no tap share/skills listing" % SKILLS_SRC


def machine_skill_rows(m):
    """check --host rows for the machine-wide ~/.claude/skills (design D6)."""
    sk = skills_cfg(m)
    if not isinstance(sk.get("shared"), list):
        return []  # no skills classes declared: nothing to compare against
    mdir = os.path.join(os.path.expanduser("~"), ".claude", "skills")
    rows = []

    def add(name, expected, actual, status):
        rows.append({"team": "-", "dir": mdir, "plugin": name, "kind": "skill", "expected": expected,
                     "actual": actual, "status": status})

    _kind, expected, problem = expected_machine_skills(m)
    if problem:
        add("-", "expected skill set", problem, "SKILLS_UNVERIFIABLE")
        return rows
    ignore = set(sk.get("ignore") or [])
    unmanaged = {k for k in (sk.get("unmanagedLocal") or {}) if not k.startswith("_")}
    groups = group_skill_map(m)
    expected = expected - ignore
    try:
        present = set(os.listdir(mdir)) if os.path.isdir(mdir) else set()
    except OSError as exc:
        add("-", "readable skills dir", str(exc), "SKILLS_UNVERIFIABLE")
        return rows
    for name in sorted(expected):
        p = os.path.join(mdir, name)
        if not os.path.lexists(p):
            add(name, "present", "absent", "SKILL_MISSING")  # GUARD:skill-missing
        elif os.path.islink(p) and not os.path.exists(p):
            add(name, "present", "dangling link", "SKILL_MISSING")
    for name in sorted(present):
        if name in ignore:  # GUARD:skill-ignore
            continue
        if name in groups:  # GUARD:skill-group-leak
            add(name, "not machine-wide (group:%s)" % groups[name]["group"], "present", "SKILL_GROUP_LEAK")
        elif name in expected:
            continue
        elif name in unmanaged:
            add(name, "unmanaged local", "present", "UNMANAGED_LOCAL")
        else:
            add(name, "not expected", "present", "SKILL_EXTRA")  # GUARD:skill-extra
    return rows


def do_skills(args):
    m = load_valid_manifest()
    gm = group_skill_map(m)
    if args.action == "group-names":
        for n in sorted(gm):
            out(n)
        return 0
    sk = skills_cfg(m)
    rows = [(n, "shared") for n in sk.get("shared") or []]
    rows += [(n, "dev-host") for n in sorted(k for k in (sk.get("devHost") or {}) if not k.startswith("_"))]
    rows += [(n, "group:%s (owner %s)" % (e["group"], e["owner"])) for n, e in sorted(gm.items())]
    for n, c in rows:
        out("%s\t%s" % (n, c))
    return 0


# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

def fmt_action_line(r):
    acts = ", ".join("%s %s:%s" % (a["action"], a["section"], a["key"]) for a in r["actions"]) or "no change"
    extra = " [%s]" % r["error"] if r.get("error") else ""
    return "  %-9s %s -- %s%s" % (r["status"], r["path"], acts, extra)


def local_enabled_map(directory):
    """The enabledPlugins object of <dir>/.claude/settings.local.json, or {}."""
    try:
        with open(os.path.join(directory, ".claude", "settings.local.json"), "r") as fh:
            doc = json.load(fh)
    except (OSError, ValueError):
        return {}
    ep = doc.get("enabledPlugins") if isinstance(doc, dict) else None
    return ep if isinstance(ep, dict) else {}


def local_optouts(directory):
    """Plugin ids the PERSON switched off in <dir>/.claude/settings.local.json (docs section 10)."""
    return {k for k, v in local_enabled_map(directory).items() if v is False}


def local_enables(directory):
    """Plugin ids the person switched ON in settings.local.json (local outranks project scope)."""
    return {k for k, v in local_enabled_map(directory).items() if v is True}


def parity_rows(m, team, cfg, directory, state):
    """PARITY / EXCEPTED / OPT_OUT rows for one existing dir (XACA-1643-005, design D5).

    PARITY compares the on-disk project file with the RENDERED list and never reads the live
    plugin list. It reports only keys the rendered list lacks: a true nobody recorded (hand-added
    for one team) or a false nobody recorded (an unrecorded team opt-out). A rendered key that is
    missing or changed is FILE_DRIFT / CONFLICT from plan_merge, and a key the sync wrote earlier
    or the manifest retired is REMOVED/CONFLICT there too, so neither is reported twice."""
    rows = []
    if not os.path.isdir(directory):
        return rows

    def add(plugin, expected, actual, status, detail=None):
        row = {"team": team, "dir": directory, "plugin": plugin, "expected": expected,
               "actual": actual, "status": status}
        if detail is not None:
            row["detail"] = detail
        rows.append(row)

    local_on = local_enables(directory)
    for pid, rem in sorted(exception_removals(m, team).items()):  # GUARD:excepted
        why = "; ".join("%s: %s" % (b.get("id"), b.get("reason")) for b in rem["by"])
        if rem["mode"] == "false" and pid in local_on:  # GUARD:local-breach
            add(pid, "excepted (off)", "enabled (settings.local.json)", "EXCEPTION_BREACH",
                "settings.local.json turns it on and outranks the enforced project false; " + why)
            continue
        add(pid, "excepted", "excepted", "EXCEPTED", why)
    for pid in sorted(enabled_ids(cfg) & local_optouts(directory)):  # GUARD:optout
        add(pid, "enabled", "opted out (settings.local.json)", "OPT_OUT",
            "person-level opt-out in settings.local.json")
    if not cfg.get("deliver", True):
        return rows  # nothing is delivered here, so there is no rendered list to compare with
    path = target_path(directory)
    try:
        guard_target(path)
        cur = read_target(path)
    except ToolError:
        return rows  # process_target() already reports an unreadable/refused file
    ep = cur.get("enabledPlugins") if cur is not None else None
    if not isinstance(ep, dict):
        return rows
    rendered = cfg.get("enabledPlugins") or {}
    retired = cfg.get("retiredPlugins") or {}
    prior = ((state.get(path) or {}).get("written") or {}).get("enabledPlugins") or {}
    for k in sorted(ep):
        if k in rendered or k in retired or k in prior:
            continue
        if ep[k] is True:  # GUARD:parity-true
            add(k, "not in rendered list", "true (hand-added)", "PARITY")
        elif ep[k] is False:  # GUARD:parity-false
            add(k, "not in rendered list", "false (unrecorded opt-out)", "PARITY")
    return rows


def unmanaged_rows(m):
    """UNMANAGED_TEAM rows: a registry team whose working_dir exists on this host, matches no
    teamTargets session dir and is not listed in unmanagedTeams (E9)."""
    tp = team_paths()
    if tp is None:
        return []
    covered = set()
    for name in m["teamTargets"]:
        for d in resolve_dirs(name, effective_team_cfg(m, name)) or []:
            covered.add(os.path.realpath(d))
    declared = set(k for k in (m.get("unmanagedTeams") or {}) if not k.startswith("_"))
    rows = []
    for key, ent in sorted(tp["teams"].items()):
        if key in declared:
            continue
        if not isinstance(ent, dict) or not isinstance(ent.get("working_dir", ""), str):
            raise ToolError("team-paths registry %s: teams.%s must be an object whose working_dir "
                            "is a string (nothing can be verified)" % (TEAM_PATHS_JSON, key), 3)
        if not ent.get("working_dir"):
            continue  # an alias_of entry owns no dir
        d = expand(ent["working_dir"])
        if not os.path.isdir(d) or os.path.realpath(d) in covered:  # GUARD:unmanaged
            continue
        rows.append({"team": key, "dir": d, "plugin": "-",
                     "expected": "in teamTargets or unmanagedTeams", "actual": "unmanaged",
                     "status": "UNMANAGED_TEAM"})
    return rows


def do_list(args):
    m = load_valid_manifest()
    rows = []
    for n in sorted(m["teamTargets"]):
        cfg = effective_team_cfg(m, n)
        dirs = resolve_dirs(n, cfg)
        rows.append({"team": n, "mode": cfg.get("mode"), "deliver": cfg.get("deliver", True),
                     "plugins": sorted(enabled_ids(cfg)),
                     "excluded": sorted(set(cfg.get("enabledPlugins") or {}) - enabled_ids(cfg)),
                     "hosted": dirs is not None, "dirs": dirs or []})
    if args.json:
        out(json.dumps({"manifest": MANIFEST, "teams": rows}, indent=2))
        return 0
    out("%-10s %-9s %-8s %-7s %s" % ("TEAM", "MODE", "DELIVER", "HOSTED", "PLUGINS"))
    for r in rows:
        out("%-10s %-9s %-8s %-7s %s" % (r["team"], r["mode"], str(r["deliver"]).lower(),
                                         "yes" if r["hosted"] else "no", len(r["plugins"])))
        for d in r["dirs"]:
            out("             %s%s" % (d, "" if os.path.isdir(d) else "  (absent)"))
    return 0


def do_check(args):
    if args.probe and not args.host:
        raise ToolError("--probe is only valid with --host")
    if args.manifest:
        return check_manifest(args)
    if args.host:
        return check_host(args)
    m = load_valid_manifest()
    names = select_teams(m, args.team, args.all)
    guard_dir_collisions(m, names)
    state = load_state()
    targets = session_targets(m, names) + worktree_targets(m, names)
    results = [process_target(t, c, d, state, dry_run=True) for t, c, d in targets]
    parity = []
    for t, c, d in targets:
        parity.extend(parity_rows(m, t, c, d, state))
    for t, c, d in skill_targets(m, names, state):  # XACA-1643-006: group skills
        parity.extend(skill_rows(m, t, c, d, state))
    if args.all:  # the whole registry is needed to find a team the manifest does not cover
        parity.extend(unmanaged_rows(m))
    return report_check(results, args.json, parity)


def report_check(results, as_json, parity=None):
    parity = parity or []
    drift = [r for r in results if r["status"] in ("DRIFT", "CONFLICT", "ERROR")]
    p_drift = [r for r in parity if r["status"] in DRIFT_STATUSES]
    n_drift = len(drift) + len(p_drift)
    if as_json:
        for r in results:
            r.pop("_new_obj", None)
        out(json.dumps({"results": results, "parity": parity, "drift": n_drift}, indent=2))
    else:
        for r in results:
            if r["status"] not in ("OK",):
                out("[%s]" % r["team"])
                out(fmt_action_line(r))
        for r in p_drift:
            out("[%s]" % r["team"])
            out("  %-14s %s -- %s: %s" % (r["status"], r["dir"], r["plugin"], r["actual"]))
        out("checked=%d drift=%d" % (len(results), n_drift))
    if n_drift:
        return 1
    if not any(r["status"] != "DIR_ABSENT" for r in results):  # GUARD:zero-targets
        return no_hosted_teams("check")
    return 0


def check_manifest(args):
    m = load_manifest()
    catalog = load_catalog()
    errs = validate_manifest(m, catalog)
    for e in errs:
        out("MANIFEST-FAIL: %s" % e)
    if catalog is None:
        out("catalog checks: SKIPPED (no marketplace catalog at %s)" % CATALOG_JSON)
        if args.require_catalog:
            out("--require-catalog set: unverifiable")
            return 3
    if errs:
        out("manifest: %d problem(s)" % len(errs))
        return 1
    out("manifest: OK (%d teams)" % len(m["teamTargets"]))
    return 0


def do_sync(args):
    m0 = load_valid_manifest(load_catalog())  # validate BEFORE the lock: an invalid manifest creates nothing at all
    guard_dir_collisions(m0, select_teams(m0, args.team, args.all))  # ... and so does a collision
    if args.dry_run:
        return _do_sync(args)
    with state_lock():
        return _do_sync(args)


def _do_sync(args):
    m = load_valid_manifest(load_catalog())
    names = select_teams(m, args.team, args.all)
    guard_dir_collisions(m, names)
    state = load_state()
    results = []
    targets = session_targets(m, names)
    for t, c, d in targets:
        try:
            guard_not_worktree(d)
        except ToolError as exc:
            results.append({"team": t, "dir": d, "path": target_path(d), "actions": [], "changed": False,
                            "status": "ERROR", "error": str(exc)})
            continue
        r = process_target(t, c, d, state, args.dry_run, args.force_owned)
        results.append(r)
        if args.install_missing and r["status"] not in ("ERROR", "CONFLICT", "DIR_ABSENT"):
            rows, problem = ensure_installed(c, d, args.dry_run, set(builtin_ids(m)))
            r["installs"] = rows
            if problem:
                r["status"] = "ERROR"
                r["error"] = problem
    if args.all:
        for t, c, d in worktree_targets(m, names):
            results.append(process_target(t, c, d, state, args.dry_run, args.force_owned))
    # group skills: session dirs always, linked worktrees with --all (the same reach as the plugins)
    results.extend(skill_results(m, names, state, args.dry_run, sessions=True, worktrees=bool(args.all)))
    return finish_sync(results, state, args)


def do_sync_worktrees(args):
    m0 = load_valid_manifest(load_catalog())  # validate first: nothing is written on any problem
    guard_dir_collisions(m0, select_teams(m0, args.team, args.all))
    if args.dry_run:
        return _do_sync_worktrees(args)
    with state_lock():
        return _do_sync_worktrees(args)


def _do_sync_worktrees(args):
    m = load_valid_manifest(load_catalog())
    names = select_teams(m, args.team, args.all)
    guard_dir_collisions(m, names)
    state = load_state()
    results = []
    for n in names:
        if m["teamTargets"][n].get("mode") == "tracked" and not args.json:
            out("%s: tracked mode -- worktrees inherit the committed file by checkout" % n)
    for t, c, d in worktree_targets(m, names):
        results.append(process_target(t, c, d, state, args.dry_run, args.force_owned))
    results.extend(skill_results(m, names, state, args.dry_run, sessions=False, worktrees=True))
    return finish_sync(results, state, args)


def untracked_tracked_notes(results):
    """A tracked-mode team is meant to commit its settings.json. Until that file is
    committed, a sync leaves it untracked in the repo (read-only git probe; advisory)."""
    notes = []
    for r in results:
        if r.get("mode") != "tracked" or not r.get("changed") or not os.path.isfile(r["path"]):
            continue
        rc, _so, _se = git(["ls-files", "--error-unmatch", "--", r["path"]], cwd=r["dir"])
        if rc == 1:  # GUARD:untracked-note (1 = untracked; 128 = not a git repo)
            notes.append("%s is a tracked-mode target but %s is not committed in its repo; "
                         "it stays an untracked file until you commit it" % (r["team"], r["path"]))
    return notes


def finish_sync(results, state, args):
    if not args.dry_run:
        try:
            save_state(state)
        except OSError as exc:
            err("could not save state %s: %s" % (STATE_FILE, exc))
            return 2
    bad = [r for r in results if r["status"] in ("ERROR", "CONFLICT")]
    for r in results:
        r.pop("_new_obj", None)
    notes = [] if args.dry_run else untracked_tracked_notes(results)
    if args.json:
        out(json.dumps({"results": results, "failed": len(bad), "dryRun": bool(args.dry_run),
                        "notes": notes}, indent=2))
    else:
        for r in results:
            if r["status"] == "DIR_ABSENT":
                continue
            out("[%s]" % r["team"])
            out(fmt_action_line(r))
            for ins in r.get("installs", []):
                out("  %-13s %s -- %s%s" % (ins["result"], ins["plugin"], r["dir"],
                                            " (%s)" % ins["detail"] if ins["detail"] else ""))
        for n in notes:
            out("NOTE: %s" % n)
        out("%d target(s), %d need attention%s" % (len(results), len(bad), " (dry run)" if args.dry_run else ""))
    return 1 if bad else 0


def do_diff(args):
    m = load_valid_manifest()
    names = select_teams(m, args.team, False)
    state = load_state()
    rc = 0
    for t, c, d in session_targets(m, names):
        r = process_target(t, c, d, state, dry_run=True)
        path = r["path"]
        if r["status"] == "ERROR":
            out("# %s: ERROR %s" % (path, r["error"]))
            rc = 1
            continue
        try:
            cur = read_target(path)
        except ToolError as exc:
            out("# %s: ERROR %s" % (path, exc))
            rc = 1
            continue
        before = json.dumps(cur, indent=2, ensure_ascii=False).splitlines() if cur is not None else []
        after = json.dumps(r["_new_obj"], indent=2, ensure_ascii=False).splitlines() if r["changed"] else before
        diff = list(difflib.unified_diff(before, after, "a/" + path, "b/" + path, lineterm=""))
        if diff:
            rc = 1
            for ln in diff:
                out(ln)
        else:
            out("# %s: no difference" % path)
    return rc


DRIFT_STATUSES = ("MISSING", "NOT_INSTALLED", "BLOCKED_LOADED", "FILE_DRIFT", "CONFLICT",
                  "POLICY_ABSENT", "POLICY_STALE", "POLICY_SKIPPED",
                  "PARITY", "UNMANAGED_TEAM", "EXCEPTION_BREACH")  # GUARD:drift-statuses
DRIFT_STATUSES = DRIFT_STATUSES + ("SKILL_MISSING", "SKILL_GROUP_LEAK", "SKILL_GROUP_MISSING",
                                  "DIR_COLLISION")  # GUARD:skill-drift-statuses
# Informational rows: counted in no total (not warn, not drift, not unverifiable).
INFO_STATUSES = ("OK", "OUT_OF_SCOPE", "EXCEPTED", "OPT_OUT", "UNMANAGED_LOCAL")
WARN_STATUSES = ("EXTRA", "SKILL_EXTRA", "BUILTIN_UNAVAILABLE")  # GUARD:builtin-warn
UNVERIFIABLE_STATUSES = ("VERSION_UNVERIFIED", "LIST_UNREADABLE", "CLAUDE_UNRUNNABLE", "PROBE_UNVERIFIABLE",
                         "SKILLS_UNVERIFIABLE")


def parse_version(text):
    mt = VERSION_RE.search(text or "")
    return tuple(int(x) for x in mt.groups()) if mt else None


def claude_version():
    rc, so, _se = run([CLAUDE_BIN, "--version"], timeout=30)
    return parse_version(so) if rc == 0 else None


_VERSION_CACHE = {}


def claude_version_cached():
    """One `claude --version` per process for the per-directory BUILTIN rows."""
    if CLAUDE_BIN not in _VERSION_CACHE:
        _VERSION_CACHE[CLAUDE_BIN] = claude_version()
    return _VERSION_CACHE[CLAUDE_BIN]


def live_plugin_list(directory):
    """`claude plugin list --json` from `directory`: list of dicts, or None when unreadable."""
    rc, so, _se = run([CLAUDE_BIN, "plugin", "list", "--json"], cwd=directory, timeout=120)
    if rc != 0:
        return None
    try:
        doc = json.loads(so)
    except ValueError:
        return None
    if not isinstance(doc, list) or not all(isinstance(e, dict) for e in doc):
        return None
    return doc


def policy_paths():
    """(base dir, drop-in dir, our file). The file name is the POLICY_FILE constant, never
    anything read from the manifest or the environment."""
    dropin = os.path.join(MANAGED_BASE, DROPIN_NAME)
    return MANAGED_BASE, dropin, os.path.join(dropin, POLICY_FILE)


PROBE_NOT_SET = "NOT_SET"


def policy_env_keys(m):
    """Every env key the L1 baseline sets (read back from the rendered drop-in, so a key added
    to render_policy() later is covered). The probe must strip all of them from the child."""
    keys = {POLICY_ENV}
    keys.update(json.loads(render_policy(m)).get("env", {}))
    return keys


def probe_marker(want, strip_keys=None):
    """Behavioural probe: did claude actually load the L1 drop-in? One `claude -p` model call
    reading the marker env var (the one probe that does not depend on claude's version).
    Returns ("LOADED"|"NOT_LOADED"|"UNVERIFIABLE", detail).

    Isolation: the child gets NONE of the keys the baseline sets (an inherited marker would be
    printed by printenv and read as LOADED), runs from a fresh temp cwd (no project hooks or
    settings), loads no MCP server and no user/project/local settings, answers no permission
    prompt (dontAsk denies anything not allowed) and has exactly one tool, Bash(printenv:*)."""
    strip = set(strip_keys or ()) | {POLICY_ENV}
    child_env = {k: v for k, v in os.environ.items() if k not in strip}  # GUARD:probe-env
    prompt = ("Run exactly this and reply with only its output: printenv %s . If it prints nothing, "
              "reply with exactly %s." % (POLICY_ENV, PROBE_NOT_SET))
    argv = [CLAUDE_BIN, "-p", prompt,
            "--tools", "Bash", "--allowedTools", "Bash(printenv:*)", "--permission-mode", "dontAsk",
            "--strict-mcp-config", "--setting-sources", "", "--disable-slash-commands",
            "--no-session-persistence"]
    with tempfile.TemporaryDirectory(prefix="kbspl-probe-") as cwd:
        rc, so, se = run(argv, cwd=cwd, timeout=180, env=child_env)
    if rc != 0:  # GUARD:probe-unverifiable
        return "UNVERIFIABLE", "claude -p exited %d: %s" % (rc, (se or so).strip()[:120])
    out_text = so.strip()
    if not out_text:
        return "UNVERIFIABLE", "claude -p printed nothing"
    if re.search(r"(?<![A-Za-z0-9._-])%s(?![A-Za-z0-9._-])" % re.escape(want), out_text):
        return "LOADED", out_text[:80]
    # Only a bare revision-shaped token (another revision) or the explicit NOT_SET answer proves
    # claude ran printenv and the marker was not ours. A denied tool, a refusal or any prose does not.
    if out_text == PROBE_NOT_SET or REVISION_RE.match(out_text):  # GUARD:probe-verdict
        return "NOT_LOADED", out_text[:80]
    return "UNVERIFIABLE", "claude -p answered neither the marker nor %s: %s" % (PROBE_NOT_SET, out_text[:100])


def host_policy(m, probe):
    """L1 policy status. Returns (row_or_None, info dict). Read-only (the probe costs one
    model call). Statuses: OK, POLICY_ABSENT, POLICY_STALE, POLICY_SKIPPED (file current but
    claude did not load it), PROBE_UNVERIFIABLE."""
    bl = m.get("baseline")
    info = {"status": "NOT_DECLARED", "installedSha": None, "canonicalSha": None, "probe": None}
    if bl is None:
        if probe:
            info["status"] = "PROBE_UNVERIFIABLE"
            return {"team": "-", "dir": MANAGED_BASE, "plugin": "policy-probe", "expected": "baseline declared",
                    "actual": "manifest has no baseline: nothing to verify", "status": "PROBE_UNVERIFIABLE"}, info
        return None, info
    text = render_policy(m)
    info["canonicalSha"] = hashlib.sha256(text.encode("utf-8")).hexdigest()
    _base, _dropin, installed = policy_paths()
    status = "OK"
    if not os.path.exists(installed):
        status = "POLICY_ABSENT"
    else:
        info["installedSha"] = sha256_file(installed)
        if info["installedSha"] != info["canonicalSha"]:
            status = "POLICY_STALE"
    row = {"team": "-", "dir": MANAGED_BASE, "plugin": POLICY_FILE, "expected": "installed==canonical",
           "actual": status, "status": status}
    if probe and status == "OK":
        verdict, detail = probe_marker(bl["revision"], policy_env_keys(m))
        info["probe"] = verdict
        if verdict == "UNVERIFIABLE":
            status = "PROBE_UNVERIFIABLE"
            row.update({"plugin": "policy-probe", "expected": bl["revision"], "actual": detail, "status": status})
        elif verdict == "NOT_LOADED":
            status = "POLICY_SKIPPED"
            row.update({"plugin": "policy-probe", "expected": bl["revision"],
                        "actual": "file current, marker not seen by claude", "status": status})
    info["status"] = status
    return row, info


def host_rows_for_dir(m, team, cfg, directory, blocked, state):
    rows = []

    def add(plugin, expected, actual, status):
        rows.append({"team": team, "dir": directory, "plugin": plugin, "expected": expected,
                     "actual": actual, "status": status})

    if not os.path.isdir(directory):
        add("-", "dir", "absent", "DIR_ABSENT")
        return rows
    # File level: what the sync owns in <dir>/.claude/settings.json.
    res = process_target(team, cfg, directory, state, dry_run=True)
    if res["status"] == "ERROR":
        add("-", "readable settings.json", res["error"], "FILE_DRIFT")
    for a in res["actions"]:
        if a["action"] == "ADOPTED":
            continue
        add(a["key"], "per manifest", a["action"], "CONFLICT" if a["action"] == "CONFLICT" else "FILE_DRIFT")
    prows = parity_rows(m, team, cfg, directory, state)
    rows.extend(prows)
    optout = {r["plugin"] for r in prows if r["status"] == "OPT_OUT"}
    excepted = set(exception_removals(m, team))
    oos = set((m.get("liveOutOfScope") or {}).get("marketplaces") or [])
    # Live level: what claude actually loads from this cwd.
    expected = {pid: True for pid in enabled_ids(cfg)}  # an excepted (false) plugin is not expected on
    # Built-ins never appear in `claude plugin list` (XACA-1643-015): judge them by claude's version.
    for pid, minv in sorted(builtin_ids(m).items()):  # GUARD:builtin-live
        if pid not in expected:
            continue
        expected.pop(pid)
        have, need = claude_version_cached(), parse_version(minv or "")
        if have is not None and need is not None and have >= need:  # GUARD:builtin-version
            rows.append({"team": team, "dir": directory, "plugin": pid, "kind": "builtin",
                         "expected": ">=%s" % minv, "actual": ".".join(str(x) for x in have), "status": "OK"})
        else:
            rows.append({"team": team, "dir": directory, "plugin": pid, "kind": "builtin",
                         "expected": ">=%s" % minv,
                         "actual": ".".join(str(x) for x in have) if have else "claude --version failed",
                         "status": "BUILTIN_UNAVAILABLE"})
    plist = live_plugin_list(directory)
    if plist is None:
        add("-", "plugin list", "unreadable", "LIST_UNREADABLE")
        return rows
    by_id = {}
    for e in plist:
        by_id[e.get("id")] = e
    for pid in sorted(expected):
        ent = by_id.get(pid)
        if pid in optout:
            continue  # the person switched it off; the OPT_OUT row above is the whole story
        if ent is None:
            # `plugin list` omits enabled-but-uninstalled ids (also catches unresolvable ids).
            add(pid, "enabled", "not installed", "NOT_INSTALLED")  # GUARD:not-installed
        elif ent.get("enabled") is True:
            add(pid, "enabled", "enabled", "OK")
        else:
            add(pid, "enabled", "disabled", "MISSING")
    for pid in blocked:
        ent = by_id.get(pid)
        if ent is not None and ent.get("enabled") is True:
            add(pid, "blocked", "enabled", "BLOCKED_LOADED")
    for pid, ent in sorted(by_id.items(), key=lambda kv: str(kv[0])):
        if ent.get("enabled") is True and pid not in expected and pid not in blocked:
            if pid in excepted:  # GUARD:exception-breach
                add(str(pid), "excepted (off)", "enabled", "EXCEPTION_BREACH")
            elif str(pid).rpartition("@")[2] in oos:  # GUARD:out-of-scope
                add(str(pid), "not the toolset", "enabled", "OUT_OF_SCOPE")
            else:
                add(str(pid), "not expected", "enabled", "EXTRA")
    return rows


def check_host(args):
    """Read-only per-host drift check (design section 6). Exit 0/1/2/3."""
    m = load_manifest()
    problems = validate_manifest(m, None)
    if problems:
        for p in problems:
            err("manifest invalid: %s" % p)
        return 3
    blocked = blocked_plugins(m)
    state = load_state()
    version = claude_version()
    floor = parse_version(m.get("minClaudeVersion") or "")
    rows = []
    if version is None:
        rows.append({"team": "-", "dir": "-", "plugin": "claude", "expected": "runnable",
                     "actual": "claude --version failed", "status": "CLAUDE_UNRUNNABLE"})
    elif floor is not None and version < floor:  # GUARD:version-floor
        rows.append({"team": "-", "dir": "-", "plugin": "claude", "expected": ">=%s" % m["minClaudeVersion"],
                     "actual": ".".join(str(x) for x in version), "status": "VERSION_UNVERIFIED"})
    teams_seen = 0
    dirs_seen = 0
    dirs_live = 0
    if version is not None:
        for name in sorted(m["teamTargets"]):
            cfg = effective_team_cfg(m, name)
            dirs = resolve_dirs(name, cfg)
            if dirs is None:
                continue
            teams_seen += 1
            targets = list(dirs)
            if cfg.get("mode") == "deployed":
                targets += [d for (_t, _c, d) in worktree_targets(m, [name])]
            for d in targets:
                dirs_seen += 1
                dirs_live += 1 if os.path.isdir(d) else 0
                rows.extend(host_rows_for_dir(m, name, cfg, d, blocked, state))
    for h in dir_collisions(m):  # GUARD:host-dir-collision
        rows.append({"team": ",".join(h["teams"]), "dir": h["dir"], "plugin": "-",
                     "expected": "one team per dir", "actual": "shared by %d teams" % len(h["teams"]),
                     "status": "DIR_COLLISION"})
    rows.extend(unmanaged_rows(m))
    rows.extend(machine_skill_rows(m))  # XACA-1643-006: machine-wide ~/.claude/skills
    for t, c, d in skill_targets(m, sorted(m["teamTargets"]), state):
        rows.extend(skill_rows(m, t, c, d, state))
    can_probe = version is not None and not (floor is not None and version < floor)
    prow, pinfo = host_policy(m, bool(args.probe) and can_probe)
    if prow is not None:
        rows.append(prow)
    n_drift = sum(1 for r in rows if r["status"] in DRIFT_STATUSES)
    n_warn = sum(1 for r in rows if r["status"] in WARN_STATUSES)
    n_unv = sum(1 for r in rows if r["status"] in UNVERIFIABLE_STATUSES)
    host = os.environ.get("KBSPL_HOST") or os.uname()[1]
    n_info = sum(1 for r in rows if r["status"] in INFO_STATUSES and r["status"] != "OK")
    summary = {"teams": teams_seen, "dirs": dirs_seen, "drift": n_drift, "warn": n_warn, "unverifiable": n_unv,
               "info": n_info}
    # Drift is a definite finding and wins; unverifiable is never folded into 0.
    rc = 1 if n_drift else (3 if n_unv else 0)  # GUARD:exit-precedence
    if rc == 0 and dirs_live == 0:  # GUARD:host-zero-targets
        rc = no_hosted_teams("check --host")
        summary["status"] = "NO_HOSTED_TEAMS"
    if args.json:
        out(json.dumps({"host": host,
                        "claudeVersion": ".".join(str(x) for x in version) if version else None,
                        "minClaudeVersion": m.get("minClaudeVersion"), "policy": pinfo,
                        "rows": rows, "summary": summary, "exit": rc}, indent=2))
        return rc
    cur_team = None
    for r in rows:
        if r["status"] in INFO_STATUSES:
            continue  # info rows are in --json (rows, summary.info), never in the drift table
        if r["team"] != cur_team:
            cur_team = r["team"]
            out("[%s]" % cur_team)
            out("  %-44s %-34s %-14s %-18s %s" % ("DIR", "PLUGIN", "EXPECTED", "ACTUAL", "STATUS"))
        out("  %-44s %-34s %-14s %-18s %s" % (r["dir"][-44:], r["plugin"][:34], r["expected"][:14],
                                              str(r["actual"])[:18], r["status"]))
    out("HOST %s teams=%d dirs=%d drift=%d warn=%d unverifiable=%d" % (
        host, teams_seen, dirs_seen, n_drift, n_warn, n_unv))
    return rc


def probe_binary(b):
    """Is this plugin's binary usable? A declared probe is the ONLY authority:
    /usr/bin/sourcekit-lsp is a shim that exists with no toolchain behind it
    (001 implication 7), so a PATH hit must not count when a probe is declared."""
    probe = b.get("probe")
    if probe:  # GUARD:probe-authority
        rc, _so, _se = run(probe, timeout=30)
        return rc == 0
    return shutil.which(b["command"]) is not None


def binary_rows(m, args):
    binaries = m.get("binaries") or {}
    if args.team and args.team not in m["teamTargets"]:
        raise ToolError("unknown team %r (manifest teams: %s)" % (args.team, ", ".join(sorted(m["teamTargets"]))))
    names = [args.team] if args.team else sorted(m["teamTargets"])
    wanted = {}
    required = {}
    hosted = 0
    for n in names:
        cfg = effective_team_cfg(m, n)
        if not args.team:
            dirs = resolve_dirs(n, cfg)
            if dirs is None or not any_live(dirs):
                continue  # this host does not host the team
        hosted += 1
        if not cfg.get("deliver", True):
            continue
        for pid in sorted(enabled_ids(cfg)):  # an excepted plugin needs no binary on this team
            wanted.setdefault(pid, []).append(n)
        for cmd in cfg.get("requiredBinaries") or []:
            required.setdefault(cmd, []).append(n)
    rows = []
    for pid in sorted(wanted):
        b = binaries.get(pid)
        if b is None:
            continue  # non-LSP plugin: needs no binary (an unmapped LSP plugin fails validation upstream)
        rows.append({"plugin": pid, "command": b["command"], "teams": wanted[pid],
                     "status": "PRESENT" if probe_binary(b) else "MISSING",
                     "install": b.get("install"), "installCmd": b.get("installCmd"), "_b": b})
    for cmd in sorted(required):
        rows.append({"plugin": "(requiredBinaries)", "command": cmd, "teams": required[cmd],
                     "status": "PRESENT" if shutil.which(cmd) else "MISSING",
                     "install": None, "installCmd": None, "_b": {"command": cmd}})
    return rows, hosted


def claude_row(m):
    version = claude_version()
    floor = m.get("minClaudeVersion")
    if version is None:
        return {"version": None, "floor": floor, "status": "UNRUNNABLE"}
    fv = parse_version(floor or "")
    status = "BELOW_FLOOR" if (fv is not None and version < fv) else "OK"
    return {"version": ".".join(str(x) for x in version), "floor": floor, "status": status}


def do_binaries(args):
    """Which LSP binaries do this host's enabled plugins need, and are they usable?
    Exit 0 all present / 1 missing / 3 unverifiable (bad manifest, unmapped LSP plugin,
    claude unrunnable or below the floor). --install never runs silently."""
    m = load_manifest()
    problems = validate_manifest(m, load_catalog())
    if problems:  # GUARD:binaries-validate
        for p in problems:
            err("manifest invalid: %s" % p)
        return 3
    team_paths()  # a malformed registry is exit 3 here, whatever --team says
    rows, hosted = binary_rows(m, args)
    claude = claude_row(m)
    missing = [r for r in rows if r["status"] == "MISSING"]
    notes = []
    if args.install and missing:
        interactive = sys.stdin.isatty() and sys.stdout.isatty()
        seam = test_seam()  # test-only, sandbox-gated stand-in for the prompt answer
        seen = set()
        for r in missing:
            cmd = r.get("installCmd")
            if not cmd:
                notes.append("%s: no automatic install; manual: %s" % (r["command"], r.get("install") or "see docs"))
                continue
            if tuple(cmd) in seen:
                continue
            seen.add(tuple(cmd))
            line = " ".join(cmd)
            if not interactive and seam is None:  # GUARD:no-silent-install
                notes.append("would run (non-interactive, NOT executing): %s" % line)
                continue
            if seam is not None:
                ans = seam
            else:
                sys.stdout.write("Run `%s` to install %s? [y/N] " % (line, r["command"]))
                sys.stdout.flush()
                ans = sys.stdin.readline()
            if ans.strip().lower() not in ("y", "yes"):
                notes.append("skipped: %s" % line)
                continue
            notes.append("running: %s" % line)
            rc = subprocess.call(cmd)
            notes.append("%s exited %d" % (cmd[0], rc))
            for r2 in rows:
                if r2.get("installCmd") == cmd:
                    r2["status"] = "PRESENT" if probe_binary(r2["_b"]) else "MISSING"
        missing = [r for r in rows if r["status"] == "MISSING"]
    # "0 needed" is a legitimate 0 only when teams DID resolve and enable no LSP plugin.
    no_hosted = hosted == 0  # GUARD:binaries-zero-teams
    if no_hosted:
        no_hosted_teams("binaries")
    rc = 1 if missing else (3 if (claude["status"] != "OK" or no_hosted) else 0)
    for r in rows:
        r.pop("_b", None)
    if args.json:
        out(json.dumps({"rows": rows, "claude": claude, "notes": notes, "exit": rc}, indent=2))
        return rc
    for r in rows:
        out("%-8s %-28s %-40s teams=%s" % (r["status"], r["command"], r["plugin"], ",".join(r["teams"])))
        if r["status"] == "MISSING" and r.get("install"):
            out("         install: %s" % r["install"])
    out("claude %s (floor %s): %s" % (claude["version"] or "?", claude["floor"] or "none", claude["status"]))
    for n in notes:
        out(n)
    out("binaries: %d needed, %d missing" % (len(rows), len(missing)))
    return rc


# ---------------------------------------------------------------------------
# managed-policy (L1): install / remove / print the fleet drop-in
# ---------------------------------------------------------------------------

def test_seam():
    """KBSPL_TEST_INSTALL_ANSWER stands in for the typed prompt answer, for tests only. It is
    honoured ONLY in a sandboxed run: TEST_TMP_DIR names an existing dir AND the managed dir is
    under it (the same gate family as the default-dir refusal below). Anywhere else it is ignored, so
    it can never skip the terminal requirement or the [y/N] prompt in production."""
    ans = os.environ.get("KBSPL_TEST_INSTALL_ANSWER")
    if ans is None:
        return None
    tmp = os.environ.get("TEST_TMP_DIR") or ""
    root, base = os.path.realpath(tmp), os.path.realpath(MANAGED_BASE)
    sandboxed = os.path.isdir(tmp) and (base == root or base.startswith(root.rstrip(os.sep) + os.sep))
    if not sandboxed:  # GUARD:seam-gate
        return None
    return ans


def guard_default_managed_dir():
    """A test run must never reach the real system path (the dev machine is a source, not a
    consumer of the managed policy). Tests set TEST_TMP_DIR and CLAUDE_MANAGED_DIR."""
    if os.environ.get("TEST_TMP_DIR") and MANAGED_BASE == DEFAULT_MANAGED_BASE:  # GUARD:test-default-dir
        raise ToolError("refusing: TEST_TMP_DIR is set (a test run) but CLAUDE_MANAGED_DIR is not, so this "
                        "would touch the real %s" % DEFAULT_MANAGED_BASE)


def shq(argv):
    return " ".join(shlex.quote(a) for a in argv)


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()  # GUARD:interactive


def priv_run(argv):
    """Run one command as root. ALWAYS visible (echoed first) and always plain `sudo`, which
    prompts for the password itself: never `sudo -n`, never a cached-credential trick."""
    full = list(argv) if os.geteuid() == 0 else ["sudo"] + list(argv)  # GUARD:sudo-interactive
    sys.stdout.write("  + %s\n" % shq(full))
    sys.stdout.flush()
    return subprocess.call(full)


def policy_confirm(question, args):
    """(ok, why). Needs a real terminal even with --yes: sudo asks for a password on it, so
    a run with no terminal is a PENDING install, not a silent one."""
    seam = test_seam()  # test-only, sandbox-gated stand-in for the typed answer
    if seam is None and not interactive():  # GUARD:policy-tty
        return False, "non-interactive (no terminal)"
    if args.yes:
        return True, ""
    if seam is not None:
        ans = seam
    else:
        sys.stdout.write("%s [y/N] " % question)
        sys.stdout.flush()
        ans = sys.stdin.readline()
    if ans.strip().lower() not in ("y", "yes"):  # GUARD:policy-confirm
        return False, "declined"
    return True, ""


def backup_policy_file(src):
    """Copy the installed file under ~/aiteamforge-backups/claude-managed-YYYYMMDD/ before it
    is replaced or removed. Raises (aborting the change) when the backup cannot be made."""
    d = os.path.join(os.path.expanduser("~"), "aiteamforge-backups", "claude-managed-" + time.strftime("%Y%m%d"))
    os.makedirs(d, exist_ok=True)
    dst = os.path.join(d, "%s.%s" % (POLICY_FILE, time.strftime("%H%M%S")))
    shutil.copy2(src, dst)
    return dst


def read_bytes(path):
    try:
        with open(path, "rb") as fh:
            return fh.read()
    except OSError:
        return None


def show_policy_diff(cur, text, dest):
    before = cur.decode("utf-8", "replace").splitlines() if cur is not None else []
    after = text.splitlines()
    for ln in difflib.unified_diff(before, after, "installed:" + dest if cur is not None else "(absent)",
                                   "canonical:" + dest, lineterm=""):
        out(ln)


def policy_install(text, args):
    _base, dropin, dest = policy_paths()
    want = text.encode("utf-8")
    cur = read_bytes(dest)
    if cur == want:  # GUARD:policy-uptodate
        out("managed policy: up to date (%s), nothing to do" % dest)
        return 0
    show_policy_diff(cur, text, dest)
    tmpdest = os.path.join(dropin, "." + POLICY_FILE + ".kbspl-new")  # no .json suffix: never read as a drop-in
    if args.dry_run:
        out("DRY RUN: nothing written. With sudo this would run:")
        for argv in ([["mkdir", "-p", dropin], ["cp", "<staged policy file>", tmpdest],
                      ["chown", "root:wheel", tmpdest], ["chmod", "0644", tmpdest],
                      ["mv", "-f", tmpdest, dest]]):
            out("  + sudo " + shq(argv))
        return 0
    ok, why = policy_confirm("Install the Claude Code managed policy to %s (requires sudo)?" % dest, args)
    if not ok:
        out("managed policy: PENDING (%s). Not installed. Run `%s managed-policy --install` from a terminal." % (why, PROG))
        return 4
    fd, stage = tempfile.mkstemp(prefix="kbspl-policy-")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(want)
        out("About to run these as root (sudo will ask for your password):")
        for argv in ([["mkdir", "-p", dropin], ["cp", stage, tmpdest], ["chown", "root:wheel", tmpdest],
                      ["chmod", "0644", tmpdest]]):
            if priv_run(argv) != 0:
                priv_run(["rm", "-f", tmpdest])
                err("%s failed; managed policy NOT installed (the existing file is untouched)" % argv[0])
                return 1
        backup = None
        if cur is not None:
            try:
                backup = backup_policy_file(dest)
            except OSError as exc:
                priv_run(["rm", "-f", tmpdest])
                err("could not back up the installed policy (%s); managed policy NOT replaced" % exc)
                return 1
        if priv_run(["mv", "-f", tmpdest, dest]) != 0:  # GUARD:atomic-swap
            priv_run(["rm", "-f", tmpdest])
            err("could not move the policy into place; the existing file is untouched")
            return 1
        got = read_bytes(dest)
        if got != want:  # GUARD:policy-readback
            err("read-back of %s does not match the canonical policy; rolling back" % dest)
            if backup is not None:
                rolled = priv_run(["cp", backup, tmpdest]) == 0 and priv_run(["chown", "root:wheel", tmpdest]) == 0 \
                    and priv_run(["chmod", "0644", tmpdest]) == 0 and priv_run(["mv", "-f", tmpdest, dest]) == 0
            else:
                rolled = priv_run(["rm", "-f", dest]) == 0
            err("rollback %s" % ("complete" if rolled else "FAILED: inspect %s by hand" % dest))
            return 1
        out("managed policy: installed %s%s" % (dest, " (previous copy backed up to %s)" % backup if backup else ""))
        out("verify: %s check --host --probe" % PROG)
        return 0
    finally:
        try:
            os.unlink(stage)
        except OSError:
            pass


def policy_remove(args):
    base, dropin, dest = policy_paths()
    if not os.path.lexists(dest):
        out("managed policy: %s is not installed, nothing to remove" % dest)
        return 0
    rm_argv = ["rm", dest]  # GUARD:remove-only-ours
    if args.dry_run:
        out("DRY RUN: nothing removed. With sudo this would run:")
        out("  + sudo " + shq(rm_argv))
        out("  + sudo rmdir %s   (only if empty)" % shlex.quote(dropin))
        return 0
    ok, why = policy_confirm("Remove the Claude Code managed policy %s (requires sudo)?" % dest, args)
    if not ok:
        out("managed policy: NOT removed (%s)" % why)
        return 4
    try:
        backup = backup_policy_file(dest)
    except OSError as exc:
        err("could not back up %s (%s); NOT removed" % (dest, exc))
        return 1
    out("About to run this as root (sudo will ask for your password):")
    if priv_run(rm_argv) != 0:
        err("could not remove %s" % dest)
        return 1
    # Leave the directories alone unless they are now empty: other drop-ins and
    # managed-settings.json belong to someone else.
    if os.path.isdir(dropin) and not os.listdir(dropin):  # GUARD:rmdir-empty
        priv_run(["rmdir", dropin])
        if os.path.basename(base) == "ClaudeCode" and os.path.isdir(base) and not os.listdir(base):
            priv_run(["rmdir", base])
    out("managed policy: removed %s (backup: %s)" % (dest, backup))
    return 0


def do_managed_policy(args):
    chosen = [n for n, v in (("--print", args.print_policy), ("--install", args.install), ("--remove", args.remove)) if v]
    if len(chosen) != 1:
        raise ToolError("managed-policy needs exactly one of --print, --install, --remove")
    if args.remove:
        guard_default_managed_dir()
        return policy_remove(args)
    text = render_policy(load_manifest())
    if args.print_policy:
        sys.stdout.write(text)
        return 0
    guard_default_managed_dir()
    return policy_install(text, args)


# ---------------------------------------------------------------------------
# sync --install-missing (project-scoped installs only)
# ---------------------------------------------------------------------------

def install_argv(pid):
    # --scope project, always: the default (user) writes user-scope enabledPlugins, which
    # XACA-1227 is removing, and `local` would write settings.local.json, which is never ours.
    return [CLAUDE_BIN, "plugin", "install", pid, "--scope", "project"]  # GUARD:install-scope


def ensure_installed(cfg, directory, dry_run, builtin=()):
    """Install, from `directory`, every enabled plugin that `plugin list --json` does not show.
    Returns (rows, problem). A plugin that is installed but disabled needs nothing: the project
    `true` enables it (XACA-1599-008)."""
    rows = []
    if not cfg.get("deliver", True) or not os.path.isdir(directory):
        return rows, None
    want = sorted(pid for pid in enabled_ids(cfg) if pid not in builtin)  # GUARD:install-skips-builtin
    if not want:
        return rows, None
    plist = live_plugin_list(directory)
    if plist is None:
        return rows, "plugin list unreadable from %s; installed nothing" % directory
    have = set(e.get("id") for e in plist)
    problem = None
    for pid in want:
        if pid in have:
            continue
        if not PLUGIN_ID_RE.match(pid) or pid.startswith("-"):
            rows.append({"plugin": pid, "result": "FAILED", "detail": "not a valid plugin id"})
            problem = "refused to install an invalid plugin id"
            continue
        if dry_run:
            rows.append({"plugin": pid, "result": "WOULD_INSTALL", "detail": " ".join(install_argv(pid))})
            continue
        rc, so, se = run(install_argv(pid), cwd=directory, timeout=300)
        if rc == 0:
            rows.append({"plugin": pid, "result": "INSTALLED", "detail": ""})
        else:
            rows.append({"plugin": pid, "result": "FAILED", "detail": ((se or so).strip()[:160] or "rc=%d" % rc)})
            problem = "claude plugin install failed for %s" % pid
    return rows, problem


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser():
    ap = argparse.ArgumentParser(prog=PROG, description="Fleet-standard Claude Code plugin delivery (XACA-1599)")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("list", help="teams, modes and resolved session dirs")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=do_list)

    p = sub.add_parser("check", help="drift check (exit 0 clean / 1 drift / 2 usage / 3 unverifiable)")
    p.add_argument("team", nargs="?")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--manifest", action="store_true", help="validate the manifest itself")
    p.add_argument("--require-catalog", action="store_true", help="--manifest: exit 3 if no marketplace catalog")
    p.add_argument("--host", action="store_true", help="live check of this host via `claude plugin list`")
    p.add_argument("--probe", "--deep", dest="probe", action="store_true",
                   help="--host: behavioural probe, one `claude -p` model call reading the policy marker "
                        "(exit 3 when it cannot be verified)")
    p.set_defaults(fn=do_check)

    for name, fn, helptxt in (("sync", do_sync, "write session dirs (and, with --all, linked worktrees)"),
                              ("sync-worktrees", do_sync_worktrees, "write linked worktrees of deployed teams")):
        p = sub.add_parser(name, help=helptxt)
        p.add_argument("team", nargs="?")
        p.add_argument("--all", action="store_true")
        p.add_argument("--dry-run", action="store_true")
        p.add_argument("--force-owned", action="store_true", help="overwrite a key a human changed")
        p.add_argument("--json", action="store_true")
        if name == "sync":
            p.add_argument("--install-missing", action="store_true",
                           help="also run `claude plugin install <id> --scope project` (never user/local) from "
                                "each session dir for enabled plugins that `plugin list` does not show")
        p.set_defaults(fn=fn, install_missing=False)

    p = sub.add_parser("skills", help="skill classes (XACA-1643): group-names | classes")
    p.add_argument("action", choices=("group-names", "classes"))
    p.set_defaults(fn=do_skills)

    p = sub.add_parser("diff", help="unified diff of what sync would change")
    p.add_argument("team")
    p.set_defaults(fn=do_diff)

    p = sub.add_parser("binaries", help="LSP binaries the enabled plugins need")
    p.add_argument("--team")
    p.add_argument("--install", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=do_binaries)

    p = sub.add_parser("managed-policy", help="L1 fleet policy: print, install or remove the managed drop-in")
    p.add_argument("--print", dest="print_policy", action="store_true", help="print the generated policy and exit")
    p.add_argument("--install", action="store_true", help="install %s (sudo, explicit confirm, terminal only)" % POLICY_FILE)
    p.add_argument("--remove", action="store_true", help="remove ONLY %s (and the dirs, if left empty)" % POLICY_FILE)
    p.add_argument("--yes", action="store_true", help="skip the typed [y/N]; a terminal is still required")
    p.add_argument("--dry-run", action="store_true", help="show the diff and the exact sudo commands, change nothing")
    p.set_defaults(fn=do_managed_policy)

    p = sub.add_parser("help")
    p.set_defaults(fn=lambda a: (build_parser().print_help(), 0)[1])
    return ap


def main(argv):
    ap = build_parser()
    args = ap.parse_args(argv)
    if not getattr(args, "fn", None):
        ap.print_help()
        return 2
    try:
        return args.fn(args)
    except ToolError as exc:
        err(str(exc))
        return exc.code
    except BrokenPipeError:
        return 0
    except Exception:  # noqa: BLE001 -- a distinct code, so callers never read a crash as "binary missing"/drift
        import traceback
        traceback.print_exc()
        err("unexpected exception (a bug in %s, not a finding); exiting %d" % (PROG, EXIT_CRASH))
        return EXIT_CRASH


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
