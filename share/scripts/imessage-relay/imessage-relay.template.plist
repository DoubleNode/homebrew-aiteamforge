<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iMessage relay LaunchAgent - XACA-1402-011 (EPIC-0068, design doc section 2.3)
  =============================================================================
  Rendered by scripts/imessage-relay/install-imessage-relay.sh. NEVER hand-copied:
  the placeholders below are substituted at install time.

    {{NODE}}            absolute path of a Node 18+ binary, resolved at install time
    {{RELAY}}           installed imessage-relay.js ($AITEAMFORGE_DIR/scripts/)
    {{HOME}}            the consuming user's home
    {{AITEAMFORGE_DIR}} the consumer install root (the relay reads config/machine-identity.json there)
    {{LOG_DIR}}         ~/Library/Logs/aiteamforge

  WHY A LAUNCHAGENT (not a LaunchDaemon): Messages.app only exists in the logged-in GUI
  session, and the first send raises a one-time macOS Automation -> Messages prompt that
  has to be approved at the console. A daemon has no GUI session and would fail silently.

  OPT-IN ONLY: the installer refuses unless the operator opted in AND `imessage-relay.js
  probe` exits 0 (Messages has a signed-in, enabled iMessage account). Never installed on
  the dev-team source machine.

  NO SECRETS HERE: the relay reads the fleet token from ~/.aiteamforge/fleet-config.json
  itself. PATH is minimal on purpose: the relay calls /usr/bin/osascript by absolute path.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiteamforge.imessage-relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{NODE}}</string>
        <string>{{RELAY}}</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>AITEAMFORGE_DIR</key>
        <string>{{AITEAMFORGE_DIR}}</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/imessage-relay.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/imessage-relay.err.log</string>
</dict>
</plist>
