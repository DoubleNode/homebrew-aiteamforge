_series_to_subtitle() {
    case "$1" in
        ENT) echo "STAR TREK: ENTERPRISE" ;;
        TNG) echo "STAR TREK: THE NEXT GENERATION" ;;
        DS9) echo "STAR TREK: DEEP SPACE NINE" ;;
        TOS) echo "STAR TREK: THE ORIGINAL SERIES" ;;
        LD)  echo "STAR TREK: LOWER DECKS" ;;
        VOY) echo "STAR TREK: VOYAGER" ;;
        MED) echo "HOUSE, M.D." ;;
        LEG) echo "THE PRACTICE" ;;
        FER) echo "STAR TREK: FERENGI ALLIANCE" ;;
        SDK) echo "STAR TREK: SPACE DOCK" ;;
        SNW) echo "STAR TREK: STRANGE NEW WORLDS" ;;
        *)   echo "STAR TREK" ;;
    esac
}

