# ── Port computation ──────────────────────────────────────────────────────────

_compute_port() {
    # Try aiteamforge_compute_instance_port first (needs aiteamforge-paths.sh sourced)
    local port
    if source "${AITEAMFORGE_PATHS_SH}" 2>/dev/null && \
       declare -f aiteamforge_compute_instance_port &>/dev/null; then
        # Attempt to compute using the band base already known to the registry.
        # For a brand-new team, pass a synthetic entry by injecting a temp env.
        # Use python3 fallback — simpler and no side effects.
        port=""
    fi

    # Python-based scan: find first free port in band
    port=$(python3 - "${TEAM_PATHS_JSON}" "${PORT_BAND_BASE}" "${PORT_BAND_RANGE}" 2>/dev/null <<'PYEOF'
import sys, json
from pathlib import Path

team_paths_file, base_str, range_str = sys.argv[1], sys.argv[2], sys.argv[3]
base = int(base_str)
band_range = int(range_str)

used = set()
if Path(team_paths_file).exists():
    try:
        config = json.loads(Path(team_paths_file).read_text(encoding="utf-8"))
        for entry in config.get("teams", {}).values():
            p = entry.get("lcars_port")
            if p is not None:
                try:
                    used.add(int(p))
                except (ValueError, TypeError):
                    pass
    except Exception:
        pass

for port in range(base, base + band_range):
    if port not in used:
        print(port)
        sys.exit(0)
print("", end="")
sys.exit(1)
PYEOF
)
    echo "$port"
}

# ── Python helper: insert into aiteamforge_paths.py DEFAULT_TEAMS ─────────────

_insert_default_teams() {
    local team_id="$1" team_code="$2" kanban_dir="$3" working_dir="$4"
    local lcars_port="$5" port_base="$6" port_range="$7"

    python3 - "${AITEAMFORGE_PATHS_PY}" \
        "$team_id" "$team_code" "$kanban_dir" "$working_dir" \
        "$lcars_port" "$port_base" "$port_range" <<'PYEOF'
import sys, re, ast

path = sys.argv[1]
team_id, team_code, kanban_dir, working_dir = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
lcars_port, port_base, port_range = sys.argv[6], sys.argv[7], sys.argv[8]

src = open(path).read()

# Check already present using AST (handles AnnAssign)
def _already_in_default_teams(src, tid):
    tree = ast.parse(src)
    for node in ast.walk(tree):
        targets = []
        value = None
        if isinstance(node, ast.Assign):
            targets = node.targets; value = node.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            targets = [node.target]; value = node.value
        for t in targets:
            if isinstance(t, ast.Name) and t.id == "DEFAULT_TEAMS":
                if isinstance(value, ast.Dict):
                    for k in value.keys:
                        if isinstance(k, ast.Constant) and k.value == tid:
                            return True
    return False

if _already_in_default_teams(src, team_id):
    sys.exit(0)  # Already present, no-op

# Build the new entry block
# Use a raw-string multiline insert to avoid f-string quoting issues
port_value = "None" if lcars_port in ("None", "null", "") else lcars_port
new_entry = f'''    "{team_id}": {{
        "team_code": "{team_code}",
        "kanban_dir": "{kanban_dir}",
        "working_dir": "{working_dir}",
        "lcars_port_base": {port_base},
        "lcars_port_range": {port_range},
        "lcars_port": {port_value},
        "anthropic_account_id": "",
        "anthropic_account_nickname": "",
        "anthropic_api_key_env_var": "",
    }},'''

# Insert before the closing "# ── Aliases" comment or before the final closing }
# Strategy: find the last entry's closing brace + comma, insert after it.
# Look for "    }" followed by optional comma then newline, before closing DEFAULT_TEAMS }
# We insert before the "# ── Aliases" section or before `}` at the end of DEFAULT_TEAMS.

# Find insertion point: before the "# ── Aliases" comment block inside DEFAULT_TEAMS,
# or before the last closing brace of the dict.
aliases_pattern = r'(\n    # ── Aliases [^\n]*\n)'
m = re.search(aliases_pattern, src)
if m:
    insert_pos = m.start()
    new_src = src[:insert_pos] + "\n" + new_entry + src[insert_pos:]
else:
    # Fallback: insert before the closing brace of DEFAULT_TEAMS
    # Find the last "    }," block and insert after it
    pattern = r'(    \},?\n\n}\n)'
    m2 = re.search(pattern, src[::-1])
    if m2:
        # Reverse the search — find last occurrence of a closing brace sequence
        insert_pos = len(src) - m2.end()
        new_src = src[:insert_pos] + new_entry + "\n" + src[insert_pos:]
    else:
        # Last resort: insert before the final "}"
        last_brace = src.rfind("\n}")
        if last_brace == -1:
            print(f"ERROR: could not find insertion point in {path}", file=sys.stderr)
            sys.exit(1)
        new_src = src[:last_brace] + "\n" + new_entry + src[last_brace:]

open(path, "w").write(new_src)
sys.exit(0)
PYEOF
}

# ── Shell helper: idempotent case-arm insert ───────────────────────────────────

_insert_case_arm() {
    local file="$1"
    local func_name="$2"
    local new_arm="$3"   # the arm to insert, e.g. "        myteam) echo \"MTM\" ;;"
    local sentinel="$4"  # text before which to insert (e.g. "        *)")

    # Check if already present (the team-id would be at the start of the arm)
    local arm_key
    arm_key=$(echo "$new_arm" | sed "s/^[[:space:]]*//" | cut -d')' -f1)
    if grep -q "^[[:space:]]*${arm_key})[[:space:]]" "$file" 2>/dev/null; then
        return 0  # Already present
    fi

    # Insert before the sentinel line. XACA-0542-018: scope the sentinel search to
    # within the named function's body, since multiple case statements in the same
    # file share the same default sentinel (e.g. "        *)") — an unscoped search
    # would insert the arm into the FIRST such function rather than func_name.
    python3 - "$file" "$func_name" "$sentinel" "$new_arm" <<'PYEOF'
import sys
path, func_name, sentinel, new_arm = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
src = open(path).read()
# Anchor the search at the function definition so we land in the right function.
func_idx = src.find(func_name + '()')
if func_idx == -1:
    print(f"WARNING: function '{func_name}' not found in {path}", file=sys.stderr)
    sys.exit(1)
idx = src.find(sentinel, func_idx)
if idx == -1:
    print(f"WARNING: sentinel '{sentinel}' not found in {path} (function {func_name})", file=sys.stderr)
    sys.exit(1)
# Find the start of the line containing the sentinel
line_start = src.rfind('\n', 0, idx) + 1
new_src = src[:line_start] + new_arm + '\n' + src[line_start:]
open(path, 'w').write(new_src)
PYEOF
}

# ── server.py team_dir_map insertion — RETIRED (XACA-0992) ───────────────────
#
# `_insert_team_dir_map()` used to live here. Removed: the dict it edited
# (lcars-ui/server.py's hand-rolled `team_dir_map`) was itself removed when
# serve_image()/serve_appicon() moved to the generic
# _resolve_base_team()/_split_team_id() rule, so this function's regex could
# never match again and every call would `exit 1` — which, under this
# script's `set -euo pipefail`, aborted the entire provisioning run at
# site 10, after sites 1-9 had already succeeded. See site 10's comment at
# its call site (search "RETIRED (XACA-0992)") for the full story and the
# ASSET_DIR derivation comment above for the invariant server.py now
# enforces instead.

# ── Insert into amb-session-map.json ─────────────────────────────────────────

_insert_amb_session_map() {
    local team_id="$1"
    local terminals_and_avatars="$2"  # newline-separated "terminal:avatar" pairs

    python3 - "${AMB_SESSION_MAP}" "$team_id" "$terminals_and_avatars" <<'PYEOF'
import sys, json
from pathlib import Path

path = Path(sys.argv[1])
team_id = sys.argv[2]
pairs = [line.strip() for line in sys.argv[3].strip().splitlines() if ':' in line.strip()]

data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}

changed = False
for pair in pairs:
    terminal, avatar = pair.split(':', 1)
    key = f"{team_id}-{terminal}"
    if key not in data:
        data[key] = avatar
        changed = True

if changed:
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PYEOF
}

# ── Insert into aiteamforge-paths.sh heredoc ─────────────────────────────────

_insert_paths_sh_heredoc() {
    local team_id="$1" kanban_dir="$2" working_dir="$3" lcars_port="$4"
    local port_base="$5" port_range="$6" team_code="$7"

    python3 - "${AITEAMFORGE_PATHS_SH}" \
        "$team_id" "$kanban_dir" "$working_dir" "$lcars_port" \
        "$port_base" "$port_range" "$team_code" <<'PYEOF'
import sys, re

path = sys.argv[1]
team_id, kanban_dir, working_dir = sys.argv[2], sys.argv[3], sys.argv[4]
lcars_port, port_base, port_range, team_code = sys.argv[5], sys.argv[6], sys.argv[7], sys.argv[8]

src = open(path).read()

# Check if already present
if f'"{team_id}"' in src or f"'{team_id}'" in src:
    # Simple heuristic: check for the team_id in the heredoc lines
    for line in src.splitlines():
        stripped = line.strip()
        if stripped.startswith(f'printf') and f'"{team_id}"' in stripped:
            sys.exit(0)
    # Also check literal printf with the team_id
    if re.search(r'printf[^\n]+' + re.escape(team_id), src):
        sys.exit(0)

# Normalise lcars_port — "null" or empty → "null" for the shell heredoc
port_val = "null" if lcars_port in ("None", "null", "") else lcars_port

# Build the new printf line (matching existing format)
new_line = (
    f'    printf \'%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n\' '
    f'"{team_id}"'
    f'     "{kanban_dir}"'
    f'     "{working_dir}"'
    f'     "{port_val}"  "{port_base}" "{port_range}" "{team_code}"'
)

# Insert before the legacy alias block or before the closing brace of the function
# Sentinel: the "# Legacy alias" comment or the closing "}" of _AITEAMFORGE_DEFAULT_TEAMS_DATA
sentinel = '    # Legacy alias'
idx = src.find(sentinel)
if idx == -1:
    # Try the freelance alias line
    sentinel = '    printf \'%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\n\' "freelance"'
    idx = src.find(sentinel)
if idx == -1:
    # Insert before the closing } of the function
    # Find _AITEAMFORGE_DEFAULT_TEAMS_DATA closing brace
    func_end = src.rfind('\n}\n', 0, src.find('_aiteamforge_is_interactive'))
    if func_end == -1:
        print(f"ERROR: could not find insertion point in {path}", file=sys.stderr)
        sys.exit(1)
    idx = func_end + 1  # after \n, before }

line_start = src.rfind('\n', 0, idx) + 1
new_src = src[:line_start] + new_line + '\n' + src[line_start:]
open(path, 'w').write(new_src)
PYEOF
}

# ── Insert into team-paths.json ───────────────────────────────────────────────

_insert_team_paths_json() {
    local team_id="$1" team_code="$2" kanban_dir="$3" working_dir="$4"
    local lcars_port="$5" port_base="$6" port_range="$7"

    # XACA-1187-003/-004/-005: this is the new-team REGISTRATION writer --
    # the exact path `spacedock` went through. The old body did a single
    # unlocked read, mutated an in-memory dict, and called a bare
    # `write_text()` -- no lock (so a concurrent self-heal pass / LCARS
    # account save / kb-port-reconcile run / another kb-init-team or
    # kb-freelance run completing its own read-modify-write in the window
    # between our read and our write had its change silently discarded --
    # the lost-update mechanism XACA-1187 forensics reproduced), and no
    # `os.replace()` (so a concurrent reader could observe a truncated file
    # mid-write). Rebuilt to match the proven pattern already shipped at
    # kanban-hooks/aiteamforge_paths.py:_rewrite_config_on_disk and
    # scripts/kb-port-reconcile:_update_team_paths_json: flock the shared
    # `team-paths.json.lock` sidecar, RE-READ the file under that lock
    # before mutating (the part that actually defeats the lost update --
    # atomicity alone does not), then tmp-in-same-dir + fsync + os.replace.
    python3 - "${TEAM_PATHS_JSON}" \
        "$team_id" "$team_code" "$kanban_dir" "$working_dir" \
        "$lcars_port" "$port_base" "$port_range" "${AITEAMFORGE_PATHS_PY}" <<'PYEOF'
import fcntl
import importlib.util
import json
import os
import stat
import sys
import tempfile
from pathlib import Path

path = Path(sys.argv[1])
team_id, team_code, kanban_dir, working_dir = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
lcars_port_str, port_base_str, port_range_str = sys.argv[6], sys.argv[7], sys.argv[8]
paths_py = sys.argv[9] if len(sys.argv) > 9 else ""

lcars_port = None if lcars_port_str in ("None", "null", "") else int(lcars_port_str)

# XACA-1187-005: single-source the fail-closed no-team-loss guard from the
# canonical module via the same importlib pattern kb-port-reconcile already
# uses for its write-side byte floor, rather than reproducing the
# set-difference logic here. Falls back to an inline reimplementation if the
# module can't be loaded (must never become a hard dependency -- same
# convention as kb-port-reconcile's _MIN_PLAUSIBLE_REGISTRY_BYTES fallback).
def _fallback_reject_if_team_ids_lost(before_ids, after_ids, *, allow_removal=False, resolved=None, context=""):
    lost = sorted(set(before_ids) - set(after_ids))
    if lost and not allow_removal:
        print(
            f"kb-init-team: REFUSING to write {resolved} -- {context}: this write "
            f"would drop {len(lost)} team id(s) already in the registry: "
            f"{', '.join(lost)} (XACA-1187-005). No write performed.",
            file=sys.stderr,
        )
        raise ValueError(f"refusing to write: would drop team id(s): {', '.join(lost)}")
    return lost

_reject_if_team_ids_lost = _fallback_reject_if_team_ids_lost
if paths_py:
    try:
        _spec = importlib.util.spec_from_file_location("_kb_init_team_loss_guard_mod", paths_py)
        if _spec is not None and _spec.loader is not None:
            _mod = importlib.util.module_from_spec(_spec)
            _spec.loader.exec_module(_mod)
            _reject_if_team_ids_lost = getattr(_mod, "_reject_if_team_ids_lost", _fallback_reject_if_team_ids_lost)
    except Exception:
        pass  # keep the fallback -- the guard must never become the reason we can't run at all

resolved = path.resolve()
lock_path = resolved.with_name(f"{resolved.name}.lock")

# XACA-1187 regression fix (PR #875 round-2 review): the parent directory
# must exist BEFORE the lock file can be created inside it. On a
# genuinely first-time machine -- ~/.aiteamforge/ not created yet, exactly
# the case kb-init-team exists to serve -- opening the lock file first
# fails with ENOENT and this always exits 2, before ever reaching the
# mkdir that used to run later in this function. Create the directory
# here, reported distinctly from a lock-open failure, so a directory
# problem never reads as a lock problem.
try:
    resolved.parent.mkdir(parents=True, exist_ok=True)
except OSError as exc:
    print(f"kb-init-team: cannot create directory {resolved.parent}: {exc}", file=sys.stderr)
    sys.exit(2)

# XACA-1059-005 lock-identity convention: open 'a' (never truncate) and
# NEVER unlink. lcars-ui/server.py's _sweep_stale_locks() is the only thing
# that ever removes this file, and only when a non-blocking flock probe
# proves nobody holds it -- do not "clean up" this lock file here.
try:
    lock = open(lock_path, "a")
except OSError as exc:
    print(f"kb-init-team: cannot create/open lock file {lock_path}: {exc}", file=sys.stderr)
    sys.exit(2)

with lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    try:
        # Re-read under the lock -- TOCTOU defense against another writer
        # racing between whatever this process read earlier (if anything)
        # and this write.
        #
        # XACA-1187-004: a parse failure on an EXISTING file must never be
        # silently reinterpreted as an empty registry -- that would both
        # (a) make the write below deregister every other team, and (b)
        # feed the loss guard a fabricated before_ids={} that can never
        # detect anything as lost, defeating XACA-1187-005 outright. Fail
        # CLOSED: abort loudly, naming the file, before any write is
        # attempted. Only a genuinely ABSENT file (first-ever bootstrap --
        # nothing to lose) legitimately starts from {"teams": {}}.
        if resolved.exists():
            try:
                config = json.loads(resolved.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                print(
                    f"kb-init-team: cannot re-read {resolved} under lock: {exc} -- "
                    f"refusing to register '{team_id}' against an unreadable "
                    f"registry (XACA-1187-004). No write performed; the file on "
                    f"disk is untouched.",
                    file=sys.stderr,
                )
                sys.exit(2)
        else:
            config = {"teams": {}}

        if not isinstance(config, dict):
            print(
                f"kb-init-team: {resolved} does not contain a JSON object at "
                f"its root -- refusing to register '{team_id}' (XACA-1187-004).",
                file=sys.stderr,
            )
            sys.exit(2)
        if not isinstance(config.get("teams"), dict):
            config["teams"] = {}

        before_ids = set(config["teams"].keys())

        if team_id in config["teams"]:
            sys.exit(0)  # Already present -- another writer won the race, or a re-run.

        config["teams"][team_id] = {
            "team_code": team_code,
            "kanban_dir": kanban_dir,
            "working_dir": working_dir,
            "lcars_port": lcars_port,
            "lcars_port_base": int(port_base_str),
            "lcars_port_range": int(port_range_str),
            "anthropic_account_id": "",
            "anthropic_account_nickname": "",
            "anthropic_api_key_env_var": "",
        }

        after_ids = set(config["teams"].keys())

        # XACA-1187-005: fail-closed invariant guard. This call site is a
        # pure ADD -- before_ids must always be a subset of after_ids. Any
        # lost id here means something upstream corrupted the in-memory
        # config between the re-read and this point, never a legitimate
        # removal -- this call site must never pass allow_removal=True.
        try:
            _reject_if_team_ids_lost(
                before_ids, after_ids, allow_removal=False, resolved=resolved,
                context="kb-init-team registration",
            )
        except ValueError:
            sys.exit(2)

        # (directory already created above, before the lock was opened --
        # XACA-1187 regression fix)
        serialized = json.dumps(config, indent=2, sort_keys=True) + "\n"

        try:
            orig_mode = stat.S_IMODE(os.stat(resolved).st_mode)
        except OSError:
            orig_mode = None

        fd, tmp_name = tempfile.mkstemp(prefix=f"{resolved.name}.tmp.", dir=str(resolved.parent))
        tmp_path = Path(tmp_name)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(serialized)
                f.flush()
                os.fsync(f.fileno())
            if orig_mode is not None:
                os.chmod(tmp_path, orig_mode)
            else:
                # mkstemp() always creates at 0600 regardless of umask. With
                # no pre-existing file to inherit a mode from (a genuinely
                # fresh bootstrap), compute what a plain open() would have
                # produced under the current umask instead, so a
                # fresh-bootstrap file's mode matches every other writer in
                # this codebase (they all use plain open(), which already
                # respects umask automatically).
                _umask = os.umask(0o022)
                os.umask(_umask)
                os.chmod(tmp_path, 0o666 & ~_umask)
            os.replace(str(tmp_path), str(resolved))
            try:
                dir_fd = os.open(str(resolved.parent), os.O_RDONLY)
                try:
                    os.fsync(dir_fd)
                finally:
                    os.close(dir_fd)
            except OSError:
                pass  # best-effort -- the rename itself already succeeded
        except Exception:
            tmp_path.unlink(missing_ok=True)
            raise
        sys.exit(0)
    finally:
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        # Intentionally NO unlink -- see XACA-1059-005 note above.
PYEOF
}

# ── Create board JSON ─────────────────────────────────────────────────────────
#
# XACA-1163: board.json's `series` field stores the kanban item-ID prefix
# X<TEAM_CODE> (e.g. "XACA"), never the Trek series code. The Trek code
# (`series` param below, e.g. "ENT"/"DS9") is a provision-time input only —
# it selects subtitle/ship/terminals and is never persisted to the board.
# Mirrors scripts/kb-freelance:23,540-541, which already implements this.

_create_board_json() {
    local team_id="$1" team_name="$2" org_name="$3" org_color="$4"
    local kanban_dir="$5" series="$6" team_code="$7"
    local board_file="${kanban_dir}/${team_id}-board.json"

    if [[ -f "$board_file" ]]; then
        return 0  # Already exists
    fi

    local subtitle ship
    subtitle=$(_series_to_subtitle "$series")
    ship=$(_series_to_ship "$series")

    local terminals_json
    terminals_json=$(python3 - "$(_series_terminals "$series")" "$team_id" <<'PYEOF'
import sys, json

pairs_raw = sys.argv[1]
team_id = sys.argv[2]
terminals = {}
for line in pairs_raw.strip().splitlines():
    line = line.strip()
    if ':' not in line:
        continue
    terminal, avatar = line.split(':', 1)
    terminals[terminal] = {
        "active": True,
        "agent": avatar,
        "agentId": f"{team_id}-{terminal}"
    }
print(json.dumps(terminals, indent=2))
PYEOF
)

    # XACA-0648: resolve the board template path at call time; falls back to
    # an embedded heredoc tempfile if no template file is found on disk.
    local _board_tmpl
    _board_tmpl="$(_resolve_board_template)"
    # Clean up tmpfile on ALL exit paths (success, python3 failure, set -e abort).
    # Use a RETURN trap so cleanup is scoped to this function only.  The trap
    # fires on all paths including python3 failures that would otherwise leave a
    # /tmp landmine under set -euo pipefail.  Checking the basename prefix (not
    # a hardcoded /tmp prefix) ensures the trap fires correctly regardless of
    # which directory TMPDIR resolves to (e.g. /var/folders/... on macOS).
    local _board_tmpl_is_tmp=0
    case "$(basename "${_board_tmpl}")" in
        kb-init-team-board-template.*) _board_tmpl_is_tmp=1 ;;
    esac
    if [[ "$_board_tmpl_is_tmp" -eq 1 ]]; then
        # shellcheck disable=SC2064  # intentional: expand _board_tmpl now
        trap "rm -f '${_board_tmpl}' 2>/dev/null; trap - RETURN" RETURN
    fi

    python3 - "${_board_tmpl}" "$board_file" \
        "$team_id" "$team_name" "$subtitle" "$ship" "$series" \
        "$org_name" "$org_color" "$kanban_dir" "$terminals_json" "$team_code" <<'PYEOF'
import sys, json, datetime
from pathlib import Path

template_path = sys.argv[1]
board_file = sys.argv[2]
team_id, team_name, subtitle, ship, series = sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7]
org_name, org_color, kanban_dir = sys.argv[8], sys.argv[9], sys.argv[10]
terminals_json = sys.argv[11]
team_code = sys.argv[12]

template = json.loads(Path(template_path).read_text(encoding='utf-8'))

board = template.copy()
board['team'] = team_id
board['teamName'] = team_name
board['subtitle'] = subtitle
board['ship'] = ship
# XACA-1163: `series` stores the kanban item-ID prefix X<TEAM_CODE>, not the
# Trek series code (`series` var above only drove subtitle/ship/terminals).
# Mirrors kb-freelance:540 ("The board's `series` field stores the kanban
# item-prefix (X<team_code>)."). When no real team code was supplied
# (local-only mode's "LOC" placeholder), the key is OMITTED — never "" or
# null, both of which are unsafe sentinels for the ID-generating readers
# (bash's _kb_generate_id falls back correctly on absence; import_issue.py
# mints a silently-corrupt "-0001" on "" and raises TypeError on null). The
# template above seeds the literal placeholder string "{{TEAM_SERIES}}" for
# this key, so it must be actively popped, not merely left unassigned.
if team_code:
    board['series'] = 'X' + team_code
else:
    board.pop('series', None)
board['organization'] = org_name
board['orgColor'] = org_color
board['kanbanDir'] = kanban_dir
board['lastUpdated'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
board['terminals'] = json.loads(terminals_json)

# XACA-0729: Defensive normalization — ensure releaseConfig always leads with
# PLANNED so new boards never start in the ACTIVE lifecycle bug.  This guard
# fires when an old installed tap ships a board-template.json that pre-dates
# this fix; it is a no-op when the template already carries the correct value.
_REQUIRED_ENVS = ["PLANNED", "DEV", "QA", "ALPHA", "BETA", "GAMMA", "PROD"]
_DEFAULT_RELEASE_CONFIG = {
    "defaultEnvironments": _REQUIRED_ENVS,
    "platforms": {
        "ios": {"name": "iOS", "store": "App Store", "icon": "apple"},
        "android": {"name": "Android", "store": "Play Store", "icon": "android"},
        "firebase": {"name": "Firebase", "store": None, "icon": "database"},
        "web": {"name": "Web", "store": None, "icon": "globe"},
        "other": {"name": "Other", "store": None, "icon": "ellipsis-h"},
    },
    "releaseTypes": {
        "feature": {"name": "Feature Release", "description": "New features", "color": "#4a90d9"},
        "bugfix": {"name": "Bug Fix Release", "description": "Bug fixes", "color": "#f5a623"},
        "hotfix": {"name": "Hotfix", "description": "Critical fixes", "color": "#d0021b"},
        "maintenance": {"name": "Maintenance", "description": "Technical updates", "color": "#7ed321"},
    },
    "flowConfig": {
        "stages": {
            "PLANNED": {"enabled": True, "required": True},
            "DEV": {"enabled": True, "required": True},
            "QA": {"enabled": True, "required": False},
            "ALPHA": {"enabled": True, "required": False},
            "BETA": {"enabled": True, "required": False},
            "GAMMA": {"enabled": True, "required": False},
            "PROD": {"enabled": True, "required": True},
        }
    },
}
rc = board.get("releaseConfig") or {}
envs = rc.get("defaultEnvironments", [])
if not envs or envs[0] != "PLANNED":
    # Missing or broken releaseConfig — seed the full canonical default.
    board["releaseConfig"] = _DEFAULT_RELEASE_CONFIG
else:
    # releaseConfig present and PLANNED-leading; ensure flowConfig.stages
    # includes PLANNED as required (older boards may have stages without it).
    fc = rc.get("flowConfig") or {}
    stages = fc.get("stages") or {}
    if "PLANNED" not in stages:
        stages["PLANNED"] = {"enabled": True, "required": True}
        fc["stages"] = stages
        rc["flowConfig"] = fc
        board["releaseConfig"] = rc

Path(board_file).write_text(json.dumps(board, indent=2) + '\n', encoding='utf-8')
PYEOF
    # Note: the RETURN trap above handles tmpfile cleanup for both success and
    # python3-failure paths — no explicit rm needed here.
}

# ── XACA-0754-002: local-only (PII) team floor + tier-index writers ──────────
#
# kb-init-team is bash; kanban-helpers.sh (which owns the canonical
# _kb_is_local_only_team / _kb_knowledge_local_root predicates, XACA-0754 C1/C2)
# is zsh and cannot be sourced here — verified: `bash -c 'source kanban-helpers.sh'`
# aborts with a parse-time syntax error from unrelated zsh-only syntax elsewhere
# in that file, even though the three predicates below are themselves portable.
# So this is a deliberate, git-tracked REPLICA of the hardcoded floor — not a
# derivation. It MUST be kept in lockstep with kanban-helpers.sh's
# _kb_local_only_teams_hardcoded (kanban-helpers.sh:10897) and
# _kb_is_local_only_team (kanban-helpers.sh:10940); scripts/tests/test-kb-init-team.sh
# asserts the routing behavior this floor produces.
_kbit_local_only_teams_hardcoded() {
    # KEEP IN SYNC with kanban-helpers.sh's _kb_local_only_teams_hardcoded
    # (kanban-helpers.sh:10897-10899) — adding/removing/renaming a team on
    # EITHER side without the other is a silent PII-leak regression (a new
    # personal team backfilled via --backfill-tiers would route to the
    # SYNCED global root instead of ~/knowledge-local). Enforced by the
    # cross-floor drift-guard in scripts/tests/test-kb-init-team.sh
    # (SECTION H) — that test fails the moment these two lists diverge.
    printf '%s\n' finance-personal legal-coparenting medical-general
}

# _kbit_is_local_only_team <team-id> — mirrors kanban-helpers.sh's two-source
# check: the hardcoded floor above (checked first, unconditionally — a missing
# or regenerated team-paths.json can never misclassify one of these three
# teams as shareable), then an optional "local_only": true flag in
# team-paths.json for extensibility to future personal teams.
_kbit_is_local_only_team() {
    local team="${1-}"
    [[ -z "$team" ]] && return 1

    local t
    for t in $(_kbit_local_only_teams_hardcoded); do
        [[ "$t" == "$team" ]] && return 0
    done

    local config_path="${TEAM_PATHS_JSON}"
    [[ -f "$config_path" ]] || return 1
    local flag_value
    flag_value=$(python3 - "$config_path" "$team" <<'PYEOF'
import sys, json
from pathlib import Path
config_path, team = sys.argv[1], sys.argv[2]
try:
    config = json.loads(Path(config_path).read_text(encoding='utf-8'))
    v = config.get('teams', {}).get(team, {}).get('local_only', False)
    print('true' if v is True else 'false')
except Exception:
    print('false')
PYEOF
)
    [[ "$flag_value" == "true" ]]
}

# Mirrors kanban-helpers.sh's _kb_knowledge_local_root (kanban-helpers.sh:10886).
_kbit_knowledge_local_root() {
    echo "${KB_KNOWLEDGE_LOCAL_ROOT:-${HOME}/knowledge-local}"
}

# Maps a team-id to its persona-roster directory under
# ~/dev-team/.claude/agents-master/ (per-team CLAUDE.md layout: academy/,
# ios/, android/, firebase/, command/, dns/, finance/, legal/, medical/,
# mainevent/, freelance/ — 11 group directories). The three local-only teams'
# full team-ids differ from their group directory name (mirrors
# kanban-helpers.sh's _kb_local_team_persona_group, kanban-helpers.sh:11049);
# every freelance-<client>-<project> instance shares the single "freelance"
# group; everything else (academy/ios/android/firebase/command/dns/mainevent)
# already matches its group name 1:1.
_kbit_agents_master_group_for_team() {
    case "${1-}" in
        finance-personal)  echo finance ;;
        legal-coparenting) echo legal ;;
        medical-general)   echo medical ;;
        freelance-*)       echo freelance ;;
        *)                 echo "${1-}" ;;
    esac
}

# Resolves the kb agent-tier slug roster for ANY team-id by reading each
# agents-master persona file's `name:` frontmatter field (that field IS the kb
# slug — mirrors kanban-helpers.sh's _kb_local_personas_for_team fallback scan,
# kanban-helpers.sh:11104-11109). One slug per line. Returns 1 (silently) if
# the group directory doesn't exist on this machine (e.g. LOCAL-ONLY/tap-consumer
# mode, where agents-master is Academy/dev-source-only) — callers treat that as
# "agent-tier roster unknown, team-tier only" rather than a hard failure.
_kbit_agent_roster_for_team() {
    local team_id="${1-}"
    local group
    group=$(_kbit_agents_master_group_for_team "$team_id")
    local master_dir="${HOME}/dev-team/.claude/agents-master/${group}"
    [[ -d "$master_dir" ]] || return 1

    local f name
    for f in "${master_dir}"/*.md; do
        [[ -f "$f" ]] || continue
        name=$(grep -m1 '^name:' "$f" 2>/dev/null | sed 's/^name:[[:space:]]*//' | tr -d "\"'")
        [[ -n "$name" ]] && echo "$name"
    done
}

# ── Shared tier-index writers (used by BOTH _create_dir_tree's global-tier
# ── block AND --backfill-tiers — single template source, XACA-0754-002) ──────
#
# is_local: "1" writes the LOCAL-ONLY (PII) template variant — matches
# kanban-helpers.sh's kb-knowledge-local-scaffold templates (kanban-helpers.sh:
# 13215) byte-for-byte in shape; "0" writes the standard global template that
# _create_dir_tree has always written. Idempotent: never touches an existing
# INDEX.md. Returns 0 if created, 1 if it already existed (so callers can
# report create-vs-skip counts without a second stat call).
_write_team_tier_index() {
    local root="$1" team_id="$2" team_name="$3" is_local="${4:-0}"
    local today
    today=$(date +%Y-%m-%d)
    local team_tier_dir="${root}/teams/${team_id}"
    mkdir -p "$team_tier_dir"
    local team_tier_index="${team_tier_dir}/INDEX.md"
    [[ -f "$team_tier_index" ]] && return 1

    if [[ "$is_local" -eq 1 ]]; then
        cat > "$team_tier_index" <<EOF
# ${team_id} — Team Knowledge Index (local-only)

**Team:** ${team_id}
**Tier:** team
**Storage:** LOCAL ONLY — this tree is never synced off this machine (XACA-0754)
**Last Updated:** ${today}

---

## Tag Index

| Tag | Entries |
|-----|---------|
| _none yet_ | |

---

## Entries

_No entries yet._
EOF
    else
        cat > "$team_tier_index" <<EOF
# ${team_name} — Team Knowledge Index

**Team:** ${team_id}
**Tier:** team (reserved — activates with the team-as-agent-bundle feature)
**Last Updated:** ${today}

---

## Tag Index

| Tag | Entries |
|-----|---------|
| _none yet_ | |

---

## Entries

_No entries yet._
EOF
    fi
    return 0
}

_write_agent_tier_index() {
    local root="$1" persona="$2" is_local="${3:-0}"
    local today
    today=$(date +%Y-%m-%d)
    local agent_index="${root}/agents/${persona}/INDEX.md"
    [[ -f "$agent_index" ]] && return 1
    mkdir -p "${root}/agents/${persona}"

    if [[ "$is_local" -eq 1 ]]; then
        cat > "$agent_index" <<EOF
# ${persona} Knowledge Index (local-only)

**Agent:** ${persona}
**Storage:** LOCAL ONLY — this tree is never synced off this machine (XACA-0754)
**Last Updated:** ${today}

---

## Tag Index

| Tag | Entries |
|-----|---------|
| _none yet_ | |

---

## Entries

_No entries yet._
EOF
    else
        cat > "$agent_index" <<EOF
# ${persona} Knowledge Index

**Agent:** ${persona}
**Last Updated:** ${today}

---

## Tag Index

| Tag | Entries |
|-----|---------|
| _none yet_ | |

---

## Entries

_No entries yet._
EOF
    fi
    return 0
}

# ── Create directory tree + four-tier knowledge scaffolding ───────────────────
#
# Scaffolds a newly-provisioned team's slots in the four-tier knowledge schema
# (authoritative contract: ~/knowledge/SPEC.md). This REPLACES the pre-XACA-0222
# per-avatar + TEAM/ repo-local layout, which no current tool reads.
#
#   Project tier (in-repo):  <kanban-dir>/knowledge/project/INDEX.md (+ retrospectives/)
#     discovery anchor:      <working-dir>/.knowledge-config.yml (makes the in-repo
#                            tier resolve for current-project searches — any team,
#                            container-layout included)
#   Team tier   (global):    $KB_KNOWLEDGE_GLOBAL_ROOT/teams/<team-id>/INDEX.md  (reserved, §4.2)
#   Agent tier  (global):    $KB_KNOWLEDGE_GLOBAL_ROOT/agents/<persona>/INDEX.md (create-if-missing)
#
# Global tiers are BEST-EFFORT: if $KB_KNOWLEDGE_GLOBAL_ROOT (default ~/knowledge)
# is absent — a fresh machine that has not yet received the EPIC-0047 tap rollout —
# they are skipped with a warning, never a hard error. Every write is idempotent.
# Agent directories are global and merge across teams (SPEC §4.1/§8.1), so an
# existing persona INDEX is NEVER clobbered.
_create_dir_tree() {
    local kanban_dir="$1" team_id="$2" team_name="$3" series="$4" working_dir="${5:-}"

    local today
    today=$(date +%Y-%m-%d)

    # Core dirs
    mkdir -p "${kanban_dir}/config"
    mkdir -p "${kanban_dir}/activity"
    mkdir -p "${kanban_dir}/plans"

    # ── Project tier: <kanban-dir>/knowledge/project/ (SPEC §4.4) ──────────────
    # Resolve the config anchor + project slug. kb-init-team always knows the
    # team's working dir (parent of the kanban dir by convention:
    # kanban == <working-dir>/kanban — see team-paths.json for every team).
    # Anchoring on it — rather than a git-rev-parse from the kanban dir — lets us
    # write the discovery config even before the repo is git-init'd AND for
    # container-layout teams, closing the gap where the in-repo project tier
    # existed but --project resolution defaulted elsewhere and never found it.
    # Fall back to git detection, then team_id, when no working dir was passed.
    local anchor_dir="" slug="$team_id"
    if [[ -n "$working_dir" ]]; then
        anchor_dir="$working_dir"
    elif anchor_dir=$(git -C "$kanban_dir" rev-parse --show-toplevel 2>/dev/null) && [[ -n "$anchor_dir" ]]; then
        : # git-detected repo root
    else
        anchor_dir=""
    fi
    [[ -n "$anchor_dir" ]] && slug="$(basename "$anchor_dir")"

    local project_dir="${kanban_dir}/knowledge/project"
    mkdir -p "${project_dir}/retrospectives"
    # Keep the (otherwise empty) retrospectives dir in git.
    [[ -f "${project_dir}/retrospectives/.gitkeep" ]] || : > "${project_dir}/retrospectives/.gitkeep"

    local project_index="${project_dir}/INDEX.md"
    if [[ ! -f "$project_index" ]]; then
        cat > "$project_index" <<EOF
# Project Knowledge — ${slug} (${team_name})

**Project:** ${slug}
**Last Updated:** ${today}

---

## Relevant Subjects

Declare the cross-cutting subject tiers this project's knowledge should be read
alongside — this list drives \`kb-knowledge-search --project\`. Add entries for
this team's stack, e.g. \`subjects:ios\`, \`subjects:firebase\`, \`subjects:git\`.

_None declared yet._

---

## Tag Index

| Tag | Entries |
|-----|---------|
| _none yet_ | |

---

## Retrospectives

_No retrospectives yet._
EOF
    fi

    # ── .knowledge-config.yml at the team's working dir ───────────────────────
    # Makes the in-repo project tier discoverable via config-file resolution
    # (kanban-helpers _kb_knowledge_project_path case 1 — verified to resolve
    # current-project searches to the in-repo tier). Written only when kanban is
    # the conventional <working-dir>/kanban child; skipped otherwise.
    if [[ -n "$anchor_dir" && -d "$anchor_dir" \
          && "$(cd "$anchor_dir" && pwd -P)/kanban" == "$(cd "$kanban_dir" && pwd -P)" ]]; then
        local kcfg="${anchor_dir}/.knowledge-config.yml"
        if [[ ! -f "$kcfg" ]]; then
            cat > "$kcfg" <<EOF
project: ${slug}
project_knowledge_path: ./kanban/knowledge/project
# Declare the subject tiers this project's knowledge should be read alongside,
# e.g. subjects:ios, subjects:firebase, subjects:git. Empty by default.
relevant_subjects: []
EOF
        fi
    fi

    # ── Global tiers: team (reserved) + agent (create-if-missing) ─────────────
    local kb_root="${KB_KNOWLEDGE_GLOBAL_ROOT:-$HOME/knowledge}"
    if [[ ! -d "$kb_root" ]]; then
        _warn "Global knowledge root not found (${kb_root}) — skipping team + agent tiers."
        _warn "  (~/knowledge ships fleet-wide via EPIC-0047; re-run kb-init-team once it lands.)"
        return 0
    fi

    # Team tier — reserved/empty per SPEC §4.2. (XACA-0754-002: writer shared
    # with --backfill-tiers via _write_team_tier_index; see its definition
    # above for the templates. is_local=0 — new teams provisioned via the
    # normal kb-init-team flow are never one of the local-only PII teams,
    # which already exist and are handled by --backfill-tiers/
    # kb-knowledge-local-scaffold instead.)
    _write_team_tier_index "$kb_root" "$team_id" "$team_name" 0 || true

    # Agent tier — one dir per persona, create-if-missing, NEVER clobber an
    # existing INDEX (agent dirs are global + merged across teams).
    while IFS=':' read -r _ avatar; do
        [[ -z "$avatar" ]] && continue
        _write_agent_tier_index "$kb_root" "$avatar" 0 || true
    done < <(_series_terminals "$series")
}

# ── Check-only mode ───────────────────────────────────────────────────────────

# membership in DEFAULT_TEAMS (delegates to existing injection-safe python helper)
_chk_default_teams() { [[ "$(_team_in_default_teams "$1")" == "yes" ]]; }

# fixed-string grep (no regex) for a literal token in a file
_chk_grep_literal() { grep -qF -- "$1" "$2"; }

# file exists
_chk_file_exists() { [[ -f "$1" ]]; }

# team_id present as a key under JSON "teams" map
_chk_json_team_in_teams() {
    python3 - "$1" "$2" <<'PYEOF'
import sys, json
d = json.load(open(sys.argv[1]))
sys.exit(0 if sys.argv[2] in d.get("teams", {}) else 1)
PYEOF
}

# any top-level JSON key starts with "<team_id>-"
_chk_json_key_prefix() {
    python3 - "$1" "$2" <<'PYEOF'
import sys, json
d = json.load(open(sys.argv[1]))
prefix = sys.argv[2] + "-"
sys.exit(0 if any(k.startswith(prefix) for k in d) else 1)
PYEOF
}

# case-label <label> present within shell function <func> region of <file>.
# Reproduces the original anchoring (^|[[:space:]|])LABEL[|)] but matches the
# label via awk index() — a pure string compare, never an ERE — so the
# (already-inert, charset-gated) regex-injection surface is removed at the root
# per XACA-0546-001. <func> is always a hard-coded caller literal, so its use in
# the function-region regex carries no user-input injection surface.
_chk_case_label() {
    local func="$1" file="$2" label="$3"
    awk -v fn="$func" -v lab="$label" '
        function has_label(line,   n, p, abs, before, after, off) {
            n = length(lab); off = 1
            while ((p = index(substr(line, off), lab)) > 0) {
                abs = off + p - 1
                before = (abs == 1) ? "" : substr(line, abs - 1, 1)
                after  = substr(line, abs + n, 1)
                if ((abs == 1 || before ~ /[[:space:]]/ || before == "|") \
                    && (after == "|" || after == ")"))
                    return 1
                off = abs + 1
            }
            return 0
        }
        $0 ~ "^" fn "\\(\\)" { f = 1 }
        f && /^\}$/ { exit found ? 0 : 1 }
        f && has_label($0) { found = 1 }
        END { exit found ? 0 : 1 }
    ' "$file"
}

_check_site() {
    local name="$1"; shift
    if "$@" >/dev/null 2>&1; then
        _ok "${name}"
        return 0
    else
        _fail "${name} — NOT registered"
        return 1
    fi
}

_run_check_only() {
    echo ""
    echo "=== kb-init-team --check-only: ${TEAM_ID} ==="
    if [[ "$INIT_MODE" == "local-only" ]]; then
        echo -e "${CYAN}  LOCAL-ONLY mode (tap-consumer) — registration sites 1–11 are product-managed${NC}"
    fi
    echo ""
    local all_ok=0

    if [[ "$INIT_MODE" == "full" ]]; then
        # ── Registration sites (FULL/dev mode only) ───────────────────────────

        # 1. DEFAULT_TEAMS
        _check_site "aiteamforge_paths.py DEFAULT_TEAMS" \
            _chk_default_teams "$TEAM_ID" || all_ok=1

        # 2. aiteamforge-paths.sh heredoc
        _check_site "aiteamforge-paths.sh heredoc" \
            _chk_grep_literal "\"${TEAM_ID}\"" "$AITEAMFORGE_PATHS_SH" || all_ok=1

        # 3. lcars-ports file
        _check_site "lcars-ports/${TEAM_ID}-lcars.port" \
            _chk_file_exists "${LCARS_PORTS_DIR}/${TEAM_ID}-lcars.port" || all_ok=1

        # 4. team-paths.json
        _check_site "~/.aiteamforge/team-paths.json" \
            _chk_json_team_in_teams "$TEAM_PATHS_JSON" "$TEAM_ID" || all_ok=1

        # 5/6. RETIRED (XACA-1058) — see the doc comment near the top of this
        # file. kanban-helpers.sh's _kb_get_team_code()/_kb_get_team_from_code()
        # no longer carry per-team case arms at all: the overlay (Site 4) is
        # now the sole and authoritative source, read FIRST in both
        # directions, ahead of any case statement. A per-team arm would be a
        # redundant, driftable mirror of Site 4 — exactly the defect XACA-1058
        # removes — so checking for one here would only ever report a false
        # failure going forward. No-op, informational.
        echo -e "${CYAN}[SKIP]${NC} kanban-helpers.sh _kb_get_team_code — retired (XACA-1058, overlay is sole source now)"
        echo -e "${CYAN}[SKIP]${NC} kanban-helpers.sh _kb_get_team_from_code — retired (XACA-1058, overlay is sole source now)"

        # 7. kanban-helpers.sh _kb_get_kanban_dir
        _check_site "kanban-helpers.sh _kb_get_kanban_dir" \
            _chk_case_label _kb_get_kanban_dir "$KANBAN_HELPERS" "$TEAM_ID" || all_ok=1

        # 8. kanban-helpers.sh _kb_team_lcars_port
        # Presence of the case label within the function is sufficient; the port value
        # may be on a separate line (e.g. backslash-continued multi-team arm).
        # Previously used a two-pipe grep|grep that required _port= on the same line as
        # the label — false-negative for freelance-doublenode-awaysentry (line 11646).
        _check_site "kanban-helpers.sh _kb_team_lcars_port port entry" \
            _chk_case_label _kb_team_lcars_port "$KANBAN_HELPERS" "$TEAM_ID" || all_ok=1

        # 9. statusline-command.sh
        _check_site "statusline-command.sh _get_team_kanban_dir" \
            _chk_case_label _get_team_kanban_dir "$STATUSLINE_SH" "$TEAM_ID" || all_ok=1

        # 10. RETIRED (XACA-0992) — see the doc comment near the top of this
        # file. server.py's team_dir_map dict no longer exists; a fresh
        # team gets no literal entry there by design (_resolve_base_team()
        # resolves it generically), so grepping for one would only ever
        # report a false failure here going forward. No-op, informational.
        echo -e "${CYAN}[SKIP]${NC} server.py team_dir_map — retired (XACA-0992, resolved generically now)"

        # 11. amb-session-map.json
        _check_site "amb-session-map.json" \
            _chk_json_key_prefix "$AMB_SESSION_MAP" "$TEAM_ID" || all_ok=1
    else
        # LOCAL-ONLY mode: registration sites are product-managed by the tap formula.
        # Report them as cleanly skipped rather than failing the check.
        local _reg_sites=(
            "aiteamforge_paths.py DEFAULT_TEAMS"
            "aiteamforge-paths.sh heredoc"
            "lcars-ports file"
            "~/.aiteamforge/team-paths.json"
            "kanban-helpers.sh _kb_get_team_code"
            "kanban-helpers.sh _kb_get_team_from_code"
            "kanban-helpers.sh _kb_get_kanban_dir"
            "kanban-helpers.sh _kb_team_lcars_port"
            "statusline-command.sh _get_team_kanban_dir"
            "server.py team_dir_map"
            "amb-session-map.json"
        )
        for _s in "${_reg_sites[@]}"; do
            echo -e "${CYAN}[SKIP]${NC} ${_s} — product-managed (tap install)"
        done
    fi

    # ── Provisioning sites (both modes) ──────────────────────────────────────

    # 12. board.json
    _check_site "board.json exists" \
        _chk_file_exists "${KANBAN_DIR}/${TEAM_ID}-board.json" || all_ok=1

    # 13. project-tier knowledge (four-tier schema, SPEC §4.4)
    _check_site "knowledge project tier (knowledge/project/INDEX.md)" \
        _chk_file_exists "${KANBAN_DIR}/knowledge/project/INDEX.md" || all_ok=1

    # 14. global team tier — only asserted when the global root is present
    #     (absent on machines pre-EPIC-0047 rollout; not a provisioning failure).
    local _kb_root="${KB_KNOWLEDGE_GLOBAL_ROOT:-$HOME/knowledge}"
    if [[ -d "$_kb_root" ]]; then
        _check_site "knowledge team tier (${_kb_root}/teams/${TEAM_ID}/INDEX.md)" \
            _chk_file_exists "${_kb_root}/teams/${TEAM_ID}/INDEX.md" || all_ok=1
    else
        echo -e "${CYAN}[SKIP]${NC} knowledge team/agent tiers — global root absent (${_kb_root})"
    fi

    echo ""
    if [[ "$all_ok" -eq 0 ]]; then
        if [[ "$INIT_MODE" == "full" ]]; then
            echo -e "${GREEN}All sites registered. Team '${TEAM_ID}' is fully provisioned.${NC}"
        else
            echo -e "${GREEN}Provisioning complete. Team '${TEAM_ID}' board is present.${NC}"
            echo -e "${CYAN}  Registration sites are product-managed (tap install) — no action needed.${NC}"
        fi
    else
        if [[ "$INIT_MODE" == "full" ]]; then
            echo -e "${RED}Some sites not yet registered. Run kb-init-team without --check-only to provision.${NC}"
        else
            echo -e "${RED}Provisioning incomplete. Run kb-init-team without --check-only to provision the board.${NC}"
        fi
    fi
    return "$all_ok"
}

# ── --backfill-tiers: idempotent knowledge-tier-only backfill (XACA-0754-002) ─
#
# XACA-0748 made kb-init-team scaffold team+agent knowledge tiers for NEW
# teams. Teams registered BEFORE that (mainevent, command, etc.) never got
# that scaffold. This runs ONLY the tier-writing subset of _create_dir_tree —
# no board creation, no sites 1–11 registration, no port allocation — for a
# team-id that is already fully registered elsewhere.
#
# PII ROUTING IS MANDATORY: finance-personal / legal-coparenting /
# medical-general (and any future team flagged "local_only": true in
# team-paths.json) route to $KB_KNOWLEDGE_LOCAL_ROOT (default
# ~/knowledge-local), never the synced $KB_KNOWLEDGE_GLOBAL_ROOT. See
# _kbit_is_local_only_team above — same two-source floor kanban-helpers.sh
# uses for kb-knowledge-add's write routing (XACA-0754 C2/C4).
_run_backfill_tiers() {
    local team_id="$TEAM_ID"
    local team_name
    team_name=$(echo "$team_id" | tr '[:lower:]-' '[:upper:] ' | tr -s ' ')

    echo ""
    echo "=== kb-init-team --backfill-tiers: '${team_id}' ==="

    local write_root is_local=0
    if _kbit_is_local_only_team "$team_id"; then
        write_root=$(_kbit_knowledge_local_root)
        is_local=1
        _info "Routing    : LOCAL root (PII team, XACA-0754) → ${write_root}"
    else
        write_root="${KB_KNOWLEDGE_GLOBAL_ROOT:-$HOME/knowledge}"
        _info "Routing    : GLOBAL/synced root → ${write_root}"
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo -e "${CYAN}  DRY-RUN mode — no files will be written${NC}"
    fi
    echo ""

    # Local root is a plain, never-git, never-synced directory tree (design
    # §2) — safe to create on demand, unlike the global root (a git clone that
    # must arrive via the EPIC-0047 tap rollout; fabricating it here would be
    # wrong). Global root absence is best-effort-skip, mirroring
    # _create_dir_tree's existing behavior exactly.
    if [[ "$is_local" -eq 0 && ! -d "$write_root" ]]; then
        _fail "Global knowledge root not found (${write_root})."
        _fail "  (~/knowledge ships fleet-wide via EPIC-0047; re-run once it lands.)"
        return 1
    fi
    if [[ "$is_local" -eq 1 && "$DRY_RUN" -eq 0 && "$CHECK_ONLY" -eq 0 ]]; then
        mkdir -p "${write_root}/agents" "${write_root}/teams"
    fi

    local -a roster=()
    local persona
    while IFS= read -r persona; do
        [[ -n "$persona" ]] && roster+=("$persona")
    done < <(_kbit_agent_roster_for_team "$team_id" 2>/dev/null)
    if [[ "${#roster[@]}" -eq 0 ]]; then
        _warn "No agent-tier persona roster resolved for '${team_id}' (no matching directory under ~/dev-team/.claude/agents-master/) — team-tier only."
    fi

    local team_tier_index="${write_root}/teams/${team_id}/INDEX.md"

    # ── --check-only: report present/missing, write nothing ──────────────────
    if [[ "$CHECK_ONLY" -eq 1 ]]; then
        local all_ok=0
        if [[ -f "$team_tier_index" ]]; then
            _ok "team-tier INDEX present: ${team_tier_index}"
        else
            _fail "Missing team-tier INDEX: ${team_tier_index}"
            all_ok=1
        fi
        for persona in "${roster[@]}"; do
            local agent_index="${write_root}/agents/${persona}/INDEX.md"
            if [[ -f "$agent_index" ]]; then
                _ok "agent-tier INDEX present: ${agent_index}"
            else
                _fail "Missing agent-tier INDEX: ${agent_index}"
                all_ok=1
            fi
        done
        echo ""
        if [[ "$all_ok" -eq 0 ]]; then
            echo -e "${GREEN}All knowledge-tier scaffold present for '${team_id}'.${NC}"
        else
            echo -e "${RED}Backfill incomplete for '${team_id}'. Run: kb-init-team --team-id ${team_id} --backfill-tiers${NC}"
        fi
        return "$all_ok"
    fi

    # ── --dry-run: preview only ────────────────────────────────────────────────
    if [[ "$DRY_RUN" -eq 1 ]]; then
        if [[ -f "$team_tier_index" ]]; then
            _skip "teams/${team_id}/INDEX.md"
        else
            _dry "Would create ${team_tier_index}"
        fi
        for persona in "${roster[@]}"; do
            local agent_index="${write_root}/agents/${persona}/INDEX.md"
            if [[ -f "$agent_index" ]]; then
                _skip "agents/${persona}/INDEX.md"
            else
                _dry "Would create ${agent_index}"
            fi
        done
        return 0
    fi

    # ── Apply ──────────────────────────────────────────────────────────────────
    local team_created=0 agent_created=0 agent_present=0
    if _write_team_tier_index "$write_root" "$team_id" "$team_name" "$is_local"; then
        team_created=1
        _ok "created teams/${team_id}/INDEX.md"
    else
        _skip "teams/${team_id}/INDEX.md"
    fi
    for persona in "${roster[@]}"; do
        if _write_agent_tier_index "$write_root" "$persona" "$is_local"; then
            agent_created=$((agent_created + 1))
            _ok "created agents/${persona}/INDEX.md"
        else
            agent_present=$((agent_present + 1))
        fi
    done

    echo ""
    echo "  Backfill complete for '${team_id}' → ${write_root}"
    echo "  team_tier_created=${team_created} agent_tier_created=${agent_created} agent_tier_already_present=${agent_present}"
    echo ""
    return 0
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
    # Collect required params
    _prompt TEAM_ID      "Team ID (e.g. freelance-acme-ios)"

    # XACA-0542-017: validate team-id charset BEFORE it is interpolated into any
    # _chk_* helper argument or python source (TEAM_CODE derivation below) —
    # injection hardening (defense-in-depth; eval removed in XACA-0546).
    # Lowercase alphanumeric with internal dashes only.
    if [[ ! "$TEAM_ID" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        _fail "team_id must be lowercase alphanumeric with dashes (got: '${TEAM_ID}')"
        exit 1
    fi

    # ── --backfill-tiers: standalone knowledge-tier-only mode (XACA-0754-002) ──
    # Only needs TEAM_ID (validated above) — deliberately bypasses TEAM_CODE /
    # KANBAN_DIR prompts and the full sites 1–14 registration flow below; an
    # already-registered team has no business re-running those.
    if [[ "$BACKFILL_TIERS" -eq 1 ]]; then
        _run_backfill_tiers
        exit $?
    fi

    # XACA-0648: In LOCAL-ONLY mode (tap-consumer), TEAM_CODE is not required for
    # provisioning (sites 12–14 only).  Registration sites 1–11 are product-managed
    # by the tap formula — attempting to read from aiteamforge_paths.py (which lives
    # in the dev-source tree, not on a consumer) would FileNotFoundError.
    if [[ "$INIT_MODE" == "full" ]]; then
        # --check-only: TEAM_CODE is optional — derive from registry if not provided.
        # This allows "kb-init-team --team-id <id> --check-only" without specifying --team-code.
        if [[ "$CHECK_ONLY" -eq 1 && -z "$TEAM_CODE" ]]; then
            TEAM_CODE=$(python3 -c "
import sys; sys.path.insert(0, '${AITEAMFORGE_PATHS_PY%/*}')
from aiteamforge_paths import get_team_code
print(get_team_code('${TEAM_ID}'))
" 2>/dev/null || echo "")
        fi

        _prompt TEAM_CODE    "Team code (3 uppercase letters, e.g. FAI)"
    else
        # LOCAL-ONLY mode: TEAM_CODE is optional for --check-only and provisioning;
        # set a placeholder if absent so validation below is skipped cleanly.
        # If the caller supplied one we still validate and use it (idempotent).
        if [[ "$CHECK_ONLY" -eq 1 && -z "$TEAM_CODE" ]]; then
            # XACA-1163 (PR #860 review): TEAM_CODE_IS_REAL, not the literal
            # string, is what decides whether board.json gets a `series` key.
            # Keying on `!= "LOC"` conflated "no code was supplied" with "the
            # supplied code happens to be LOC", so a team legitimately coded LOC
            # would silently take the omit branch. Ruling 1 clause 1 says "if
            # --team-code was supplied", and this records exactly that.
            TEAM_CODE_IS_REAL=0
            TEAM_CODE="LOC"  # placeholder — never written to board.json
        fi
        # In LOCAL-ONLY non-check-only mode: TEAM_CODE is not required.
        # If not supplied, set a placeholder; it is never written to any file.
        if [[ -z "$TEAM_CODE" ]]; then
            TEAM_CODE_IS_REAL=0
            TEAM_CODE="LOC"
        fi
    fi

    _prompt KANBAN_DIR   "Kanban directory (absolute path)"

    # Validate team code length (always — placeholder "LOC" passes; user-supplied
    # values are caught here before they can be silently truncated or injected).
    TEAM_CODE=$(echo "$TEAM_CODE" | tr '[:lower:]' '[:upper:]')
    if [[ ${#TEAM_CODE} -ne 3 ]]; then
        _fail "team_code must be exactly 3 characters; got: '${TEAM_CODE}'"
        exit 1
    fi
    # XACA-0542-017: charset-restrict team-code too (interpolated into _chk_* args/python).
    if [[ ! "$TEAM_CODE" =~ ^[A-Z0-9]{3}$ ]]; then
        _fail "team_code must be 3 uppercase alphanumeric characters; got: '${TEAM_CODE}'"
        exit 1
    fi

    # XACA-0542-021: KANBAN_DIR is passed as an argument to _chk_* helpers;
    # reject non-absolute paths and shell metacharacters as defense-in-depth
    # (eval removed in XACA-0546; hardening started for team-id/team-code in 017).
    if [[ "$KANBAN_DIR" != /* ]] || [[ "$KANBAN_DIR" == *[\;\|\&\$\`\(\)\<\>\"\'\!]* ]] || [[ "$KANBAN_DIR" == *$'\n'* ]]; then
        _fail "kanban_dir must be an absolute path without shell metacharacters; got: '${KANBAN_DIR}'"
        exit 1
    fi

    _derive_defaults

    # --check-only mode
    if [[ "$CHECK_ONLY" -eq 1 ]]; then
        _run_check_only
        exit $?
    fi

    echo ""
    if [[ "$INIT_MODE" == "full" ]]; then
        echo "=== kb-init-team: registering '${TEAM_ID}' (${TEAM_CODE}) ==="
    else
        echo "=== kb-init-team: provisioning '${TEAM_ID}' [LOCAL-ONLY / tap-consumer mode] ==="
        echo -e "${CYAN}  Registration sites 1–11 are product-managed — skipping (tap install)${NC}"
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo -e "${CYAN}  DRY-RUN mode — no files will be written${NC}"
    fi
    echo ""

    # ── Conflict detection (FULL mode only — reads aiteamforge_paths.py) ──

    local team_exists="no" code_exists="no"
    if [[ "$INIT_MODE" == "full" ]]; then
        team_exists=$(_team_in_default_teams "$TEAM_ID")
        code_exists=$(_team_code_in_default_teams "$TEAM_CODE")

        if [[ "$team_exists" == "yes" ]]; then
            _warn "Team '${TEAM_ID}' already exists in DEFAULT_TEAMS — treating as idempotent re-run"
        fi
        if [[ "$code_exists" == "yes" ]]; then
            # Check if it's OUR team or someone else's
            local existing_team
            existing_team=$(python3 -c "
import sys; sys.path.insert(0, '${DEV_TEAM_ROOT}/kanban-hooks')
from aiteamforge_paths import get_team_from_code
print(get_team_from_code('${TEAM_CODE}'))
" 2>/dev/null || echo "")
            if [[ "$existing_team" != "$TEAM_ID" && -n "$existing_team" ]]; then
                _fail "Team code '${TEAM_CODE}' is already used by team '${existing_team}'"
                _fail "Choose a different team_code"
                exit 1
            fi
        fi
    fi

    # ── Compute port if not provided (FULL mode only) ─────────────────────
    # In LOCAL-ONLY mode the team is already registered; port allocation is not
    # needed for provisioning and would fail without the aiteamforge-paths.sh source.

    if [[ "$INIT_MODE" == "full" ]]; then
        if [[ -z "$LCARS_PORT" ]]; then
            if [[ "$DRY_RUN" -eq 0 ]]; then
                LCARS_PORT=$(_compute_port)
                if [[ -z "$LCARS_PORT" ]]; then
                    _fail "Could not allocate a port in band [${PORT_BAND_BASE}, $((PORT_BAND_BASE + PORT_BAND_RANGE)))"
                    _fail "Specify --lcars-port <port> or extend the band"
                    exit 1
                fi
            else
                LCARS_PORT="<auto: band [${PORT_BAND_BASE}, $((PORT_BAND_BASE + PORT_BAND_RANGE))]>"
            fi
        else
            # Validate provided port is not in use (unless already our team)
            if [[ "$team_exists" != "yes" ]] && _port_in_use "$LCARS_PORT"; then
                _fail "Port ${LCARS_PORT} is already in use"
                exit 1
            fi
        fi
    fi

    _info "Team ID    : ${TEAM_ID}"
    if [[ "$INIT_MODE" == "full" ]]; then
        _info "Team Code  : ${TEAM_CODE}"
        _info "LCARS Port : ${LCARS_PORT}"
    fi
    _info "Team Name  : ${TEAM_NAME}"
    _info "Kanban Dir : ${KANBAN_DIR}"
    _info "Series     : ${SERIES}"
    _info "Mode       : ${INIT_MODE}"
    echo ""

    local TERMINALS_LIST
    TERMINALS_LIST=$(_series_terminals "$SERIES")

    # ── Sites 1–11: registration (FULL / dev-source mode only) ───────────
    # In LOCAL-ONLY mode these are product-managed by the tap formula.
    # The team is already present in DEFAULT_TEAMS and all case-map files.

    if [[ "$INIT_MODE" == "full" ]]; then

        # ── Site 1: aiteamforge_paths.py DEFAULT_TEAMS ────────────────────

        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert '${TEAM_ID}' into DEFAULT_TEAMS in aiteamforge_paths.py"
        else
            if [[ "$(_team_in_default_teams "$TEAM_ID")" == "yes" ]]; then
                _skip "aiteamforge_paths.py DEFAULT_TEAMS"
            else
                _insert_default_teams "$TEAM_ID" "$TEAM_CODE" "$KANBAN_DIR" "$WORKING_DIR" \
                    "$LCARS_PORT" "$PORT_BAND_BASE" "$PORT_BAND_RANGE"
                _ok "aiteamforge_paths.py DEFAULT_TEAMS"
            fi
        fi

        # ── Site 2: aiteamforge-paths.sh heredoc ─────────────────────────

        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert printf row for '${TEAM_ID}' into _AITEAMFORGE_DEFAULT_TEAMS_DATA"
        else
            if grep -q "\"${TEAM_ID}\"" "${AITEAMFORGE_PATHS_SH}" 2>/dev/null; then
                _skip "aiteamforge-paths.sh _AITEAMFORGE_DEFAULT_TEAMS_DATA"
            else
                _insert_paths_sh_heredoc "$TEAM_ID" "$KANBAN_DIR" "$WORKING_DIR" \
                    "$LCARS_PORT" "$PORT_BAND_BASE" "$PORT_BAND_RANGE" "$TEAM_CODE"
                _ok "aiteamforge-paths.sh _AITEAMFORGE_DEFAULT_TEAMS_DATA"
            fi
        fi

        # ── Site 3: lcars-ports file ──────────────────────────────────────

        local port_file="${LCARS_PORTS_DIR}/${TEAM_ID}-lcars.port"
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would create ${port_file} with port ${LCARS_PORT}"
        else
            if [[ -f "$port_file" ]]; then
                _skip "lcars-ports/${TEAM_ID}-lcars.port"
            else
                mkdir -p "$LCARS_PORTS_DIR"
                printf '%s\n' "$LCARS_PORT" > "$port_file"
                _ok "lcars-ports/${TEAM_ID}-lcars.port"
            fi
        fi

        # ── Site 4: ~/.aiteamforge/team-paths.json ────────────────────────

        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert '${TEAM_ID}' into ${TEAM_PATHS_JSON}"
        else
            if [[ -f "$TEAM_PATHS_JSON" ]] && python3 -c "
import json, sys
d = json.load(open('${TEAM_PATHS_JSON}'))
sys.exit(0 if '${TEAM_ID}' in d.get('teams', {}) else 1)
" 2>/dev/null; then
                _skip "~/.aiteamforge/team-paths.json"
            else
                # XACA-1187-003/-005: the writer can now legitimately refuse
                # (lock/re-read failure, unreadable registry, or the
                # no-team-loss guard) -- surface that instead of printing
                # _ok over a write that never happened.
                if _insert_team_paths_json "$TEAM_ID" "$TEAM_CODE" "$KANBAN_DIR" "$WORKING_DIR" \
                    "$LCARS_PORT" "$PORT_BAND_BASE" "$PORT_BAND_RANGE"; then
                    _ok "~/.aiteamforge/team-paths.json"
                else
                    echo "ERROR: failed to register '${TEAM_ID}' in ~/.aiteamforge/team-paths.json (see stderr above)" >&2
                    return 1
                fi
            fi
        fi

        # ── Site 5: RETIRED (XACA-1058) ────────────────────────────────────
        #
        # This used to insert a literal `${TEAM_ID}) echo "${TEAM_CODE}" ;;`
        # case arm into kanban-helpers.sh's _kb_get_team_code(), anchored on
        # the sentinel `        *)\n            # Smart fallback`. XACA-1058
        # deleted that sentinel along with the derivation heuristic it fed (a
        # wrong-but-plausible code minted for any unrecognized slug — the
        # exact defect class this ticket exists to remove) — so the anchor
        # this step searched for no longer exists in kanban-helpers.sh, and
        # left wired in, this step would `_warn` "sentinel not found, manual
        # edit needed" on every future team, forever. Site 4
        # (~/.aiteamforge/team-paths.json) already writes team_code
        # unconditionally for every team, and _kb_get_team_code() now reads
        # that overlay FIRST, before any case statement — so a per-team arm
        # here would be a redundant, driftable second copy of the same fact,
        # which is precisely what XACA-1058 removes. Retired to a no-op
        # instead of deleted outright so the site numbering below (and
        # anything that references sites by number) doesn't shift — same
        # precedent as Site 10.
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "kanban-helpers.sh _kb_get_team_code — retired (XACA-1058), overlay (Site 4) is now the sole source"
        else
            echo -e "${CYAN}[SKIP]${NC} kanban-helpers.sh _kb_get_team_code — retired (XACA-1058, overlay is sole source now)"
        fi

        # ── Site 6: RETIRED (XACA-1058) ────────────────────────────────────
        #
        # Same rationale as Site 5, reverse direction
        # (_kb_get_team_from_code()). Unlike Site 5, this step's own sentinel
        # (`        *)   echo "" ;;  # Unknown code`) is still intact and
        # would still successfully insert an arm — but doing so would
        # recreate the exact redundant-mirror defect XACA-1058 removes:
        # _kb_overlay_code_to_slug (consulted by _kb_get_team_from_code ahead
        # of any case statement) already resolves every overlay-registered
        # team_code back to its slug from the same Site-4 entry. Retired for
        # the same reason as Site 5, not because this anchor broke.
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "kanban-helpers.sh _kb_get_team_from_code — retired (XACA-1058), overlay (Site 4) is now the sole source"
        else
            echo -e "${CYAN}[SKIP]${NC} kanban-helpers.sh _kb_get_team_from_code — retired (XACA-1058, overlay is sole source now)"
        fi

        # ── Site 7: kanban-helpers.sh _kb_get_kanban_dir ─────────────────

        local kanban_dir_arm="        ${TEAM_ID})
            echo \"${KANBAN_DIR}\"
            ;;"
        local kanban_dir_sentinel="        # Legal Projects"
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert case arm for '${TEAM_ID}' in _kb_get_kanban_dir()"
        else
            # Use _chk_case_label (boundary-anchored) to avoid false-positives from
            # comments mentioning TEAM_ID inside the function region (k501 sibling-drift fix).
            if _chk_case_label _kb_get_kanban_dir "${KANBAN_HELPERS}" "${TEAM_ID}"; then
                _skip "kanban-helpers.sh _kb_get_kanban_dir"
            else
                _insert_case_arm "${KANBAN_HELPERS}" "_kb_get_kanban_dir" \
                    "$kanban_dir_arm" "$kanban_dir_sentinel" && _ok "kanban-helpers.sh _kb_get_kanban_dir" \
                    || _warn "kanban-helpers.sh _kb_get_kanban_dir — sentinel not found, manual edit needed"
            fi
        fi

        # ── Site 8: kanban-helpers.sh _kb_team_lcars_port ────────────────

        local port_arm="        ${TEAM_ID})                           _port=\"${LCARS_PORT}\" ;;"
        local port_sentinel="        *)                                      _port=\"\" ;;"
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert case arm for '${TEAM_ID}' in _kb_team_lcars_port()"
        else
            # Use _chk_case_label (boundary-anchored) to avoid false-positives from
            # comments mentioning TEAM_ID inside the function region (k501 sibling-drift fix).
            if _chk_case_label _kb_team_lcars_port "${KANBAN_HELPERS}" "${TEAM_ID}"; then
                _skip "kanban-helpers.sh _kb_team_lcars_port"
            else
                _insert_case_arm "${KANBAN_HELPERS}" "_kb_team_lcars_port" \
                    "$port_arm" "$port_sentinel" && _ok "kanban-helpers.sh _kb_team_lcars_port" \
                    || _warn "kanban-helpers.sh _kb_team_lcars_port — sentinel not found, manual edit needed"
            fi
        fi

        # ── Site 9: statusline-command.sh _get_team_kanban_dir ───────────

        local statusline_arm="        ${TEAM_ID})     echo \"${KANBAN_DIR}\" ;;"
        local statusline_sentinel="        *)                              echo \"\${HOME}/dev-team/kanban\" ;;"
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert case arm for '${TEAM_ID}' in statusline _get_team_kanban_dir()"
        else
            if grep -q "^[[:space:]]*${TEAM_ID})" "${STATUSLINE_SH}"; then
                _skip "statusline-command.sh _get_team_kanban_dir"
            else
                _insert_case_arm "${STATUSLINE_SH}" "_get_team_kanban_dir" \
                    "$statusline_arm" "$statusline_sentinel" && _ok "statusline-command.sh _get_team_kanban_dir" \
                    || _warn "statusline-command.sh — sentinel not found, manual edit needed"
            fi
        fi

        # ── Site 10: RETIRED (XACA-0992) ──────────────────────────────────
        #
        # This used to insert '${TEAM_ID}': '${ASSET_DIR}' into a hand-rolled
        # team_dir_map dict in lcars-ui/server.py. That dict was removed
        # entirely when server.py's team-logo/avatar/appicon serving moved
        # to the generic _resolve_base_team()/_split_team_id() rule (splits
        # any team id on its first hyphen, no per-team entry required) —
        # so the pattern this step used to search for no longer exists in
        # server.py at all. Left wired in, this step would `exit 1` on
        # every future team (site 10's python helper prints "ERROR:
        # team_dir_map not found" and fails closed) and, under this
        # script's `set -euo pipefail`, would silently abort the ENTIRE
        # provisioning run right here — after sites 1-9 already succeeded,
        # before sites 11-14 (amb-session-map.json, board, directory tree,
        # knowledge scaffolding) ever ran. Retired to a no-op instead of
        # deleted outright so the site numbering below (and anything that
        # references sites by number) doesn't shift.
        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "server.py team_dir_map — retired (XACA-0992), nothing to insert"
        else
            echo -e "${CYAN}[SKIP]${NC} server.py team_dir_map — retired (XACA-0992, resolved generically now)"
        fi

        # ── Site 11: amb-session-map.json ─────────────────────────────────

        if [[ "$DRY_RUN" -eq 1 ]]; then
            _dry "Would insert $(echo "$TERMINALS_LIST" | wc -l | tr -d ' ') entries into amb-session-map.json"
        else
            if python3 -c "
import json, sys
d=json.load(open('${AMB_SESSION_MAP}'))
sys.exit(0 if any(k.startswith('${TEAM_ID}-') for k in d) else 1)
" 2>/dev/null; then
                _skip "amb-session-map.json"
            else
                _insert_amb_session_map "$TEAM_ID" "$TERMINALS_LIST"
                _ok "amb-session-map.json"
            fi
        fi

    else
        # LOCAL-ONLY: log each registration site as a clean skip
        local _reg_sites=(
            "aiteamforge_paths.py DEFAULT_TEAMS"
            "aiteamforge-paths.sh _AITEAMFORGE_DEFAULT_TEAMS_DATA"
            "lcars-ports/${TEAM_ID}-lcars.port"
            "~/.aiteamforge/team-paths.json"
            "kanban-helpers.sh _kb_get_team_code"
            "kanban-helpers.sh _kb_get_team_from_code"
            "kanban-helpers.sh _kb_get_kanban_dir"
            "kanban-helpers.sh _kb_team_lcars_port"
            "statusline-command.sh _get_team_kanban_dir"
            "server.py team_dir_map"
            "amb-session-map.json"
        )
        for _s in "${_reg_sites[@]}"; do
            if [[ "$DRY_RUN" -eq 1 ]]; then
                _dry "[LOCAL-ONLY] ${_s} — product-managed (tap install), no action"
            else
                echo -e "${CYAN}[SKIP]${NC} ${_s} — product-managed (tap install)"
            fi
        done
    fi

    # ── Site 12: board.json ───────────────────────────────────────────────

    if [[ "$DRY_RUN" -eq 1 ]]; then
        # XACA-1163 (PR #860 review): echo the ID PREFIX the board would be born
        # with, mirroring kb-freelance:774. The prefix is the single most
        # consequential thing this command decides -- it is baked into every
        # item id from the first one onward -- and a dry-run that does not show
        # it cannot be used to catch the very defect this ticket fixed.
        if [[ "$TEAM_CODE_IS_REAL" -eq 1 ]]; then
            _dry "Would create ${KANBAN_DIR}/${TEAM_ID}-board.json (series/prefix=X${TEAM_CODE}; crew series=${SERIES})"
        else
            _dry "Would create ${KANBAN_DIR}/${TEAM_ID}-board.json (series/prefix OMITTED — no team code supplied; ids fall back to the derived team code; crew series=${SERIES})"
        fi
    else
        if [[ -f "${KANBAN_DIR}/${TEAM_ID}-board.json" ]]; then
            _skip "board.json"
        else
            mkdir -p "$KANBAN_DIR"
            _create_board_json "$TEAM_ID" "$TEAM_NAME" "$ORG_NAME" "$ORG_COLOR" \
                "$KANBAN_DIR" "$SERIES" \
                "$( [[ "$TEAM_CODE_IS_REAL" -eq 1 ]] && printf '%s' "$TEAM_CODE" )"
            _ok "board.json → ${KANBAN_DIR}/${TEAM_ID}-board.json"
        fi
    fi

    # ── Site 13+14: directory tree + four-tier knowledge scaffolding ─────

    if [[ "$DRY_RUN" -eq 1 ]]; then
        _dry "Would create kanban/ directory tree + project-tier knowledge (knowledge/project/)"
        _dry "Would scaffold team + agent tiers under ${KB_KNOWLEDGE_GLOBAL_ROOT:-$HOME/knowledge} (if present)"
    else
        _create_dir_tree "$KANBAN_DIR" "$TEAM_ID" "$TEAM_NAME" "$SERIES" "$WORKING_DIR"
        _ok "Directory tree (config/ activity/ plans/) + four-tier knowledge scaffolding"
    fi

    # ── Site 15: machine routing (kb-msg-provision --add-team) ─────────────
    # ADDITIVE-ONLY, NEVER FATAL (XACA-1078-003; contract:
    # kanban/plans/XACA-1078/XACA-1078_msg_routing_provisioning.md, "The
    # Unattended-Write Contract"). This asserts exactly the one fact this
    # process can honestly speak for: "$TEAM_ID was created HERE, just now,
    # by me" -- never a full re-derivation of the whole registry.
    #
    # Uses `if VAR="$(cmd)"; then ... else ...; fi`, NEVER `cmd && other` or
    # a bare `VAR="$(cmd)"` followed by a separate `$?` check, as the
    # sanctioned pattern under this script's `set -euo pipefail`: a plain
    # failing assignment outside an `if`/`while`/`&&`/`||` context aborts the
    # ENTIRE script right there, before any handling code runs
    # (feedback_set_e_last_line_short_circuit.md). By this point team
    # creation has already fully succeeded and must stay succeeded no matter
    # what this step does.
    local ROUTING_STATUS=""
    local _routing_script="${SCRIPT_DIR}/kb-msg-provision"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        _dry "Would run: kb-msg-provision --add-team ${TEAM_ID} (machine routing map)"
    elif [[ ! -f "$_routing_script" ]]; then
        _warn "ROUTING: NOT PROVISIONED (kb-msg-provision not found at ${_routing_script})"
        _warn "  Run by hand once available: kb-msg-provision --add-team ${TEAM_ID}"
        ROUTING_STATUS="kb-msg-provision not found"
    else
        local _routing_out _routing_rc
        # --quiet suppresses the tool's routine stdout report; its decline/
        # environment messages always print to stderr regardless of --quiet
        # (kb-msg-provision's `_notice`/`_die_env`), so `2>&1` here captures
        # exactly the reason, nothing more, for verbatim disclosure below.
        if _routing_out="$(python3 "$_routing_script" --add-team "$TEAM_ID" --quiet 2>&1)"; then
            _routing_rc=0
        else
            _routing_rc=$?
        fi
        if [[ "$_routing_rc" -eq 0 ]]; then
            _ok "Machine routing (kb-msg-provision --add-team ${TEAM_ID})"
        else
            # Contract Decision 3 / rule 12: exit 1 (declined) and exit 2
            # (environment problem) are treated IDENTICALLY here -- warn,
            # continue, never propagate, never suppress the reason. This
            # does NOT prompt: the team already exists and the only
            # available answers are "continue" and "continue" (disclose,
            # don't ask).
            _warn "ROUTING: NOT PROVISIONED (kb-msg-provision exited ${_routing_rc})"
            if [[ -n "$_routing_out" ]]; then
                echo "$_routing_out" >&2
            fi
            _warn "  Run by hand to resolve: kb-msg-provision --add-team ${TEAM_ID}"
            ROUTING_STATUS="kb-msg-provision exited ${_routing_rc}"
        fi
    fi

    # ── Validation (FULL mode only — validates dev-source Python/shell files) ──

    if [[ "$DRY_RUN" -eq 0 && "$INIT_MODE" == "full" ]]; then
        echo ""
        echo "=== Validation ==="

        # py_compile checks
        local py_ok=1
        for py_file in "${AITEAMFORGE_PATHS_PY}" \
                       "${DEV_TEAM_ROOT}/kanban-hooks/kanban_utils.py" \
                       "${SERVER_PY}"; do
            if python3 -m py_compile "$py_file" 2>/dev/null; then
                _ok "py_compile: $(basename $py_file)"
            else
                _fail "py_compile FAILED: $py_file"
                py_ok=0
            fi
        done

        # Syntax checks — shebang-aware (XACA-1056). kanban-helpers.sh is
        # zsh BY DESIGN (`#!/usr/bin/env zsh`); running it through bash's
        # parser was a false-negative that failed EVERY run regardless of
        # actual correctness, training everyone to ignore this validator's
        # output. Dispatch on the file's own shebang instead of hardcoding
        # one parser for every file: zsh-shebanged files get `zsh -n`,
        # everything else keeps the original `bash -n`. A file whose parser
        # is unavailable is SKIPPED (visibly, via _warn) rather than passed
        # or failed — a skip must never read as a pass.
        #
        # A MISSING file is NOT the same case and is NOT skipped: these three
        # paths are core install artifacts, so their absence IS the finding.
        # The pre-XACA-1056 loop hard-failed on a missing file (bash -n on a
        # nonexistent path exits nonzero -> _fail, py_ok=0) and that strictness
        # is deliberately preserved here. Softening it would have cured a
        # validator that cried wolf by making one that stays silent, which is
        # strictly worse: nobody investigates silence.
        for sh_file in "${KANBAN_HELPERS}" "${STATUSLINE_SH}" "${AITEAMFORGE_PATHS_SH}"; do
            if [[ ! -f "$sh_file" ]]; then
                _fail "syntax check FAILED (file not found): $sh_file"
                py_ok=0
                continue
            fi
            local shebang_line=""
            shebang_line=$(head -n 1 -- "$sh_file" 2>/dev/null || true)
            # Route on the interpreter BASENAME, exact match -- not a
            # substring/suffix test against the whole line. `*zsh*` would
            # misroute `#!/opt/notzsh/bin/bash` to zsh; a basename suffix
            # glob (`${interp##*/} == *zsh`) would still misroute a real
            # basename like `notzsh`. Handle the `env` indirection
            # (`#!/usr/bin/env zsh` -> interpreter is the NEXT token) and
            # ignore trailing interpreter args (`#!/bin/zsh -f`).
            local interp_name=""
            if [[ "$shebang_line" == "#!"* ]]; then
                local -a shebang_tokens=()
                read -r -a shebang_tokens <<< "${shebang_line:2}"
                local interp_tok="${shebang_tokens[0]:-}"
                if [[ "$(basename -- "$interp_tok" 2>/dev/null)" == "env" ]]; then
                    interp_tok="${shebang_tokens[1]:-}"
                fi
                interp_name=$(basename -- "$interp_tok" 2>/dev/null || true)
            fi
            if [[ "$interp_name" == "zsh" ]]; then
                if ! command -v zsh >/dev/null 2>&1; then
                    _warn "syntax check SKIPPED (zsh not on PATH): $(basename "$sh_file")"
                    continue
                fi
                if zsh -n "$sh_file" 2>/dev/null; then
                    _ok "syntax (zsh -n): $(basename "$sh_file")"
                else
                    _fail "syntax (zsh -n) FAILED: $sh_file"
                    py_ok=0
                fi
            else
                if bash -n "$sh_file" 2>/dev/null; then
                    _ok "syntax (bash -n): $(basename "$sh_file")"
                else
                    _fail "syntax (bash -n) FAILED: $sh_file"
                    py_ok=0
                fi
            fi
        done

        # JSON checks
        for json_file in "${AMB_SESSION_MAP}" "${TEAM_PATHS_JSON}"; do
            if [[ -f "$json_file" ]]; then
                if python3 -c "import json; json.load(open('$json_file'))" 2>/dev/null; then
                    _ok "json valid: $(basename $json_file)"
                else
                    _fail "JSON INVALID: $json_file"
                    py_ok=0
                fi
            fi
        done

        if [[ "$py_ok" -eq 1 ]]; then
            echo ""
            _ok "All validation checks passed."
        else
            echo ""
            _fail "One or more validation checks failed. Review files before committing."
            exit 1
        fi
    fi

    echo ""
    echo "=== Summary ==="
    echo ""
    if [[ "$INIT_MODE" == "full" ]]; then
        _info "Team '${TEAM_ID}' (${TEAM_CODE}) registration complete."
        _info "Port: ${LCARS_PORT} | Series: ${SERIES} | Asset dir: ${ASSET_DIR}"
        if [[ -n "$ROUTING_STATUS" ]]; then
            _warn "ROUTING: NOT PROVISIONED (${ROUTING_STATUS})"
        fi
        echo ""
        _info "Next steps:"
        _info "  1. Run ./sync-tap.sh to sync canonical sources to homebrew-tap/share/"
        _info "  2. Commit: git add <changed-files> && git commit -m 'feat: register team ${TEAM_ID}'"
        _info "  3. The tap's share/kanban-hooks/ copies sync via sync-tap.sh (XACA-0340 rule)"
        _info "  4. server.py needs NO new entry (XACA-0992: _resolve_base_team() resolves this generically from the team id) — restart only picks up other config, e.g. team-paths.json"
        _info "  5. kanban_utils and server prefix maps derive at next import — no restart needed"
    else
        _info "Team '${TEAM_ID}' board and directory tree provisioned (local-only mode)."
        _info "Series: ${SERIES} | Kanban dir: ${KANBAN_DIR}"
        _info "Registration sites are product-managed — no dev-source files were modified."
        if [[ -n "$ROUTING_STATUS" ]]; then
            _warn "ROUTING: NOT PROVISIONED (${ROUTING_STATUS})"
        fi
    fi
    echo ""
}

main "$@"
