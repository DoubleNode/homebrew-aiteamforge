#!/usr/bin/env bash
# kb-init-team — Initialize a new kanban team across all infrastructure sites.
#
# XACA-0542 subitem 002: Standalone provisioner for new teams.
#
# USAGE
#   kb-init-team [OPTIONS]
#
# OPTIONS
#   --team-id <id>         Team identifier, e.g. freelance-acme-ios (required)
#   --team-code <CODE>     3-letter code, e.g. FAI (required; must be globally unique)
#   --team-name <name>     Display name, e.g. "ACME IOS" (default: uppercase of team-id)
#   --org-name <name>      Organization display name, e.g. "ACME" (default: derived)
#   --org-color <hex>      Hex color for LCARS org badge, e.g. #2ECC71 (default: #888888)
#   --kanban-dir <path>    Absolute path to kanban directory (required)
#   --working-dir <path>   Absolute path to working/project dir (default: parent of kanban-dir)
#   --series <SERIES>      Star Trek series for crew config: ENT|TNG|DS9|TOS|LD|VOY|MED|LEG|FER|SDK|SNW
#                          (default: ENT)
#   --asset-dir <dir>      Asset dir family name for image serving (default: derived from team-id)
#   --lcars-port <port>    Explicit port number (default: auto-computed via port band)
#   --port-band-base <N>   Port band base for auto-compute (default: 8500 for freelance, else 8600)
#   --port-band-range <N>  Port band size (default: 100)
#   --dry-run              Print all changes without applying any (exit 0)
#   --check-only           Verify team is fully registered; exit 0 if complete, 1 if not
#   --non-interactive      Fail instead of prompting; exit 1 if required inputs missing
#   --backfill-tiers       Idempotently backfill team+agent knowledge-tier INDEX.md
#                          scaffold for an ALREADY-REGISTERED team (only --team-id is
#                          required; skips full provisioning). Routes finance-personal/
#                          legal-coparenting/medical-general to ~/knowledge-local (PII),
#                          all other teams to ~/knowledge. Combine with --dry-run or
#                          --check-only. XACA-0754-002.
#   --help                 Show this help
#
# REGISTRATION SITES (what this tool writes)
#   PRIMARY (must write — registry sources):
#     1. kanban-hooks/aiteamforge_paths.py — DEFAULT_TEAMS entry (the SSoT)
#     2. homebrew-tap/libexec/lib/aiteamforge-paths.sh — _AITEAMFORGE_DEFAULT_TEAMS_DATA row
#     3. lcars-ports/<team-id>-lcars.port — port file
#     4. ~/.aiteamforge/team-paths.json — live runtime overlay
#
#   FALLBACK INSURANCE (hardcoded case statements; must stay mirrored with registry):
#
#     ┌─ READ vs WRITE — read this before touching sites 5-9 (XACA-1161) ─────┐
#     │ "Retired" is ambiguous here and the ambiguity has already caused a    │
#     │ real defect. A site has TWO paths:                                    │
#     │                                                                       │
#     │   WRITE path — does kb-init-team INSERT a case arm for a new team?    │
#     │   READ  path — do the arms ALREADY THERE still resolve and return?    │
#     │                                                                       │
#     │ XACA-1058 retired the WRITE path of sites 5 and 6. It did NOT retire  │
#     │ their READ path. Both still carry live case tables that return values │
#     │ today. A previous revision of this header called sites 5, 6 and 10    │
#     │ "RETIRED" without that qualifier; that claim was copied into the      │
#     │ XACA-1161 ticket description and nearly into the XACA-1161-007 CI     │
#     │ drift guard, which would have skipped two live read sites and         │
#     │ inherited exactly the fail-open shape that guard exists to close.     │
#     │                                                                       │
#     │ MEASURED 2026-09-10 — ONLY SITE 10 IS FULLY RETIRED.                  │
#     └───────────────────────────────────────────────────────────────────────┘
#
#     5.  WRITE PATH RETIRED (XACA-1058) / READ PATH LIVE.
#         kanban-helpers.sh _kb_get_team_code().
#         kb-init-team no longer inserts a per-team arm here: XACA-1058 deleted
#         the derivation heuristic these arms fed (a wrong-but-plausible code
#         minted for any unrecognized slug) and made Site 4's overlay the sole
#         authoritative source, read FIRST ahead of any case statement. A new
#         per-team arm would be a redundant, driftable second copy of Site 4.
#         BUT THE EXISTING ARMS STILL RESOLVE. Verify before assuming otherwise:
#           awk '/^_kb_get_team_code\(\)/,/^}/' kanban-helpers.sh \
#             | grep -cE '^[[:space:]]*[a-z][a-z0-9-]*\)'      # -> 31 arm lines
#         31 case-arm lines across THREE tables, 11 distinct slugs. Two tables
#         are overlay/built-in disagreement warnings; the third is a live
#         resolution fallback that RETURNS a team_code when the overlay misses
#         AND the shell loader is unavailable — which is the normal state on
#         every tap consumer (see the LOADER DISCOVERY note below).
#     6.  WRITE PATH RETIRED (XACA-1058) / READ PATH LIVE.
#         kanban-helpers.sh _kb_get_team_from_code() — same as Site 5, reverse
#         direction. _kb_overlay_code_to_slug resolves overlay-registered codes
#         ahead of the case statement, so no new arm is inserted; the existing
#         CODE) -> slug table still fires when overlay reverse-lookup and the
#         shell loader both miss.
#           awk '/^_kb_get_team_from_code\(\)/,/^}/' kanban-helpers.sh \
#             | grep -oE '^[[:space:]]*[A-Z]{3}\)'
#         -> ACA AND CMD DNS FIN FIR FRE IOS LCP MED MEV  (11 live codes)
#     7.  kanban-helpers.sh _kb_get_kanban_dir() case          (READ + WRITE live)
#     8.  kanban-helpers.sh _kb_team_lcars_port() case         (READ + WRITE live)
#     9.  claude/statusline-command.sh _get_team_kanban_dir()  (READ + WRITE live)
#
#     ── DO NOT TRUST THE "MUST EXACTLY MIRROR DEFAULT_TEAMS" COMMENTS ──
#     Sites 5 and 6 each carry, directly above their table, a comment reading
#     "MUST EXACTLY MIRROR DEFAULT_TEAMS team_code values in
#     aiteamforge_paths.py" — sitting above an arm reading `freelance) "FRE"`.
#     DEFAULT_TEAMS has no freelance entry (removed by XACA-0628); the SHELL
#     seed does. Those comments name the wrong seed. Verify by importing the
#     symbol, not by grepping the file (a literal "freelance": also appears in
#     an unrelated port-band dict, so a naive grep answers "present"):
#       python3 -c "import sys; sys.path.insert(0,'kanban-hooks'); \
#         import aiteamforge_paths as P; print('freelance' in P.DEFAULT_TEAMS)"
#       -> False
#     Do not add a third comment of that shape.
#
#     ── LOADER DISCOVERY IS BROKEN ON CONSUMERS — why 5-9 cannot be retired ──
#     XACA-1161 set out to retire these tables and DID NOT, because on a tap
#     consumer they are the ONLY registry that exists. kanban-helpers.sh lines
#     37-39 probe three paths for the shell loader; all three are dead there:
#       1. ${HOME}/dev-team/homebrew-tap/... — the dev repo. M3Pro only.
#       2. $(brew --prefix)/share/aiteamforge/... — a directory nothing in the
#          tap ever creates (share/aiteamforge-env.sh is a FILE in share/, not
#          a share/aiteamforge/ DIRECTORY — do not confuse them).
#       3. ${HOME}/.aiteamforge/lib/... — a file nothing ever writes; all 8
#          code references to that path are this candidate list itself.
#     The formula does `libexec.install Dir["*"]`, so the loader installs to a
#     DOUBLED path — $(brew --prefix)/opt/aiteamforge/libexec/libexec/lib/ —
#     which the formula's own `test do` block asserts, and which matches none
#     of the three candidates. On THIS machine candidate 1 resolves, so tests
#     pass here and the breakage appears only on boxes nobody is watching.
#     Fixing discovery is the prerequisite and is tracked on XACA-1133.
#     Full evidence: docs/registry/xaca-1161-outcome.md section 3.
#
#   STATIC MAPS (not derivable from registry):
#     10. FULLY RETIRED (XACA-0992) — BOTH read and write paths. This is the
#         ONLY site in this register for which the unqualified word "retired"
#         is accurate; sites 5 and 6 above retired their WRITE path only.
#         Re-verify with a control so a broken grep cannot read as "clean":
#           grep -c 'team_dir_map'      lcars-ui/server.py   # -> 0 (gone)
#           grep -c '_resolve_base_team' lcars-ui/server.py  # -> 8 (control)
#         lcars-ui/server.py's per-team `team_dir_map`
#         dict this site used to populate was replaced by the generic
#         _resolve_base_team()/_split_team_id() rule (splits any team id on
#         its first hyphen — no per-team registration needed at all). This
#         numbered slot is kept as a no-op, reported as such below, so the
#         site numbering below and in kb-init-team --check-only output
#         doesn't shift out from under any doc/runbook referencing sites by
#         number. See scripts/kb-init-team's ASSET_DIR derivation comment
#         for the invariant server.py now enforces instead.
#     11. amb-session-map.json (terminal-session → persona entries)
#
#   BOARD + DIRECTORY TREE (provisioning, not registration):
#     12. <kanban-dir>/<team-id>-board.json
#     13. <kanban-dir>/config/ activity/ plans/ knowledge/project/ (project tier)
#     14. Four-tier knowledge scaffolding (see ~/knowledge/SPEC.md):
#           - project: <kanban-dir>/knowledge/project/INDEX.md (+ retrospectives/)
#           - team:    $KB_KNOWLEDGE_GLOBAL_ROOT/teams/<team-id>/INDEX.md (reserved)
#           - agent:   $KB_KNOWLEDGE_GLOBAL_ROOT/agents/<persona>/INDEX.md (if missing)
#         Global tiers skipped-with-warning when $KB_KNOWLEDGE_GLOBAL_ROOT absent.
#
#   MACHINE ROUTING (best-effort, ADDITIVE-ONLY, NEVER FATAL -- XACA-1078):
#     15. Runs `kb-msg-provision --add-team <team-id>` after sites 1-14
#         above complete, asserting this team's row in
#         ~/.aiteamforge/team-machines.json (the cross-machine kb-msg
#         routing map). This is the ONE fact a team-birth call can honestly
#         speak for -- "this team was created HERE, just now, by me" --
#         never a full re-derivation of the whole registry (see
#         kb-msg-provision's own --help for why). A routing failure NEVER
#         aborts team creation: it is disclosed (the tool's stderr,
#         verbatim, plus one copyable remediation command) and surfaces as
#         a `ROUTING: NOT PROVISIONED (<reason>)` line in the completion
#         banner below -- it does not prompt, even though this script is
#         otherwise interactive (the team already exists; there is
#         nothing left to ask). Full contract:
#         kanban/plans/XACA-1078/XACA-1078_msg_routing_provisioning.md,
#         section "The Unattended-Write Contract".
#
#   REACHABILITY (not a value store — XACA-1161 addition; the original
#   15-site register omitted it entirely):
#     16. homebrew-tap/share/teams/registry.json — the installable-template
#         catalog. It holds NO registry-schema fields at all; measured, the
#         union of its entry keys is exactly:
#           category, color, description, icon, id, name, order, recommended, theme
#         Verify (and note the control, which prints NONE rather than nothing):
#           python3 -c "import json; d=json.load(open('homebrew-tap/share/teams/registry.json')); \
#             k=set().union(*(set(e) for e in d['teams'])); print(sorted(k)); \
#             print(sorted(k & {'kanban_dir','working_dir','team_code','lcars_port', \
#             'lcars_port_base','lcars_port_range','primary_host','alias_of','board_less'}) or 'NONE')"
#         It is nonetheless a registration site, because it decides whether a
#         seed row is REACHABLE: a team correctly registered in both seeds but
#         absent from this catalog is not installable. Treat it as a
#         REACHABILITY site, not a value site — never join it to a seed
#         expecting field data.
#         CAUTION: its ids are TEMPLATE ids, not runtime slugs, and they
#         differ — it lists `legal`, `medical`, `finance`, `freelance` where
#         the runtime slugs are `legal-coparenting`, `medical-general`,
#         `finance-personal`, and per-project `freelance-<client>-<project>`.
#         Anything joining this file to a seed on `id` must MAP, not match.
#         The XACA-1161-007 drift guard asserts, via the real resolver rather
#         than a re-implementation of it, that every template listed here still
#         resolves a port band — which is what holds the load-bearing
#         shell-only `freelance` seed row in place.
#
#   DERIVES AUTOMATICALLY (no explicit insert needed after #1):
#     - kanban_utils._TEAM_CODE_MAP — built from build_team_code_map() at import
#     - server._ITEM_PREFIX_TO_TEAM — built from _build_item_prefix_to_team() at module load
#     - server.get_board_for_item() prefix map — built from _ITEM_PREFIX_TO_TEAM
#     - server.TEAM_KANBAN_DIRS — built from aiteamforge_paths.list_teams() at startup
#     - kanban_utils.TEAM_KANBAN_DIRS — built from DEFAULT_TEAMS at import
#
# IDEMPOTENCY
#   Every write checks if the entry already exists before inserting. Running
#   kb-init-team twice on the same team is safe. --check-only verifies all sites.
#
# TAP MIRROR NOTE
#   aiteamforge_paths.py has a mirror at homebrew-tap/share/kanban-hooks/.
#   kanban_utils.py also has a tap mirror, but it derives from registry so
#   its fallback hardcoded dict only needs updating when the registry import
#   would fail — the tap-side copy updates automatically when sync-tap.sh runs.
#   This script edits the CANONICAL source (dev-team). Run sync-tap.sh (or
#   use kb-edit-shared where applicable) after registering to keep tap aligned.

set -euo pipefail

# ── Locate dev-team root ──────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_TEAM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

AITEAMFORGE_PATHS_PY="${DEV_TEAM_ROOT}/kanban-hooks/aiteamforge_paths.py"
AITEAMFORGE_PATHS_SH="${DEV_TEAM_ROOT}/homebrew-tap/libexec/lib/aiteamforge-paths.sh"
KANBAN_HELPERS="${DEV_TEAM_ROOT}/kanban-helpers.sh"
STATUSLINE_SH="${DEV_TEAM_ROOT}/claude/statusline-command.sh"
SERVER_PY="${DEV_TEAM_ROOT}/lcars-ui/server.py"
AMB_SESSION_MAP="${DEV_TEAM_ROOT}/amb-session-map.json"
LCARS_PORTS_DIR="${DEV_TEAM_ROOT}/lcars-ports"
# Honors AITEAMFORGE_CONFIG (same override kanban-helpers.sh's
# _kb_overlay_config_path resolves, kanban-helpers.sh:74-76) — keeps
# _kbit_is_local_only_team's overlay-flag lookup sandboxable in tests without
# drifting from the canonical resolution kanban-helpers.sh uses.
TEAM_PATHS_JSON="${AITEAMFORGE_CONFIG:-${HOME}/.aiteamforge/team-paths.json}"

# XACA-0804: kb-init-team is a genuine registration/provisioning entrypoint —
# its get_team_code()/get_team_from_code() lookups below must be able to
# bootstrap-write a missing registry, not just silently fall back.
export AITEAMFORGE_ALLOW_BOOTSTRAP_WRITE=1

# ── XACA-0648: Auto-detect dev-source-of-truth vs tap-consumer mode ──────────
#
# FULL mode (sites 1–14):  runs on the dev-source-of-truth machine where the
#   homebrew-tap submodule is checked out alongside the scripts.
#   Signal: "${DEV_TEAM_ROOT}/homebrew-tap/libexec/lib/aiteamforge-paths.sh" exists.
#
# LOCAL-ONLY mode (sites 12–14 only):  runs on a tap-consumer machine where
#   "scripts/kb-init-team" has been installed under $AITEAMFORGE_DIR.  The tap
#   install rewrites "~/dev-team" → "$AITEAMFORGE_DIR", so DEV_TEAM_ROOT becomes
#   something like ~/aiteamforge — but there is no homebrew-tap/ submodule there.
#   Registration sites 1–11 mutate canonical dev-source files that do not exist
#   on a consumer; they are product-managed by the tap formula.  Skipping them
#   is correct: the team is already registered in the shipped DEFAULT_TEAMS.
#
# Computed once here; referenced throughout the file.
if [[ -f "${AITEAMFORGE_PATHS_SH}" ]]; then
    INIT_MODE="full"
else
    INIT_MODE="local-only"
fi

# ── Board-template resolver (XACA-0648) ───────────────────────────────────────
# Returns the path of the first board-template.json candidate that exists, or
# writes an embedded fallback to a tmpfile and returns that path.
# The embedded fallback guarantees board creation never fails even when no
# template file is present on disk.
_resolve_board_template() {
    # Candidate (a): dev-source path (FULL mode machine)
    local _dev="${DEV_TEAM_ROOT}/homebrew-tap/share/templates/kanban/board-template.json"
    if [[ -f "$_dev" ]]; then
        printf '%s' "$_dev"
        return 0
    fi

    # Candidate (b): brew Cellar install path — try `brew --prefix aiteamforge`
    local _brew_prefix=""
    _brew_prefix="$(brew --prefix aiteamforge 2>/dev/null || true)"
    if [[ -n "$_brew_prefix" ]]; then
        local _brew="${_brew_prefix}/libexec/share/templates/kanban/board-template.json"
        if [[ -f "$_brew" ]]; then
            printf '%s' "$_brew"
            return 0
        fi
    fi

    # Candidate (c): relative to DEV_TEAM_ROOT (covers the case where DEV_TEAM_ROOT
    # is the tap-installed AITEAMFORGE_DIR and share/ lives alongside scripts/).
    local _rel="${DEV_TEAM_ROOT}/share/templates/kanban/board-template.json"
    if [[ -f "$_rel" ]]; then
        printf '%s' "$_rel"
        return 0
    fi

    # Embedded fallback: write the minimal board template to a tmpfile so that
    # board creation NEVER fails due to a missing template file.
    # BSD mktemp (macOS) requires X's at the END of the template — a trailing
    # suffix defeats randomization and causes "File exists" on the second call.
    # Honor TMPDIR so the file lands in the correct per-user temp directory.
    local _tmp
    _tmp="$(mktemp "${TMPDIR:-/tmp}/kb-init-team-board-template.XXXXXX")" \
        || { _fail "mktemp failed — cannot create embedded board template in ${TMPDIR:-/tmp}"; return 1; }
    cat > "$_tmp" <<'BOARD_TEMPLATE_HEREDOC'
{
  "team": "{{TEAM_ID}}",
  "teamName": "{{TEAM_NAME}}",
  "subtitle": "{{TEAM_SUBTITLE}}",
  "ship": "{{TEAM_SHIP}}",
  "series": "{{TEAM_SERIES}}",
  "organization": "{{TEAM_ORG}}",
  "orgColor": "{{TEAM_ORG_COLOR}}",
  "kanbanDir": "{{KANBAN_DIR}}",
  "lastUpdated": "{{CREATED_DATE}}",
  "nextId": 1,
  "nextEpicId": 1,
  "nextReleaseId": 1,
  "fleetMonitorUrl": "",
  "terminals": {},
  "activeWindows": [],
  "backlog": [],
  "epics": [],
  "releases": [],
  "releaseConfig": {
    "defaultEnvironments": ["PLANNED", "DEV", "QA", "ALPHA", "BETA", "GAMMA", "PROD"],
    "platforms": {
      "ios": {"name": "iOS", "store": "App Store", "icon": "apple"},
      "android": {"name": "Android", "store": "Play Store", "icon": "android"},
      "firebase": {"name": "Firebase", "store": null, "icon": "database"},
      "web": {"name": "Web", "store": null, "icon": "globe"},
      "other": {"name": "Other", "store": null, "icon": "ellipsis-h"}
    },
    "releaseTypes": {
      "feature": {"name": "Feature Release", "description": "New features", "color": "#4a90d9"},
      "bugfix": {"name": "Bug Fix Release", "description": "Bug fixes", "color": "#f5a623"},
      "hotfix": {"name": "Hotfix", "description": "Critical fixes", "color": "#d0021b"},
      "maintenance": {"name": "Maintenance", "description": "Technical updates", "color": "#7ed321"}
    },
    "flowConfig": {
      "stages": {
        "PLANNED": {"enabled": true, "required": true},
        "DEV": {"enabled": true, "required": true},
        "QA": {"enabled": true, "required": false},
        "ALPHA": {"enabled": true, "required": false},
        "BETA": {"enabled": true, "required": false},
        "GAMMA": {"enabled": true, "required": false},
        "PROD": {"enabled": true, "required": true}
      }
    }
  }
}
BOARD_TEMPLATE_HEREDOC
    printf '%s' "$_tmp"
}

# ── Colour helpers ────────────────────────────────────────────────────────────

RED='\033[0;31m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; NC='\033[0m'
_ok()   { echo -e "${GREEN}  [OK]${NC} $*"; }
_skip() { echo -e "${CYAN}[SKIP]${NC} $* (already registered)"; }
_info() { echo -e "       $*"; }
_warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }
_fail() { echo -e "${RED}[FAIL]${NC} $*" >&2; }
_dry()  { echo -e "${CYAN} [DRY]${NC} $*"; }

# ── Argument parsing ──────────────────────────────────────────────────────────

TEAM_ID=""
TEAM_CODE=""
# XACA-1163: 1 = a real team code is available (supplied via --team-code,
# prompted, or derived from the registry); 0 = only the "LOC" placeholder.
# board.json's `series` key is written ONLY when this is 1 — see
# _create_board_json. Do NOT re-derive this by comparing TEAM_CODE to "LOC":
# that is a sentinel collision with a legitimate 3-letter code.
TEAM_CODE_IS_REAL=1
TEAM_NAME=""
ORG_NAME=""
ORG_COLOR="#888888"
KANBAN_DIR=""
WORKING_DIR=""
SERIES="ENT"
ASSET_DIR=""
LCARS_PORT=""
PORT_BAND_BASE=""
PORT_BAND_RANGE="100"
DRY_RUN=0
CHECK_ONLY=0
NON_INTERACTIVE=0
BACKFILL_TIERS=0

usage() {
    # XACA-1161-008: NO hardcoded line count. This was `head -60`, then
    # `head -104` (XACA-1078-003), and each time the header grew past the
    # magic number --help silently truncated -- omitting documentation that
    # WAS in the file, with no error and no visible sign anything was missing.
    # That is the same fail-quiet shape this whole ticket is about: truncated
    # output and complete output are indistinguishable to the reader. Adding
    # the sites 5/6/10 read-vs-write correction and site 16 overran 104 and
    # cut --help off mid-sentence, which is how it was found.
    #
    # Print the leading comment block by its STRUCTURE instead: everything
    # from line 2 (past the shebang) up to the first line that is not a
    # comment. Self-maintaining -- the header can grow or shrink freely and
    # --help always shows exactly all of it.
    awk 'NR == 1 { next }                  # skip shebang
         /^#/    { sub(/^# ?/, ""); print; next }
                 { exit }' "${BASH_SOURCE[0]}"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "${1-}" in
        --team-id)          TEAM_ID="${2:?--team-id requires a value}";      shift 2 ;;
        --team-code)        TEAM_CODE="${2:?--team-code requires a value}";  shift 2 ;;
        --team-name)        TEAM_NAME="${2:?--team-name requires a value}";  shift 2 ;;
        --org-name)         ORG_NAME="${2:?--org-name requires a value}";    shift 2 ;;
        --org-color)        ORG_COLOR="${2:?--org-color requires a value}";  shift 2 ;;
        --kanban-dir)       KANBAN_DIR="${2:?--kanban-dir requires a value}"; shift 2 ;;
        --working-dir)      WORKING_DIR="${2:?--working-dir requires a value}"; shift 2 ;;
        --series)           SERIES="${2:?--series requires a value}";        shift 2 ;;
        --asset-dir)        ASSET_DIR="${2:?--asset-dir requires a value}";  shift 2 ;;
        --lcars-port)       LCARS_PORT="${2:?--lcars-port requires a value}"; shift 2 ;;
        --port-band-base)   PORT_BAND_BASE="${2:?--port-band-base requires a value}"; shift 2 ;;
        --port-band-range)  PORT_BAND_RANGE="${2:?--port-band-range requires a value}"; shift 2 ;;
        --dry-run)          DRY_RUN=1;          shift ;;
        --check-only)       CHECK_ONLY=1;       shift ;;
        --non-interactive)  NON_INTERACTIVE=1;  shift ;;
        --backfill-tiers)   BACKFILL_TIERS=1;   shift ;;
        --help|-h)          usage ;;
        *) _fail "Unknown option: ${1}"; exit 1 ;;
    esac
done

# ── Interactive prompts (when --non-interactive is NOT set) ───────────────────

_prompt() {
    local var_name="$1" prompt_text="$2" default="${3-}"
    local current
    current="${!var_name}"
    if [[ -n "$current" ]]; then return 0; fi
    if [[ "$NON_INTERACTIVE" -eq 1 ]]; then
        if [[ -n "$default" ]]; then
            printf -v "$var_name" '%s' "$default"
        else
            _fail "--non-interactive set but required param ${var_name} is missing"
            exit 1
        fi
    else
        local response
        if [[ -n "$default" ]]; then
            read -r -p "  ${prompt_text} [${default}]: " response
            printf -v "$var_name" '%s' "${response:-$default}"
        else
            read -r -p "  ${prompt_text}: " response
            if [[ -z "$response" ]]; then
                _fail "${var_name} is required"
                exit 1
            fi
            printf -v "$var_name" '%s' "$response"
        fi
    fi
}

# ── Validation helpers ────────────────────────────────────────────────────────

_team_in_default_teams() {
    python3 - "${AITEAMFORGE_PATHS_PY}" "${1}" <<'PYEOF'
import sys, ast

def _iter_default_teams(path):
    """Yield (key_constant, value_dict) for DEFAULT_TEAMS. Handles Assign and AnnAssign."""
    src = open(path).read()
    tree = ast.parse(src)
    for node in ast.walk(tree):
        targets = []
        value = None
        if isinstance(node, ast.Assign):
            targets = node.targets; value = node.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            targets = [node.target]; value = node.value
        for t in targets:
            if isinstance(t, ast.Name) and t.id == "DEFAULT_TEAMS":
                if isinstance(value, ast.Dict):
                    for k in value.keys:
                        if isinstance(k, ast.Constant) and k.value == sys.argv[2]:
                            print("yes"); sys.exit(0)

_iter_default_teams(sys.argv[1])
print("no")
PYEOF
}

_team_code_in_default_teams() {
    # Returns "yes" if team_code already registered for ANY team
    python3 - "${AITEAMFORGE_PATHS_PY}" "${1}" <<'PYEOF'
import sys, ast
src = open(sys.argv[1]).read()
tree = ast.parse(src)
target_code = sys.argv[2].upper()
for node in ast.walk(tree):
    targets = []
    value = None
    if isinstance(node, ast.Assign):
        targets = node.targets; value = node.value
    elif isinstance(node, ast.AnnAssign) and node.value is not None:
        targets = [node.target]; value = node.value
    for t in targets:
        if isinstance(t, ast.Name) and t.id == "DEFAULT_TEAMS":
            if isinstance(value, ast.Dict):
                for val in value.values:
                    if isinstance(val, ast.Dict):
                        for k, v in zip(val.keys, val.values):
                            if isinstance(k, ast.Constant) and k.value == "team_code":
                                if isinstance(v, ast.Constant) and str(v.value).upper() == target_code:
                                    print("yes"); sys.exit(0)
print("no")
PYEOF
}

_port_in_use() {
    local port="$1"
    # Check lcars-ports/ files
    if grep -r "^${port}$" "${LCARS_PORTS_DIR}"/ 2>/dev/null | grep -q .; then
        return 0
    fi
    # Check team-paths.json
    if [[ -f "${TEAM_PATHS_JSON}" ]]; then
        if python3 -c "
import json, sys
d = json.load(open('${TEAM_PATHS_JSON}'))
ports = [str(v.get('lcars_port','')) for v in d.get('teams',{}).values()]
sys.exit(0 if '${port}' in ports else 1)
" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# ── Derive defaults ───────────────────────────────────────────────────────────

_derive_defaults() {
    # TEAM_NAME: uppercase hyphen-separated id
    if [[ -z "$TEAM_NAME" ]]; then
        TEAM_NAME=$(echo "$TEAM_ID" | tr '[:lower:]-' '[:upper:] ' | tr -s ' ')
    fi

    # ORG_NAME: first capital segment of team-id
    if [[ -z "$ORG_NAME" ]]; then
        ORG_NAME=$(echo "$TEAM_ID" | cut -d'-' -f1 | tr '[:lower:]' '[:upper:]')
    fi

    # WORKING_DIR: parent of kanban-dir
    if [[ -z "$WORKING_DIR" ]]; then
        WORKING_DIR="$(dirname "${KANBAN_DIR}")"
    fi

    # ASSET_DIR: derive from team-id prefix segment
    #
    # XACA-0992 (protected subitem 022): lcars-ui/server.py's
    # _resolve_base_team()/_split_team_id() resolve ANY runtime team id to
    # a base-brand slug by splitting on the FIRST hyphen and keeping only
    # that first segment (e.g. 'mainevent-newproject-ios' -> 'mainevent') —
    # unconditionally, with no per-team registration required. That is a
    # hard invariant server.py's image/appicon serving depends on: whatever
    # directory a team's logos/avatars/appicon masters actually live under
    # MUST be exactly that first segment (or the one hardcoded exception,
    # 'dns' -> 'dns-framework', which server.py's serve_image applies on
    # top of the shared resolution and is NOT something new teams get by
    # default here).
    #
    # The default case below used to be `ASSET_DIR="${TEAM_ID}"` — the FULL
    # team id, hyphens and all. For any hyphenated id whose first segment
    # wasn't already special-cased (a brand new 'mainevent-<project>-
    # <platform>' team, or any future org that follows the same
    # <brand>-<project>-<platform> convention), that produced an ASSET_DIR
    # the serving code would NEVER actually look in — server.py always
    # collapses to the first segment regardless of what this script decided
    # to materialize on disk, so a team provisioned under the old default
    # silently 404s (or falls back to APPICON_FALLBACK_TEAM's icons / no
    # logo at all) with no error anywhere pointing at the mismatch.
    # Defaulting to `first_seg` instead makes this script's default agree
    # with server.py's resolution by construction, for every prefix,
    # present or future.
    #
    # XACA-0992 (protected subitem, round-three gate remediation): this case
    # statement previously carried FOUR extra named arms —
    # freelance/legal/medical/finance, each just restating
    # `ASSET_DIR="${first_seg}"` verbatim for its own name (e.g.
    # `legal) ASSET_DIR="legal" ;;`) — which the `*)` default arm already
    # produces for those exact same inputs. They were pure noise: removing
    # them changes no team's resolved ASSET_DIR. `dns` is the ONLY genuine
    # exception in this list — the one case where the resolved value
    # (`dns-framework`) actually differs from `first_seg` (`dns`) — so it's
    # the only prefix that needs (or ever needed) an explicit arm.
    # freelance/legal/medical/finance/mainevent, and any future
    # <brand>-<project>[-<platform>] team, all fall through `*)` unchanged.
    # An operator who genuinely needs a different physical directory can
    # still pass `--asset-dir` explicitly (this default only fires when
    # unset); doing so for a prefix outside the dns-framework exception is
    # almost certainly a mismatch with how server.py will resolve that
    # team's requests, so treat that as a deliberate, documented override,
    # not a routine choice.
    if [[ -z "$ASSET_DIR" ]]; then
        local first_seg="${TEAM_ID%%-*}"
        case "$first_seg" in
            dns)       ASSET_DIR="dns-framework" ;;
            *)         ASSET_DIR="${first_seg}" ;;
        esac
    fi

    # XACA-0992 (protected subitem 022): cheap enforcement of the same
    # invariant for an EXPLICIT `--asset-dir` override too — the default
    # case above can no longer drift from server.py's resolution by
    # construction, but a hand-supplied override bypasses that default
    # entirely and gets no such guarantee. Warn (not a hard fail: an
    # operator may deliberately be pointing at an existing shared brand
    # directory, e.g. a new mainevent-* team explicitly passing
    # `--asset-dir mainevent`, which is exactly the correct override for a
    # prefix this script does not yet special-case) whenever the value
    # will not actually be what server.py's _resolve_base_team()/dns
    # exception resolves this team id to — that mismatch is invisible
    # until someone notices a broken icon/logo, so surface it at creation
    # time instead.
    _asset_dir_first_seg="${TEAM_ID%%-*}"
    _asset_dir_expected="${_asset_dir_first_seg}"
    [[ "$_asset_dir_first_seg" == "dns" ]] && _asset_dir_expected="dns-framework"
    if [[ "$ASSET_DIR" != "$_asset_dir_expected" ]]; then
        echo "WARNING: --asset-dir '${ASSET_DIR}' does not match what lcars-ui/server.py's _resolve_base_team() will resolve team '${TEAM_ID}' to ('${_asset_dir_expected}'). Logo/avatar/appicon serving always uses the RESOLVED value, never this script's ASSET_DIR directly — if '${ASSET_DIR}' is not also '${_asset_dir_expected}' on disk (or a deliberate symlink to it), image serving for this team will silently 404 or fall back to another team's icons. Proceeding with the explicit override as requested." >&2
    fi
    unset _asset_dir_first_seg _asset_dir_expected

    # PORT_BAND_BASE: default based on team-id prefix
    if [[ -z "$PORT_BAND_BASE" ]]; then
        local first_seg="${TEAM_ID%%-*}"
        case "$first_seg" in
            freelance) PORT_BAND_BASE="8500" ;;
            legal)     PORT_BAND_BASE="8320" ;;
            medical)   PORT_BAND_BASE="8340" ;;
            finance)   PORT_BAND_BASE="8360" ;;
            dns)       PORT_BAND_BASE="8180" ;;
            *)         PORT_BAND_BASE="8600" ;;
        esac
    fi
}

