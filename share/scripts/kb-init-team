#!/usr/bin/env bash
# kb-init-team — Initialize a new kanban team across all infrastructure sites.
#
# XACA-0542 subitem 002: Standalone provisioner for new teams.
#
# USAGE
#   kb-init-team [OPTIONS]
#
# OPTIONS
#   --team-id <id>         Team identifier, e.g. freelance-acme-ios (required)
#   --team-code <CODE>     3-letter code, e.g. FAI (required; must be globally unique)
#   --team-name <name>     Display name, e.g. "ACME IOS" (default: uppercase of team-id)
#   --org-name <name>      Organization display name, e.g. "ACME" (default: derived)
#   --org-color <hex>      Hex color for LCARS org badge, e.g. #2ECC71 (default: #888888)
#   --kanban-dir <path>    Absolute path to kanban directory (required)
#   --working-dir <path>   Absolute path to working/project dir (default: parent of kanban-dir)
#   --series <SERIES>      Star Trek series for crew config: ENT|TNG|DS9|TOS|LD|VOY|MED|LEG|FER
#                          (default: ENT)
#   --asset-dir <dir>      Asset dir family name for image serving (default: derived from team-id)
#   --lcars-port <port>    Explicit port number (default: auto-computed via port band)
#   --port-band-base <N>   Port band base for auto-compute (default: 8500 for freelance, else 8600)
#   --port-band-range <N>  Port band size (default: 100)
#   --dry-run              Print all changes without applying any (exit 0)
#   --check-only           Verify team is fully registered; exit 0 if complete, 1 if not
#   --non-interactive      Fail instead of prompting; exit 1 if required inputs missing
#   --help                 Show this help
#
# REGISTRATION SITES (what this tool writes)
#   PRIMARY (must write — registry sources):
#     1. kanban-hooks/aiteamforge_paths.py — DEFAULT_TEAMS entry (the SSoT)
#     2. homebrew-tap/libexec/lib/aiteamforge-paths.sh — _AITEAMFORGE_DEFAULT_TEAMS_DATA row
#     3. lcars-ports/<team-id>-lcars.port — port file
#     4. ~/.aiteamforge/team-paths.json — live runtime overlay
#
#   FALLBACK INSURANCE (hardcoded case statements; must stay mirrored with registry):
#     5.  kanban-helpers.sh _kb_get_team_code() case
#     6.  kanban-helpers.sh _kb_get_team_from_code() case
#     7.  kanban-helpers.sh _kb_get_kanban_dir() case
#     8.  kanban-helpers.sh _kb_team_lcars_port() case
#     9.  claude/statusline-command.sh _get_team_kanban_dir() case
#
#   STATIC MAPS (not derivable from registry):
#     10. lcars-ui/server.py team_dir_map (asset dir for image serving)
#     11. amb-session-map.json (terminal-session → persona entries)
#
#   BOARD + DIRECTORY TREE (provisioning, not registration):
#     12. <kanban-dir>/<team-id>-board.json
#     13. <kanban-dir>/config/ activity/ plans/ knowledge/
#     14. Knowledge INDEX.md files per crew member
#
#   DERIVES AUTOMATICALLY (no explicit insert needed after #1):
#     - kanban_utils._TEAM_CODE_MAP — built from build_team_code_map() at import
#     - server._ITEM_PREFIX_TO_TEAM — built from _build_item_prefix_to_team() at module load
#     - server.get_board_for_item() prefix map — built from _ITEM_PREFIX_TO_TEAM
#     - server.TEAM_KANBAN_DIRS — built from aiteamforge_paths.list_teams() at startup
#     - kanban_utils.TEAM_KANBAN_DIRS — built from DEFAULT_TEAMS at import
#
# IDEMPOTENCY
#   Every write checks if the entry already exists before inserting. Running
#   kb-init-team twice on the same team is safe. --check-only verifies all sites.
#
# TAP MIRROR NOTE
#   aiteamforge_paths.py has a mirror at homebrew-tap/share/kanban-hooks/.
#   kanban_utils.py also has a tap mirror, but it derives from registry so
#   its fallback hardcoded dict only needs updating when the registry import
#   would fail — the tap-side copy updates automatically when sync-tap.sh runs.
#   This script edits the CANONICAL source (dev-team). Run sync-tap.sh (or
#   use kb-edit-shared where applicable) after registering to keep tap aligned.

set -euo pipefail

# ── Locate dev-team root ──────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_TEAM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

AITEAMFORGE_PATHS_PY="${DEV_TEAM_ROOT}/kanban-hooks/aiteamforge_paths.py"
AITEAMFORGE_PATHS_SH="${DEV_TEAM_ROOT}/homebrew-tap/libexec/lib/aiteamforge-paths.sh"
KANBAN_HELPERS="${DEV_TEAM_ROOT}/kanban-helpers.sh"
STATUSLINE_SH="${DEV_TEAM_ROOT}/claude/statusline-command.sh"
SERVER_PY="${DEV_TEAM_ROOT}/lcars-ui/server.py"
AMB_SESSION_MAP="${DEV_TEAM_ROOT}/amb-session-map.json"
LCARS_PORTS_DIR="${DEV_TEAM_ROOT}/lcars-ports"
TEAM_PATHS_JSON="${HOME}/.aiteamforge/team-paths.json"

# ── XACA-0648: Auto-detect dev-source-of-truth vs tap-consumer mode ──────────
#
# FULL mode (sites 1–14):  runs on the dev-source-of-truth machine where the
#   homebrew-tap submodule is checked out alongside the scripts.
#   Signal: "${DEV_TEAM_ROOT}/homebrew-tap/libexec/lib/aiteamforge-paths.sh" exists.
#
# LOCAL-ONLY mode (sites 12–14 only):  runs on a tap-consumer machine where
#   "scripts/kb-init-team" has been installed under $AITEAMFORGE_DIR.  The tap
#   install rewrites "~/dev-team" → "$AITEAMFORGE_DIR", so DEV_TEAM_ROOT becomes
#   something like ~/aiteamforge — but there is no homebrew-tap/ submodule there.
#   Registration sites 1–11 mutate canonical dev-source files that do not exist
#   on a consumer; they are product-managed by the tap formula.  Skipping them
#   is correct: the team is already registered in the shipped DEFAULT_TEAMS.
#
# Computed once here; referenced throughout the file.
if [[ -f "${AITEAMFORGE_PATHS_SH}" ]]; then
    INIT_MODE="full"
else
    INIT_MODE="local-only"
fi

# ── Board-template resolver (XACA-0648) ───────────────────────────────────────
# Returns the path of the first board-template.json candidate that exists, or
# writes an embedded fallback to a tmpfile and returns that path.
# The embedded fallback guarantees board creation never fails even when no
# template file is present on disk.
_resolve_board_template() {
    # Candidate (a): dev-source path (FULL mode machine)
    local _dev="${DEV_TEAM_ROOT}/homebrew-tap/share/templates/kanban/board-template.json"
    if [[ -f "$_dev" ]]; then
        printf '%s' "$_dev"
        return 0
    fi

    # Candidate (b): brew Cellar install path — try `brew --prefix aiteamforge`
    local _brew_prefix=""
    _brew_prefix="$(brew --prefix aiteamforge 2>/dev/null || true)"
    if [[ -n "$_brew_prefix" ]]; then
        local _brew="${_brew_prefix}/libexec/share/templates/kanban/board-template.json"
        if [[ -f "$_brew" ]]; then
            printf '%s' "$_brew"
            return 0
        fi
    fi

    # Candidate (c): relative to DEV_TEAM_ROOT (covers the case where DEV_TEAM_ROOT
    # is the tap-installed AITEAMFORGE_DIR and share/ lives alongside scripts/).
    local _rel="${DEV_TEAM_ROOT}/share/templates/kanban/board-template.json"
    if [[ -f "$_rel" ]]; then
        printf '%s' "$_rel"
        return 0
    fi

    # Embedded fallback: write the minimal board template to a tmpfile so that
    # board creation NEVER fails due to a missing template file.
    # BSD mktemp (macOS) requires X's at the END of the template — a trailing
    # suffix defeats randomization and causes "File exists" on the second call.
    # Honor TMPDIR so the file lands in the correct per-user temp directory.
    local _tmp
    _tmp="$(mktemp "${TMPDIR:-/tmp}/kb-init-team-board-template.XXXXXX")" \
        || { _fail "mktemp failed — cannot create embedded board template in ${TMPDIR:-/tmp}"; return 1; }
    cat > "$_tmp" <<'BOARD_TEMPLATE_HEREDOC'
{
  "team": "{{TEAM_ID}}",
  "teamName": "{{TEAM_NAME}}",
  "subtitle": "{{TEAM_SUBTITLE}}",
  "ship": "{{TEAM_SHIP}}",
  "series": "{{TEAM_SERIES}}",
  "organization": "{{TEAM_ORG}}",
  "orgColor": "{{TEAM_ORG_COLOR}}",
  "kanbanDir": "{{KANBAN_DIR}}",
  "lastUpdated": "{{CREATED_DATE}}",
  "nextId": 1,
  "nextEpicId": 1,
  "nextReleaseId": 1,
  "fleetMonitorUrl": "",
  "terminals": {},
  "activeWindows": [],
  "backlog": [],
  "epics": [],
  "releases": [],
  "releaseConfig": {
    "defaultEnvironments": ["PLANNED", "DEV", "QA", "ALPHA", "BETA", "GAMMA", "PROD"],
    "platforms": {
      "ios": {"name": "iOS", "store": "App Store", "icon": "apple"},
      "android": {"name": "Android", "store": "Play Store", "icon": "android"},
      "firebase": {"name": "Firebase", "store": null, "icon": "database"},
      "web": {"name": "Web", "store": null, "icon": "globe"},
      "other": {"name": "Other", "store": null, "icon": "ellipsis-h"}
    },
    "releaseTypes": {
      "feature": {"name": "Feature Release", "description": "New features", "color": "#4a90d9"},
      "bugfix": {"name": "Bug Fix Release", "description": "Bug fixes", "color": "#f5a623"},
      "hotfix": {"name": "Hotfix", "description": "Critical fixes", "color": "#d0021b"},
      "maintenance": {"name": "Maintenance", "description": "Technical updates", "color": "#7ed321"}
    },
    "flowConfig": {
      "stages": {
        "PLANNED": {"enabled": true, "required": true},
        "DEV": {"enabled": true, "required": true},
        "QA": {"enabled": true, "required": false},
        "ALPHA": {"enabled": true, "required": false},
        "BETA": {"enabled": true, "required": false},
        "GAMMA": {"enabled": true, "required": false},
        "PROD": {"enabled": true, "required": true}
      }
    }
  }
}
BOARD_TEMPLATE_HEREDOC
    printf '%s' "$_tmp"
}

# ── Colour helpers ────────────────────────────────────────────────────────────

RED='\033[0;31m'; YELLOW='\033[0;33m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; NC='\033[0m'
_ok()   { echo -e "${GREEN}  [OK]${NC} $*"; }
_skip() { echo -e "${CYAN}[SKIP]${NC} $* (already registered)"; }
_info() { echo -e "       $*"; }
_warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }
_fail() { echo -e "${RED}[FAIL]${NC} $*" >&2; }
_dry()  { echo -e "${CYAN} [DRY]${NC} $*"; }

# ── Argument parsing ──────────────────────────────────────────────────────────

TEAM_ID=""
TEAM_CODE=""
TEAM_NAME=""
ORG_NAME=""
ORG_COLOR="#888888"
KANBAN_DIR=""
WORKING_DIR=""
SERIES="ENT"
ASSET_DIR=""
LCARS_PORT=""
PORT_BAND_BASE=""
PORT_BAND_RANGE="100"
DRY_RUN=0
CHECK_ONLY=0
NON_INTERACTIVE=0

usage() {
    head -60 "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "${1-}" in
        --team-id)          TEAM_ID="${2:?--team-id requires a value}";      shift 2 ;;
        --team-code)        TEAM_CODE="${2:?--team-code requires a value}";  shift 2 ;;
        --team-name)        TEAM_NAME="${2:?--team-name requires a value}";  shift 2 ;;
        --org-name)         ORG_NAME="${2:?--org-name requires a value}";    shift 2 ;;
        --org-color)        ORG_COLOR="${2:?--org-color requires a value}";  shift 2 ;;
        --kanban-dir)       KANBAN_DIR="${2:?--kanban-dir requires a value}"; shift 2 ;;
        --working-dir)      WORKING_DIR="${2:?--working-dir requires a value}"; shift 2 ;;
        --series)           SERIES="${2:?--series requires a value}";        shift 2 ;;
        --asset-dir)        ASSET_DIR="${2:?--asset-dir requires a value}";  shift 2 ;;
        --lcars-port)       LCARS_PORT="${2:?--lcars-port requires a value}"; shift 2 ;;
        --port-band-base)   PORT_BAND_BASE="${2:?--port-band-base requires a value}"; shift 2 ;;
        --port-band-range)  PORT_BAND_RANGE="${2:?--port-band-range requires a value}"; shift 2 ;;
        --dry-run)          DRY_RUN=1;          shift ;;
        --check-only)       CHECK_ONLY=1;       shift ;;
        --non-interactive)  NON_INTERACTIVE=1;  shift ;;
        --help|-h)          usage ;;
        *) _fail "Unknown option: ${1}"; exit 1 ;;
    esac
done

# ── Interactive prompts (when --non-interactive is NOT set) ───────────────────

_prompt() {
    local var_name="$1" prompt_text="$2" default="${3-}"
    local current
    current="${!var_name}"
    if [[ -n "$current" ]]; then return 0; fi
    if [[ "$NON_INTERACTIVE" -eq 1 ]]; then
        if [[ -n "$default" ]]; then
            printf -v "$var_name" '%s' "$default"
        else
            _fail "--non-interactive set but required param ${var_name} is missing"
            exit 1
        fi
    else
        local response
        if [[ -n "$default" ]]; then
            read -r -p "  ${prompt_text} [${default}]: " response
            printf -v "$var_name" '%s' "${response:-$default}"
        else
            read -r -p "  ${prompt_text}: " response
            if [[ -z "$response" ]]; then
                _fail "${var_name} is required"
                exit 1
            fi
            printf -v "$var_name" '%s' "$response"
        fi
    fi
}

# ── Validation helpers ────────────────────────────────────────────────────────

_team_in_default_teams() {
    python3 - "${AITEAMFORGE_PATHS_PY}" "${1}" <<'PYEOF'
import sys, ast

def _iter_default_teams(path):
    """Yield (key_constant, value_dict) for DEFAULT_TEAMS. Handles Assign and AnnAssign."""
    src = open(path).read()
    tree = ast.parse(src)
    for node in ast.walk(tree):
        targets = []
        value = None
        if isinstance(node, ast.Assign):
            targets = node.targets; value = node.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            targets = [node.target]; value = node.value
        for t in targets:
            if isinstance(t, ast.Name) and t.id == "DEFAULT_TEAMS":
                if isinstance(value, ast.Dict):
                    for k in value.keys:
                        if isinstance(k, ast.Constant) and k.value == sys.argv[2]:
                            print("yes"); sys.exit(0)

_iter_default_teams(sys.argv[1])
print("no")
PYEOF
}

_team_code_in_default_teams() {
    # Returns "yes" if team_code already registered for ANY team
    python3 - "${AITEAMFORGE_PATHS_PY}" "${1}" <<'PYEOF'
import sys, ast
src = open(sys.argv[1]).read()
tree = ast.parse(src)
target_code = sys.argv[2].upper()
for node in ast.walk(tree):
    targets = []
    value = None
    if isinstance(node, ast.Assign):
        targets = node.targets; value = node.value
    elif isinstance(node, ast.AnnAssign) and node.value is not None:
        targets = [node.target]; value = node.value
    for t in targets:
        if isinstance(t, ast.Name) and t.id == "DEFAULT_TEAMS":
            if isinstance(value, ast.Dict):
                for val in value.values:
                    if isinstance(val, ast.Dict):
                        for k, v in zip(val.keys, val.values):
                            if isinstance(k, ast.Constant) and k.value == "team_code":
                                if isinstance(v, ast.Constant) and str(v.value).upper() == target_code:
                                    print("yes"); sys.exit(0)
print("no")
PYEOF
}

_port_in_use() {
    local port="$1"
    # Check lcars-ports/ files
    if grep -r "^${port}$" "${LCARS_PORTS_DIR}"/ 2>/dev/null | grep -q .; then
        return 0
    fi
    # Check team-paths.json
    if [[ -f "${TEAM_PATHS_JSON}" ]]; then
        if python3 -c "
import json, sys
d = json.load(open('${TEAM_PATHS_JSON}'))
ports = [str(v.get('lcars_port','')) for v in d.get('teams',{}).values()]
sys.exit(0 if '${port}' in ports else 1)
" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# ── Derive defaults ───────────────────────────────────────────────────────────

_derive_defaults() {
    # TEAM_NAME: uppercase hyphen-separated id
    if [[ -z "$TEAM_NAME" ]]; then
        TEAM_NAME=$(echo "$TEAM_ID" | tr '[:lower:]-' '[:upper:] ' | tr -s ' ')
    fi

    # ORG_NAME: first capital segment of team-id
    if [[ -z "$ORG_NAME" ]]; then
        ORG_NAME=$(echo "$TEAM_ID" | cut -d'-' -f1 | tr '[:lower:]' '[:upper:]')
    fi

    # WORKING_DIR: parent of kanban-dir
    if [[ -z "$WORKING_DIR" ]]; then
        WORKING_DIR="$(dirname "${KANBAN_DIR}")"
    fi

    # ASSET_DIR: derive from team-id prefix segment
    if [[ -z "$ASSET_DIR" ]]; then
        local first_seg="${TEAM_ID%%-*}"
        case "$first_seg" in
            freelance) ASSET_DIR="freelance" ;;
            legal)     ASSET_DIR="legal" ;;
            medical)   ASSET_DIR="medical" ;;
            finance)   ASSET_DIR="finance" ;;
            dns)       ASSET_DIR="dns-framework" ;;
            *)         ASSET_DIR="${TEAM_ID}" ;;
        esac
    fi

    # PORT_BAND_BASE: default based on team-id prefix
    if [[ -z "$PORT_BAND_BASE" ]]; then
        local first_seg="${TEAM_ID%%-*}"
        case "$first_seg" in
            freelance) PORT_BAND_BASE="8500" ;;
            legal)     PORT_BAND_BASE="8320" ;;
            medical)   PORT_BAND_BASE="8340" ;;
            finance)   PORT_BAND_BASE="8360" ;;
            dns)       PORT_BAND_BASE="8180" ;;
            *)         PORT_BAND_BASE="8600" ;;
        esac
    fi
}

