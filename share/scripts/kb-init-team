        LD)  echo "STAR TREK: LOWER DECKS" ;;
        VOY) echo "STAR TREK: VOYAGER" ;;
        MED) echo "HOUSE, M.D." ;;
        LEG) echo "THE PRACTICE" ;;
        FER) echo "STAR TREK: FERENGI ALLIANCE" ;;
