    t19_ok=false
    _err "[selftest] Test 19: JSON worktrees array did not contain drifted main-root entry for '$t19_main_root_label'; json=$t19_json_out"
  fi

  MANIFEST="$_saved_manifest_19"
  MASTER_ROOT="$_saved_master_root_19"
  MASTER_RELATIVE="$_saved_master_relative_19"

  git -C "$t19_inner" worktree remove --force "$t19_wt" >/dev/null 2>&1 || true
  rm -rf "$tmp19"

  if [ "$t19_ok" = true ]; then
    _info "[selftest] PASS: Test 19 (check detects main-root drift: status=$t19_has_drift_entry)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 19 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 20: list counts the main root in [wt:N/M] ---
  # After syncing a container-layout team with a nested main root, the 'list'
  # subcommand's [wt:synced/total] annotation must count the main root in the total
  # (and as synced when it is deployed). Fixture: same shape as Test 16.
  _info "[selftest] Test 20: list counts the nested main root in [wt:N/M]..."

  local tmp20
  tmp20=$(mktemp -d)
  local t20_container="${tmp20}/FakeContainer20"
  local t20_inner="${t20_container}/inner-dev"
  local t20_wt="${t20_container}/worktrees/feature-t20"
  mkdir -p "$t20_inner"
  git -C "$t20_inner" init -q
  git -C "$t20_inner" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1
  git -C "$t20_inner" worktree add "$t20_wt" -b "feature-selftest-t20" >/dev/null 2>&1

