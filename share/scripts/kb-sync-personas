  local t19_main_agents="${t19_inner}/.claude/agents"
  local t19_drifted_file
  t19_drifted_file=$(find "$t19_main_agents" -maxdepth 1 -name 'persona-s.md' 2>/dev/null | head -1)
  if [ -n "$t19_drifted_file" ]; then
    rm "$t19_drifted_file"
  fi

  # check must exit non-zero (drift detected) and the JSON must show the main root entry
  local t19_check_exit=0
  local t19_json_out
  t19_json_out=$(_kbsp_check t19-team --json 2>&1) || t19_check_exit=$?

  local t19_ok=true

  # check must report drift (exit non-zero)
  if [ "$t19_check_exit" -eq 0 ]; then
    t19_ok=false
