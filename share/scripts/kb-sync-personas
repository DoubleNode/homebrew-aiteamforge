  t17_wt_count=$(find "${t17_wt}/.claude/agents" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
  if [ "$t17_wt_count" -ne "$t17_canonical_count" ]; then
    t17_ok=false
    _err "[selftest] Test 17: linked-worktree persona count — got $t17_wt_count, expected $t17_canonical_count"
  fi

  # Assert: markers written to BOTH targets
  if [ ! -f "${t17_inner}/.claude/agents/.synced-from-master" ]; then
    t17_ok=false
    _err "[selftest] Test 17: .synced-from-master marker missing from nested main root"
  fi
  if [ ! -f "${t17_wt}/.claude/agents/.synced-from-master" ]; then
    t17_ok=false
    _err "[selftest] Test 17: .synced-from-master marker missing from linked worktree"
  fi

