      "exists": true,
      "groups": ["t20-team"]
    }
  ]
}
T20_MANIFEST

  local _saved_manifest_20="$MANIFEST"
  local _saved_master_root_20="$MASTER_ROOT"
  local _saved_master_relative_20="$MASTER_RELATIVE"
  MANIFEST="$t20_manifest"
  MASTER_ROOT="$t20_master_root"
  MASTER_RELATIVE="fake-master20"

  local t20_ok=true

  # First assert WITHOUT deploy: list must show wt:0/2 (1 linked wt + 1 main root = 2 total)
  local t20_list_before
  t20_list_before=$(_kbsp_list 2>&1 | grep "t20-team") || t20_list_before=""
  local t20_total_before
  t20_total_before=$(printf '%s' "$t20_list_before" | grep -oE '\[wt:[0-9]+/[0-9]+\]' | grep -oE '/[0-9]+' | tr -d '/' | head -1) || t20_total_before=""
  if [ "$t20_total_before" != "2" ]; then
    t20_ok=false
    _err "[selftest] Test 20: before deploy, list should show wt:0/2 — got '$t20_list_before'"
  fi

  # Deploy and re-check: should be wt:2/2
  _kbsp_sync_worktrees t20-team >/dev/null 2>&1 || true

  local t20_list_after
  t20_list_after=$(_kbsp_list 2>&1 | grep "t20-team") || t20_list_after=""
  local t20_synced_after t20_total_after
  t20_synced_after=$(printf '%s' "$t20_list_after" | grep -oE '\[wt:[0-9]+/[0-9]+\]' | grep -oE 'wt:[0-9]+' | grep -oE '[0-9]+' | head -1) || t20_synced_after=""
  t20_total_after=$(printf '%s' "$t20_list_after" | grep -oE '\[wt:[0-9]+/[0-9]+\]' | grep -oE '/[0-9]+' | tr -d '/' | head -1) || t20_total_after=""
  if [ "$t20_synced_after" != "2" ] || [ "$t20_total_after" != "2" ]; then
    t20_ok=false
    _err "[selftest] Test 20: after deploy, list should show [wt:2/2] — got '$t20_list_after'"
  fi

  MANIFEST="$_saved_manifest_20"
  MASTER_ROOT="$_saved_master_root_20"
  MASTER_RELATIVE="$_saved_master_relative_20"

  git -C "$t20_inner" worktree remove --force "$t20_wt" >/dev/null 2>&1 || true
  rm -rf "$tmp20"

  if [ "$t20_ok" = true ]; then
    _info "[selftest] PASS: Test 20 (list [wt:N/M]: before=wt:0/$t20_total_before, after=wt:$t20_synced_after/$t20_total_after)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 20 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 21: XACA-1261 consumer-mode targetRepo/hosted-here resolution ---
  # Synthetic fixture exercising _resolve_target_repo_for_team + _is_hosted_here
  # via the real _kbsp_list subcommand (plus direct function calls for the cases
  # a list row can't observe), following Test 14/19/20's "swap script globals,
  # invoke the real subcommand, restore" pattern rather than inventing a new
  # mocking mechanism.
  #
  # Manifest rows / synthetic team-paths.json entries:
  #   t21-hosted           — team-paths working_dir IS a real git repo (Case 1
  #                          of _resolve_git_roots) -> must APPEAR, with TARGET
  #                          REPO resolved from the REGISTRY, never from the
  #                          manifest's own (deliberately bogus) targetRepo.
  #   t21-unhosted         — HAS a team-paths.json entry, but that working_dir
  #                          is a plain directory with no git checkout inside
  #                          it -> must be OMITTED (registered-but-not-really-
  #                          hosted, the academy-on-a-non-academy-consumer
  #                          shape).
  #   t21-unregistered     — no team-paths.json entry at all -> must be
  #                          OMITTED.
  #   t21-dns (21e)        — the DNS shape (code-review blocking finding): a
  #                          non-git CONTAINER whose registry working_dir AND
  #                          manifest targetRepo are the SAME container path,
  #                          which ALSO has a child directory that is its own
  #                          real git checkout (Case 2 of _resolve_git_roots
  #                          finds it, so the team is hosted). Rule 1 (manifest
  #                          targetRepo exists on this machine -> use it) must
  #                          win and resolve to the CONTAINER, never to the
  #                          child git root — pinning the fix for the exact
  #                          "DNS has multiple inner git roots" blocking finding
  #                          (a first-root-wins scan could not tell this case
  #                          apart from t21-freelance-pending below; this
  #                          resolver never scans roots at all).
  #   t21-freelance-pending (21f) — the freelance-pre-#918 shape: registry
  #                          working_dir is a non-git container with a real
  #                          child git checkout (identical STRUCTURAL shape to
  #                          t21-dns), but the manifest's targetRepo is a
  #                          dev-machine-local path that does NOT exist on this
  #                          machine (rule 1 misses). Rule 2 must fall back to
  #                          the registry's working_dir (the container) — the
  #                          documented, expected interim answer pending
  #                          XACA-1260/PR #918 — never inferring the child
  #                          work-tree via any root scan.
  #   t21-neither (21g)    — NEITHER the manifest targetRepo NOR the registry
  #                          working_dir exists on this machine -> the resolver
  #                          must return empty (asserted via a DIRECT call,
  #                          since a list row can't distinguish "resolver
  #                          returned empty" from "never reached the resolver")
  #                          AND the team must be OMITTED from list (consistent
  #                          with _is_hosted_here also being false here, so
  #                          this is the ordinary not-hosted path, not the
  #                          disagreement-guard path).
  #
  # 21d is the negative control the spec requires: re-run the IDENTICAL manifest
  # + registry fixture under KBSP_MODE=dev (the pre-fix resolution path — targetRepo
  # read straight off the manifest, no hosted-here filter). It must fail to
  # produce a correct result — t21-hosted resolves to the manifest's deliberately
  # bogus dev-only path (not the registry's real git dir), and the two rows that
  # consumer mode omits are NOT filtered at all — proving this test actually
  # exercises the fix rather than passing vacuously either way.
  _info "[selftest] Test 21: consumer-mode targetRepo/hosted-here resolution..."

  local tmp21
  tmp21=$(mktemp -d)

  # t21-hosted: working_dir IS the git repo itself (matches Case 1 in
  # _resolve_git_roots, same shape Test 12 already relies on).
  local t21_hosted_repo="${tmp21}/HostedRepo"
  mkdir -p "$t21_hosted_repo"
  git -C "$t21_hosted_repo" init -q
  git -C "$t21_hosted_repo" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  # t21-unhosted: registered, but no git checkout lives here at all.
  local t21_unhosted_dir="${tmp21}/UnhostedDir"
  mkdir -p "$t21_unhosted_dir/kanban"

  # t21-dns (21e): non-git container whose working_dir/targetRepo IS the
  # container, with a child git checkout present (DNS's real multi-sub-repo
  # shape — DNSProtocols/, DNSCore/, etc, each its own .git). Only one child
  # repo is needed to prove the point: rule 1 must never even look at it.
  local t21_dns_container="${tmp21}/DnsContainer"
  local t21_dns_child="${t21_dns_container}/DNSProtocols"
  mkdir -p "$t21_dns_child"
  git -C "$t21_dns_child" init -q
  git -C "$t21_dns_child" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  # t21-freelance-pending (21f): STRUCTURALLY IDENTICAL to t21-dns (non-git
  # container + one child git checkout) but the manifest targetRepo will be
  # bogus (simulating a pre-XACA-1260/#918 dev-only value) — so rule 2's
  # container fallback is what must fire here, in contrast to t21-dns where
  # rule 1 fires. Same shape, different manifest data, opposite rule taken;
  # that is exactly the pair the blocking finding said no scan could tell apart.
  local t21_fl_container="${tmp21}/FreelanceContainer"
  local t21_fl_child="${t21_fl_container}/develop"
  mkdir -p "$t21_fl_child"
  git -C "$t21_fl_child" init -q
  git -C "$t21_fl_child" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  # t21-neither (21g): registered, but BOTH the registry working_dir and the
  # manifest targetRepo point at paths that do not exist on this machine at
  # all — no directories created for either. _is_hosted_here must also be
  # false here (same working_dir feeds both), so this exercises the ordinary
  # "not hosted" path, not the disagreement guard.
  local t21_neither_working_dir="${tmp21}/does-not-exist-workingdir"
  local t21_neither_manifest_repo="${tmp21}/does-not-exist-manifest-targetrepo"

  # t21-outside (PR #917 round-2 blocking finding): registry working_dir IS a
  # real git checkout (so _is_hosted_here says hosted), while the manifest names
  # a DIFFERENT, existing, non-git directory outside it. Must NOT be used.
  local t21_outside="${tmp21}/OutsideStaleDir"
  mkdir -p "$t21_outside"

  local t21_team_paths="${tmp21}/team-paths21.json"
  cat > "$t21_team_paths" <<T21_TEAM_PATHS
{
  "schema_version": 3,
  "teams": {
    "t21-hosted": { "working_dir": "${t21_hosted_repo}" },
    "t21-unhosted": { "working_dir": "${t21_unhosted_dir}" },
    "t21-dns": { "working_dir": "${t21_dns_container}" },
    "t21-freelance-pending": { "working_dir": "${t21_fl_container}" },
    "t21-neither": { "working_dir": "${t21_neither_working_dir}" },
    "t21-outside": { "working_dir": "${t21_hosted_repo}" }
  }
}
T21_TEAM_PATHS

  local t21_manifest="${tmp21}/manifest21.json"
  cat > "$t21_manifest" <<T21_MANIFEST
{
  "schemaVersion": "1",
  "masterRoot": "fake-master21",
  "deployments": [
    {
      "team": "t21-hosted",
      "targetRepo": "${tmp21}/dev-only-bogus-path-hosted",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-unhosted",
      "targetRepo": "${tmp21}/dev-only-bogus-path-unhosted",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-dns",
      "targetRepo": "${t21_dns_container}",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-freelance-pending",
      "targetRepo": "${tmp21}/dev-only-bogus-path-freelance-pending",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-outside",
      "targetRepo": "${tmp21}/OutsideStaleDir",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-neither",
      "targetRepo": "${t21_neither_manifest_repo}",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    },
    {
      "team": "t21-unregistered",
      "targetRepo": "${tmp21}/dev-only-bogus-path-unregistered",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t21-group"]
    }
  ]
}
T21_MANIFEST

  local _saved_manifest_21="$MANIFEST"
  local _saved_team_paths_json_21="$TEAM_PATHS_JSON"
  local _saved_kbsp_mode_21="$KBSP_MODE"
  MANIFEST="$t21_manifest"
  TEAM_PATHS_JSON="$t21_team_paths"

  # --- 21a/b/c: consumer mode ---
  KBSP_MODE="consumer"
  local t21_consumer_out
  t21_consumer_out=$(_kbsp_list 2>&1)

  local t21_ok=true

  local t21_hosted_line
  t21_hosted_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-hosted[[:space:]]') || t21_hosted_line=""
  if [ -z "$t21_hosted_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21a: t21-hosted row missing from consumer-mode list; output=$t21_consumer_out"
  elif [[ "$t21_hosted_line" != *"$t21_hosted_repo"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21a: t21-hosted row did not resolve TARGET REPO from the registry ($t21_hosted_repo); got: $t21_hosted_line"
  elif [[ "$t21_hosted_line" == *"dev-only-bogus-path"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21a: t21-hosted row used the manifest's own targetRepo instead of the registry; got: $t21_hosted_line"
  fi

  local t21_unhosted_line
  t21_unhosted_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-unhosted[[:space:]]') || t21_unhosted_line=""
  if [ -n "$t21_unhosted_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21b: t21-unhosted row should be OMITTED (registered but no git checkout) — got: $t21_unhosted_line"
  fi

  local t21_unregistered_line
  t21_unregistered_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-unregistered[[:space:]]') || t21_unregistered_line=""
  if [ -n "$t21_unregistered_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21c: t21-unregistered row should be OMITTED (no team-paths.json entry) — got: $t21_unregistered_line"
  fi

  # 21e (XACA-1261 blocking finding — DNS shape): manifest targetRepo IS the
  # container and must be used AS-IS, even though a child git root also
  # exists. This is the exact case a first-root-wins scan could not have
  # gotten right for DNS's real multi-sub-repo layout.
  local t21_dns_line
  t21_dns_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-dns[[:space:]]') || t21_dns_line=""
  if [ -z "$t21_dns_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21e: t21-dns row missing — a container with a child git root must still be hosted; output=$t21_consumer_out"
  elif [[ "$t21_dns_line" != *"$t21_dns_container"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21e: t21-dns did not resolve TARGET REPO to the container ($t21_dns_container) via rule 1; got: $t21_dns_line"
  elif [[ "$t21_dns_line" == *"$t21_dns_child"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21e: t21-dns resolved to the child git root ($t21_dns_child) instead of the manifest's own targetRepo (the container) — rule 1 must win over any root inference; got: $t21_dns_line"
  fi

  # 21f (XACA-1261): STRUCTURALLY IDENTICAL to t21-dns (container + one child
  # git root), but the manifest targetRepo is bogus here -> rule 2 must fall
  # back to the container (the documented pending-#918 interim answer), never
  # to the child work-tree.
  local t21_fl_line
  t21_fl_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-freelance-pending[[:space:]]') || t21_fl_line=""
  if [ -z "$t21_fl_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21f: t21-freelance-pending row missing — a container with a child git root must still be hosted; output=$t21_consumer_out"
  elif [[ "$t21_fl_line" != *"$t21_fl_container"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21f: t21-freelance-pending did not fall back to the registry's working_dir ($t21_fl_container); got: $t21_fl_line"
  elif [[ "$t21_fl_line" == *"$t21_fl_child"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21f: t21-freelance-pending resolved to the child work-tree ($t21_fl_child) instead of the container fallback — that is the OLD (rejected) root-inference behavior; got: $t21_fl_line"
  elif [[ "$t21_fl_line" == *"dev-only-bogus-path"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21f: t21-freelance-pending used the bogus manifest targetRepo instead of falling back; got: $t21_fl_line"
  fi

  # 21g (XACA-1261): neither the manifest targetRepo nor the registry
  # working_dir exists on this machine. Asserted via a DIRECT call to
  # _resolve_target_repo_for_team (a list row can't distinguish "resolver
  # returned empty" from "never reached the resolver" — _is_hosted_here
  # already omits this team from the list for the same underlying reason).
  local t21_neither_idx
  t21_neither_idx=$(_deploy_index_by_team "t21-neither")
  local t21_neither_direct
  t21_neither_direct=$(_resolve_target_repo_for_team "$t21_neither_idx" "t21-neither" 2>/dev/null)
  if [ -n "$t21_neither_direct" ]; then
    t21_ok=false
    _err "[selftest] Test 21g: _resolve_target_repo_for_team should return empty when neither manifest targetRepo nor registry working_dir exist — got: '$t21_neither_direct'"
  fi

  local t21_neither_line
  t21_neither_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-neither[[:space:]]') || t21_neither_line=""
  if [ -n "$t21_neither_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21g: t21-neither row should be OMITTED from list (not hosted here) — got: $t21_neither_line"
  fi

  # 21h: manifest targetRepo that EXISTS but lies OUTSIDE the registry's
  # working_dir must be refused and fall back to the registry path. Reproduces
  # the reviewer's live case: validated one path, would have written another.
  local t21_outside_line
  t21_outside_line=$(printf '%s\n' "$t21_consumer_out" | grep -E '^t21-outside[[:space:]]') || t21_outside_line=""
  if [ -z "$t21_outside_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21h: t21-outside row missing; expected a row resolved to the REGISTRY path. output=$t21_consumer_out"
  elif [[ "$t21_outside_line" == *"OutsideStaleDir"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21h: manifest targetRepo OUTSIDE the registry working_dir was silently used as the deploy target -- validated one path, would write another; got: $t21_outside_line"
  elif [[ "$t21_outside_line" != *"$t21_hosted_repo"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21h: expected fallback to the registry working_dir ($t21_hosted_repo); got: $t21_outside_line"
  fi

  # --- 21d: negative control — same fixture, pre-fix (dev-mode) resolution path ---
  KBSP_MODE="dev"
  local t21_dev_out
  t21_dev_out=$(_kbsp_list 2>&1)

  local t21_dev_hosted_line
  t21_dev_hosted_line=$(printf '%s\n' "$t21_dev_out" | grep -E '^t21-hosted[[:space:]]') || t21_dev_hosted_line=""
  if [ -z "$t21_dev_hosted_line" ] || [[ "$t21_dev_hosted_line" != *"dev-only-bogus-path-hosted"* ]]; then
    t21_ok=false
    _err "[selftest] Test 21d: negative control did not behave like the pre-fix path (expected t21-hosted to show the manifest's bogus dev-only targetRepo under KBSP_MODE=dev) — got: $t21_dev_hosted_line"
  fi
  local t21_dev_unhosted_line
  t21_dev_unhosted_line=$(printf '%s\n' "$t21_dev_out" | grep -E '^t21-unhosted[[:space:]]') || t21_dev_unhosted_line=""
  if [ -z "$t21_dev_unhosted_line" ]; then
    t21_ok=false
    _err "[selftest] Test 21d: negative control expected t21-unhosted to be UNFILTERED under KBSP_MODE=dev (dev mode applies no hosted-here filter) — it was absent instead"
  fi

  MANIFEST="$_saved_manifest_21"
  TEAM_PATHS_JSON="$_saved_team_paths_json_21"
  KBSP_MODE="$_saved_kbsp_mode_21"

  rm -rf "$tmp21"

  if [ "$t21_ok" = true ]; then
    _info "[selftest] PASS: Test 21 (consumer mode: hosted row resolved from registry; unhosted + unregistered omitted; DNS-shape manifest priority + freelance-pending container fallback + neither-resolves empty all pinned; negative control confirms the fix is load-bearing)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 21 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 22: XACA-1261 Finding 3 — consumer-shape MASTER_ROOT guard ---
  # CRITICAL, and structurally different from every test above: this is the
  # ONE case that must NOT be exercised only on the dev machine. Every other
  # test in this suite calls this script's FUNCTIONS in-process, inheriting
  # the REAL dev machine's MASTER_ROOT (which genuinely exists here) — so a
  # defect in the main-dispatch preamble (bare top-level code, not a function
  # this suite can call directly, that runs unconditionally before ANY
  # subcommand) is invisible to all of them. That is exactly how the original
  # unconditional "MASTER_ROOT must exist" guard shipped killing list, check,
  # diff, --help, and even selftest itself on every real consumer while this
  # very selftest suite stayed green on the dev machine.
  #
  # Build an actual consumer-SHAPED sandbox on disk and exec a real COPY of
  # this script as a genuine subprocess against it — no in-process global
  # overrides can reach the preamble, so this is the only way to prove it.
  # DEV_TEAM is derived from the script's OWN location (one directory above
  # SCRIPT_DIR): a copy dropped directly under /tmp resolves DEV_TEAM=/tmp and
  # dies on a missing manifest before ever reaching the guard under test — the
  # sandbox therefore mirrors the real "<root>/scripts/<script>" layout.
  _info "[selftest] Test 22: consumer-shape MASTER_ROOT guard (XACA-1261 Finding 3)..."

  local tmp22 t22_ok=true
  tmp22=$(mktemp -d)
  mkdir -p "${tmp22}/scripts" "${tmp22}/.claude" "${tmp22}/t22-team/personas/agents"
  cp "${BASH_SOURCE[0]}" "${tmp22}/scripts/kb-sync-personas"
  chmod +x "${tmp22}/scripts/kb-sync-personas"
  echo "# fake persona" > "${tmp22}/t22-team/personas/agents/fake.md"

  # t22-team's working_dir/targetRepo doubles as a real git checkout, purely
  # so _is_hosted_here (unchanged by this fix) reports it hosted and the row
  # actually appears in `list` output — proving the preamble fix, not merely
  # that a broken/omitted row happens not to crash.
  git -C "${tmp22}/t22-team" init -q
  git -C "${tmp22}/t22-team" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  cat > "${tmp22}/.claude/personas-manifest.json" <<T22_MANIFEST
{
  "schemaVersion": "1",
  "masterRoot": ".claude/agents-master",
  "deployments": [
    {
      "team": "t22-team",
      "targetRepo": "${tmp22}/t22-team",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t22-team"]
    }
  ]
}
T22_MANIFEST

  local t22_team_paths="${tmp22}/team-paths22.json"
  cat > "$t22_team_paths" <<T22_TEAM_PATHS
{
  "schema_version": 3,
  "teams": {
    "t22-team": { "working_dir": "${tmp22}/t22-team" }
  }
}
T22_TEAM_PATHS

  # Deliberately NO ${tmp22}/.claude/agents-master — THIS is the consumer
  # shape (agents-master/ is never mirrored). KBSP_MODE is left UNSET so the
  # subprocess's own top-of-file auto-detection runs for real, exactly as it
  # would on an actual consumer machine.
  # NOTE (set -euo pipefail is active for this whole script): a bare
  # `out=$(cmd)` where cmd fails would abort the ENTIRE selftest run right
  # here under errexit — exactly the failure mode this test exists to catch,
  # so it must survive a failing subprocess to report it. `|| rc=$?` after an
  # rc pre-initialized to 0 is the safe idiom already used elsewhere in this
  # suite (see t14a_out's `|| t14a_ok=false`) — the assignment inside `||`
  # itself always succeeds, so errexit never fires on either branch.
  local t22_list_out t22_list_rc=0 t22_help_out t22_help_rc=0
  t22_list_out=$(TEAM_PATHS_JSON="$t22_team_paths" "${tmp22}/scripts/kb-sync-personas" list 2>&1) || t22_list_rc=$?
  t22_help_out=$(TEAM_PATHS_JSON="$t22_team_paths" "${tmp22}/scripts/kb-sync-personas" --help 2>&1) || t22_help_rc=$?

  if [ "$t22_list_rc" -ne 0 ]; then
    t22_ok=false
    _err "[selftest] Test 22a: 'list' should exit 0 in the consumer shape (no agents-master/) — exit=$t22_list_rc, output=$t22_list_out"
  elif [[ "$t22_list_out" == *"Master root not found"* ]]; then
    t22_ok=false
    _err "[selftest] Test 22a: 'list' hit the dev-mode MASTER_ROOT guard in the consumer shape — output=$t22_list_out"
  elif [[ "$t22_list_out" != *"t22-team"* ]]; then
    t22_ok=false
    _err "[selftest] Test 22a: 'list' ran but did not show the hosted t22-team row — output=$t22_list_out"
  fi

  if [ "$t22_help_rc" -ne 0 ]; then
    t22_ok=false
    _err "[selftest] Test 22b: '--help' should exit 0 in the consumer shape — exit=$t22_help_rc, output=$t22_help_out"
  elif [[ "$t22_help_out" == *"Master root not found"* ]]; then
    t22_ok=false
    _err "[selftest] Test 22b: '--help' hit the dev-mode MASTER_ROOT guard in the consumer shape — output=$t22_help_out"
  fi

  rm -rf "$tmp22"

  if [ "$t22_ok" = true ]; then
    _info "[selftest] PASS: Test 22 (consumer shape subprocess: list + --help both run and exit 0 without agents-master/ present)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 22 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 23: XACA-1261-021 — sync-worktrees under consumer mode ---
  # Round-3 verification had to hand-build this fixture because no selftest
  # covered _kbsp_sync_worktrees in consumer mode. The risk it guards is a
  # SILENT NO-OP: the consumer-mode _is_hosted_here filter is an early
  # `continue`, so a mis-scoped filter would skip a team that should deploy
  # while still exiting 0 — exactly the "delivered but does nothing" shape this
  # whole ticket exists to remove. Asserts a hosted team IS processed and an
  # unhosted team is omitted, in one dry-run pass.
  _info "[selftest] Test 23: sync-worktrees consumer-mode hosted/unhosted handling..."
  local t23 t23_ok=true
  t23=$(mktemp -d)

  # Hosted: container holding a real inner git repo (container-layout shape).
  local t23_container="${t23}/HostedContainer"
  local t23_inner="${t23_container}/develop"
  mkdir -p "$t23_inner"
  git -C "$t23_inner" init -q
  git -C "$t23_inner" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  # Unhosted: registered, but no checkout anywhere beneath it.
  local t23_unhosted="${t23}/UnhostedContainer"
  mkdir -p "$t23_unhosted/kanban"

  # Consumer-shaped persona source: <DEV_TEAM>/<group>/personas/agents
  local t23_src="${t23}/t23-group/personas/agents"
  mkdir -p "$t23_src"
  printf -- '---\nname: t23-persona\n---\nbody\n' > "${t23_src}/t23-persona.md"

  local t23_registry="${t23}/team-paths23.json"
  cat > "$t23_registry" <<T23_REG
{
  "schema_version": 3,
  "teams": {
    "t23-hosted": { "working_dir": "${t23_container}" },
    "t23-unhosted": { "working_dir": "${t23_unhosted}" }
  }
}
T23_REG

  local t23_manifest="${t23}/manifest23.json"
  cat > "$t23_manifest" <<T23_MAN
{
  "schemaVersion": "1",
  "masterRoot": "fake-master23",
  "deployments": [
    { "team": "t23-hosted",   "targetRepo": "${t23_container}", "targetDir": ".claude/agents",
      "isGitRepo": true, "exists": true, "groups": ["t23-group"] },
    { "team": "t23-unhosted", "targetRepo": "${t23_unhosted}",  "targetDir": ".claude/agents",
      "isGitRepo": true, "exists": true, "groups": ["t23-group"] }
  ]
}
T23_MAN

  local _sv_man_23="$MANIFEST" _sv_tp_23="$TEAM_PATHS_JSON" _sv_mode_23="$KBSP_MODE" _sv_dt_23="$DEV_TEAM"
  MANIFEST="$t23_manifest"
  TEAM_PATHS_JSON="$t23_registry"
  DEV_TEAM="$t23"          # so _group_persona_dir resolves <DEV_TEAM>/<grp>/personas/agents
  KBSP_MODE="consumer"

  local t23_out
  t23_out=$(_kbsp_sync_worktrees --all --dry-run 2>&1) || true

  MANIFEST="$_sv_man_23"; TEAM_PATHS_JSON="$_sv_tp_23"
  KBSP_MODE="$_sv_mode_23"; DEV_TEAM="$_sv_dt_23"

  if ! printf '%s\n' "$t23_out" | grep -q 't23-hosted'; then
    t23_ok=false
    _err "[selftest] Test 23a: hosted team was SILENTLY SKIPPED by the consumer-mode filter (exit 0, deployed nothing). output=$t23_out"
  fi
  if printf '%s\n' "$t23_out" | grep -q 't23-unhosted'; then
    t23_ok=false
    _err "[selftest] Test 23b: unhosted team should be omitted in consumer mode; it was processed. output=$t23_out"
  fi

  rm -rf "$t23"

  if [ "$t23_ok" = true ]; then
    _info "[selftest] PASS: Test 23 (sync-worktrees consumer mode: hosted processed, unhosted omitted)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 23 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Cleanup ---
  rm -rf "$tmp_repo"
  _info "[selftest] Temp dir cleaned up."

  # --- Summary ---
  echo ""
  echo "Self-test results: ${pass} passed, ${fail} failed"
  if [ "$fail" -gt 0 ]; then
    _err "Self-test FAILED ($fail failures)"
    return 1
  else
    _info "Self-test PASSED"
    return 0
  fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
_require_jq

# The manifest itself IS shipped to consumers (install_kb_sync_personas_script()
# in install-kanban.sh / update_personas_manifest() in aiteamforge-upgrade.sh
# both lay it down at $AITEAMFORGE_DIR/.claude/personas-manifest.json — the
# exact path $MANIFEST resolves to on a consumer, since DEV_TEAM there IS
# AITEAMFORGE_DIR), so this stays fatal in BOTH modes — a missing manifest is a
# genuinely broken install either way. Only the static hint text below needs
# to be mode-aware: it used to hardcode the dev-machine path unconditionally,
# which is simply wrong/misleading on a consumer box.
if [ ! -f "$MANIFEST" ]; then
  _err "Manifest not found: $MANIFEST"
  if [ "$KBSP_MODE" = "dev" ]; then
    _err "Expected at: ~/dev-team/.claude/personas-manifest.json"
  else
    _err "Expected at: \$AITEAMFORGE_DIR/.claude/personas-manifest.json (this machine's AITEAMFORGE_DIR/DEV_TEAM resolved to: $DEV_TEAM)"
  fi
  exit 1
fi

# XACA-1261 Finding 3 (CRITICAL, QA-caught): agents-master/ is, BY DESIGN,
# NEVER mirrored to a consumer (sync-tap.sh mirrors only individual per-group
# flat dirs into ${DEV_TEAM}/<group>/personas/agents/ — see _group_persona_dir
# above — never agents-master/ itself). That absence is precisely the signal
# that put us into KBSP_MODE=consumer a few dozen lines up. An UNCONDITIONAL
# "MASTER_ROOT must exist" check here therefore killed list/check/diff/--help/
# selftest on EVERY consumer, unconditionally, before dispatch was ever
# reached — the entire consumer-mode feature was unreachable. Nothing caught
# it because every test (including this file's own selftest) runs ON THE DEV
# MACHINE, where MASTER_ROOT genuinely exists and this guard was always a
# no-op; the bug only manifests in the consumer shape.
#
# Dev mode:      keep today's behavior EXACTLY — a missing agents-master/ on
#                the dev machine is still a fatal, broken-checkout error.
# Consumer mode: MASTER_ROOT's absence is normal, not an error — validate the
#                thing that actually matters instead: at least ONE per-team
#                source directory (${DEV_TEAM}/<group>/personas/agents, what
#                _group_persona_dir resolves in this mode) must exist
#                SOMEWHERE under DEV_TEAM, proving this is a real,
#                at-least-partially-provisioned AITeamForge install and not a
#                bare/corrupt one. A single missing GROUP among many is
#                legitimate (a consumer legitimately hosts only some teams)
#                and is already reported per-deployment, non-fatally, by
#                _source_files_for_deployment's own "Master group directory
#                not found: $grp_dir" warning — distinguishable there from a
#                clean sync because that warning names the specific group
#                directory, while THIS check only fires when NOTHING was ever
#                provisioned for ANY group, anywhere.
if [ "$KBSP_MODE" = "dev" ]; then
  if [ ! -d "$MASTER_ROOT" ]; then
    _err "Master root not found: $MASTER_ROOT"
    exit 1
  fi
else
  _xaca1261_has_group_content=false
  for _xaca1261_group_dir in "${DEV_TEAM}"/*/personas/agents; do
    [ -d "$_xaca1261_group_dir" ] || continue
    _xaca1261_has_group_content=true
    break
  done
  if [ "$_xaca1261_has_group_content" = false ]; then
    _err "No persona source content found under $DEV_TEAM"
    _err "  (expected at least one <group>/personas/agents/ directory)."
    _err "This looks like a broken or incomplete AITeamForge install — refusing"
    _err "to proceed rather than silently reporting empty (but"
    _err "successful-looking) results for every team."
    exit 1
  fi
  unset _xaca1261_has_group_content _xaca1261_group_dir
fi

CMD="${1:-help}"
shift || true

case "$CMD" in
  list)            _kbsp_list "$@" ;;
  check)           _kbsp_check "$@" ;;
  sync)            _kbsp_sync "$@" ;;
  sync-worktrees)  _kbsp_sync_worktrees "$@" ;;
  diff)            _kbsp_diff "$@" ;;
  refresh)         _kbsp_refresh "$@" ;;
  selftest)        _kbsp_selftest "$@" ;;
  help|--help|-h)  _kbsp_help ;;
  *)
    _err "Unknown subcommand: $CMD"
    echo ""
    _kbsp_help
    exit 1
    ;;
esac
