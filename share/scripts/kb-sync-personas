  rm -rf "$tmp17"

  if [ "$t17_ok" = true ]; then
    _info "[selftest] PASS: Test 17 (both targets deployed: main-root=$t17_main_count, linked-wt=$t17_wt_count personas)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 17 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 18: iOS/DNS no-double-deploy — container IS the git root ---
  # When container is itself the git root (_resolve_git_roots returns the container),
  # the XACA-0660 main-root loop must skip it (canon_main_root == canon_container_cmp)
  # and NOT deploy a second copy. The sync subcommand owns the main deployment for these
  # teams; sync-worktrees must succeed with no error and no file written to a
  # "main root" target that would duplicate the standard deploy path.
  _info "[selftest] Test 18: iOS/DNS no-double-deploy — container IS git root..."

  local tmp18
  tmp18=$(mktemp -d)
  local t18_container="${tmp18}/iOS-style-container"
  mkdir -p "$t18_container"
  # Container itself IS the git repo (iOS/DNS topology)
  git -C "$t18_container" init -q
  git -C "$t18_container" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1

  local t18_master_root="${tmp18}/fake-master18"
  local t18_team_dir="${t18_master_root}/t18-team"
  mkdir -p "$t18_team_dir"
  printf "# persona R\n" > "${t18_team_dir}/persona-r.md"

  local t18_manifest="${tmp18}/manifest18.json"
  cat > "$t18_manifest" <<T18_MANIFEST
{
  "schemaVersion": "1",
  "masterRoot": "fake-master18",
  "deployments": [
    {
      "team": "t18-team",
      "targetRepo": "${t18_container}",
      "targetDir": ".claude/agents",
      "isGitRepo": true,
      "exists": true,
      "groups": ["t18-team"]
    }
  ]
}
T18_MANIFEST

  local _saved_manifest_18="$MANIFEST"
  local _saved_master_root_18="$MASTER_ROOT"
  local _saved_master_relative_18="$MASTER_RELATIVE"
  MANIFEST="$t18_manifest"
  MASTER_ROOT="$t18_master_root"
  MASTER_RELATIVE="fake-master18"

  local t18_ok=true
  local t18_out
  # git-tracked personas check: container has .gitignore that does NOT ignore .claude/agents/
  # so _deployment_is_gitignored_personas returns false → sync-worktrees skips this team.
  # We need the team to be treated as gitignored (container-layout) to exercise the
  # main-root skip path. Add a .gitignore that ignores .claude/agents/
  printf ".claude/agents/\n" > "${t18_container}/.gitignore"
  git -C "$t18_container" add .gitignore >/dev/null 2>&1

  t18_out=$(_kbsp_sync_worktrees t18-team 2>&1) || t18_ok=false

  # The main-root loop must have skipped the container-as-root case: no personas
  # should land at t18_container/.claude/agents (sync-worktrees never writes there
  # without a linked worktree in this fixture — and there are NO linked worktrees).
  # The command must exit without error.
  local t18_main_target="${t18_container}/.claude/agents"
  if [ -d "$t18_main_target" ]; then
    # A directory was created — that's a double-deploy. Check if it has persona files.
    local t18_deploy_count
    t18_deploy_count=$(find "$t18_main_target" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$t18_deploy_count" -gt 0 ]; then
      t18_ok=false
      _err "[selftest] Test 18: main-root loop wrote $t18_deploy_count personas to container root (double-deploy)"
    fi
    # Directory may be created as side-effect of exclude write; files are the real signal
  fi

  MANIFEST="$_saved_manifest_18"
  MASTER_ROOT="$_saved_master_root_18"
  MASTER_RELATIVE="$_saved_master_relative_18"

  rm -rf "$tmp18"

  if [ "$t18_ok" = true ]; then
    _info "[selftest] PASS: Test 18 (iOS/DNS no-double-deploy: container-as-root skipped correctly)"
    pass=$((pass + 1))
  else
    _err "[selftest] FAIL: Test 18 — see diagnostics above"
    fail=$((fail + 1))
  fi

  # --- Test 19: check detects main-root drift ---
  # After a full sync, remove a persona file from the nested main root, then assert
  # that 'check' reports DRIFT (not SYNCED) for that team. The JSON output must
  # include an entry with status != "synced" for the main root.
  _info "[selftest] Test 19: check detects main-root drift..."

  local tmp19
  tmp19=$(mktemp -d)
  local t19_container="${tmp19}/FakeContainer19"
  local t19_inner="${t19_container}/inner-dev"
  local t19_wt="${t19_container}/worktrees/feature-t19"
  mkdir -p "$t19_inner"
  git -C "$t19_inner" init -q
  git -C "$t19_inner" -c user.email="t@t.com" -c user.name="T" \
    commit -q --allow-empty -m "init" >/dev/null 2>&1
  git -C "$t19_inner" worktree add "$t19_wt" -b "feature-selftest-t19" >/dev/null 2>&1

  local t19_master_root="${tmp19}/fake-master19"
  local t19_team_dir="${t19_master_root}/t19-team"
  mkdir -p "$t19_team_dir"
  printf "# persona S\n" > "${t19_team_dir}/persona-s.md"
  printf "# persona T\n" > "${t19_team_dir}/persona-t.md"

