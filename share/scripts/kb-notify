#!/usr/bin/env python3
"""kb-notify: send release-workflow notices to notify.json aliases (XACA-1345).

Thin argparse dispatcher over kanban-hooks/release_notify.py. Aliases resolve
from the CALLING team's notify.json; the destination behind an alias is a
secretRef the provider resolves just-in-time and this CLI never sees or prints.

  kb-notify send --to <alias> (--template <name> --data <json> | --text <str>)
                 [--ref REL-xxxx|CR-xxxx] [--team T] [--json]
  kb-notify send --type <notice-type> [--text S] [--title S] [--ref REL-xxxx|CR-xxxx]
                 [--team T] [--json]
                 (XACA-1403: deliver through the Fleet Monitor hub with the team's
                 notify key; if the hub is unconfigured/unreachable/5xx fall back to
                 direct aliases, then a macOS notification. Prints type + deliveredVia;
                 --json prints the receipt, FROZEN contract for XACA-1406: one object
                 with ok, deliveredVia and, on failure, error.)
  kb-notify send --type <notice-type> [--ref ...] [--team T] --dry-run
                 (XACA-1399: resolve severity, hub connections, quiet hours and
                 dedupe key from the team's notify.json v2 and print them as JSON;
                 sends nothing.)
  kb-notify test --to <alias> [--team T]     (verifies route + secret; sends NOTHING)
  kb-notify routes push [--team T] [--dry-run] [--force] [--if-configured] [--json]
                 (XACA-1403: PUT the team's notify.json v2 routes to the hub; skipped
                 when unchanged, refreshed hourly; exit 1 + ok:false on any failure)

Exit codes:
  0  ok (send: delivered and receipted; test: route and secret are good;
     send --type --dry-run: resolution printed)
  1  notify failure: config/alias/template/secret problem, an UNKNOWN --type,
     or the provider failed (send --type: receipt ok:false). A delivery failure
     ALSO writes an ok:false receipt. Never retried.
  2  usage error (argparse; bad --data, --ref, missing argument)
  3  RECEIPT_FAILED: the receipt could not be written (the notice may have gone)

Receipts: {id, ts, provider, alias, template, ok, error, providerMessageId?}
appended to notices[] of the --ref record on the team board; without --ref, to
<kanban>/notify-log.jsonl.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

EXIT_OK, EXIT_NOTIFY_ERROR, EXIT_USAGE, EXIT_RECEIPT_FAILED = 0, 1, 2, 3
REF_RE = re.compile(r"^(REL|CR)-[A-Za-z0-9][A-Za-z0-9._-]*(?![\s\S])")  # not $: it matches before a final \n
ALIAS_RE = re.compile(r"^[a-z][a-z0-9-]{0,31}(?![\s\S])")


def _find_hooks_dir():
    """kanban-hooks/ is a sibling of scripts/ in the dev tree and in the tap's
    share/ layout; a flattened tap install puts the modules next to this file."""
    here = Path(__file__).resolve().parent
    for cand in (here.parent / "kanban-hooks", here):
        if (cand / "release_notify.py").is_file():
            return cand
    return None


def _ref(value):
    if not REF_RE.match(value):
        raise argparse.ArgumentTypeError("invalid ref %r (expected REL-... or CR-...)" % value)
    return value


def _alias(value):
    if not ALIAS_RE.match(value):
        raise argparse.ArgumentTypeError("invalid alias %r" % value)
    return value


def _type(value):
    if not ALIAS_RE.match(value):  # notice-type ids share the alias grammar (notice-types.schema.json)
        raise argparse.ArgumentTypeError("invalid notice type %r" % value)
    return value


def _data(value):
    try:
        obj = json.loads(value)
    except ValueError:
        raise argparse.ArgumentTypeError("--data is not valid JSON") from None
    if not isinstance(obj, dict):
        raise argparse.ArgumentTypeError("--data must be a JSON object")
    return obj


def build_parser():
    p = argparse.ArgumentParser(prog="kb-notify", description="Release-workflow notifier.")
    sub = p.add_subparsers(dest="command", metavar="<subcommand>")
    sub.required = True

    def add(name, help_, to_required=True):
        s = sub.add_parser(name, help=help_, description=help_)
        s.add_argument("--to", required=to_required, type=_alias, help="alias from the team's notify.json")
        s.add_argument("--team", help="team id (default: $KB_TEAM)")
        return s

    s = add("send", "deliver to an alias (--to) or resolve a notice type (--type)", to_required=False)
    s.add_argument("--type", dest="notice_type", type=_type, metavar="NOTICE_TYPE",
                   help="notice type from the catalog (e.g. gate-blocked); resolves routing from the team's "
                        "notify.json v2. Exactly one of --to / --type")
    s.add_argument("--dry-run", action="store_true",
                   help="with --type: print the resolution as JSON and send nothing")
    body = s.add_mutually_exclusive_group(required=False)
    body.add_argument("--template", help="notice template name (profiles/notice/<name>.md)")
    body.add_argument("--text", help="literal message text")
    s.add_argument("--title", help="with --type: notice title (default: '<team>: <type>')")
    s.add_argument("--data", type=_data, default=None, help="JSON object of template facts (with --template)")
    s.add_argument("--ref", type=_ref, help="REL-/CR- record that receives the receipt")
    s.add_argument("--json", action="store_true", help="print the receipt as JSON")
    add("test", "verify route and secret resolve; sends nothing")
    r = sub.add_parser("routes", help="manage the team's hub routes", description="manage the team's hub routes")
    rsub = r.add_subparsers(dest="routes_command", metavar="<action>")
    rsub.required = True
    rp = rsub.add_parser("push", help="push the team's notify.json v2 routes to the Fleet Monitor hub",
                         description="PUT the team's notify.json v2 routes (and team notice types) to the hub. "
                                     "Skips when unchanged since the last good push (hourly refresh).")
    rp.add_argument("--team", help="team id (default: $KB_TEAM)")
    rp.add_argument("--dry-run", action="store_true", help="validate and report what would happen; no network")
    rp.add_argument("--force", action="store_true", help="push even if unchanged")
    rp.add_argument("--if-configured", action="store_true",
                    help="reporter mode: a team with no v2 notify.json or no key is a quiet skip, not an error")
    rp.add_argument("--json", action="store_true", help="print the result as JSON")
    return p


def _report_type_receipt(receipt, args):
    """Print a `send --type` receipt and return the exit code. The --json shape
    (ok, deliveredVia, error on failure) is a frozen contract (XACA-1406)."""
    if args.json:
        print(json.dumps(receipt, sort_keys=True))
    elif receipt["ok"]:
        # "sent" only when something was shown; otherwise say why nothing was.
        hub = receipt.get("hub") or {}
        if receipt["deliveredVia"] == "none" and hub.get("localSuppressed"):
            word = "suppressed (%s)" % hub["localSuppressed"]
        elif receipt["deliveredVia"] == "hub" and not hub.get("delivered"):
            word = "suppressed (%s)" % (hub.get("reason") or "suppressed")
        elif receipt["deliveredVia"] == "none":
            word = "suppressed (none-delivered)"
        else:
            word = "sent"
        print("kb-notify: %s type=%s deliveredVia=%s receipt=%s" % (
            word, receipt["type"], receipt["deliveredVia"], receipt["id"]))
    if not receipt["ok"]:
        print("kb-notify: delivery failed type=%s deliveredVia=%s receipt=%s: %s" % (
            receipt["type"], receipt["deliveredVia"], receipt["id"], receipt["error"]), file=sys.stderr)
        return EXIT_NOTIFY_ERROR
    return EXIT_OK


def main(argv=None, _engine_factory=None):
    args = build_parser().parse_args(argv)
    if args.command == "send":
        if (args.to is None) == (args.notice_type is None):
            build_parser().error("send needs exactly one of --to <alias> or --type <notice-type>")
        if args.notice_type is not None and (args.template is not None or args.data is not None):
            build_parser().error("--type takes no --template/--data (use --text and --title)")
        if args.notice_type is None:
            if args.title is not None:
                build_parser().error("--title is only valid with --type")
            if args.template is None and args.text is None:
                build_parser().error("send --to needs --template or --text")
            if args.dry_run:
                build_parser().error("--dry-run is only valid with --type")
        if args.data is not None and args.template is None:
            build_parser().error("--data requires --template")
    team = args.team or os.environ.get("KB_TEAM", "")
    if not team:
        build_parser().error("no team: pass --team or set $KB_TEAM")
    hooks = _find_hooks_dir()
    if hooks is None:
        print("kb-notify: release_notify.py not found", file=sys.stderr)
        return EXIT_NOTIFY_ERROR
    sys.path.insert(0, str(hooks))
    if args.command == "routes":  # XACA-1403-002: no engine, no secrets resolved by this CLI
        import release_notify_routes_push as rp  # noqa: PLC0415 - path set just above
        return rp.run_cli(team, args)
    import release_notify as rn  # noqa: PLC0415 - path set just above

    try:
        engine = (_engine_factory or rn.NotifyEngine)(team)
        if args.command == "test":
            provider = engine.test(args.to)
            print("kb-notify: test ok provider=%s alias=%s" % (provider, args.to))
            return EXIT_OK
        if args.command == "send" and args.notice_type is not None:
            if args.dry_run:
                result = engine.resolve_type(args.notice_type, ref=args.ref)  # unknown type -> NotifyConfigError
                print(json.dumps(result, sort_keys=True))
                return EXIT_OK
            receipt = engine.send_type(args.notice_type, text=args.text, title=args.title, ref=args.ref)
            return _report_type_receipt(receipt, args)
        receipt = engine.send(args.to, template=args.template, data=args.data,
                              text=args.text, ref=args.ref)
    except rn.NotifyReceiptError as exc:
        print("kb-notify: %s" % exc, file=sys.stderr)
        return EXIT_RECEIPT_FAILED
    except rn.NotifyError as exc:
        print("kb-notify: %s" % exc, file=sys.stderr)
        return EXIT_NOTIFY_ERROR
    except Exception as exc:  # noqa: BLE001 - never dump a traceback that could carry a secret
        print("kb-notify: unexpected error (%s)" % type(exc).__name__, file=sys.stderr)
        return EXIT_NOTIFY_ERROR

    if args.json:
        print(json.dumps(receipt, sort_keys=True))
    elif receipt["ok"]:
        print("kb-notify: sent provider=%s alias=%s receipt=%s" % (
            receipt["provider"], receipt["alias"], receipt["id"]))
    if not receipt["ok"]:
        print("kb-notify: delivery failed provider=%s alias=%s receipt=%s: %s" % (
            receipt["provider"], receipt["alias"], receipt["id"], receipt["error"]), file=sys.stderr)
        return EXIT_NOTIFY_ERROR
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
