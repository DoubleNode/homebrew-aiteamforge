#!/usr/bin/env python3
"""kb-wiki: publish and read release-workflow wiki docs (XACA-1344).

THE CLI CONTRACT. Thin argparse dispatcher over kanban-hooks/release_wiki.py.
The engine tickets (XACA-1348/1349) and the future wiki-signal provider build
against this text; changing a flag, a JSON key or an exit code is a breaking
change. All seven subcommands are real (XACA-1344 PR 3/3); none is a stub.

kb-wiki does NOT write the release/CR record. The caller passes the stored
state in (--page-id, --stored-version) and stores the printed record itself.

PROVIDERS (wiki.json "provider"; XACA-1370)
  confluence  Confluence Cloud; needs credential, baseUrl and a space + parent
              per doc type. For Main Event teams only (see host guard).
  local       File-backed, no network, no credential. Pages live under
              <team-kanban>/wiki/ (pages/<id>/meta.json + body.html + versions/),
              written atomically under a file lock with full version history.
              The team id is the space; each doc type gets its own top-level
              folder (the parent). docTypes entries are empty objects.
              The kanban tree is covered by kanban-backup. Write verbs create
              the tree; read verbs and doctor never do.
  Host guard: mainevent.atlassian.net (and subdomains) is refused unless the
  team's board organization is MAIN EVENT (alias-aware, fail-closed). Only
  Main Event / D&B content is ever created there. Other teams use `local`.
  See docs/release-workflow/kb-wiki-providers.md.

Every subcommand takes --team T (default $KB_TEAM) and --json. Without --json
the output is for humans and NOT stable. With --json stdout is exactly one JSON
document and nothing else (diagnostics go to stderr) on exit 0 and exit 4; on
exit 1 or 2 stdout is EMPTY (the reason is on stderr) -- check the exit code
before parsing. --doc is one of cr,
testing-log, cr-record and must be mapped in the team's wiki.json docTypes.
--key is REL-... or CR-... (never used to LOOK UP a page). read and url do
report whether the fetched page carries its identity label (identityMatches)
and sits under the configured parent/space (underConfiguredParent); a consumer
must require BOTH before trusting the echoed doc/key. A mismatch is still exit 0.
--page-id is numeric.

WRITE VERBS
  publish       --doc D --key K --title S --body-file F
                [--page-id ID (--stored-version V | --expect-version N) [--adopt]] [--json]
      Identity is a label kb-wiki-<doc>-<key lowercased> (e.g.
      kb-wiki-testing-log-rel-5) stamped on create and required on update.
      Keys are CASE-INSENSITIVE: CR-Ab and CR-aB are the same record and the
      same page (real ids exist in both casings, e.g. CR-academy-... and
      CR-ACADEMY-...; user decision 2026-09-29, XACA-1344-030).
      No --page-id: create. Refuses (exit 1) if the parent is missing/wrong
      type, a page already carries the (doc, key) label, or the title exists.
      With --page-id: update. A missing page is exit 1, NEVER a create; the
      page must be under the doc's configured parent (and not be it) and in
      its space, and carry this (doc, key) label. --adopt labels an UNLABELLED
      page (after the location check) and refuses when another page already
      carries the label; another key's page is always refused.
      JSON: {"pageId": "<id>", "url": "<url>", "version": <int>}
  patch-section --doc D --key K --page-id ID --heading H --body-file F
                (--stored-version V | --expect-version N) [--json]
      Replaces only the content under heading H (exit 1 if absent/ambiguous, or
      if the replacement holds a heading of the same or higher level). The
      section ends at the next same/higher heading or the close of the element
      enclosing the heading. Same location + identity guards as publish update.
      JSON: the same {"pageId","url","version"} record.

READ VERBS (provider-generic: no Confluence-only field at the top level)
  read          --doc D --key K --page-id ID [--json]
      JSON: {"doc","key","pageId","title","version":int,"url","kind":"page",
             "labels":[str],"ancestors":[{"id","title"}],"body",
             "identityLabel":str,"identityMatches":bool,
             "underConfiguredParent":bool}
      Exit 1 if the page does not exist.
  find          --doc D --key K --title T [--json]
      Exact-title search in the doc type's mapped space. ZERO MATCHES IS AN
      ANSWER, NOT AN ERROR: exit 0 with an empty list.
      JSON: {"doc","key","title","space","matches":[{"pageId","title",
             "version","url","kind","labels","ancestors":[{"id","title"}]}]}
  children      --doc D [--page-id ID] [--json]
      Lists the children of the doc type's mapped parent (its configured type,
      page or folder). --page-id lists that page's children instead; it is a
      page id unless it equals the mapped parent's id, when the mapped type
      applies.
      JSON: {"doc","parentType","parentId","children":[<match record above>]}
  url           --doc D --key K --page-id ID [--json]
      Prints the page URL after confirming the page exists (exit 1 if not).
      JSON: {"doc","key","pageId","url","identityLabel","identityMatches",
             "underConfiguredParent"}
      stdout stays the bare url; an unverified identity warns on stderr.

  doctor        [--doc D] [--json]
      Runs, in order: wiki-json (loads + validates), credentials (reports the
      SOURCE, secretRef or credentials-file, and the base URL host; never the
      email, token or a resolved value), then per doc type: parent-read (the
      mapped parent exists and is the configured type), write-permission
      (never writes; PASS only when the provider positively confirms, else
      WARN "not verifiable without writing"), title-pattern (XACA-1343's own
      validator), profile-chain (INFO: default -> group -> team layering).
      Text: one line per check, `PASS|WARN|FAIL|INFO [doc] check: reason`.
      JSON: a list of {"check","docType"|null,"status","reason"[,"data"]}.
      A check that needs jsonschema (unavailable under /usr/bin/python3 3.9)
      reports WARN "validator unavailable (jsonschema not installed)", never
      PASS. Exit 1 if ANY check FAILs; WARN and INFO alone exit 0.

Exit codes (the engine may rely on these):
  0  ok (find with zero matches, and doctor with only PASS/WARN/INFO, are 0)
  1  wiki/provider error (credentials, not found, transport, duplicate title,
     bad parent, heading absent/ambiguous, missing/invalid wiki.json), or a
     doctor FAIL
  2  usage error (argparse; bad --doc, malformed --key, missing argument, no
     team, --doc not mapped in wiki.json docTypes, update without a version)
  3  RETIRED. Was NOT_IMPLEMENTED ("<subcommand> not implemented yet") while
     read/find/children/url/doctor were stubs; never emitted since PR 3/3.
     Callers that coded against it: the verb now exists, handle 0/1/2 instead.
  4  version-guard refusal: live version != stored/expected (newer, older, or a
     409 race). The page is left unchanged. Without --json the unified diff
     (live vs rendered) goes to stdout; with --json stdout is the one document
     {"refused":"version-guard","message":...,"diff":...} ("diff" is "" for a
     409 race, where there is nothing to compare).

Subcommands: publish, read, find, children, url, patch-section, doctor.
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import sys
import urllib.parse
from pathlib import Path

EXIT_OK, EXIT_WIKI_ERROR, EXIT_USAGE, EXIT_VERSION_GUARD = 0, 1, 2, 4  # 3 is retired
DOC_TYPES = ("cr", "testing-log", "cr-record")
KEY_RE = re.compile(r"^(REL|CR)-[A-Za-z0-9][A-Za-z0-9._-]*(?![\s\S])")  # not $: it matches before a final \n
TEAM_RE = re.compile(r"^[a-z][a-z0-9_-]{0,63}(?![\s\S])")
TEST_PROVIDER_VAR = "KB_WIKI_TEST_PROVIDER_FILE"  # test-only: a .py file defining make_provider()
ALLOW_ANY_DIR_VAR = "RELEASE_CONFIG_VALIDATE_ALLOW_ANY_DIR"  # same hatch as the validator CLI


def _find_hooks_dir():
    """kanban-hooks/ is a sibling of scripts/ in the dev tree and in the tap's
    share/ layout; a flattened tap install puts the modules next to this file."""
    here = Path(__file__).resolve().parent
    for cand in (here.parent / "kanban-hooks", here):
        if (cand / "release_wiki.py").is_file():
            return cand
    return None


def _nonneg_int(value):
    if not re.fullmatch(r"[0-9]+", value):
        raise argparse.ArgumentTypeError(f"invalid version {value!r} (expected a non-negative integer)")
    return int(value)


def _key(value):
    if not KEY_RE.match(value):
        raise argparse.ArgumentTypeError(f"invalid key {value!r} (expected REL-... or CR-...)")
    return value


def build_parser():
    p = argparse.ArgumentParser(prog="kb-wiki", description="Release-workflow wiki publisher.")
    sub = p.add_subparsers(dest="command", metavar="<subcommand>")
    sub.required = True

    def add(name, help_, doc=True, key=True, body=False, heading=False,
            versions=False, title=False, page_id=False):
        s = sub.add_parser(name, help=help_, description=help_)
        s.add_argument("--team", help="team id (default: $KB_TEAM)")
        s.add_argument("--json", action="store_true", help="machine-readable output")
        if doc:
            s.add_argument("--doc", required=True, choices=DOC_TYPES, help="doc type")
        if key:
            s.add_argument("--key", required=True, type=_key, help="REL-/CR- id")
        if body:
            s.add_argument("--body-file", required=True, help="rendered body (storage format)")
        if heading:
            s.add_argument("--heading", required=True, help="heading whose body is replaced")
        if title:
            s.add_argument("--title", required=True, help="page title")
        if page_id:
            s.add_argument("--page-id", required=(name in ("patch-section", "read", "url")),
                           help="page id (publish: update it, never create)")
        if versions:
            if name == "publish":
                s.add_argument("--adopt", action="store_true",
                               help="with --page-id: label an unlabelled legacy page (overwrites it)")
            s.add_argument("--stored-version", type=_nonneg_int, metavar="V",
                           help="version recorded at last publish; refuse if live differs")
            s.add_argument("--expect-version", type=_nonneg_int, metavar="N",
                           help="refuse unless the live page is at exactly version N")
        s.add_argument("--config-dir", help=argparse.SUPPRESS)  # test-only, mirrors the validator CLI
        return s

    add("publish", "create or update the one page for (doc, key)", body=True,
        versions=True, title=True, page_id=True)
    add("read", "print body + version, labels, ancestors", page_id=True)
    add("find", "exact-title search in the doc type's space; zero matches is exit 0, "
        "an answer not an error", title=True)
    add("children", "list children of the doc type's mapped parent (or --page-id)",
        key=False, page_id=True)
    add("url", "print the URL of an existing page (exit 1 if it is missing)", page_id=True)
    add("patch-section", "replace only the body under one heading",
        body=True, heading=True, versions=True, page_id=True)
    s = add("doctor", "check credentials, parents, write access, title patterns",
            doc=False, key=False)
    s.add_argument("--doc", choices=DOC_TYPES, help="limit to one doc type")
    return p


class _Usage(Exception):
    pass


class _ConfigError(Exception):
    pass


def _err(msg):
    print(f"kb-wiki: {msg}", file=sys.stderr)


def _resolve_config_dir(team, override):
    """Same convention as scripts/release_config_validate.py::_resolve_config_dir
    (<team kanban>/config via aiteamforge_paths; --config-dir only for tests and
    only under kanban/config unless the validator's escape hatch is set). It is
    re-stated here, not imported, because that module needs jsonschema at import
    time and this resolution must work on a bare system python."""
    def allowed(p):
        return os.environ.get(ALLOW_ANY_DIR_VAR) == "1" or p.parts[-2:] == ("kanban", "config")

    if override is not None:
        cand = Path(override).expanduser().resolve()
        if not allowed(cand):
            raise _Usage(f"--config-dir must be a team's <kanban>/config directory (got {cand})")
        return cand
    import aiteamforge_paths
    try:
        kdir = aiteamforge_paths.get_team_kanban_dir(team)
    except KeyError as exc:
        raise _Usage(str(exc)) from None
    cand = (Path(kdir) / "config").resolve()
    if not allowed(cand):
        raise _Usage(f"resolved config dir {cand} does not end in kanban/config; refusing")
    return cand


def _full_validate(config, quiet=False):
    """Run XACA-1342's schema validator when importable (it needs jsonschema).
    Returns True when the schema was applied, False when it could not be
    (doctor turns False into a WARN, never a PASS)."""
    here = Path(__file__).resolve().parent
    for cand in (here / "release_config_validate.py",
                 here.parent / "scripts" / "release_config_validate.py"):
        if cand.is_file():
            spec = importlib.util.spec_from_file_location("release_config_validate", cand)
            mod = importlib.util.module_from_spec(spec)
            try:
                spec.loader.exec_module(mod)
            except ImportError:
                if not quiet:
                    _err("schema validator unavailable (jsonschema missing); "
                         "checking only the fields kb-wiki uses")
                return False
            errors = mod.validate_wiki_config(config)
            if errors:
                raise _ConfigError("wiki.json invalid: " + "; ".join(errors))
            return True
    if not quiet:
        _err("schema validator not found; checking only the fields kb-wiki uses")
    return False


def _read_wiki_json(team, override):
    """Load wiki.json as a dict (missing/unreadable/non-object is _ConfigError)."""
    cfg_path = _resolve_config_dir(team, override) / "wiki.json"
    try:
        config = json.loads(cfg_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise _ConfigError(f"wiki.json not found for team '{team}' ({cfg_path})") from None
    except (OSError, ValueError) as exc:
        raise _ConfigError(f"cannot read wiki.json ({type(exc).__name__})") from None
    if not isinstance(config, dict):
        raise _ConfigError("wiki.json must be a JSON object")
    return config


def _doc_mapping(config, doc):
    """(space, parent_type, parent_id) for a doc type; _ConfigError if invalid."""
    entry = config["docTypes"][doc]
    try:
        space, parent = entry["space"], entry["parent"]
        ptype, pid = parent["type"], parent["id"]
    except (KeyError, TypeError):
        raise _ConfigError(f"wiki.json docTypes.{doc} needs space and parent{{type,id}}") from None
    if not (isinstance(space, str) and space and ptype in ("page", "folder")
            and isinstance(pid, (str, int)) and not isinstance(pid, bool) and str(pid)):
        raise _ConfigError(f"wiki.json docTypes.{doc} has an invalid space/parent")
    return space, ptype, str(pid)


PROVIDERS = ("confluence", "local")

# XACA-1370-013. User rule (2026-09-30): ONLY Main Event / D&B content is ever
# created in this Atlassian tenant. A Confluence wiki.json (or a credentials-file
# site) that resolves to it is refused unless the team is a Main Event team.
PROTECTED_CONFLUENCE_HOST = "mainevent.atlassian.net"
# A board's `organization`, compared after whitespace-normalising and casefolding.
# Deliberately ONLY "main event": the measured boards say 'MAIN EVENT', and the
# squashed 'MAINEVENT' is NOT accepted -- a spelling variant is not evidence of
# membership, and this guard fails closed.
MAIN_EVENT_ORGANIZATION = "main event"
_MAX_ALIAS_HOPS = 5


def _base_url_host(value):
    """Real hostname of a baseUrl, lowercased, no port, one trailing dot dropped;
    None when it does not parse to a hostname. Mirrors release_wiki_confluence's
    scheme-less handling ('x.atlassian.net' means https://x.atlassian.net), and
    uses urlsplit().hostname so userinfo/lookalike tricks resolve to the host a
    client would really connect to."""
    if not isinstance(value, str):
        return None
    raw = value.strip()
    if not raw or any(c.isspace() for c in raw):
        return None
    if "://" not in raw:
        raw = "https://" + raw
    try:
        u = urllib.parse.urlsplit(raw)
        u.port  # validates the port
        host = u.hostname
    except ValueError:
        return None
    if not host:
        return None
    host = host.lower()
    if not host.isascii():
        # The socket layer IDNA-encodes a non-ASCII host (NFKC: fullwidth letters
        # and U+3002 become ASCII), so 'ｍainevent.atlassian.net' connects to the
        # protected tenant. Compare what would be CONNECTED to; undecodable = None.
        try:
            host = host.encode("idna").decode("ascii").lower()
        except UnicodeError:
            return None
    host = host.rstrip(".")  # every trailing dot, not just one
    return host or None


def _is_protected_host(host):
    return host == PROTECTED_CONFLUENCE_HOST or host.endswith("." + PROTECTED_CONFLUENCE_HOST)


def _board_organization(kanban_dir):
    """The single `organization` declared by the *-board.json file(s) in a kanban
    dir. Raises ValueError (reason text only) on any doubt."""
    boards = sorted(Path(kanban_dir).glob("*-board.json"))
    if not boards:
        raise ValueError("no *-board.json in its kanban dir")
    found = set()
    for b in boards:
        try:
            data = json.loads(b.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            raise ValueError(f"board {b.name} is unreadable or not valid JSON") from None
        org = data.get("organization") if isinstance(data, dict) else None
        if not isinstance(org, str) or not org.strip():
            raise ValueError(f"board {b.name} has no string 'organization'")
        found.add(" ".join(org.split()).casefold())
    if len(found) > 1:
        raise ValueError("its boards disagree on 'organization'")
    return found.pop()


def _is_main_event_team(team):
    """(True, "") when the team's board organization is MAIN EVENT, else
    (False, reason). Source of truth: registry kanban_dir(team) -> *-board.json
    -> `organization`; a board-less alias is resolved through alias_of() (up to
    _MAX_ALIAS_HOPS, cycle-safe). Every doubt is a refusal."""
    import aiteamforge_registry as reg
    current, seen = team, set()
    for _ in range(_MAX_ALIAS_HOPS + 1):
        if current in seen:
            return False, "alias cycle"
        seen.add(current)
        try:
            kdir = reg.kanban_dir(current)
        except reg.BoardLessTeamError:
            alias = reg.alias_of(current)
            if not alias:
                return False, f"'{current}' is board-less with no alias"
            current = alias
            continue
        except KeyError:
            return False, f"'{current}' is not a registered team"
        except Exception as exc:
            return False, f"registry lookup failed ({type(exc).__name__})"
        try:
            org = _board_organization(kdir)
        except ValueError as exc:
            return False, str(exc)
        if org == MAIN_EVENT_ORGANIZATION:
            return True, ""
        return False, "its board organization is not MAIN EVENT"
    return False, "alias chain too long"


def _guard_host(team, host):
    """Refuse (_ConfigError) a protected-host target for a non-Main-Event team."""
    if host is None or not _is_protected_host(host):
        return
    ok, why = _is_main_event_team(team)
    if not ok:
        raise _ConfigError(
            f"refusing: {PROTECTED_CONFLUENCE_HOST} is reserved for Main Event teams; "
            f"team '{team}' is not one ({why}). Use provider 'local' for this team.")


def _guard_confluence_config(team, config):
    """Guard the wiki.json baseUrl. An absent/empty baseUrl is checked later, on
    the credential's resolved site (credentials-file fallback), in _make_provider.
    A present baseUrl that has no hostname fails closed."""
    if config.get("provider") != "confluence":
        return
    base = config.get("baseUrl")
    if base is None or base == "":
        return
    host = _base_url_host(base)
    if host is None:
        raise _ConfigError(f"refusing: wiki.json baseUrl has no usable hostname "
                           f"(team '{team}'); cannot prove it is not "
                           f"{PROTECTED_CONFLUENCE_HOST}")
    _guard_host(team, host)


def _local_root(team, override):
    """<team kanban>/wiki/ -- through the SAME resolution every other kb-wiki path
    uses (_resolve_config_dir: team registry, or --config-dir for tests). A
    board-less team has no kanban dir; that surfaces as _Usage (exit 2) with the
    registry's own explanatory message, never a traceback."""
    return _resolve_config_dir(team, override).parent / "wiki"


def _local_mapping(team, doc, override, create):
    """(space, parent_type, parent_id) for a LOCAL doc type.

    A local docType carries no space/parent (the schema forbids them), but the
    orchestration layer (publish, check_location, find_by_title, ...) needs both,
    so they are synthesised here and nowhere else:
      * space      = the team id (valid space key, one wiki per team kanban tree);
      * parent     = a top-level FOLDER titled with the doc type ("cr",
                     "testing-log", "cr-record") in that space, so the wiki tree
                     is wiki/pages/<folder>/<page> and `children --doc D` lists
                     exactly that doc type's pages.
    Write verbs (create=True) ensure the folder exists (idempotent, one lock).
    Read verbs never write: a folder that does not exist yet yields the id "0",
    which is never allocated (ids start at 1000), so find/children are simply
    empty and read/url of a numeric page id behave normally."""
    if os.environ.get(TEST_PROVIDER_VAR):  # a test provider owns the data; touch no disk
        return team, "folder", "0"
    from release_wiki_local import LocalProvider
    provider = LocalProvider(_local_root(team, override))
    if create:
        return team, "folder", provider.ensure_folder(team, doc).id
    folder = provider.find_folder(team, doc)
    if folder is not None:
        return team, "folder", folder.id
    return team, "folder", "0"


def _load_wiki_config(team, doc, override, create=False):
    """Returns (config, space, parent_type, parent_id). Missing/invalid wiki.json
    is _ConfigError (exit 1); an unmapped --doc is _Usage (exit 2). `create` is
    True only for write verbs and only matters for the local provider."""
    config = _read_wiki_json(team, override)
    _full_validate(config)
    provider = config.get("provider")
    if provider not in PROVIDERS:
        raise _ConfigError("wiki.json provider must be 'confluence' or 'local'")
    doc_types = config.get("docTypes")
    if not isinstance(doc_types, dict):
        raise _ConfigError("wiki.json docTypes must be an object")
    if doc_types.get(doc) is None:
        raise _Usage(f"doc type '{doc}' is not mapped in wiki.json docTypes")
    if provider == "local":
        return (config,) + _local_mapping(team, doc, override, create)
    _guard_confluence_config(team, config)
    return (config,) + _doc_mapping(config, doc)


def _make_provider(team, config, config_dir=None):
    _guard_confluence_config(team, config)  # before ANY credential or transport work
    hook = os.environ.get(TEST_PROVIDER_VAR)
    if hook:
        _err(f"WARNING: {TEST_PROVIDER_VAR} is set; using a test provider")
        spec = importlib.util.spec_from_file_location("kb_wiki_test_provider", hook)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod.make_provider()
    if config.get("provider") == "local":
        from release_wiki_local import LocalProvider
        return LocalProvider(_local_root(team, config_dir))  # never touches disk here
    from release_wiki_confluence import ConfluenceProvider, load_credential
    ref = (config.get("credential") or {}).get("secretRef")
    cred = load_credential(team, secret_ref=ref, base_url=config.get("baseUrl"))
    # The credentials file can supply the site when wiki.json has no baseUrl.
    chost = _base_url_host(getattr(cred, "base_url", None))
    if chost is None:
        raise _ConfigError(f"refusing: resolved Confluence site has no usable hostname (team '{team}')")
    _guard_host(team, chost)
    return ConfluenceProvider(cred)


def _read_body(path):
    try:
        return Path(path).read_bytes().decode("utf-8")  # bytes: no newline translation
    except (OSError, UnicodeDecodeError) as exc:
        raise _Usage(f"cannot read --body-file ({type(exc).__name__})") from None


def _team_of(args):
    team = args.team or os.environ.get("KB_TEAM", "")
    if not team:
        raise _Usage("no team: pass --team or set $KB_TEAM")
    if not TEAM_RE.match(team):
        raise _Usage(f"invalid team id {team!r}")
    return team


def _check_page_id(args):
    page_id = getattr(args, "page_id", None)
    if page_id is not None and not re.fullmatch(r"[0-9]+", page_id):
        raise _Usage("--page-id must be numeric")


def _run(args):
    import release_wiki as rw
    team = _team_of(args)
    is_patch = args.command == "patch-section"
    _check_page_id(args)
    versioned = args.stored_version is not None or args.expect_version is not None
    if args.page_id is not None and not versioned:
        raise _Usage("updating an existing page needs --stored-version or --expect-version")
    if args.page_id is None and versioned:
        raise _Usage("--stored-version/--expect-version only apply with --page-id")
    body = _read_body(args.body_file)
    if not is_patch and not body.strip():
        raise _Usage("--body-file is empty; refusing to publish a blank page")
    if not is_patch and args.adopt and args.page_id is None:
        raise _Usage("--adopt only applies with --page-id")
    label = rw.identity_label(args.doc, args.key)
    config, space, ptype, pid = _load_wiki_config(team, args.doc, args.config_dir, create=True)
    provider = _make_provider(team, config, args.config_dir)
    if is_patch:
        res = rw.patch_section(provider, args.page_id, args.heading, body,
                               args.stored_version, args.expect_version,
                               space=space, parent_id=pid, label=label)
    else:
        res = rw.publish(provider, space, ptype, pid, args.title, body, args.page_id,
                         args.stored_version, args.expect_version,
                         label=label, adopt=args.adopt)
    if args.json:
        print(json.dumps(res.record()))
    else:
        verb = "created" if res.created else ("patched" if is_patch else "updated")
        print(f"kb-wiki: {verb} {args.key} pageId={res.page_id} version={res.version} url={res.url}")
    return EXIT_OK


def _fmt_page(rec):
    anc = " > ".join(f"{a['id']} {a['title']}".strip() for a in rec["ancestors"]) or "-"
    return (f"pageId={rec['pageId']} version={rec['version']} kind={rec['kind']} "
            f"title={rec['title']!r} url={rec['url']} ancestors={anc}")


def _yn(flag):
    return "yes" if flag else "no"


def _run_read(args):
    """read / find / children / url."""
    import release_wiki as rw
    team = _team_of(args)
    _check_page_id(args)
    config, space, ptype, pid = _load_wiki_config(team, args.doc, args.config_dir)
    provider = _make_provider(team, config, args.config_dir)
    cmd, doc, key = args.command, args.doc, getattr(args, "key", None)
    if cmd == "read":
        page = provider.get_page(args.page_id)  # one fetch feeds both record and identity
        rec = rw.page_record(page, body=True)
        ident = rw.identity_fields(page, doc, key, space, pid)
        if args.json:
            print(json.dumps({"doc": doc, "key": key, **rec, **ident}))
        else:
            print(f"kb-wiki: {_fmt_page(rec)}")
            print(f"labels: {', '.join(rec['labels']) or '-'}")
            print(f"identity: label={ident['identityLabel']} "
                  f"matches={_yn(ident['identityMatches'])} "
                  f"under-configured-parent={_yn(ident['underConfiguredParent'])}")
            print()
            print(rec["body"])
    elif cmd == "find":
        matches = rw.find_pages(provider, space, args.title)
        if args.json:
            print(json.dumps({"doc": doc, "key": key, "title": args.title,
                              "space": space, "matches": matches}))
        elif not matches:
            print(f"kb-wiki: no page titled {args.title!r} in space {space}")
        else:
            for m in matches:
                print(f"kb-wiki: {_fmt_page(m)}")
    elif cmd == "children":
        page_id = getattr(args, "page_id", None)
        if page_id is not None and page_id != pid:
            ptype, pid = "page", page_id  # an explicit id is a page unless it IS the mapped parent
        kids = rw.child_records(provider, ptype, pid)
        if args.json:
            print(json.dumps({"doc": doc, "parentType": ptype, "parentId": pid, "children": kids}))
        else:
            print(f"kb-wiki: {len(kids)} child(ren) of {ptype} {pid}")
            for k in kids:
                print(f"  {_fmt_page(k)}")
    else:  # url
        page = provider.get_page(args.page_id)  # exactly one fetch
        url = rw.confirmed_url_from(page, provider)
        ident = rw.identity_fields(page, doc, key, space, pid)
        if args.json:
            print(json.dumps({"doc": doc, "key": key, "pageId": args.page_id, "url": url, **ident}))
        else:
            print(url)  # stdout is the bare url: scripts consume it
            if not (ident["identityMatches"] and ident["underConfiguredParent"]):
                print(f"kb-wiki: warning: page {args.page_id} is not verified as {doc} {key} "
                      f"(identityMatches={str(ident['identityMatches']).lower()} "
                      f"underConfiguredParent={str(ident['underConfiguredParent']).lower()})",
                      file=sys.stderr)
    return EXIT_OK


# ---------------------------------------------------------------- doctor

TITLE_SHAPES = {"testing-log": ("ver", "relId", "platform"), "cr-record": ("ver", "relId", "crId")}
# Spec 12.1 shapes, in XACA-1343's <Name> template syntax (the plan's {ver}
# notation is not a syntax XACA-1343 implements); the shipped defaults carry these.
EXPECTED_TITLE = {"testing-log": "v<Ver> - <RelId> - <Platform> Testing Log",
                  "cr-record": "v<Ver> - <RelId> - <CrId>"}
NEEDS_JSONSCHEMA = "validator unavailable (jsonschema not installed)"
_SAFE_HOST = re.compile(r"[A-Za-z0-9.-]{1,253}(?![\s\S])")
_SAFE_DOC = re.compile(r"[a-z][a-z0-9-]{0,31}(?![\s\S])")


def _import_profile_modules():
    """(resolver, validator) from scripts/. ImportError propagates; the caller
    tells 'jsonschema missing' (exc.name == 'jsonschema') from other causes."""
    here = str(Path(__file__).resolve().parent)
    if here not in sys.path:
        sys.path.insert(0, here)
    import release_profile_resolver
    import release_profile_validate
    return release_profile_resolver, release_profile_validate


def _title_pattern_check(rw, doc, profile, validator):
    """XACA-1343's validate_draft owns validity (compile, unsafe-pattern screen,
    bounded execution). The probe title only makes it run; a probe MISMATCH
    ('title-pattern') is expected and ignored, every other rule is a defect."""
    name = "title-pattern"
    pat = profile.get("titlePattern")
    if pat is None:
        if doc == "cr":  # schema: optional; cr keeps each team's own rule
            return rw.Check(name, rw.WARN, "no titlePattern; cr keeps its team's existing "
                            "title rule (schema allows absence)", doc)
        return rw.Check(name, rw.FAIL, f"titlePattern is missing (expected shape "
                        f"'{EXPECTED_TITLE[doc]}')", doc)
    if not isinstance(pat, str) or not pat.strip():
        return rw.Check(name, rw.FAIL, "titlePattern must be a non-empty string", doc)
    bad = [v for v in validator.validate_draft("", "probe", {"titlePattern": pat})
           if v.rule != "title-pattern"]
    if bad:
        return rw.Check(name, rw.FAIL, f"titlePattern invalid: {bad[0].rule}: "
                        f"{rw._one_line(bad[0].detail)}", doc)
    missing = [t for t in TITLE_SHAPES.get(doc, ()) if "{%s}" % t.lower() not in pat.lower()
               and "<%s>" % t.lower() not in pat.lower()]
    if missing:
        return rw.Check(name, rw.WARN, f"titlePattern is valid but does not mention "
                        f"{', '.join(missing)} (expected '{EXPECTED_TITLE[doc]}')", doc)
    return rw.Check(name, rw.PASS, "titlePattern is present and valid", doc)


def _profile_checks(rw, team, doc, kanban_dir, out):
    try:
        resolver, validator = _import_profile_modules()
    except ImportError as exc:  # jsonschema missing (system python 3.9) or modules absent
        why = NEEDS_JSONSCHEMA if getattr(exc, "name", None) == "jsonschema" \
            else f"profile modules unavailable ({type(exc).__name__})"
        out.append(rw.Check("title-pattern", rw.WARN, why, doc))
        out.append(rw.Check("profile-chain", rw.WARN, why, doc))
        return
    try:
        res = resolver.resolve_profile(team, doc, kanban_dir=kanban_dir)
    except Exception as exc:  # ProfileResolutionError / ReleaseConfigValidationError / OSError
        msg = f"profile resolution failed ({type(exc).__name__}): {rw._one_line(exc)}"
        out.append(rw.Check("title-pattern", rw.FAIL, msg, doc))
        out.append(rw.Check("profile-chain", rw.FAIL, msg, doc))
        return
    out.append(_title_pattern_check(rw, doc, res["profile"], validator))
    frm = res["profileResolvedFrom"]
    chain = {"kind": frm.get("kind"),
             "profile.json": list(reversed(frm.get("profile.json") or [])),  # default -> team
             "template.md": frm.get("template.md"), "style.md": frm.get("style.md")}
    text = "; ".join(f"{f}: {' -> '.join(v) if isinstance(v, list) else v}"
                     for f, v in chain.items() if f != "kind" and v)
    out.append(rw.Check("profile-chain", rw.INFO, text or "no profile files found", doc, chain))


def _local_checks(rw, team, config, selected, override):
    """Doctor for provider=local: no credential, no network. -> [Check]"""
    from release_wiki_local import LocalProvider
    root = _local_root(team, override)
    provider = LocalProvider(root)
    out = [rw.Check("credentials", rw.PASS, "no credential needed (local provider)")]
    try:
        writable = provider.can_write(team, "folder", None)  # never creates anything
    except rw.WikiError as exc:
        out.append(rw.Check("wiki-dir", rw.FAIL, f"cannot check {root} ({type(exc).__name__}): "
                                                 f"{rw._one_line(exc)}"))
        return out
    if writable is True:
        state = "exists" if root.is_dir() else "will be created on first publish"
        out.append(rw.Check("wiki-dir", rw.PASS, f"{root} is writable ({state})"))
    else:
        out.append(rw.Check("wiki-dir", rw.FAIL, f"{root} is not writable (or cannot be created)"))
    for doc in selected:
        _, _, pid = _local_mapping(team, doc, override, create=False)
        if pid == "0":
            out.append(rw.Check("parent-read", rw.INFO,
                                "folder is created on first publish", doc))
        else:
            out.append(rw.check_parent(provider, doc, "folder", pid))
    return out


def _credential_checks(rw, team, config):
    """-> (provider or None, [Check])."""
    name = "credentials"
    cred = config.get("credential")
    ref = cred.get("secretRef") if isinstance(cred, dict) else None
    try:
        provider = _make_provider(team, config)
    except _ConfigError as exc:
        return None, [rw.Check("host-guard", rw.FAIL, rw._one_line(exc))]
    except rw.WikiResolverUnavailableError:
        return None, [rw.Check(name, rw.WARN, f"secret resolver: {NEEDS_JSONSCHEMA}")]
    except rw.WikiCredentialError as exc:
        return None, [rw.Check(name, rw.FAIL, f"credentials do not resolve: {rw._one_line(exc)}")]
    except rw.WikiError as exc:
        return None, [rw.Check(name, rw.FAIL, f"provider unavailable ({type(exc).__name__}): "
                                              f"{rw._one_line(exc)}")]
    except Exception as exc:  # e.g. a broken test-provider file; never a traceback
        return None, [rw.Check(name, rw.FAIL, f"provider unavailable ({type(exc).__name__})")]
    summary = provider.credential_summary()
    source = summary.get("source") if isinstance(summary, dict) else None
    host = summary.get("host") if isinstance(summary, dict) else None
    source = source if source in ("secretRef", "credentials-file") else None
    host = host if isinstance(host, str) and _SAFE_HOST.fullmatch(host) else None
    if source is None or host is None:
        return provider, [rw.Check(name, rw.WARN, "credentials resolved but the provider "
                                   "did not report a source/host")]
    if isinstance(ref, str) and ref and source == "credentials-file":
        return provider, [rw.Check(name, rw.WARN, f"secretRef did not resolve; using the "
                                   f"credentials file (host={host})")]
    return provider, [rw.Check(name, rw.PASS, f"credentials resolved (source={source}, host={host})")]


def _doctor(args):
    import release_wiki as rw
    team = _team_of(args)
    checks = []
    try:
        config = _read_wiki_json(team, args.config_dir)
        validated = _full_validate(config, quiet=True)
        if config.get("provider") not in PROVIDERS:
            raise _ConfigError("wiki.json provider must be 'confluence' or 'local'")
        if not isinstance(config.get("docTypes"), dict):
            raise _ConfigError("wiki.json docTypes must be an object")
    except _ConfigError as exc:
        return [rw.Check("wiki-json", rw.FAIL, rw._one_line(exc))]
    if validated:
        checks.append(rw.Check("wiki-json", rw.PASS, "loaded and schema-valid"))
    else:
        checks.append(rw.Check("wiki-json", rw.WARN, f"loaded; schema not applied: {NEEDS_JSONSCHEMA}"))
    docs = config["docTypes"]
    for extra in sorted(k for k in docs if k not in DOC_TYPES):
        shown = extra if isinstance(extra, str) and _SAFE_DOC.fullmatch(extra) else "<malformed>"
        checks.append(rw.Check("wiki-json", rw.WARN, f"docTypes.{shown} is not a known doc type; ignored"))
    if args.doc is not None and args.doc not in docs:
        raise _Usage(f"doc type '{args.doc}' is not mapped in wiki.json docTypes")
    selected = [d for d in DOC_TYPES if d in docs and args.doc in (None, d)]
    if not selected:
        checks.append(rw.Check("wiki-json", rw.WARN, "no known doc types are mapped"))
    kanban_dir = _resolve_config_dir(team, args.config_dir).parent
    if config.get("provider") == "local":
        checks.extend(_local_checks(rw, team, config, selected, args.config_dir))
        for doc in selected:
            _profile_checks(rw, team, doc, kanban_dir, checks)
        return checks
    try:
        _guard_confluence_config(team, config)
    except _ConfigError as exc:
        checks.append(rw.Check("host-guard", rw.FAIL, rw._one_line(exc)))
        return checks  # no credential resolution, no provider, no network
    provider, cred = _credential_checks(rw, team, config)
    checks.extend(cred)
    for doc in selected:
        try:
            space, ptype, pid = _doc_mapping(config, doc)
        except _ConfigError as exc:
            checks.append(rw.Check("parent-read", rw.FAIL, str(exc), doc))
            checks.append(rw.Check("write-permission", rw.WARN, "skipped: invalid mapping", doc))
        else:
            if provider is None:
                checks.append(rw.Check("parent-read", rw.WARN, "skipped: credentials unavailable", doc))
                checks.append(rw.Check("write-permission", rw.WARN, "skipped: credentials unavailable", doc))
            else:
                checks.append(rw.check_parent(provider, doc, ptype, pid))
                checks.append(rw.check_write(provider, doc, space, ptype, pid))
        _profile_checks(rw, team, doc, kanban_dir, checks)
    return checks


def _run_doctor(args):
    import release_wiki as rw
    checks = _doctor(args)
    if args.json:
        print(json.dumps([c.to_dict() for c in checks]))
    else:
        for c in checks:
            where = f" [{c.doc}]" if c.doc else ""
            print(f"{c.status}{where} {c.name}: {c.reason}")
    return rw.doctor_exit_code(checks)


def main(argv=None):
    args = build_parser().parse_args(argv)
    hooks = _find_hooks_dir()
    if hooks is not None:
        sys.path.insert(0, str(hooks))
    try:
        import release_wiki as rw
    except ImportError:
        _err("cannot import release_wiki (kanban-hooks/ not found next to scripts/)")
        return EXIT_WIKI_ERROR
    runner = {"publish": _run, "patch-section": _run, "doctor": _run_doctor}.get(args.command, _run_read)
    try:
        return runner(args)
    except (_Usage, rw.WikiUsageError) as exc:
        _err(str(exc))
        return EXIT_USAGE
    except _ConfigError as exc:
        _err(str(exc))
        return EXIT_WIKI_ERROR
    except (rw.WikiGuardError, rw.WikiConflictError) as exc:
        _err(f"version guard: {exc}")
        diff = getattr(exc, "diff", "") or ""
        if getattr(args, "json", False):  # --json: stdout is exactly one document
            print(json.dumps({"refused": "version-guard", "message": str(exc), "diff": diff}))
        else:
            sys.stdout.write(diff)
        return EXIT_VERSION_GUARD
    except rw.WikiError as exc:
        # Message first (what a human reads), error class last as a grep-able tag.
        # Every WikiError subclass prints this way; existing suites pin the tag.
        _err(f"{exc} ({type(exc).__name__})")
        return EXIT_WIKI_ERROR
    except Exception as exc:  # never a traceback, never a secret
        _err(f"unexpected {type(exc).__name__}")
        return EXIT_WIKI_ERROR


if __name__ == "__main__":
    sys.exit(main())
