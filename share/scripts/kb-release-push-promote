#!/usr/bin/env bash
# kb-release-push-promote — XACA-0658-006 Branch-push auto-promotion orchestrator
#
# Usage:
#   kb-release-push-promote --branch <branch-name> [--team <team>]
#                           [--platform <plat>] [--auto-bump] [--dry-run]
#
# Called by kb-git-push after a successful push. Resolves the pushed branch to
# an environment via branch_env_map, finds the active release for the team,
# runs the version gate, calls the LCARS promote API, and promotes RELNOTES.
#
# Exit codes:
#   0  — success (including branch-not-mapped no-op, no-active-release no-op)
#   1  — hard block (version gate fail, CR-divergence halt, promote API error, bad args)
#
# CR-divergence halt (XACA-0897 Guard 5):
#   kb-release-version-gate exits 3 (distinct from its ordinary 0/1 contract) when the
#   release's platforms.<plat>.version has diverged from the linked CR's
#   cr_submitted_version — i.e. the release was renumbered after CAB approved it. This
#   script MUST NOT attempt --auto-bump against that class: auto-bump exists to
#   reconcile CODE to the release TARGET, and running it here would perform the exact
#   renumber the halt exists to stop. On gate exit 3 this script hard-blocks the
#   platform immediately (no bump attempt) and reports the overall exit as 1 with a
#   halt-specific message distinct from an ordinary gate failure. It is NOT
#   agent-clearable from here — this script never forwards any override; the human-only
#   override lives entirely in kb-release-version-gate --override-cr-divergence (a live
#   TTY + typed confirmation, unusable from an automated/non-interactive caller like
#   this script or kb-git-push). See docs/ "CR-Divergence Halt (Guard 5)".
#
# Design notes:
#   - No ~/dev-team/ hardcodes — siblings resolved via $AITEAMFORGE_DIR /
#     $(dirname "$0"). Reads all team config from ~/.aiteamforge/team-paths.json.
#   - Defer set -euo pipefail until AFTER sourcing kanban-helpers.sh.
#   - $? after cmd | tail is tail's exit — avoid pipelines for exit-code capture.
#   - Empty-array guard: avoid "${arr[@]}" without set +u or a length check.
#   - Runs under both bash 3.2 (macOS system) and zsh.
#
# PROD path (OQ-2 resolution):
#   PROD is IN branch_env_map. On PROD push: version gate is a HARD BLOCK (must
#   pass). On pass: promote API is called, RELNOTES-GAMMA → RELNOTES-PROD with
#   --prod-stub, then a LOUD manual-steps prompt is printed (store copy + /cr).
#
# LCARS-down (non-fatal):
#   If the promote API call cannot connect (HTTP 000 / curl error), the script
#   prints a recovery hint and exits 0. The gate exit semantics still stand.
#
# Canonical source: ~/dev-team/scripts/kb-release-push-promote
# Tap mirror:       homebrew-tap/share/scripts/kb-release-push-promote
# Canonical-source rule: XACA-0340 — edit here, run ./sync-tap.sh to mirror.

# ---------------------------------------------------------------------------
# Resolve script directory (BASH_SOURCE is empty under zsh — use ${(%):-%x})
# ---------------------------------------------------------------------------
if [ -n "${BASH_SOURCE:-}" ]; then
    _SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
elif [ -n "${ZSH_VERSION:-}" ]; then
    _SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
else
    _SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi

# ---------------------------------------------------------------------------
# Locate kanban-helpers.sh relative to this script's location
# ---------------------------------------------------------------------------
_KH_CANDIDATES=(
    "${AITEAMFORGE_DIR:-}/kanban-helpers.sh"
    "${_SCRIPT_DIR}/../kanban-helpers.sh"
    "${HOME}/dev-team/kanban-helpers.sh"
)
_KH=""
for _c in "${_KH_CANDIDATES[@]}"; do
    _c_expanded="${_c//\~/$HOME}"
    if [ -f "$_c_expanded" ]; then
        _KH="$_c_expanded"
        break
    fi
done
if [ -z "$_KH" ]; then
    echo "ERROR: cannot locate kanban-helpers.sh" >&2
    exit 1
fi
# Source without set -e so internal non-zero returns don't abort us.
# shellcheck source=/dev/null
source "$_KH" 2>/dev/null || true

# Tighten shell options now that sourcing is complete.
set -euo pipefail

# ---------------------------------------------------------------------------
# Locate aiteamforge_paths.py relative to this script
# ---------------------------------------------------------------------------
_PATHS_PY_CANDIDATES=(
    "${AITEAMFORGE_DIR:-}/kanban-hooks/aiteamforge_paths.py"
    "${_SCRIPT_DIR}/../kanban-hooks/aiteamforge_paths.py"
)
_PATHS_PY=""
for _c in "${_PATHS_PY_CANDIDATES[@]}"; do
    _c_expanded="${_c//\~/$HOME}"
    if [ -f "$_c_expanded" ]; then
        _PATHS_PY="$_c_expanded"
        break
    fi
done
if [ -z "$_PATHS_PY" ]; then
    echo "ERROR: cannot locate aiteamforge_paths.py" >&2
    exit 1
fi
_PATHS_PY_DIR="$(dirname "$_PATHS_PY")"

# ---------------------------------------------------------------------------
# Locate the RELNOTES library (005 deliverable)
# ---------------------------------------------------------------------------
_RELNOTES_LIB_CANDIDATES=(
    "${AITEAMFORGE_DIR:-}/scripts/lib/kb-relnotes-promote.sh"
    "${_SCRIPT_DIR}/lib/kb-relnotes-promote.sh"
)
_RELNOTES_LIB=""
for _c in "${_RELNOTES_LIB_CANDIDATES[@]}"; do
    _c_expanded="${_c//\~/$HOME}"
    if [ -f "$_c_expanded" ]; then
        _RELNOTES_LIB="$_c_expanded"
        break
    fi
done
# Not hard-failing here: RELNOTES promotion is non-fatal; we'll check at call site.

# ---------------------------------------------------------------------------
# Locate the gate and bump scripts
# ---------------------------------------------------------------------------
_GATE_SCRIPT_CANDIDATES=(
    "${AITEAMFORGE_DIR:-}/scripts/kb-release-version-gate"
    "${_SCRIPT_DIR}/kb-release-version-gate"
)
_GATE_SCRIPT=""
for _c in "${_GATE_SCRIPT_CANDIDATES[@]}"; do
    _c_expanded="${_c//\~/$HOME}"
    if [ -f "$_c_expanded" ]; then
        _GATE_SCRIPT="$_c_expanded"
        break
    fi
done

_BUMP_SCRIPT_CANDIDATES=(
    "${AITEAMFORGE_DIR:-}/scripts/kb-release-version-bump"
    "${_SCRIPT_DIR}/kb-release-version-bump"
)
_BUMP_SCRIPT=""
for _c in "${_BUMP_SCRIPT_CANDIDATES[@]}"; do
    _c_expanded="${_c//\~/$HOME}"
    if [ -f "$_c_expanded" ]; then
        _BUMP_SCRIPT="$_c_expanded"
        break
    fi
done

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
OPT_BRANCH=""
OPT_TEAM=""
OPT_PLATFORM=""
OPT_AUTO_BUMP=0
OPT_DRY_RUN=0

while [ $# -gt 0 ]; do
    case "${1-}" in
        --branch)
            OPT_BRANCH="${2-}"
            shift 2
            ;;
        --team)
            OPT_TEAM="${2-}"
            shift 2
            ;;
        --platform)
            OPT_PLATFORM="${2-}"
            shift 2
            ;;
        --auto-bump)
            OPT_AUTO_BUMP=1
            shift
            ;;
        --dry-run)
            OPT_DRY_RUN=1
            shift
            ;;
        --help|-h)
            cat <<'EOF'
Usage: kb-release-push-promote --branch <branch-name> [options]

  --branch <name>    Required. The git branch that was pushed.
  --team <team>      Override team detection (KB_TEAM / .kb-team chain).
  --platform <plat>  Limit promotion to a single platform.
  --auto-bump        If the version gate fails, auto-bump the code version
                     to match the release target, then retry the gate.
  --dry-run          Print intended actions without calling promote API or
                     running RELNOTES promotion.

Called automatically by kb-git-push after a successful push.
Direct invocation is also supported for testing / manual recovery.

Exit 0 on success or non-mapped branch; exit 1 on hard block.
EOF
            exit 0
            ;;
        -*)
            echo "ERROR: unknown flag: ${1-}" >&2
            echo "Run: kb-release-push-promote --help" >&2
            exit 1
            ;;
        *)
            echo "ERROR: unexpected positional argument: ${1-}" >&2
            exit 1
            ;;
    esac
done

if [ -z "$OPT_BRANCH" ]; then
    echo "ERROR: --branch is required" >&2
    echo "Usage: kb-release-push-promote --branch <branch-name> [--team <team>] [--dry-run]" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 1 — Resolve team
# ---------------------------------------------------------------------------
if [ -n "$OPT_TEAM" ]; then
    _TEAM="$OPT_TEAM"
elif [ -n "${KB_TEAM:-}" ]; then
    _TEAM="$KB_TEAM"
else
    echo "ERROR: cannot determine team. Set KB_TEAM, pass --team <team>, or add a .kb-team sentinel." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Resolve LCARS port for the team
# ---------------------------------------------------------------------------
_LCARS_PORT=""
if command -v _kb_team_lcars_port >/dev/null 2>&1; then
    _LCARS_PORT=$(_kb_team_lcars_port "$_TEAM" 2>/dev/null) || true
fi
if [ -z "$_LCARS_PORT" ]; then
    _cfg="${AITEAMFORGE_CONFIG:-${HOME}/.aiteamforge/team-paths.json}"
    if [ -f "$_cfg" ]; then
        _LCARS_PORT=$(python3 - "$_cfg" "$_TEAM" <<'PYEOF'
import json, sys
cfg, team = sys.argv[1], sys.argv[2]
try:
    with open(cfg) as fh:
        data = json.load(fh)
except Exception:
    sys.exit(1)
entry = data.get("teams", {}).get(team, {})
port = entry.get("lcars_port")
if port:
    print(port)
PYEOF
        ) || true
    fi
fi
if [ -z "$_LCARS_PORT" ]; then
    echo "ERROR: cannot determine LCARS port for team '$_TEAM'." >&2
    exit 1
fi
_LCARS_BASE="http://localhost:${_LCARS_PORT}"

# ---------------------------------------------------------------------------
# Step 2 — Look up branch in branch_env_map
# ---------------------------------------------------------------------------
_BRANCH_MAP_JSON=""
if command -v _kb_get_team_branch_env_map >/dev/null 2>&1; then
    _BRANCH_MAP_JSON=$(_kb_get_team_branch_env_map "$_TEAM" 2>/dev/null) || true
fi

if [ -z "$_BRANCH_MAP_JSON" ] || [ "$_BRANCH_MAP_JSON" = "{}" ]; then
    # Fallback: read directly from team-paths.json
    _cfg="${AITEAMFORGE_CONFIG:-${HOME}/.aiteamforge/team-paths.json}"
    if [ -f "$_cfg" ]; then
        _BRANCH_MAP_JSON=$(python3 - "$_cfg" "$_TEAM" <<'PYEOF'
import json, sys
cfg, team = sys.argv[1], sys.argv[2]
try:
    with open(cfg) as fh:
        data = json.load(fh)
except Exception:
    print("{}")
    sys.exit(0)
raw = data.get("teams", {}).get(team, {}).get("branch_env_map", {})
if not isinstance(raw, dict):
    raw = {}
print(json.dumps(raw))
PYEOF
        ) || _BRANCH_MAP_JSON="{}"
    fi
fi

if [ -z "$_BRANCH_MAP_JSON" ] || [ "$_BRANCH_MAP_JSON" = "{}" ]; then
    echo "[kb-release-push-promote] branch_env_map not configured for team '$_TEAM' — auto-promotion disabled."
    exit 0
fi

# Check if this branch is in the map
_BRANCH_MAP_VALUE=$(python3 - "$_BRANCH_MAP_JSON" "$OPT_BRANCH" <<'PYEOF'
import json, sys
branch_map_json, branch = sys.argv[1], sys.argv[2]
try:
    bmap = json.loads(branch_map_json)
except Exception:
    print("__NOT_FOUND__")
    sys.exit(0)
val = bmap.get(branch)
if val is None:
    print("__NOT_FOUND__")
else:
    print(json.dumps(val))
PYEOF
) || _BRANCH_MAP_VALUE="__NOT_FOUND__"

if [ "$_BRANCH_MAP_VALUE" = "__NOT_FOUND__" ]; then
    echo "[kb-release-push-promote] branch '${OPT_BRANCH}' not in branch_env_map — no auto-promotion."
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 3 — Load active releases from LCARS API
# ---------------------------------------------------------------------------
_RELEASES_JSON=""
_RELEASES_JSON=$(curl -sf --max-time 10 \
    "${_LCARS_BASE}/api/releases?team=${_TEAM}&status=active" 2>/dev/null) || true

if [ -z "$_RELEASES_JSON" ]; then
    echo "[kb-release-push-promote] WARNING: LCARS not running at ${_LCARS_BASE}." >&2
    echo "  Release not promoted. Run: kb-release promote <id> [--to STAGE] when LCARS is running." >&2
    exit 0
fi

# XACA-1375-013: the team's flowConfig, so the "stage immediately before the target" match below skips
# DISABLED stages (GAMMA now follows flowConfig; the legacy mirror shows the nearest ENABLED stage).
# Best-effort: any failure leaves it empty and the plan falls back to the full fixed pipeline.
_FLOW_JSON=$(curl -sf --max-time 10 \
    "${_LCARS_BASE}/api/release-config?team=${_TEAM}" 2>/dev/null) || _FLOW_JSON=""

# XACA-1375-019: teamConfig.crSupport (the sole CR source of truth). Together with flowConfig it gives the
# FULL enabled order including CR, which the stage match below needs. Best-effort: unreadable => the plan
# assumes CR is PRESENT (the stricter reading: only a release actually AT CR matches a GAMMA/PROD push).
_TEAMCFG_JSON=$(curl -sf --max-time 10 \
    "${_LCARS_BASE}/api/team-config?team=${_TEAM}" 2>/dev/null) || _TEAMCFG_JSON=""

# Parse releases array out of {"releases": [...]}
_RELEASES_ARRAY=$(python3 -c "
import json, sys
try:
    d = json.loads(sys.argv[1])
    releases = d.get('releases', d if isinstance(d, list) else [])
    print(json.dumps(releases))
except Exception as e:
    print('[]')
" "$_RELEASES_JSON" 2>/dev/null) || _RELEASES_ARRAY="[]"

_RELEASES_COUNT=$(python3 -c "
import json, sys
try:
    print(len(json.loads(sys.argv[1])))
except Exception:
    print(0)
" "$_RELEASES_ARRAY" 2>/dev/null) || _RELEASES_COUNT=0

if [ "$_RELEASES_COUNT" -eq 0 ]; then
    echo "[kb-release-push-promote] no active releases found for team '$_TEAM' — skipping auto-promotion."
    exit 0
fi

# ---------------------------------------------------------------------------
# Step 4 — For each (platform, target_env) resolved from normalize_branch_env:
# ---------------------------------------------------------------------------

# We run all platform-env pairs through a Python orchestration loop that:
#   a) Resolves the release to use (disambiguation rule from SPEC §6)
#   b) Passes back structured instructions for the shell to execute
#
# The Python step only resolves — the shell step calls the gate, bump, and
# promote scripts. RELNOTES promotion is handled by the sourced lib function.

_PROMOTE_PLAN=$(python3 - "$_PATHS_PY_DIR" "$_RELEASES_ARRAY" "$_BRANCH_MAP_VALUE" \
    "$OPT_PLATFORM" "$_FLOW_JSON" "$_TEAMCFG_JSON" <<'PYEOF'
"""
Resolve promotion plan: for each (platform, target_env) pair, pick the right
active release using the disambiguation rule from SPEC §6.

Output format (one JSON object per line, to stdout):
  {"action": "promote",  "release_id": "...", "platform": "...",
   "target_env": "...", "env_from": "..."}
  {"action": "warn",     "message": "..."}
  {"action": "noop",     "message": "..."}

Disambiguation rule:
  1. Among all active releases, filter to those where the platform's
     currentEnvironment is immediately before target_env.
  2. If still multiple: pick the most recent createdAt.
  3. If same timestamp: warn + skip.
  4. If zero after filter: warn + skip.
"""
import json
import sys
from pathlib import Path

py_dir         = sys.argv[1]
releases_json  = sys.argv[2]
branch_val_raw = sys.argv[3]  # raw JSON value from branch_env_map
opt_platform   = sys.argv[4]  # may be empty
flow_raw       = sys.argv[5] if len(sys.argv) > 5 else ""  # GET /api/release-config body; may be empty
teamcfg_raw    = sys.argv[6] if len(sys.argv) > 6 else ""  # GET /api/team-config body; may be empty

sys.path.insert(0, py_dir)
try:
    import aiteamforge_paths
except Exception as e:
    print(json.dumps({"action": "warn", "message": f"cannot import aiteamforge_paths: {e}"}))
    sys.exit(0)

# Pipeline order used for "immediately before" check
PIPELINE_ORDER = ["PLANNED", "DEV", "QA", "ALPHA", "BETA", "GAMMA", "PROD"]

# XACA-1375-013: skip stages the team DISABLED in flowConfig (PLANNED/DEV/PROD are never skipped; a
# missing entry counts as enabled, matching release_gate.enabled_stages). Unreadable/absent flowConfig
# => the full fixed pipeline (the old behaviour). CR is not in PIPELINE_ORDER and never a target.
def _enabled_pipeline(raw: str) -> list[str]:
    try:
        stages = (json.loads(raw).get("flowConfig") or {}).get("stages") or {}
        if not isinstance(stages, dict) or not stages:
            return list(PIPELINE_ORDER)
    except Exception:
        return list(PIPELINE_ORDER)
    out = []
    for s in PIPELINE_ORDER:
        cfg = stages.get(s)
        off = isinstance(cfg, dict) and cfg.get("enabled", True) is False
        if s in ("PLANNED", "DEV", "PROD") or not off:
            out.append(s)
    return out

# XACA-1375-017: PREFER the server's computed order (GET /api/release-config -> enabledStages: CR and the
# "GAMMA is forced on when crSupport is on" rule already applied). The local computation below is only the
# fallback for an older/unreachable server and mirrors release_gate.enabled_stages (parity-tested).
def _server_order(raw: str):
    try:
        order = json.loads(raw).get("enabledStages")
    except Exception:
        return None
    ok = isinstance(order, list) and order and all(isinstance(x, str) for x in order)
    return list(order) if ok and "PLANNED" in order and "PROD" in order else None

SERVER_ORDER = _server_order(flow_raw)
ENABLED_ORDER = ([x for x in SERVER_ORDER if x != "CR"] if SERVER_ORDER
                 else _enabled_pipeline(flow_raw))   # legacy stages (no CR): the RELNOTES chain

# XACA-1375-019: the FULL stage order incl. CR (release_gate.STAGES) and the FULL enabled order. CR exists
# iff teamConfig.crSupport.enabled is exactly True (unreadable => assumed present, the stricter reading).
STAGES = ["PLANNED", "DEV", "QA", "ALPHA", "BETA", "CR", "GAMMA", "PROD"]

def _cr_enabled(raw: str) -> bool:
    try:
        return ((json.loads(raw).get("teamConfig") or {}).get("crSupport") or {}).get("enabled") is True
    except Exception:
        return True

if SERVER_ORDER:
    FULL_ORDER = [s for s in STAGES if s in SERVER_ORDER]
else:
    # fallback (mirrors release_gate.enabled_stages): CR iff crSupport; GAMMA forced ON when crSupport is on
    _cr_on = _cr_enabled(teamcfg_raw)
    FULL_ORDER = [s for s in STAGES if (s == "CR" and _cr_on) or (s == "GAMMA" and _cr_on)
                  or (s not in ("CR", "GAMMA") and s in ENABLED_ORDER)
                  or (s == "GAMMA" and not _cr_on and s in ENABLED_ORDER)]
    ENABLED_ORDER = [x for x in FULL_ORDER if x != "CR"]   # RELNOTES chain follows the same rule

def env_before(env: str) -> str | None:
    """The ENABLED legacy environment immediately before env (RELNOTES source), or None."""
    try:
        idx = ENABLED_ORDER.index(env)
    except ValueError:
        return None
    return ENABLED_ORDER[idx - 1] if idx > 0 else None

def next_enabled_after(stage: str) -> str | None:
    """The first FULL-order enabled stage after `stage` (which itself may be disabled/stranded)."""
    if stage not in STAGES:
        return None
    for s in STAGES[STAGES.index(stage) + 1:]:
        if s in FULL_ORDER:
            return s
    return None

def current_stage(r: dict, platform: str) -> str | None:
    """The release-level `stage` (authoritative); only a release with none (pre-XACA-1346) falls back to
    the legacy platform environment, which is a MIRROR and cannot tell QA from a CR-mirrored-as-QA."""
    st = r.get("stage")
    if st in STAGES:
        return st
    return r["platforms"][platform].get("environment")

try:
    releases = json.loads(releases_json)
except Exception as e:
    print(json.dumps({"action": "warn", "message": f"cannot parse releases JSON: {e}"}))
    sys.exit(0)

try:
    branch_map_value = json.loads(branch_val_raw)
except Exception:
    branch_map_value = branch_val_raw  # may already be a string

# Collect all platform keys across active releases to expand string map form
all_release_platforms: list[str] = []
for r in releases:
    if isinstance(r, dict) and isinstance(r.get("platforms"), dict):
        for p in r["platforms"]:
            if p not in all_release_platforms:
                all_release_platforms.append(p)

# Normalize branch map value → {platform: target_env}
platform_env_map: dict[str, str] = aiteamforge_paths.normalize_branch_env(
    branch_map_value, all_release_platforms
)

if not platform_env_map:
    print(json.dumps({"action": "noop",
                      "message": "branch map value resolved to empty platform map"}))
    sys.exit(0)

# Filter by --platform if given
if opt_platform:
    platform_env_map = {p: e for p, e in platform_env_map.items() if p == opt_platform}
    if not platform_env_map:
        print(json.dumps({"action": "noop",
                          "message": f"--platform {opt_platform!r} not in resolved map"}))
        sys.exit(0)

for platform, target_env in platform_env_map.items():
    # XACA-1375: CR is never an auto-promote target. It is entered by the CAB workflow only, and
    # PIPELINE_ORDER has no CR, so env_before("CR") is None and EVERY release would match. The
    # server refuses a CR entry when teamConfig.crSupport.enabled is not true (both gate modes);
    # refusing here too keeps a mis-mapped branch from even attempting it.
    if target_env == "CR":
        print(json.dumps({
            "action": "warn",
            "message": (f"branch map targets 'CR' for platform '{platform}'; CR is never an "
                        f"auto-promote target (entered via the CR workflow only) — skipping")
        }))
        continue

    # Build set of candidate releases for this platform + target_env
    # Filter 1: release must have this platform
    candidates = [
        r for r in releases
        if isinstance(r, dict)
        and isinstance(r.get("platforms"), dict)
        and platform in r["platforms"]
    ]

    if not candidates:
        print(json.dumps({
            "action": "noop",
            "message": f"no active release contains platform '{platform}' — skipping"
        }))
        continue

    # Filter 2: the release's CURRENT STAGE must be immediately before target_env in the FULL enabled order
    # (XACA-1375-019: release-level stage, CR included; NOT the legacy mirror, which shows a release at
    # CR as the stage before it and made a release at DEV/QA look "one step from PROD").
    expected_from = env_before(target_env)  # legacy RELNOTES source, also printed in the plan
    if target_env in FULL_ORDER and FULL_ORDER.index(target_env) > 0:
        best = [
            r for r in candidates
            if next_enabled_after(current_stage(r, platform)) == target_env
        ]
    elif target_env in FULL_ORDER:
        best = candidates  # PLANNED has no "before" — take all
    else:
        best = []          # a disabled target stage is never auto-promoted to

    if not best:
        # No release at the right stage; warn and skip
        current_envs = [
            f"{r['id']}:{current_stage(r, platform) or '?'}"
            for r in candidates
        ]
        print(json.dumps({
            "action": "warn",
            "message": (
                f"no active release for platform '{platform}' is at the stage immediately before "
                f"'{target_env}' (previous enabled stage: "
                f"'{FULL_ORDER[FULL_ORDER.index(target_env) - 1] if target_env in FULL_ORDER and FULL_ORDER.index(target_env) > 0 else '?'}'). "
                f"Current: {', '.join(current_envs)}"
            )
        }))
        continue

    # Filter 3: pick the most recent createdAt
    def _created_at(r):
        return r.get("createdAt", "")

    best.sort(key=_created_at, reverse=True)
    if len(best) >= 2 and _created_at(best[0]) == _created_at(best[1]):
        print(json.dumps({
            "action": "warn",
            "message": (
                f"Multiple active releases eligible for auto-promotion of "
                f"'{platform}' to '{target_env}' with same createdAt. "
                f"Run: kb-release promote <id> [--to STAGE] manually. "
                f"Candidates: {[r['id'] for r in best]}"
            )
        }))
        continue

    chosen = best[0]
    print(json.dumps({
        "action": "promote",
        "release_id": chosen["id"],
        "platform": platform,
        "target_env": target_env,
        "env_from": expected_from or "",
    }))

sys.exit(0)
PYEOF
) || {
    echo "[kb-release-push-promote] ERROR: promotion plan resolution failed." >&2
    exit 1
}

if [ -z "$_PROMOTE_PLAN" ]; then
    echo "[kb-release-push-promote] no promotions to perform for branch '${OPT_BRANCH}'."
    exit 0
fi

# ---------------------------------------------------------------------------
# Source RELNOTES library (non-fatal if absent — we'll warn at call site)
# ---------------------------------------------------------------------------
if [ -n "$_RELNOTES_LIB" ] && [ -f "$_RELNOTES_LIB" ]; then
    # shellcheck source=/dev/null
    source "$_RELNOTES_LIB" 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Process each line of the plan
# ---------------------------------------------------------------------------
_OVERALL_EXIT=0
_PROMOTED_SUMMARY=""

# We need to iterate over the plan lines. Use a while-read loop on a process
# substitution (avoids the $? after `cmd | tail` gotcha by not using a pipe
# for the iteration itself).
while IFS= read -r _plan_line; do
    [ -z "$_plan_line" ] && continue

    _action=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('action',''))" \
        "$_plan_line" 2>/dev/null) || _action=""
    _message=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('message',''))" \
        "$_plan_line" 2>/dev/null) || _message=""

    case "$_action" in
        warn)
            echo "[kb-release-push-promote] WARNING: ${_message}" >&2
            continue
            ;;
        noop)
            echo "[kb-release-push-promote] ${_message}"
            continue
            ;;
        promote)
            _release_id=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('release_id',''))" \
                "$_plan_line" 2>/dev/null) || _release_id=""
            _platform=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('platform',''))" \
                "$_plan_line" 2>/dev/null) || _platform=""
            _target_env=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('target_env',''))" \
                "$_plan_line" 2>/dev/null) || _target_env=""
            _env_from=$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('env_from',''))" \
                "$_plan_line" 2>/dev/null) || _env_from=""

            if [ -z "$_release_id" ] || [ -z "$_platform" ] || [ -z "$_target_env" ]; then
                echo "[kb-release-push-promote] ERROR: malformed plan entry: ${_plan_line}" >&2
                _OVERALL_EXIT=1
                continue
            fi

            echo "[kb-release-push-promote] processing: ${_release_id} ${_platform} → ${_target_env}"

            # ── Step 4a: Version gate ────────────────────────────────────────
            # XACA-0897-021: this used to be a WARNING-only skip that fell
            # straight through into Step 4b (promote), i.e. an unresolvable
            # gate script silently promoted with NO version check at all --
            # fail-OPEN, directly contradicting Guard 5's own fail-closed
            # contract a few lines below (gate exit 3 hard-blocks). A missing
            # gate script means "we could not verify" -- the exact class this
            # whole ticket exists to stop treating as "proceed anyway". Hard
            # block: no promotion without a gate check, ever.
            if [ -z "$_GATE_SCRIPT" ]; then
                echo "[kb-release-push-promote] ERROR: kb-release-version-gate not found — cannot verify version before promoting." >&2
                echo "  Hard block: promotion cancelled for this platform. A missing gate script is treated as" >&2
                echo "  an unverifiable state, not permission to skip verification (same fail-closed policy as" >&2
                echo "  the CR-divergence halt below). Fix: ensure scripts/kb-release-version-gate is present" >&2
                echo "  at \$AITEAMFORGE_DIR/scripts/ or alongside this script." >&2
                _OVERALL_EXIT=1
                continue
            else
                _gate_args=("$_release_id" "--platform" "$_platform" "--env" "$_target_env" "--team" "$_TEAM")
                # XACA-0897-104: --dry-run used to SKIP running the gate entirely
                # and force _gate_rc=0 -- a "would pass" verdict printed for a
                # check that never ran, the exact reassuring-result-from-an-unrun-
                # check failure mode this whole ticket exists to close, reproduced
                # inside the tooling itself. --dry-run's own documented contract
                # (see --help above) only promises to skip the promote API call
                # and RELNOTES promotion -- it says nothing about skipping
                # verification. Run it for real in both modes.
                #
                # XACA-0897-round21 (BLOCKING follow-up to XACA-0897-104): the
                # comment that used to sit here claimed the gate "never
                # mutates the release itself" under dry-run -- false. Step 0's
                # override-sentinel check unconditionally CONSUMED (deleted) a
                # pending single-use human CR-divergence override, and the
                # gate's own gateStatus POST is a real write too. Both are
                # real effects a preview must not have. Forward --dry-run to
                # the gate itself (added XACA-0897-round21) so it can suppress
                # every write it knows about (peek, don't consume, the
                # override sentinel; skip the gateStatus POST) while still
                # genuinely evaluating and reporting the correct verdict.
                if [ "$OPT_DRY_RUN" -eq 1 ]; then
                    _gate_args+=("--dry-run")
                    echo "[kb-release-push-promote] [dry-run] running (read-only preview): kb-release-version-gate ${_gate_args[*]}"
                fi
                set +e
                bash "$_GATE_SCRIPT" "${_gate_args[@]}"
                _gate_rc=$?
                set -e

                if [ "$_gate_rc" -eq 3 ]; then
                    # ── CR-DIVERGENCE HALT (XACA-0897 Guard 5) ───────────────
                    # Distinct exit code from an ordinary gate failure (1).
                    # NEVER attempt --auto-bump here, even if OPT_AUTO_BUMP is
                    # set: auto-bump exists to reconcile code to the release
                    # target, and applying it to THIS class would perform the
                    # very renumber the halt exists to prevent. This script
                    # never forwards an override — the only way to clear a
                    # CR-divergence halt is a human running
                    # `kb-release-version-gate ... --override-cr-divergence`
                    # directly, interactively, which this automated,
                    # non-interactive caller structurally cannot do.
                    echo "[kb-release-push-promote] CR-DIVERGENCE HALT for ${_platform} → ${_target_env} (kb-release-version-gate exit 3)." >&2
                    echo "  This is NOT an ordinary version-gate failure — the release's version has diverged" >&2
                    echo "  from the CAB-approved CR version. --auto-bump will NOT be attempted against this" >&2
                    echo "  halt class under any flag combination." >&2
                    echo "  Hard block: promotion cancelled for this platform. Resolution requires an explicit" >&2
                    echo "  human decision — see docs/ 'CR-Divergence Halt (Guard 5)'." >&2
                    _OVERALL_EXIT=1
                    continue
                elif [ "$_gate_rc" -ne 0 ]; then
                    # Ordinary gate failure (exit 1) — try auto-bump if requested
                    if [ "$OPT_AUTO_BUMP" -eq 1 ] && [ -n "$_BUMP_SCRIPT" ]; then
                        if [ "$OPT_DRY_RUN" -eq 1 ]; then
                            # XACA-0897-104 companion fix: kb-release-version-bump
                            # WRITES a real version-source file to disk -- unlike
                            # the gate check above, this is NOT read-only, so
                            # --dry-run must never invoke it for real. Before the
                            # fix above, --dry-run's forced _gate_rc=0 made this
                            # branch unreachable by accident (it only runs when
                            # _gate_rc != 0); now that the gate runs for real in
                            # dry-run too, a genuine ordinary failure previewed
                            # under --dry-run --auto-bump DOES reach here, so it
                            # needs its own explicit guard rather than relying on
                            # that accident.
                            echo "[kb-release-push-promote] [dry-run] would attempt auto-bump for ${_platform} (gate failed, rc=${_gate_rc}) — not run in dry-run." >&2
                        else
                            echo "[kb-release-push-promote] gate failed — attempting auto-bump for ${_platform}..." >&2
                            set +e
                            bash "$_BUMP_SCRIPT" "$_release_id" "--platform" "$_platform" "--team" "$_TEAM"
                            _bump_rc=$?
                            set -e
                            if [ "$_bump_rc" -eq 0 ]; then
                                # Re-run gate
                                set +e
                                bash "$_GATE_SCRIPT" "${_gate_args[@]}"
                                _gate_rc=$?
                                set -e
                            else
                                echo "[kb-release-push-promote] ERROR: auto-bump failed for ${_platform}." >&2
                            fi
                        fi
                    fi
                fi

                if [ "$_gate_rc" -eq 3 ]; then
                    # A retry above (there isn't one on this path today, but
                    # guard defensively) must still never be treated as an
                    # ordinary failure/auto-bump candidate.
                    echo "[kb-release-push-promote] CR-DIVERGENCE HALT for ${_platform} → ${_target_env} (kb-release-version-gate exit 3)." >&2
                    echo "  Hard block: promotion cancelled for this platform. Resolution requires an explicit" >&2
                    echo "  human decision — see docs/ 'CR-Divergence Halt (Guard 5)'." >&2
                    _OVERALL_EXIT=1
                    continue
                elif [ "$_gate_rc" -ne 0 ]; then
                    echo "[kb-release-push-promote] ERROR: version gate FAILED for ${_platform} → ${_target_env}." >&2
                    echo "  Hard block: promotion cancelled for this platform." >&2
                    _OVERALL_EXIT=1
                    continue
                fi
            fi

            # ── Step 4b: Promote via LCARS API ───────────────────────────────
            _promote_payload=$(python3 -c "
import json, sys
print(json.dumps({'platform': sys.argv[1], 'targetEnvironment': sys.argv[2]}))
" "$_platform" "$_target_env" 2>/dev/null)

            if [ "$OPT_DRY_RUN" -eq 1 ]; then
                echo "[kb-release-push-promote] [dry-run] would POST ${_LCARS_BASE}/api/releases/${_release_id}/promote"
                echo "[kb-release-push-promote] [dry-run]   payload: ${_promote_payload}"
                _promote_http="200"
            else
                # Capture both body and HTTP code
                _promote_response_file=$(mktemp /tmp/kb-promote-resp.XXXXXX)
                _promote_http=$(curl -s \
                    -o "$_promote_response_file" \
                    -w "%{http_code}" \
                    -X POST \
                    -H "Content-Type: application/json" \
                    -d "$_promote_payload" \
                    --connect-timeout 5 \
                    --max-time 15 \
                    "${_LCARS_BASE}/api/releases/${_release_id}/promote" 2>/dev/null) || _promote_http="000"
            fi

            if [ "$_promote_http" = "000" ]; then
                # Connection failure — LCARS not running (non-fatal)
                echo "[kb-release-push-promote] WARNING: LCARS not running at ${_LCARS_BASE} — promote API unreachable." >&2
                echo "  Recovery: when LCARS is running, run:" >&2
                echo "    kb-release promote ${_release_id} [--to STAGE]" >&2
                if [ "$OPT_DRY_RUN" -ne 1 ]; then
                    rm -f "$_promote_response_file"
                fi
                # Non-fatal — continue to next platform
                continue
            fi

            if [ "$_promote_http" = "400" ]; then
                # Check if "already at" — treat as no-op
                if [ "$OPT_DRY_RUN" -ne 1 ]; then
                    _resp_body=""
                    _resp_body=$(cat "$_promote_response_file" 2>/dev/null) || true
                    rm -f "$_promote_response_file"
                    _already=$(echo "$_resp_body" | python3 -c "
import json,sys
try:
    d = json.loads(sys.stdin.read())
    msg = d.get('error','') or d.get('message','')
    print('yes' if 'already' in msg.lower() else 'no')
except Exception:
    print('no')
" 2>/dev/null) || _already="no"
                else
                    _already="no"
                fi
                if [ "$_already" = "yes" ]; then
                    echo "[kb-release-push-promote] ${_release_id} ${_platform}: already at ${_target_env} — no-op."
                    continue
                fi
                echo "[kb-release-push-promote] ERROR: promote API returned HTTP 400 for ${_release_id} ${_platform}." >&2
                _OVERALL_EXIT=1
                continue
            fi

            if [ "$OPT_DRY_RUN" -ne 1 ]; then
                rm -f "$_promote_response_file" 2>/dev/null || true
            fi

            if [ "$_promote_http" != "200" ]; then
                echo "[kb-release-push-promote] ERROR: promote API returned HTTP ${_promote_http} for ${_release_id} ${_platform}." >&2
                _OVERALL_EXIT=1
                continue
            fi

            echo "[kb-release-push-promote] promoted ${_release_id} ${_platform} → ${_target_env}"

            # ── Step 4c: RELNOTES promotion ──────────────────────────────────
            _relnotes_dir=""
            if command -v _kb_get_team_relnotes_dir >/dev/null 2>&1; then
                _relnotes_dir=$(_kb_get_team_relnotes_dir "$_TEAM" "$_platform" 2>/dev/null) || true
            fi

            if [ -n "$_relnotes_dir" ] && command -v kb_relnotes_promote >/dev/null 2>&1; then
                # Determine env_from for RELNOTES
                _relnotes_from="$_env_from"
                # For PROD, SPEC §6 says source is GAMMA. XACA-1375-013: GAMMA follows the team's
                # flowConfig; when it is disabled the plan's env_from is the nearest ENABLED stage
                # before PROD, which is the source (identical to GAMMA whenever GAMMA is enabled).
                if [ "$_target_env" = "PROD" ]; then
                    _relnotes_from="${_env_from:-GAMMA}"
                fi

                if [ -z "$_relnotes_from" ]; then
                    echo "[kb-release-push-promote] WARNING: cannot determine env_from for RELNOTES — skipping RELNOTES promotion." >&2
                else
                    _relnotes_args=("$_relnotes_dir" "$_relnotes_from" "$_target_env")
                    if [ "$_target_env" = "PROD" ]; then
                        _relnotes_args=("${_relnotes_args[@]}" "--prod-stub")
                    fi
                    if [ "$OPT_DRY_RUN" -eq 1 ]; then
                        _relnotes_args=("${_relnotes_args[@]}" "--dry-run")
                    fi

                    set +e
                    kb_relnotes_promote "${_relnotes_args[@]}"
                    _relnotes_rc=$?
                    set -e

                    if [ "$_relnotes_rc" -ne 0 ]; then
                        echo "[kb-release-push-promote] WARNING: RELNOTES promotion returned non-zero (${_relnotes_rc}) — continuing." >&2
                    fi
                fi
            else
                if [ -z "$_relnotes_dir" ]; then
                    echo "[kb-release-push-promote] WARNING: relnotes_dir not configured for team '$_TEAM' platform '$_platform' — RELNOTES not promoted." >&2
                else
                    echo "[kb-release-push-promote] WARNING: kb_relnotes_promote function not loaded — RELNOTES not promoted." >&2
                fi
            fi

            # ── Step 4d: PROD loud prompt ────────────────────────────────────
            if [ "$_target_env" = "PROD" ]; then
                echo ""
                echo "============================================================"
                echo " PROD PROMOTION COMPLETE — MANUAL STEPS REQUIRED"
                echo "============================================================"
                echo ""
                echo " Release : ${_release_id}"
                echo " Platform: ${_platform}"
                echo " Stage   : PROD"
                echo ""
                echo " Store copy and Change Request are NOT automated."
                echo " You must complete the following steps manually:"
                echo ""
                echo " 1. Generate store assets (App Store promo copy, What's New):"
                echo "      /relnotes"
                echo "    Then review and finalize RELNOTES-PROD.md."
                echo ""
                echo " 2. Create or update the Change Request:"
                echo "      /cr"
                echo "    (Skipped if linkedCRs is already non-empty on this release"
                echo "     — XACA-0657 guard is active.)"
                echo ""
                echo " 3. Submit to the App Store / Play Store only after the CR"
                echo "    is approved and store assets are finalized."
                echo ""
                echo "============================================================"
                echo ""
            fi

            # Add to summary
            _PROMOTED_SUMMARY="${_PROMOTED_SUMMARY}  ${_release_id} ${_platform} → ${_target_env}
"
            ;;
        *)
            echo "[kb-release-push-promote] WARNING: unknown plan action '${_action}' — skipping." >&2
            ;;
    esac

done < <(printf '%s\n' "$_PROMOTE_PLAN")

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
if [ -n "$_PROMOTED_SUMMARY" ]; then
    echo ""
    echo "[kb-release-push-promote] Auto-promotion summary for branch '${OPT_BRANCH}':"
    printf '%s' "$_PROMOTED_SUMMARY"
elif [ "$_OVERALL_EXIT" -eq 0 ]; then
    echo "[kb-release-push-promote] No promotions performed for branch '${OPT_BRANCH}'."
fi

exit $_OVERALL_EXIT
