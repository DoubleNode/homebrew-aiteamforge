<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LCARS RunAtLoad LaunchAgent — XACA-0626
  =======================================
  One-shot agent that fires `aiteamforge start lcars` at every login/reboot,
  ensuring all configured-team LCARS servers are running after a reboot or
  after a crash that was not caught by lcars-health or lcars-watch.

  RunAtLoad  = true  — fires immediately on login/reboot, not just on events.
  KeepAlive  = false — one-shot; launchd does not restart this agent itself.
  ThrottleInterval = 30 — prevents double-fire on rapid reloads during install.

  `aiteamforge start lcars` iterates all configured teams and starts any server
  that is not already responding on its port. Already-running servers are left
  completely untouched (idempotent — the guard is in aiteamforge-start.sh).

  Why this agent is needed (XACA-0626-006 Defect D):
  - lcars-watch fires only on file changes (not a crash/reboot monitor).
  - lcars-health (300s interval, RunAtLoad) skips teams with no tmux session,
    which is the post-reboot state. Defect C fix relaxes that gate, but
    lcars-health still fires 300s after login. This agent fires immediately.
  - Together they provide defence-in-depth: RunAtLoad agent catches the login
    case instantly; lcars-health catches subsequent crashes within 5 minutes.

  XACA-0578 SIBLING-DRIFT NOTE: this plist template is one of five coupled sites.
  The other four must be updated together when this agent is added/renamed/removed:
    (a) install-kanban.sh::install_lcars_runatload_launchagent   (install side)
    (b) install-kanban.sh::uninstall_lcars_runatload_launchagent (uninstall side)
    (c) aiteamforge-upgrade.sh::update_launchagents agents array  (upgrade re-render)
    (d) aiteamforge-migrate.sh::update_launchagents agents array  (migrate re-render)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiteamforge.lcars-runatload</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Use absolute path: launchd PATH is minimal and does not include
             Homebrew bin by default. {{AITEAMFORGE_BIN}} is substituted by
             the installer to the brew-prefix bin/aiteamforge path. -->
        <string>{{AITEAMFORGE_BIN}}</string>
        <string>start</string>
        <string>lcars</string>
    </array>

    <!--
      RunAtLoad: fire immediately when the agent is loaded (at login/reboot).
      This ensures LCARS is started automatically without requiring the user to
      run a startup script manually.
    -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      KeepAlive false: one-shot execution. `aiteamforge start lcars` exits after
      starting all configured servers; launchd should not restart the agent.
    -->
    <key>KeepAlive</key>
    <false/>

    <!--
      ThrottleInterval: minimum seconds between successive job launches.
      Prevents double-fire if the agent is reloaded immediately after install.
    -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/lcars-runatload.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/lcars-runatload.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Include both Apple Silicon and Intel Homebrew prefixes so
             aiteamforge binary is reachable regardless of architecture. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{HOME_DIR}}</string>
        <key>AITEAMFORGE_DIR</key>
        <string>{{AITEAMFORGE_DIR}}</string>
    </dict>
</dict>
</plist>
