<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.devteam.fleet-reporter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/bash</string>
        <string>{{REPORTER_SCRIPT_PATH}}</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>{{AITEAMFORGE_DIR}}</string>
    <key>StandardOutPath</key>
    <string>{{AITEAMFORGE_DIR}}/logs/fleet-reporter.log</string>
    <key>StandardErrorPath</key>
    <string>{{AITEAMFORGE_DIR}}/logs/fleet-reporter.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <!-- XACA-1225-002: the REPORTER_PATH token just below (both braces
             deliberately NOT written literally in this comment — sed's
             substitution for it is global across the whole file, so writing
             it in full here would corrupt THIS COMMENT with the rendered
             PATH value too) carries the FULL PATH value: node's resolved
             bin dir, if found at install time, prepended to the standard
             Homebrew/system fallback. It is NOT a bare node-dir placeholder
             concatenated with a literal ':' in this template — doing that
             concatenation in the installer instead avoids ever rendering a
             leading ':' here when node isn't found (an empty leading PATH
             component means "current directory", which must never leak
             into a LaunchAgent's PATH). See install_fleet_reporter_launchagent()
             in install-fleet-monitor.sh. -->
        <string>{{REPORTER_PATH}}</string>
        <key>HOME</key>
        <string>{{USER_HOME}}</string>
        <key>AITEAMFORGE_DIR</key>
        <string>{{AITEAMFORGE_DIR}}</string>
    </dict>
    <key>KeepAlive</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
