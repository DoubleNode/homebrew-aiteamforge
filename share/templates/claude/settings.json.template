{
  "permissions": {
    "deny": [
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=* of=/dev/*:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "model": "opus",
  "cleanupPeriodDays": 30,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/kanban-session-start.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-session-knowledge-check.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kanban-crash-detect.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-lcars-port-drift-guard.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-live-config-drift-guard.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-team-registry-loss-guard.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-knowledge-sync-guard.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-gh-credential-guard.sh",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-where-refresh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run {{CLAUDE_CONFIG_DIR}}/hooks/damage-control/bash-tool-damage-control.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run {{CLAUDE_CONFIG_DIR}}/hooks/damage-control/edit-tool-damage-control.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run {{CLAUDE_CONFIG_DIR}}/hooks/damage-control/write-tool-damage-control.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/subagent-track.py start",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{CLAUDE_CONFIG_DIR}}/hooks/block-icloud-paths.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/kanban-hook.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/subagent-track.py stop",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/kanban-stop.py"
          },
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/subagent-track.py cleanup_if_empty",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AITEAMFORGE_DIR}}/scripts/kb-where-refresh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{AITEAMFORGE_DIR}}/kanban-hooks/subagent-track.py cleanup",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_CONFIG_DIR}}/hooks/inject-time-context.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{CLAUDE_CONFIG_DIR}}/statusline-command.sh"
  },
  "alwaysThinkingEnabled": true,
  "mcpServers": {},
  "env": {"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"},
  "skipDangerousModePermissionPrompt": true
}
