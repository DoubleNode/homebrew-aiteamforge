<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiteamforge.lcars-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>{{AITEAMFORGE_DIR}}/lcars-health-check.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/lcars-health.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/lcars-health-error.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <!-- AbandonProcessGroup (XACA-0763-002): launchd SIGKILLs every process
         still in this job's process group the instant the job itself exits.
         lcars-health-check.sh spawns a long-lived server.py that must
         survive past the health-check script's own exit — without this key
         launchd was reaping it within seconds of every 300s run. -->
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
