<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.aiteamforge.cr-confluence-poller.{{TEAM_NAME}}.plist — TEMPLATE
  Installer substitutes: {{PYTHON3_PATH}} {{AITEAMFORGE_DIR}} {{USER_HOME}} {{TEAM_NAME}}

  Per-Team LaunchAgent Scheme (XACA-0350):
    One LaunchAgent plist is installed PER TEAM configured in confluence-credentials.json.
    Each plist invokes cr-confluence-poller.py with the team flag so that team's daemon
    runs independently. If one team's credentials are broken, only that team's agent
    fails; the other teams continue unaffected.

    Label pattern:  com.aiteamforge.cr-confluence-poller.TEAM
    Plist path:     ~/Library/LaunchAgents/com.aiteamforge.cr-confluence-poller.TEAM.plist
    Log paths:      ~/Library/Logs/aiteamforge/cr-poller/TEAM.out.log
                    ~/Library/Logs/aiteamforge/cr-poller/TEAM.err.log

  This template is rendered once per team by install_cr_confluence_poller_launchagent().

  MIGRATION:
    The legacy global plist (com.aiteamforge.cr-confluence-poller.plist, no team suffix)
    is unloaded and removed automatically on the next install run.

  PER-TEAM OPT-IN (XACA-0470):
    The setup wizard now asks, per team, whether to enable the CR workflow, and
    captures shared Atlassian credentials when at least one team opts in. The
    opt-in is recorded in (non-secret, mode 644):
    ~/.config/aiteamforge/cr-config.json
      { "version": 1, "prompted": true, "teams": { "ios": true, "android": false } }
    cr-config.json is the AUTHORITY for which teams get a plist: a plist is
    installed only for teams whose value is true AND which have credentials;
    plists for non-enabled teams are unloaded+removed on every install/upgrade.

  CREDENTIALS (auto-created by the wizard; also editable by hand) — mode 600:
    ~/.config/aiteamforge/confluence-credentials.json
    Schema (one entry per CR-enabled team):
      {
        "teams": {
          "ios":      { "site": "...", "email": "...", "api_token": "...", "space_key": "DPD2" },
          "android":  { "site": "...", "email": "...", "api_token": "...", "space_key": "DPD2" },
          "firebase": { "site": "...", "email": "...", "api_token": "...", "space_key": "DPD2" }
        },
        "default": "ios"
      }
    If no team is CR-enabled, or an enabled team has no credentials entry, the
    installer skips that plist and logs an info message. The daemon itself exits
    cleanly with a warning if the file is absent at runtime.

  LOGS (per-team):
    stdout: {{USER_HOME}}/Library/Logs/aiteamforge/cr-poller/{{TEAM_NAME}}.out.log
    stderr: {{USER_HOME}}/Library/Logs/aiteamforge/cr-poller/{{TEAM_NAME}}.err.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiteamforge.cr-confluence-poller.{{TEAM_NAME}}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON3_PATH}}</string>
        <string>{{AITEAMFORGE_DIR}}/scripts/cr-confluence-poller.py</string>
        <string>--daemon</string>
        <string>--team</string>
        <string>{{TEAM_NAME}}</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{USER_HOME}}/Library/Logs/aiteamforge/cr-poller/{{TEAM_NAME}}.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{USER_HOME}}/Library/Logs/aiteamforge/cr-poller/{{TEAM_NAME}}.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{USER_HOME}}</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
